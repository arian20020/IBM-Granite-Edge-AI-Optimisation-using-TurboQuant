<?xml version="1.0" encoding="utf-8" ?>
<!--  This is an xml based file and uses utf-8 text encoding  -->
<!--  Start of whole app windo(what you see), that tag has more info inside, like x:Class, xmlns etc  -->
<Window
    x:Class="GraniteEdgeAI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <!--  Controls what we see in the background behind the buttons, cards, titles etc  -->
        <MicaBackdrop
            Kind="Base" />
        <!--  mica backdrop is the background effect provided by windows  -->
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Background="{ThemeResource GraniteAppCanvasBrush}">
        <!--  Griddeals with where the UI element are placed on the screen  -->
        <Grid.RowDefinitions>
            <!--
                this decides how many rows the grid has and how tall each row is
                the more row definitions the more rows
            -->
            <!--  Title Bar  -->
            <RowDefinition
                Height="Auto" />
            <!--  Auto means make this row as tall as the thing inside needs it  -->

            <!--  App Content  -->
            <RowDefinition
                Height="*" />
            <!--  * means use the remaining space available  -->
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="60"
            Background="{ThemeResource GraniteAppSurfaceBrush}"
            Visibility="Visible">
            <TitleBar.LeftHeader>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Text="G" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            FontFamily="Segoe UI Variable Text"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="Granite" />
                        <TextBlock
                            Opacity="0.72"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="12"
                            Text="with TurboQuant" />
                    </StackPanel>
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        <!--  App content will go here later  -->
        <Frame
            x:Name="rootFrame"
            Grid.Row="1" />
    </Grid>
</Window>
