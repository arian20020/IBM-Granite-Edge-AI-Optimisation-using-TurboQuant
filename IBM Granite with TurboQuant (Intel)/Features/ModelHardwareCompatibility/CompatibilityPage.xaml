<?xml version="1.0" encoding="utf-8"?>
<!--
  DESIGN PREVIEW ONLY. Loaded by the backend-disconnected external review host.
  The shell owns the native title bar, review controls, page heading, and journey footer.
-->
<Page
    x:Class="GraniteEdgeAI.Features.ModelHardwareCompatibility.CompatibilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="LayoutRoot"
    SizeChanged="LayoutRoot_SizeChanged"
    HorizontalAlignment="Stretch"
    AutomationProperties.AutomationId="CompatibilityPreview"
    AutomationProperties.Name="Model and hardware compatibility work surface">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Thickness x:Key="CompatibilityOutlineThickness">1</Thickness>
                    <Thickness x:Key="CompatibilityTopOutlineThickness">0,1,0,0</Thickness>
                    <Thickness x:Key="CompatibilityBudgetSeparatorRightThickness">0,0,0.8,0</Thickness>
                    <SolidColorBrush x:Key="CompatibilitySurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CompatibilitySubtleSurfaceBrush" Color="#F8FAFD" />
                    <SolidColorBrush x:Key="CompatibilityBorderBrush" Color="#D7E0EC" />
                    <SolidColorBrush x:Key="CompatibilityBudgetSeparatorBrush" Color="#F8FAFD" />
                    <SolidColorBrush x:Key="CompatibilityTextBrush" Color="#111827" />
                    <SolidColorBrush x:Key="CompatibilityMutedTextBrush" Color="#5B677A" />
                    <SolidColorBrush x:Key="CompatibilitySubtleTextBrush" Color="#758196" />
                    <SolidColorBrush x:Key="CompatibilityAccentBrush" Color="#0F62FE" />
                    <SolidColorBrush x:Key="CompatibilityAccentSurfaceBrush" Color="#EDF4FF" />
                    <SolidColorBrush x:Key="CompatibilityAccentBorderBrush" Color="#8BB4FF" />
                    <SolidColorBrush x:Key="CompatibilitySuccessBrush" Color="#087A55" />
                    <SolidColorBrush x:Key="CompatibilitySuccessSurfaceBrush" Color="#ECF8F3" />
                    <SolidColorBrush x:Key="CompatibilitySuccessBorderBrush" Color="#A9DDCB" />
                    <SolidColorBrush x:Key="CompatibilityWarningBrush" Color="#8A4B08" />
                    <SolidColorBrush x:Key="CompatibilityWarningSurfaceBrush" Color="#FFF7E8" />
                    <SolidColorBrush x:Key="CompatibilityWarningBorderBrush" Color="#E9C98B" />
                    <SolidColorBrush x:Key="CompatibilityErrorBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="CompatibilityErrorSurfaceBrush" Color="#FFF1F0" />
                    <SolidColorBrush x:Key="CompatibilityErrorBorderBrush" Color="#F2B8B5" />
                    <SolidColorBrush x:Key="CompatibilityWaitingSurfaceBrush" Color="#EEF1F5" />
                    <SolidColorBrush x:Key="CompatibilityWaitingTextBrush" Color="#667085" />
                    <SolidColorBrush x:Key="CompatibilityPointerOverBrush" Color="#F1F4F8" />
                    <SolidColorBrush x:Key="CompatibilityPressedBrush" Color="#E4E9F0" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F62FE" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0B57D0" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0847AA" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Thickness x:Key="CompatibilityOutlineThickness">0.8</Thickness>
                    <Thickness x:Key="CompatibilityTopOutlineThickness">0,0.8,0,0</Thickness>
                    <Thickness x:Key="CompatibilityBudgetSeparatorRightThickness">0,0,0.8,0</Thickness>
                    <SolidColorBrush x:Key="CompatibilitySurfaceBrush" Color="#151D2B" />
                    <SolidColorBrush x:Key="CompatibilitySubtleSurfaceBrush" Color="#1B2535" />
                    <SolidColorBrush x:Key="CompatibilityBorderBrush" Color="#344054" />
                    <SolidColorBrush x:Key="CompatibilityBudgetSeparatorBrush" Color="#151D2B" />
                    <SolidColorBrush x:Key="CompatibilityTextBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="CompatibilityMutedTextBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="CompatibilitySubtleTextBrush" Color="#98A2B3" />
                    <SolidColorBrush x:Key="CompatibilityAccentBrush" Color="#78A9FF" />
                    <SolidColorBrush x:Key="CompatibilityAccentSurfaceBrush" Color="#162B49" />
                    <SolidColorBrush x:Key="CompatibilityAccentBorderBrush" Color="#4589FF" />
                    <SolidColorBrush x:Key="CompatibilitySuccessBrush" Color="#6FD2AE" />
                    <SolidColorBrush x:Key="CompatibilitySuccessSurfaceBrush" Color="#12372E" />
                    <SolidColorBrush x:Key="CompatibilitySuccessBorderBrush" Color="#236B59" />
                    <SolidColorBrush x:Key="CompatibilityWarningBrush" Color="#F4C97A" />
                    <SolidColorBrush x:Key="CompatibilityWarningSurfaceBrush" Color="#392B16" />
                    <SolidColorBrush x:Key="CompatibilityWarningBorderBrush" Color="#725A2D" />
                    <SolidColorBrush x:Key="CompatibilityErrorBrush" Color="#FFB4AB" />
                    <SolidColorBrush x:Key="CompatibilityErrorSurfaceBrush" Color="#3D2021" />
                    <SolidColorBrush x:Key="CompatibilityErrorBorderBrush" Color="#7D3C3F" />
                    <SolidColorBrush x:Key="CompatibilityWaitingSurfaceBrush" Color="#273142" />
                    <SolidColorBrush x:Key="CompatibilityWaitingTextBrush" Color="#98A2B3" />
                    <SolidColorBrush x:Key="CompatibilityPointerOverBrush" Color="#202A39" />
                    <SolidColorBrush x:Key="CompatibilityPressedBrush" Color="#293547" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#78A9FF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#8CB7FF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A6C8FF" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#07111F" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#07111F" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#07111F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Thickness x:Key="CompatibilityOutlineThickness">1</Thickness>
                    <Thickness x:Key="CompatibilityTopOutlineThickness">0,1,0,0</Thickness>
                    <Thickness x:Key="CompatibilityBudgetSeparatorRightThickness">0,0,1,0</Thickness>
                    <SolidColorBrush x:Key="CompatibilitySurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompatibilitySubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompatibilityBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityBudgetSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilitySubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CompatibilityAccentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompatibilityAccentBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CompatibilitySuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilitySuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompatibilitySuccessBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityWarningSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompatibilityWarningBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityErrorSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompatibilityErrorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityWaitingSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CompatibilityWaitingTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CompatibilityPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CompatibilityPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CompatibilityBodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource CompatibilityMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="CompatibilityLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Foreground" Value="{ThemeResource CompatibilityMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="CompatibilityValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource CompatibilityTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="CompatibilityPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="176" />
                <Setter Property="MaxWidth" Value="240" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="CompatibilitySecondaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="176" />
                <Setter Property="MaxWidth" Value="240" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource CompatibilitySubtleSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CompatibilityBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource CompatibilityOutlineThickness}" />
                <Setter Property="Foreground" Value="{ThemeResource CompatibilityTextBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="CompatibilityQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource CompatibilitySecondaryButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource CompatibilityMutedTextBrush}" />
            </Style>
            <Style x:Key="CompatibilityDisclosureHeaderToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource CompatibilityTextBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CompatibilityAccentBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="DisclosureHeaderSurface" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="DisclosureHeaderSurface.Background" Value="{ThemeResource CompatibilitySurfaceBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="DisclosureHeaderSurface.Background" Value="{ThemeResource CompatibilityWaitingSurfaceBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates"><VisualState x:Name="Unchecked" /><VisualState x:Name="Checked" /><VisualState x:Name="Indeterminate" /></VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="Stretch" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompatibilityDisclosureStyle" TargetType="Expander">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource CompatibilitySubtleSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CompatibilityBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource CompatibilityOutlineThickness}" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border x:Name="DisclosureOuterBorder"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    MaxWidth="{TemplateBinding MaxWidth}"
                                    HorizontalAlignment="Stretch"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                     CornerRadius="{TemplateBinding CornerRadius}"
                                     UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="ExpandStates">
                                        <VisualState x:Name="ExpandUp"><VisualState.Setters><Setter Target="DisclosureContent.Visibility" Value="Visible" /><Setter Target="InspectionEvidenceChevronDown.Visibility" Value="Collapsed" /><Setter Target="InspectionEvidenceChevronUp.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="CollapseDown"><VisualState.Setters><Setter Target="DisclosureContent.Visibility" Value="Collapsed" /><Setter Target="InspectionEvidenceChevronDown.Visibility" Value="Visible" /><Setter Target="InspectionEvidenceChevronUp.Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="ExpandDown"><VisualState.Setters><Setter Target="DisclosureContent.Visibility" Value="Visible" /><Setter Target="InspectionEvidenceChevronDown.Visibility" Value="Collapsed" /><Setter Target="InspectionEvidenceChevronUp.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="CollapseUp"><VisualState.Setters><Setter Target="DisclosureContent.Visibility" Value="Collapsed" /><Setter Target="InspectionEvidenceChevronDown.Visibility" Value="Visible" /><Setter Target="InspectionEvidenceChevronUp.Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ExpandDirectionStates"><VisualState x:Name="Down" /><VisualState x:Name="Up" /></VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <ToggleButton x:Name="ExpanderHeader"
                                            AutomationProperties.AutomationId="ExpanderToggleButton"
                                                      MinHeight="52"
                                                      Padding="14,0,52,0"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                                       IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                       IsEnabled="{TemplateBinding IsEnabled}"
                                                       Style="{StaticResource CompatibilityDisclosureHeaderToggleStyle}"
                                                       UseSystemFocusVisuals="True" />
                                        <Grid Width="32" Height="32" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <FontIcon x:Name="InspectionEvidenceChevronDown" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource CompatibilityMutedTextBrush}" Glyph="&#xE70D;" AutomationProperties.AccessibilityView="Raw" />
                                            <FontIcon x:Name="InspectionEvidenceChevronUp" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource CompatibilityMutedTextBrush}" Glyph="&#xE70E;" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                                        </Grid>
                                    </Grid>
                                    <Border x:Name="ExpanderContentClip" Grid.Row="1">
                                        <Border x:Name="DisclosureContent"
                                                Padding="14,12"
                                                HorizontalAlignment="Stretch"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Visibility="Collapsed">
                                            <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompatibilityProgressItemStyle" TargetType="ListViewItem">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer
        x:Name="CompatibilityContentScroll"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollMode="Enabled"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Disabled">
    <Grid
        x:Name="CompatibilityViewportCenteringHost"
        HorizontalAlignment="Stretch">
    <Border
        x:Name="CompatibilityBay"
        MaxWidth="960"
        Padding="24,20,24,16"
        HorizontalAlignment="Stretch"
        Background="{ThemeResource CompatibilitySurfaceBrush}"
        BorderBrush="{ThemeResource CompatibilityBorderBrush}"
        BorderThickness="{ThemeResource CompatibilityOutlineThickness}"
        CornerRadius="12"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="CompatibilityBay"
        AutomationProperties.Name="Compatibility analysis and decision">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="CompatibilityIdentityHeader" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="40" Height="40" CornerRadius="20"
                    Background="{ThemeResource CompatibilityAccentSurfaceBrush}"
                    BorderBrush="{ThemeResource CompatibilityAccentBorderBrush}"
                    BorderThickness="{ThemeResource CompatibilityOutlineThickness}">
                    <FontIcon Glyph="&#xE7C3;" FontSize="18" Foreground="{ThemeResource CompatibilityAccentBrush}" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="CompatibilityModelName" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="granite-4.0-h-1b-Q4_K_M.gguf" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="CompatibilityModelDetail" Style="{StaticResource CompatibilityBodyStyle}" Text="GGUF · llama.cpp route · checked against this computer" />
                </StackPanel>
                <Border
                    x:Name="CompatibilityIdentityStatus"
                    Grid.Column="2"
                    Height="32"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CompatibilityAccentSurfaceBrush}"
                    BorderBrush="{ThemeResource CompatibilityAccentBorderBrush}"
                    BorderThickness="{ThemeResource CompatibilityOutlineThickness}"
                    CornerRadius="16"
                    UseLayoutRounding="True"
                    AutomationProperties.AutomationId="CompatibilityIdentityStatus"
                    AutomationProperties.Name="Analysing">
                    <TextBlock x:Name="CompatibilityIdentityStatusText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityAccentBrush}" Text="Analysing" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityTopOutlineThickness}" />

            <StackPanel x:Name="CompatibilityStateHost" Grid.Row="2" Margin="0,16,0,0" Spacing="14">
                <Grid x:Name="CompatibilityAnalysisPanel" AutomationProperties.AutomationId="CompatibilityAnalysisPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="CompatibilityProgressHeader" MinHeight="66" ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="CompatibilityProgressCopy" Spacing="3">
                            <TextBlock x:Name="CompatibilityProgressHeading" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Working out what this model needs" TextWrapping="WrapWholeWords" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock x:Name="CompatibilityProgressDetail" Style="{StaticResource CompatibilityBodyStyle}" Text="Reading the inspected model facts needed for a safe memory estimate." />
                        </StackPanel>
                        <TextBlock x:Name="CompatibilityProgressCount" Grid.Column="1" VerticalAlignment="Top" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityMutedTextBrush}" Text="0 of 4 checks complete" AutomationProperties.LiveSetting="Polite" />
                    </Grid>

                    <ItemsControl
                        x:Name="CompatibilityProgressRows"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Height="240"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CompatibilityProgressRows"
                        AutomationProperties.Name="Compatibility analysis stages">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ListViewItem x:Name="CompatibilityStage1" Style="{StaticResource CompatibilityProgressItemStyle}" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="4" AutomationProperties.Name="Working out what this model needs, step 1 of 4, Active">
                            <Grid MinHeight="56" Padding="8,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="CompatibilityStage1GlyphSurface" Width="32" Height="32" VerticalAlignment="Center" Background="{ThemeResource CompatibilityAccentSurfaceBrush}" BorderBrush="{ThemeResource CompatibilityAccentBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="16">
                                    <Grid x:Name="CompatibilityStage1GlyphPresenter" Width="32" Height="32">
                                        <TextBlock x:Name="CompatibilityStage1Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityAccentBrush}" Text="1" />
                                        <FontIcon x:Name="CompatibilityStage1Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource CompatibilitySuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                                        <Grid x:Name="CompatibilityStage1OrbitPresenter" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                                            <Ellipse x:Name="CompatibilityOrbitEllipse" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource CompatibilityAccentBrush}" StrokeThickness="1.6" StrokeDashArray="26,13.27" StrokeDashCap="Round" UseLayoutRounding="False" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Working out what this model needs" TextWrapping="WrapWholeWords" />
                                    <TextBlock x:Name="CompatibilityStage1Description" FontSize="12" Foreground="{ThemeResource CompatibilityMutedTextBrush}" Text="Model requirements are calculated from the inspected package facts." TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <TextBlock x:Name="CompatibilityStage1Status" Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityAccentBrush}" Text="Active" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem x:Name="CompatibilityStage2" Style="{StaticResource CompatibilityProgressItemStyle}" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="4" AutomationProperties.Name="Checking the ways it could run, step 2 of 4, Waiting">
                            <Grid MinHeight="56" Padding="8,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
