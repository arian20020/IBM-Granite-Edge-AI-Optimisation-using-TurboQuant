<?xml version="1.0" encoding="utf-8" ?>

<!--
    Layout A: the approved Direction B grammar applied literally.

    Geometry is transcribed from docs/superpowers/visual-authority/
    compat-visual-style-v3.html rather than reinvented. The rules that keep it
    honest under real content, each with its CSS counterpart:

      .hi [class] { min-width: 0 }   every child may shrink, so no pill or
                                     label can push out of its card
      .b-columns 1.35fr .85fr        dominant facts card, stacked side cards
      .b-side  grid-auto-rows: 1fr   side cards share one height
      .facts-grid grid-auto-rows:1fr fact tiles share one row height
      .fact-detail margin-top: auto  detail line pinned to the tile's bottom
      gap                          one token drives all vertical rhythm

    In XAML, "may shrink" is the default for Grid children, but a TextBlock will
    still push its parent unless it is told to trim; every text element that can
    receive variable content therefore sets TextTrimming explicitly.
-->
<Page
    x:Class="GraniteEdgeAI.Features.ModelHardwareCompatibility.CompatibilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:GraniteEdgeAI.Features.ModelHardwareCompatibility.Controls"
    xmlns:modelDownload="using:GraniteEdgeAI.Features.ModelImport.ModelDownload"
    d:DesignHeight="1024"
    d:DesignWidth="1440"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <!--
            Merged here rather than in App.xaml so the feature owns its own
            theming and needs no change to a file another workstream owns.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelImport/ModelDownload/ModelPreferenceSliderTheme.xaml" />
                <ResourceDictionary Source="ms-appx:///Features/ModelHardwareCompatibility/Presentation/CompatibilityTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" Background="{ThemeResource CompatibilityCanvasBrush}">

        <ScrollViewer
            x:Name="ContentHost"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            Padding="{StaticResource CompatibilityPageMargin}"
            SizeChanged="ContentHost_SizeChanged"
            VerticalScrollBarVisibility="Auto">

            <Grid
                x:Name="PageStack"
                MaxWidth="1240"
                HorizontalAlignment="Center"
                RowSpacing="14"
                SizeChanged="PageStack_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Stretch">
                    <TextBlock
                        x:Name="PageTitleText"
                        FontSize="{StaticResource CompatibilityTitleFontSize}"
                        FontWeight="Bold"
                        Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                        HorizontalAlignment="Center"
                        Text="Model and hardware compatibility"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PageLedeText"
                        FontSize="{StaticResource CompatibilityLedeFontSize}"
                        Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,3,0,0"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Model row -->
                <Border
                    x:Name="ModelSummaryCard"
                    Grid.Row="1"
                    Background="{ThemeResource CompatibilitySurfaceBrush}"
                    BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CompatibilityCardRadius}"
                    Padding="20,15,20,15">
                    <Grid x:Name="ModelSummaryLayoutGrid" ColumnSpacing="14" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                            BorderBrush="{ThemeResource CompatibilityBlueBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Height="38"
                            Width="38" />
                        <StackPanel x:Name="ModelSummaryTextPanel" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="ModelNameText"
                                FontSize="{StaticResource CompatibilityRowTitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="ModelDetailText"
                                FontSize="{StaticResource CompatibilityRowSubFontSize}"
                                Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Exact memory evidence consumed by this compatibility decision. -->
                <Border
                    x:Name="MachineMemoryCard"
                    Grid.Row="2"
                    Background="{ThemeResource CompatibilitySurfaceBrush}"
                    BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CompatibilityCardRadius}"
                    Padding="{StaticResource CompatibilitySectionCardPadding}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock
                                FontSize="{StaticResource CompatibilityCardTitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                Text="This computer" />
                            <TextBlock
                                FontSize="{StaticResource CompatibilityOutcomeBodyFontSize}"
                                Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                Text="Memory measured when this compatibility check ran."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid x:Name="MachineMemoryFactsGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="MachineMemoryInstalledTile"
                                Grid.Column="0"
                                Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                                BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CompatibilityFactRadius}"
                                Padding="14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="MachineMemoryInstalledLabel" FontSize="{StaticResource CompatibilityFactLabelFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextMutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineMemoryInstalledValue" FontSize="{StaticResource CompatibilityFactValueFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineMemoryInstalledDetail" FontSize="{StaticResource CompatibilityRowSubFontSize}" Foreground="{ThemeResource CompatibilityTextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="MachineMemoryAvailableTile"
                                Grid.Column="1"
                                Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                                BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CompatibilityFactRadius}"
                                Padding="14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="MachineMemoryAvailableLabel" FontSize="{StaticResource CompatibilityFactLabelFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextMutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineMemoryAvailableValue" FontSize="{StaticResource CompatibilityFactValueFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineMemoryAvailableDetail" FontSize="{StaticResource CompatibilityRowSubFontSize}" Foreground="{ThemeResource CompatibilityTextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="MachineMemoryReserveTile"
                                Grid.Column="2"
                                Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                                BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CompatibilityFactRadius}"
                                Padding="14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="MachineMemoryReserveLabel" FontSize="{StaticResource CompatibilityFactLabelFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextMutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineMemoryReserveValue" FontSize="{StaticResource CompatibilityFactValueFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineMemoryReserveDetail" FontSize="{StaticResource CompatibilityRowSubFontSize}" Foreground="{ThemeResource CompatibilityTextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="MachineMemorySafeTile"
                                Grid.Column="3"
                                Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                                BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CompatibilityFactRadius}"
                                Padding="14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="MachineMemorySafeLabel" FontSize="{StaticResource CompatibilityFactLabelFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextMutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineMemorySafeValue" FontSize="{StaticResource CompatibilityFactValueFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineMemorySafeDetail" FontSize="{StaticResource CompatibilityRowSubFontSize}" Foreground="{ThemeResource CompatibilityTextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Outcome card -->
                <Border
                    x:Name="OutcomeCard"
                    Grid.Row="3"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CompatibilityCardRadius}"
                    Padding="{StaticResource CompatibilityOutcomePadding}">
                    <Grid x:Name="OutcomeLayoutGrid" ColumnSpacing="14" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="OutcomeGlyphHost"
                            Grid.Column="0"
                            CornerRadius="16"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            MinWidth="32">
                            <TextBlock
                                x:Name="OutcomeGlyphText"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel x:Name="OutcomeTextPanel" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="OutcomeTitleText"
                                FontSize="{StaticResource CompatibilityOutcomeTitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="OutcomeDetailText"
                                FontSize="{StaticResource CompatibilityOutcomeBodyFontSize}"
                                Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            x:Name="OutcomeBadgeHost"
                            Grid.Column="2"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CompatibilityPillRadius}"
                            Padding="11,7,11,7"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="OutcomeBadgeText"
                                FontSize="{StaticResource CompatibilityPillFontSize}"
                                FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- .b-columns: 1.35fr / .85fr, children stretch to equal height -->
                <Grid x:Name="AssessmentGrid" Grid.Row="4" ColumnSpacing="14">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="AssessmentLayoutStates">
                            <VisualState x:Name="WideAssessment">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1100" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="MainFactsColumn.Width" Value="1.35*" />
                                    <Setter Target="SideFactsColumn.Width" Value="0.85*" />
                                    <Setter Target="MainFactsCard.(Grid.ColumnSpan)" Value="1" />
                                    <Setter Target="SideCardsGrid.(Grid.Column)" Value="1" />
                                    <Setter Target="SideCardsGrid.(Grid.Row)" Value="0" />
                                    <Setter Target="SideCardsGrid.(Grid.ColumnSpan)" Value="1" />
                                    <Setter Target="SideCardsGrid.Margin" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="NarrowAssessment">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="MainFactsColumn.Width" Value="*" />
                                    <Setter Target="SideFactsColumn.Width" Value="0" />
                                    <Setter Target="MainFactsCard.(Grid.ColumnSpan)" Value="2" />
                                    <Setter Target="SideCardsGrid.(Grid.Column)" Value="0" />
                                    <Setter Target="SideCardsGrid.(Grid.Row)" Value="1" />
                                    <Setter Target="SideCardsGrid.(Grid.ColumnSpan)" Value="2" />
                                    <Setter Target="SideCardsGrid.Margin" Value="0,14,0,0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MainFactsColumn" Width="1.35*" />
                        <ColumnDefinition x:Name="SideFactsColumn" Width="0.85*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dominant facts card -->
                    <Border
                        x:Name="MainFactsCard"
                        Grid.Column="0"
                        Grid.Row="0"
                        Background="{ThemeResource CompatibilitySurfaceBrush}"
                        BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CompatibilityCardRadius}"
                        Padding="{StaticResource CompatibilityMainFactsPadding}">
                        <StackPanel>
                            <TextBlock
                                x:Name="FactsCardTitle"
                                FontSize="{StaticResource CompatibilityCardTitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                Text="What this model needs" />
                            <!--
                                Two columns of tiles that share one row height, with
                                each tile's detail pinned to its own bottom edge.
                            -->
                            <Grid
                                x:Name="FactsGrid"
                                ColumnSpacing="12"
                                Margin="0,14,0,0"
                                RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="0" />
                                    <RowDefinition Height="0" />
                                </Grid.RowDefinitions>
                            </Grid>

                            <!--
                                The memory picture, under the tiles it explains.
                                Collapsed when nothing was evaluated: a bar drawn
                                at zero reads as a model that costs nothing, which
                                is the opposite of what an unanswered check means.
                            -->
                            <controls:CompatibilityBudgetDiagram
                                x:Name="BudgetDiagram"
                                Margin="0,16,0,0"
                                ShowLegend="False"
                                Visibility="Collapsed" />

                            <Border
                                x:Name="EstimateBreakdownCard"
                                Background="{ThemeResource CompatibilityCanvasBrush}"
                                BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CompatibilityCardRadius}"
                                Margin="0,16,0,0"
                                Padding="14"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="{StaticResource CompatibilityCardTitleFontSize}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                        Text="Estimated memory breakdown" />
                                    <TextBlock
                                        FontSize="{StaticResource CompatibilityOutcomeBodyFontSize}"
                                        Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                        Margin="0,3,0,0"
                                        Text="Calculated for the setup shown above — not measured"
                                        TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="10" Margin="0,12,0,0" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Background="{ThemeResource CompatibilitySurfaceBrush}"
                                            BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="{StaticResource CompatibilityFactLabelFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                                    Text="MODEL WEIGHTS" />
                                                <TextBlock
                                                    x:Name="EstimateWeightsValue"
                                                    FontSize="{StaticResource CompatibilityFactValueFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                                    Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Background="{ThemeResource CompatibilitySurfaceBrush}"
                                            BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="{StaticResource CompatibilityFactLabelFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                                    Text="KV CACHE" />
                                                <TextBlock
                                                    x:Name="EstimateKvCacheValue"
                                                    FontSize="{StaticResource CompatibilityFactValueFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                                    Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Background="{ThemeResource CompatibilitySurfaceBrush}"
                                            BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="{StaticResource CompatibilityFactLabelFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                                    Text="RUNTIME AND BUFFERS" />
                                                <TextBlock
                                                    x:Name="EstimateRuntimeValue"
                                                    FontSize="{StaticResource CompatibilityFactValueFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                                    Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Background="{ThemeResource CompatibilitySurfaceBrush}"
                                            BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="{StaticResource CompatibilityFactLabelFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                                    Text="MARGIN FOR ERROR" />
                                                <TextBlock
                                                    x:Name="EstimateMarginValue"
                                                    FontSize="{StaticResource CompatibilityFactValueFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                                    Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                                            BorderBrush="{ThemeResource CompatibilityBlueBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="{StaticResource CompatibilityFactLabelFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                                    Text="ESTIMATED PEAK" />
                                                <TextBlock
                                                    x:Name="EstimatePeakValue"
                                                    FontSize="{StaticResource CompatibilityFactValueFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                                    Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                                            BorderBrush="{ThemeResource CompatibilityBlueBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="{StaticResource CompatibilityFactLabelFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                                    Text="SAFE MEMORY" />
                                                <TextBlock
                                                    x:Name="EstimateSafeValue"
                                                    FontSize="{StaticResource CompatibilityFactValueFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                                    Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Side stack: equal rows -->
                    <Grid x:Name="SideCardsGrid" Grid.Column="1" Grid.Row="0" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="RuntimeCard"
                            Grid.Row="0"
                            Background="{ThemeResource CompatibilitySurfaceBrush}"
                            BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CompatibilityCardRadius}"
                            Padding="{StaticResource CompatibilityMiniCardPadding}">
                            <StackPanel>
                                <TextBlock
                                    x:Name="RuntimeCardTitleText"
                                    FontSize="{StaticResource CompatibilityCardTitleFontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}" />
                                <StackPanel x:Name="RuntimeRows" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="ChecksCard"
                            Grid.Row="1"
                            Background="{ThemeResource CompatibilitySurfaceBrush}"
                            BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CompatibilityCardRadius}"
                            Padding="{StaticResource CompatibilityMiniCardPadding}">
                            <StackPanel>
                                <TextBlock
                                    x:Name="ChecksCardTitleText"
                                    FontSize="{StaticResource CompatibilityCardTitleFontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}" />
                                <StackPanel x:Name="CheckRows" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!--
                    One in-page optimisation choice. It consumes the flattened
                    Task 5 view only; no candidate generation or estimation is
                    performed by this visual tree.
                -->
                <Border
                    x:Name="OptimizationCard"
                    Grid.Row="5"
                    Background="{ThemeResource CompatibilitySurfaceBrush}"
                    BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CompatibilityCardRadius}"
                    Padding="{StaticResource CompatibilitySectionCardPadding}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="{StaticResource CompatibilityCardTitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                Text="Choose how to optimise this model" />
                            <TextBlock
                                x:Name="OptimizationInstructionText"
                                FontSize="{StaticResource CompatibilityOutcomeBodyFontSize}"
                                Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid x:Name="OptimizationSetupGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="CurrentSetupCard"
                                Background="{ThemeResource CompatibilityCanvasBrush}"
                                BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CompatibilityFactRadius}"
                                Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="SemiBold" Text="Current setup" />
                                    <Grid x:Name="CurrentSetupFactsGrid" ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="CurrentWeightText" Grid.Column="0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CurrentCacheText" Grid.Column="1" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CurrentContextText" Grid.Column="2" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CurrentSystemMemoryText" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CurrentDedicatedMemoryText" Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="RecommendedSetupCard"
                                Grid.Column="1"
                                Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                                BorderBrush="{ThemeResource CompatibilityBlueBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CompatibilityFactRadius}"
                                Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid x:Name="RecommendedSetupHeaderGrid" ColumnSpacing="8" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="Recommended setup" />
                                        <TextBlock
                                            x:Name="RecommendedModeLabelText"
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource CompatibilityPrimaryBlueBrush}" />
                                    </Grid>
                                    <Grid x:Name="RecommendedSetupFactsGrid" ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="RecommendedWeightText" Grid.Column="0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RecommendedCacheText" Grid.Column="1" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RecommendedContextText" Grid.Column="2" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RecommendedSystemMemoryText" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RecommendedDedicatedMemoryText" Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="RecommendedQualityText"
                                            Grid.Row="2"
                                            Grid.ColumnSpan="3"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button
                            x:Name="AutomaticChoice"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="AutomaticChoice_Click">
                            <Grid x:Name="AutomaticChoiceLayout" ColumnSpacing="12" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="Automatic" />
                                    <TextBlock
                                        x:Name="AutomaticQualityText"
                                        Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="AutomaticSelectedText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CompatibilityPrimaryBlueBrush}"
                                    Text="Recommended" />
                            </Grid>
                        </Button>

                        <StackPanel Spacing="4">
                            <Grid x:Name="PreferenceHeaderGrid" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Your preference" />
                                <TextBlock
                                    x:Name="OptimizationSliderLabelText"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource CompatibilityPrimaryBlueBrush}" />
                            </Grid>
                            <modelDownload:ModelPreferenceSlider
                                x:Name="OptimizationSlider"
                                MinHeight="44"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="1"
                                LargeChange="10"
                                StepFrequency="1"
                                SnapsTo="StepValues"
                                IsThumbToolTipEnabled="False"
                                AutomationProperties.Name="Optimisation preference"
                                AutomationProperties.HelpText="Choose between maximum efficiency and maximum model capability"
                                ValueChanged="OptimizationSlider_ValueChanged" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource CompatibilityTextMutedBrush}" Text="Maximum efficiency" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{ThemeResource CompatibilityTextMutedBrush}" Text="Maximum capability" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="OptimizationModeRows" Spacing="8" />

                        <Border
                            x:Name="OptimizationWarningCard"
                            Background="{ThemeResource CompatibilityWarningSurfaceBrush}"
                            BorderBrush="{ThemeResource CompatibilityWarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CompatibilityFactRadius}"
                            Padding="14"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="OptimizationWarningText"
                                Foreground="{ThemeResource CompatibilityWarningTextBrush}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                        </Border>

                        <Border
                            x:Name="ExperimentalConsentCard"
                            Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                            BorderBrush="{ThemeResource CompatibilityBlueBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CompatibilityFactRadius}"
                            Padding="16"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                        Text="Experimental TurboQuant options" />
                                    <TextBlock
                                        Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                        Text="You can include a device-verified experimental format. It may improve memory efficiency, but its quality or stability may be less predictable."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="ExperimentalConsentCheckBox"
                                    AutomationProperties.Name="Include experimental TurboQuant options"
                                    Content="Include the verified experimental option for this device"
                                    Click="ExperimentalConsentCheckBox_Click" />
                                <Border
                                    x:Name="ExperimentalFinalConfirmationCard"
                                    Background="{ThemeResource CompatibilityWarningSurfaceBrush}"
                                    BorderBrush="{ThemeResource CompatibilityWarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CompatibilityFactRadius}"
                                    Padding="12"
                                    Visibility="Collapsed">
                                    <CheckBox
                                        x:Name="ExperimentalFinalConfirmationCheckBox"
                                        AutomationProperties.Name="Confirm selected experimental optimisation"
                                        Content="I understand that this selected option is experimental and may reduce quality or stability."
                                        Foreground="{ThemeResource CompatibilityWarningTextBrush}"
                                        Click="ExperimentalFinalConfirmationCheckBox_Click" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!--
                    Recovery actions. Screen 06 must say what is missing AND what
                    to do about it; this is the second half.
                -->
                <Border
                    x:Name="RecoveryCard"
                    Grid.Row="6"
                    Background="{ThemeResource CompatibilitySurfaceBrush}"
                    BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CompatibilityCardRadius}"
                    Padding="{StaticResource CompatibilitySectionCardPadding}"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock
                            FontSize="{StaticResource CompatibilityCardTitleFontSize}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                            Text="What would help" />
                        <StackPanel x:Name="RecoveryRows" Margin="0,12,0,0" />
                        <StackPanel
                            x:Name="MemoryRecoveryActions"
                            Margin="0,8,0,0"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Border
                                Background="{ThemeResource CompatibilityBlueSurfaceBrush}"
                                BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CompatibilityFactRadius}"
                                Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="{StaticResource CompatibilityRowTitleFontSize}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                                        Text="Refresh available memory" />
                                    <TextBlock
                                        FontSize="{StaticResource CompatibilityOutcomeBodyFontSize}"
                                        Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                        Text="Refresh reads the memory currently available and checks again. Or open Task Manager; you choose which applications to close, then return and refresh. Granite Edge AI will not close anything."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button
                                x:Name="RefreshMemoryAction"
                                MinHeight="44"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="{StaticResource CompatibilityButtonRadius}"
                                Padding="18,10"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Refresh memory and check again"
                                AutomationProperties.Name="Refresh memory and check again"
                                AutomationProperties.HelpText="Reads current available memory and checks compatibility again; it does not close applications" />
                            <Button
                                x:Name="OpenTaskManagerAction"
                                MinHeight="44"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="{StaticResource CompatibilityButtonRadius}"
                                Padding="18,10"
                                Content="Open Task Manager"
                                AutomationProperties.Name="Open Task Manager"
                                AutomationProperties.HelpText="Opens Task Manager; you choose which applications to close, and Granite Edge AI will not close anything" />
                            <TextBlock
                                x:Name="MemoryRecoveryStatus"
                                Visibility="Collapsed"
                                FontSize="{StaticResource CompatibilityOutcomeBodyFontSize}"
                                Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                TextWrapping="Wrap"
                                AutomationProperties.Name="Memory recovery status"
                                AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Calculation disclosure -->
                <Border
                    Grid.Row="7"
                    Background="{ThemeResource CompatibilitySurfaceBrush}"
                    BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CompatibilityCardRadius}">
                    <Expander
                        x:Name="CalculationDisclosure"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock
                                x:Name="DisclosureTitleText"
                                FontSize="{StaticResource CompatibilityRowTitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource CompatibilityTextPrimaryBrush}" />
                        </Expander.Header>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                x:Name="DisclosureDetailText"
                                FontSize="{StaticResource CompatibilityOutcomeBodyFontSize}"
                                Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                                TextWrapping="Wrap" />

                            <!--
                                The same bar with its key shown. The key lives here
                                rather than beside the bar so the surface stays
                                readable at a glance, and the breakdown is there for
                                whoever wants to know which part is the large one.
                            -->
                            <controls:CompatibilityBudgetDiagram
                                x:Name="BudgetLegend"
                                Margin="0,14,0,0"
                                ShowLegend="True"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Centred actions -->
                <Grid x:Name="ActionGrid" Grid.Row="8" ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Center" MaxWidth="520">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="SecondaryAction"
                        Grid.Column="0"
                        CornerRadius="{StaticResource CompatibilityButtonRadius}"
                        FontSize="{StaticResource CompatibilityButtonFontSize}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44"
                        Padding="18,10" />
                    <Button
                        x:Name="PrimaryAction"
                        Grid.Column="1"
                        CornerRadius="{StaticResource CompatibilityButtonRadius}"
                        FontSize="{StaticResource CompatibilityButtonFontSize}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44"
                        Padding="18,10"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="OptionalOptimizationAction"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        CornerRadius="{StaticResource CompatibilityButtonRadius}"
                        FontSize="{StaticResource CompatibilityButtonFontSize}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        MinHeight="44"
                        Padding="18,10"
                        Content="Optimise first"
                        AutomationProperties.Name="Optimise this model before chatting"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </ScrollViewer>

    </Grid>
</Page>
