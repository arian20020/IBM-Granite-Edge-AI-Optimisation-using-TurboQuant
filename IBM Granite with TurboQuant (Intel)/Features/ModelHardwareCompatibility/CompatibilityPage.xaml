                            <Border x:Name="CompatibilityOutcomeBadge" Grid.Column="2" Padding="10,6" VerticalAlignment="Top" Background="{ThemeResource CompatibilitySuccessSurfaceBrush}" BorderBrush="{ThemeResource CompatibilitySuccessBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="8"><TextBlock x:Name="CompatibilityOutcomeBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilitySuccessBrush}" Text="ESTIMATE" /></Border>
                        </Grid>

                        <Grid x:Name="CompatibilityDecisionStrip" ColumnSpacing="12" RowSpacing="10" AutomationProperties.AutomationId="CompatibilityDecisionStrip" AutomationProperties.Name="Compatibility decision facts">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CompatibilityDecisionColumn1" Width="*" /><ColumnDefinition x:Name="CompatibilityDecisionColumn2" Width="*" /><ColumnDefinition x:Name="CompatibilityDecisionColumn3" Width="*" /><ColumnDefinition x:Name="CompatibilityDecisionColumn4" Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="12,10" Background="{ThemeResource CompatibilitySubtleSurfaceBrush}" CornerRadius="8"><StackPanel Spacing="2"><TextBlock x:Name="CompatibilityMemoryNeededLabel" Style="{StaticResource CompatibilityLabelStyle}" Text="MEMORY NEEDED" /><TextBlock x:Name="CompatibilityMemoryNeeded" Style="{StaticResource CompatibilityValueStyle}" Text="5.7 GiB" /></StackPanel></Border>
                            <Border Grid.Column="1" Padding="12,10" Background="{ThemeResource CompatibilitySubtleSurfaceBrush}" CornerRadius="8"><StackPanel Spacing="2"><TextBlock x:Name="CompatibilitySafeMemoryLabel" Style="{StaticResource CompatibilityLabelStyle}" Text="SAFE MEMORY" /><TextBlock x:Name="CompatibilitySafeMemory" Style="{StaticResource CompatibilityValueStyle}" Text="9.0 GiB" /></StackPanel></Border>
                            <Border Grid.Column="2" Padding="12,10" Background="{ThemeResource CompatibilitySubtleSurfaceBrush}" CornerRadius="8"><StackPanel Spacing="2"><TextBlock x:Name="CompatibilitySpareLabel" Style="{StaticResource CompatibilityLabelStyle}" Text="SPARE" /><TextBlock x:Name="CompatibilitySpareValue" Style="{StaticResource CompatibilityValueStyle}" Text="3.3 GiB" /></StackPanel></Border>
                            <Border Grid.Column="3" Padding="12,10" Background="{ThemeResource CompatibilitySubtleSurfaceBrush}" CornerRadius="8"><StackPanel Spacing="2"><TextBlock x:Name="CompatibilityContextLabel" Style="{StaticResource CompatibilityLabelStyle}" Text="CONTEXT" /><TextBlock x:Name="CompatibilityContextValue" Style="{StaticResource CompatibilityValueStyle}" Text="4,096 tokens" /></StackPanel></Border>
                        </Grid>

                        <TextBlock x:Name="CompatibilityMemoryClarityShortfall" Style="{StaticResource CompatibilityBodyStyle}" Foreground="{ThemeResource CompatibilityWarningBrush}" TextWrapping="WrapWholeWords" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

                        <Border x:Name="CompatibilityBudgetDiagram" Padding="12" Background="{ThemeResource CompatibilitySubtleSurfaceBrush}" CornerRadius="8" AutomationProperties.AutomationId="CompatibilityBudgetDiagram" AutomationProperties.Name="Estimated memory budget">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
