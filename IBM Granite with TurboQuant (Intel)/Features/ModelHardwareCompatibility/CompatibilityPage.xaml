                                            <Border x:Name="CompatibilityBudgetWeightsSegment" Background="{ThemeResource CompatibilityAccentBrush}" BorderBrush="{ThemeResource CompatibilityBudgetSeparatorBrush}" BorderThickness="{ThemeResource CompatibilityBudgetSeparatorRightThickness}" AutomationProperties.Name="Model weights memory" />
