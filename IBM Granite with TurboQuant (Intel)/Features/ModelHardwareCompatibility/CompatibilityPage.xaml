                                    </Grid>
                                    <TextBlock x:Name="CompatibilityMinimumRamLabel" Grid.Row="4" MaxWidth="360" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" Foreground="{ThemeResource CompatibilityWarningBrush}" TextAlignment="Right" TextTrimming="None" TextWrapping="WrapWholeWords" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"><TextBlock.RenderTransform><TranslateTransform x:Name="CompatibilityMinimumRamLabelTransform" /></TextBlock.RenderTransform></TextBlock>
                                </Grid>
                                <Expander x:Name="CompatibilityMemoryLegendExpander" Style="{StaticResource CompatibilityDisclosureStyle}" Background="{ThemeResource CompatibilitySurfaceBrush}" Header="Memory colour guide" IsExpanded="False" AutomationProperties.AutomationId="CompatibilityMemoryLegendExpander" AutomationProperties.Name="Memory colour guide">
                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Border x:Name="CompatibilityLegendWeightsSwatch" Width="14" Height="14" VerticalAlignment="Center" Background="{ThemeResource CompatibilityAccentBrush}" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="3" AutomationProperties.Name="Model weights memory segment" />
                                        <StackPanel Grid.Column="1" Spacing="1"><TextBlock x:Name="CompatibilityLegendWeightsLabel" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Model weights" /><TextBlock x:Name="CompatibilityLegendWeightsMeaning" Style="{StaticResource CompatibilityBodyStyle}" FontSize="12" Text="Memory used by the model parameters" /></StackPanel>
                                        <TextBlock x:Name="CompatibilityLegendWeightsValue" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CompatibilityValueStyle}" Text="49%" />
                                        <Border x:Name="CompatibilityLegendCacheSwatch" Grid.Row="1" Width="14" Height="14" VerticalAlignment="Center" Background="{ThemeResource CompatibilitySuccessBrush}" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="3" AutomationProperties.Name="Context cache memory segment" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1"><TextBlock x:Name="CompatibilityLegendCacheLabel" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Context cache" /><TextBlock x:Name="CompatibilityLegendCacheMeaning" Style="{StaticResource CompatibilityBodyStyle}" FontSize="12" Text="Memory reserved for the current conversation length" /></StackPanel>
                                        <TextBlock x:Name="CompatibilityLegendCacheValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CompatibilityValueStyle}" Text="6%" />
                                        <Border x:Name="CompatibilityLegendWorkingSwatch" Grid.Row="2" Width="14" Height="14" VerticalAlignment="Center" Background="{ThemeResource CompatibilityWarningBrush}" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="3" AutomationProperties.Name="Working memory segment" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="1"><TextBlock x:Name="CompatibilityLegendWorkingLabel" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Working memory" /><TextBlock x:Name="CompatibilityLegendWorkingMeaning" Style="{StaticResource CompatibilityBodyStyle}" FontSize="12" Text="Temporary space used while the model runs" /></StackPanel>
                                        <TextBlock x:Name="CompatibilityLegendWorkingValue" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CompatibilityValueStyle}" Text="4%" />
                                        <Border x:Name="CompatibilityLegendMarginSwatch" Grid.Row="3" Width="14" Height="14" VerticalAlignment="Center" Background="{ThemeResource CompatibilityMutedTextBrush}" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="3" AutomationProperties.Name="Safety allowance memory segment" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="1"><TextBlock x:Name="CompatibilityLegendMarginLabel" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Safety allowance" /><TextBlock x:Name="CompatibilityLegendMarginMeaning" Style="{StaticResource CompatibilityBodyStyle}" FontSize="12" Text="Memory deliberately kept as a buffer" /></StackPanel>
                                        <TextBlock x:Name="CompatibilityLegendMarginValue" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CompatibilityValueStyle}" Text="6%" />
                                        <Border x:Name="CompatibilityLegendSpareSwatch" Grid.Row="4" Width="14" Height="14" VerticalAlignment="Center" Background="{ThemeResource CompatibilityBorderBrush}" BorderBrush="{ThemeResource CompatibilityMutedTextBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="3" AutomationProperties.Name="Spare safe-memory segment" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="1"><TextBlock x:Name="CompatibilityLegendSpareLabel" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Spare" /><TextBlock x:Name="CompatibilityLegendSpareMeaning" Style="{StaticResource CompatibilityBodyStyle}" FontSize="12" Text="Safe memory still unused by this setup" /></StackPanel>
                                        <TextBlock x:Name="CompatibilityLegendSpareValue" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CompatibilityValueStyle}" Text="35%" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
