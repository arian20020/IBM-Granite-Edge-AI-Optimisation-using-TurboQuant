                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CompatibilitySetupColumn1" Width="*" /><ColumnDefinition x:Name="CompatibilitySetupColumn2" Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Current setup" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Model format" /><TextBlock x:Name="CompatibilityCurrentWeights" Grid.Column="1" Style="{StaticResource CompatibilityValueStyle}" Text="Q4_K_M" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Cache" /><TextBlock x:Name="CompatibilityCurrentCache" Grid.Column="1" Style="{StaticResource CompatibilityValueStyle}" Text="F16" /></Grid><Grid x:Name="CompatibilityCurrentContextRow" ColumnSpacing="12" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Context" /><TextBlock x:Name="CompatibilityCurrentContext" Grid.Column="1" Style="{StaticResource CompatibilityValueStyle}" Text="4,096 tokens" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Runs on" /><TextBlock x:Name="CompatibilityRuntimeRoute" Grid.Column="1" Style="{StaticResource CompatibilityValueStyle}" Text="llama.cpp · CPU" /></Grid></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Machine memory" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Installed RAM" /><TextBlock x:Name="CompatibilityInstalledRam" Grid.Column="1" Style="{StaticResource CompatibilityValueStyle}" Text="16.0 GiB" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Available now" /><TextBlock x:Name="CompatibilityAvailableNow" Grid.Column="1" Style="{StaticResource CompatibilityValueStyle}" Text="12.0 GiB" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Safety reserve" /><TextBlock x:Name="CompatibilitySafetyReserve" Grid.Column="1" Style="{StaticResource CompatibilityValueStyle}" Text="3.0 GiB" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Safe for this model" /><TextBlock x:Name="CompatibilitySafeForModel" Grid.Column="1" Style="{StaticResource CompatibilityValueStyle}" Text="9.0 GiB" /></Grid></StackPanel>
                        </Grid>

                        <Expander x:Name="CompatibilityHardwareFactsExpander" Style="{StaticResource CompatibilityDisclosureStyle}" Header="Hardware facts" IsExpanded="False" Visibility="Collapsed" AutomationProperties.AutomationId="CompatibilityHardwareFactsExpander" AutomationProperties.Name="Hardware facts">
                            <StackPanel x:Name="CompatibilityHardwareFactsHost" Spacing="12" />
                        </Expander>

                        <Border x:Name="CompatibilityRecoveryNotice" Padding="14,12" Background="{ThemeResource CompatibilityWarningSurfaceBrush}" BorderBrush="{ThemeResource CompatibilityWarningBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="8" Visibility="Collapsed"><StackPanel Spacing="3"><TextBlock x:Name="CompatibilityRecoveryHeading" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Free some memory, then check again" /><TextBlock x:Name="CompatibilityRecoveryDetail" Style="{StaticResource CompatibilityBodyStyle}" Text="Close unused applications and browser tabs. What matters is the memory free right now." /></StackPanel></Border>

                        <Expander x:Name="CompatibilityCalculationExpander" Style="{StaticResource CompatibilityDisclosureStyle}" Header="How we worked this out" AutomationProperties.AutomationId="CompatibilityCalculationExpander" AutomationProperties.Name="How we worked this out">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock x:Name="CompatibilityCalculationDetail" Style="{StaticResource CompatibilityBodyStyle}" Text="This estimate combines inspected model facts, admitted runtime routes, the current safe memory budget, and a bounded safety allowance. It is an estimate, not a measured test run." />
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="12" Foreground="{ThemeResource CompatibilitySubtleTextBrush}" Text="Model weights · context cache · working memory · backend overhead · application overhead · margin for error" TextWrapping="WrapWholeWords" />
                            </Grid>
                        </Expander>

                        <Border x:Name="CompatibilityObservedWordingNotice" Padding="12,8" Background="{ThemeResource CompatibilityWarningSurfaceBrush}" BorderBrush="{ThemeResource CompatibilityWarningBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="8" Visibility="Collapsed"><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Observed production wording — this fixture preserves the current ‘needs to be quantised’ wording for review, including an Original-weights cache-only OpenVINO setup." /></Border>
                        <Border x:Name="CompatibilityContractReviewNotice" Padding="12,8" Background="{ThemeResource CompatibilityAccentSurfaceBrush}" BorderBrush="{ThemeResource CompatibilityAccentBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="8" Visibility="Collapsed"><TextBlock Style="{StaticResource CompatibilityBodyStyle}" Text="Contract-review only — route-correct copy proposal for review. This is not shipped or canonical product wording." /></Border>
                        <TextBlock Visibility="Collapsed" Text="Fixture-only verification review" />
                    </StackPanel>

                    <Border x:Name="CompatibilityTerminalActionBand" Grid.Row="2" Margin="0,14,0,0" Padding="14,12" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityTopOutlineThickness}" AutomationProperties.AutomationId="CompatibilityTerminalActionBand">
                        <StackPanel x:Name="CompatibilityTerminalActions" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" AutomationProperties.AutomationId="CompatibilityTerminalActions">
                            <Button x:Name="BtnCompatibilityBack" MinWidth="176" MaxWidth="240" MinHeight="44" Height="Auto" HorizontalAlignment="Center" Style="{StaticResource CompatibilitySecondaryButtonStyle}" AutomationProperties.AutomationId="CompatibilityAction.Back" Content="Back" />
                            <StackPanel x:Name="CompatibilityForwardActions" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnCompatibilitySecondaryForward" MinWidth="176" MaxWidth="240" MinHeight="44" Height="Auto" Style="{StaticResource CompatibilitySecondaryButtonStyle}" AutomationProperties.AutomationId="CompatibilityAction.ConfigureModel" AutomationProperties.Name="Choose optimisation" AutomationProperties.HelpText="Review admitted optimisation options for this model and current hardware." Content="Choose optimisation" Visibility="Collapsed" />
                                <Button x:Name="BtnCompatibilityPrimary" MinWidth="272" MaxWidth="360" MinHeight="44" Height="Auto" Style="{StaticResource CompatibilityPrimaryButtonStyle}" AutomationProperties.AutomationId="CompatibilityAction.ChatCurrentModel" AutomationProperties.Name="Chat with current model" Content="Chat with current model" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="CompatibilityConfigurePanel" Visibility="Collapsed" AutomationProperties.AutomationId="CompatibilityConfigurePanel" AutomationProperties.Name="Configure model">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="14">
                        <Border x:Name="CompatibilityOptimizationPanel" Padding="18" Background="{ThemeResource CompatibilitySubtleSurfaceBrush}" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="9" Visibility="Collapsed" AutomationProperties.AutomationId="CompatibilityOptimizationPanel" AutomationProperties.Name="Optimization setup comparison">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="CompatibilityOptimizationHeading" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Choose the balance you want" />
                                    <TextBlock x:Name="CompatibilityOptimizationDetail" Style="{StaticResource CompatibilityBodyStyle}" Text="The current model fits. You can still choose a different memory and expected-quality balance." />
                                </StackPanel>
                                <StackPanel x:Name="CompatibilityChooserSetupGrid" Spacing="8">
                                    <TextBlock x:Name="CompatibilitySelectedSetupLabel" Style="{StaticResource CompatibilityLabelStyle}" Text="SELECTED SETUP" />
                                    <ContentControl x:Name="CompatibilitySelectedSetupFocusTarget" IsTabStop="False" HorizontalContentAlignment="Stretch" Padding="0" AutomationProperties.AutomationId="CompatibilitySelectedSetupFocusTarget" AutomationProperties.Name="Selected optimisation setup" AutomationProperties.AccessibilityView="Raw">
                                    <Grid x:Name="CompatibilitySelectedSetupSummary" ColumnSpacing="20" AutomationProperties.AutomationId="CompatibilitySelectedSetupSummary" AutomationProperties.Name="Selected optimisation setup">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel x:Name="CompatibilitySelectedWeightGroup" Spacing="4"><TextBlock Style="{StaticResource CompatibilityLabelStyle}" Text="WEIGHT FORMAT" /><TextBlock x:Name="CompatibilitySelectedWeightFormat" Style="{StaticResource CompatibilityValueStyle}" Text="INT8" TextWrapping="WrapWholeWords" /></StackPanel>
                                        <StackPanel x:Name="CompatibilitySelectedCacheGroup" Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource CompatibilityLabelStyle}" Text="KV CACHE FORMAT" /><TextBlock x:Name="CompatibilitySelectedCacheFormat" Style="{StaticResource CompatibilityValueStyle}" Text="Automatic (OpenVINO default)" TextWrapping="WrapWholeWords" /></StackPanel>
                                        <StackPanel x:Name="CompatibilitySelectedContextGroup" Grid.Column="2" Spacing="4"><TextBlock Style="{StaticResource CompatibilityLabelStyle}" Text="CONTEXT" /><TextBlock x:Name="CompatibilitySelectedContext" Style="{StaticResource CompatibilityValueStyle}" Text="4,096 tokens" TextWrapping="WrapWholeWords" /></StackPanel>
                                    </Grid>
                                    </ContentControl>
                                </StackPanel>
                                <Grid x:Name="CompatibilitySafeSliderPanel" RowSpacing="4">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid x:Name="CompatibilitySafeSliderEndpoints" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CompatibilityLabelStyle}" Text="Uses less memory" TextWrapping="WrapWholeWords" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" TextAlignment="Right" Style="{StaticResource CompatibilityLabelStyle}" Text="Uses more memory" TextWrapping="WrapWholeWords" />
                                    </Grid>
                                    <Slider x:Name="CompatibilityPreferenceSlider" Grid.Row="1" MinHeight="56" HorizontalAlignment="Stretch" Minimum="0" Maximum="0" Value="0" StepFrequency="1" SnapsTo="StepValues" IsThumbToolTipEnabled="False" Header="Safe setup" AutomationProperties.AutomationId="CompatibilityPreferenceSlider" AutomationProperties.Name="Safe setup" AutomationProperties.HelpText="Choose a released safe setup. Stops run from lower to higher estimated RAM; measured quality is shown separately." />
                                </Grid>
                                <TextBlock x:Name="CompatibilitySelectionStatusText" Style="{StaticResource CompatibilityBodyStyle}" Foreground="{ThemeResource CompatibilityWarningBrush}" TextWrapping="WrapWholeWords" Visibility="Collapsed" AutomationProperties.AutomationId="CompatibilitySelectionStatus" AutomationProperties.LiveSetting="Assertive" />
                                <Grid x:Name="CompatibilitySelectedTradeoffSummary" ColumnSpacing="20" RowSpacing="6" AutomationProperties.AutomationId="CompatibilitySelectedTradeoffSummary" AutomationProperties.Name="Selected optimization mode and expected quality" AutomationProperties.LiveSetting="Polite">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel x:Name="CompatibilitySelectedModeGroup" Spacing="4"><TextBlock Style="{StaticResource CompatibilityLabelStyle}" Text="MODE" /><TextBlock x:Name="CompatibilitySelectedMode" Style="{StaticResource CompatibilityValueStyle}" Text="Balanced" TextWrapping="WrapWholeWords" /></StackPanel>
                                    <StackPanel x:Name="CompatibilityExpectedQualityGroup" Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource CompatibilityLabelStyle}" Text="EXPECTED QUALITY" /><TextBlock x:Name="CompatibilityExpectedQuality" Style="{StaticResource CompatibilityValueStyle}" Text="Acceptable" TextWrapping="WrapWholeWords" /></StackPanel>
                                </Grid>
                                <TextBlock x:Name="CompatibilitySelectedWarningText" Style="{StaticResource CompatibilityBodyStyle}" Foreground="{ThemeResource CompatibilityWarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,12" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityTopOutlineThickness}" AutomationProperties.AutomationId="CompatibilityConfigureActionBand">
                        <StackPanel x:Name="CompatibilityConfigureActions" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnCompatibilityConfigureBack" MinWidth="176" MaxWidth="240" MinHeight="44" Height="Auto" Style="{StaticResource CompatibilitySecondaryButtonStyle}" AutomationProperties.AutomationId="CompatibilityConfigureAction.Back" AutomationProperties.Name="Back to compatibility result" AutomationProperties.HelpText="Return to the retained model and hardware compatibility result." Content="Back" />
                            <Button x:Name="BtnCompatibilityConfigurePrimary" MinWidth="272" MaxWidth="360" MinHeight="44" Height="Auto" Style="{StaticResource CompatibilityPrimaryButtonStyle}" AutomationProperties.AutomationId="CompatibilityConfigureAction.StartOptimization" AutomationProperties.Name="Start optimisation" Content="Start optimisation" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
    </ScrollViewer>
</Page>
