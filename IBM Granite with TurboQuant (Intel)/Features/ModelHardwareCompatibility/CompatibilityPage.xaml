                        <ListViewItem x:Name="CompatibilityStage4" Style="{StaticResource CompatibilityProgressItemStyle}" AutomationProperties.PositionInSet="4" AutomationProperties.SizeOfSet="4" AutomationProperties.Name="Picking the safest setup, step 4 of 4, Waiting">
