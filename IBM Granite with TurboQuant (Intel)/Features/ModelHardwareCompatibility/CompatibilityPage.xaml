                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="CompatibilityStage4GlyphSurface" Width="32" Height="32" VerticalAlignment="Center" Background="{ThemeResource CompatibilityWaitingSurfaceBrush}" BorderBrush="{ThemeResource CompatibilityBorderBrush}" BorderThickness="{ThemeResource CompatibilityOutlineThickness}" CornerRadius="16"><Grid x:Name="CompatibilityStage4GlyphPresenter" Width="32" Height="32"><TextBlock x:Name="CompatibilityStage4Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityWaitingTextBrush}" Text="4" /><FontIcon x:Name="CompatibilityStage4Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource CompatibilitySuccessBrush}" Glyph="&#xE73E;" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" /><Grid x:Name="CompatibilityStage4OrbitPresenter" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" Visibility="Collapsed"><Ellipse x:Name="CompatibilityStage4OrbitEllipse" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource CompatibilityAccentBrush}" StrokeThickness="1.6" StrokeDashArray="26,13.27" StrokeDashCap="Round" UseLayoutRounding="False" /></Grid></Grid></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource CompatibilityTextBrush}" Text="Picking the safest setup" TextWrapping="WrapWholeWords" /><TextBlock x:Name="CompatibilityStage4Description" FontSize="12" Foreground="{ThemeResource CompatibilityMutedTextBrush}" Text="The safest admitted setup is selected from the available routes." TextWrapping="WrapWholeWords" /></StackPanel>
