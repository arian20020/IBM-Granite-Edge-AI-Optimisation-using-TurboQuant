                                            <Border x:Name="CompatibilityBudgetWorkingSegment" Grid.Column="2" Background="{ThemeResource CompatibilityWarningBrush}" BorderBrush="{ThemeResource CompatibilityBudgetSeparatorBrush}" BorderThickness="{ThemeResource CompatibilityBudgetSeparatorRightThickness}" AutomationProperties.Name="Working memory" />
                                            <Border x:Name="CompatibilityBudgetMarginSegment" Grid.Column="3" Background="{ThemeResource CompatibilityMutedTextBrush}" BorderBrush="{ThemeResource CompatibilityBudgetSeparatorBrush}" BorderThickness="{ThemeResource CompatibilityBudgetSeparatorRightThickness}" AutomationProperties.Name="Safety allowance memory" />
                                            <Border x:Name="CompatibilityBudgetSpareSegment" Grid.Column="4" Background="{ThemeResource CompatibilityBorderBrush}" BorderBrush="{ThemeResource CompatibilityBudgetSeparatorBrush}" BorderThickness="0" AutomationProperties.Name="Spare safe memory" />
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="3" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="CompatibilityMinimumRamMarkerBeforeColumn" Width="1*" /><ColumnDefinition x:Name="CompatibilityMinimumRamMarkerAfterColumn" Width="0*" /></Grid.ColumnDefinitions>
                                        <Line x:Name="CompatibilityMinimumRamElbow" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{ThemeResource CompatibilityWarningBrush}" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
