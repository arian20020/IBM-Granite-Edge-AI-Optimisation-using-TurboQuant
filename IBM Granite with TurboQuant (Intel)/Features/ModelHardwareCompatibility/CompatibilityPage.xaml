                                    <Grid Grid.Row="1" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="CompatibilityAvailableRamMarkerBeforeColumn" Width="1*" /><ColumnDefinition x:Name="CompatibilityAvailableRamMarkerAfterColumn" Width="0*" /></Grid.ColumnDefinitions>
