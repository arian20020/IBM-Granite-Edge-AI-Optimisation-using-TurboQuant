<?xml version="1.0" encoding="utf-8" ?>

<!--
    The memory budget bar.

    Two treatments off one set of data, as the design intends: brackets on the
    main surface answering "does it fit" at a glance, and the full legend inside
    the calculation disclosure for anyone who opens it.

    The bar is built in code rather than markup because its bands are
    proportional to real byte counts, which markup cannot express. What lives
    here is the frame those bands are placed into.
-->
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelHardwareCompatibility.Controls.CompatibilityBudgetDiagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelHardwareCompatibility/Presentation/CompatibilityTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!-- Title and verdict, baseline aligned -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="DiagramTitle"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                Text="Memory this would use"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="VerdictText"
                Grid.Column="1"
                FontSize="9.5"
                FontWeight="Bold" />
        </Grid>

        <TextBlock
            x:Name="DiagramNote"
            FontSize="9.5"
            Foreground="{ThemeResource CompatibilityTextMutedBrush}"
            Margin="0,3,0,0"
            TextWrapping="Wrap" />

        <!-- The flag naming the safe limit, sitting above its rule -->
        <Grid x:Name="FlagRail" Height="19" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FlagLeadColumn" Width="0*" />
                <ColumnDefinition x:Name="FlagTrailColumn" Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="FlagHost"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
                <TextBlock
                    x:Name="FlagText"
                    FontSize="8"
                    FontWeight="Bold"
                    Foreground="{ThemeResource CompatibilityTextPrimaryBrush}" />
                <Rectangle
                    Height="6"
                    HorizontalAlignment="Left"
                    Width="1"
                    Fill="{ThemeResource CompatibilityTextPrimaryBrush}"
                    Opacity="0.55" />
            </StackPanel>
        </Grid>

        <!-- The bar itself, with the safe-limit rule drawn over it -->
        <Grid Height="30">
            <Border
                BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid x:Name="TrackHost" />
            </Border>

            <Grid x:Name="LimitRail" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LimitLeadColumn" Width="0*" />
                    <ColumnDefinition x:Name="LimitTrailColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Rectangle
                    x:Name="LimitRule"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    StrokeDashArray="3,2"
                    StrokeThickness="1.5"
                    Width="1.5" />
            </Grid>
        </Grid>

        <!-- Scale ends -->
        <Grid Margin="0,5,0,0">
            <TextBlock
                x:Name="ScaleLeftText"
                FontSize="7.5"
                Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                HorizontalAlignment="Left"
                Text="0" />
            <TextBlock
                x:Name="ScaleRightText"
                FontSize="7.5"
                Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                HorizontalAlignment="Right" />
        </Grid>

        <!-- Brackets: the main-surface treatment -->
        <Grid x:Name="BracketHost" Margin="0,6,0,0" />

        <!-- Legend: shown only inside the calculation disclosure -->
        <Grid
            x:Name="LegendHost"
            ColumnSpacing="8"
            Margin="0,14,0,0"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="FooterText"
            FontSize="9.5"
            Foreground="{ThemeResource CompatibilityTextMutedBrush}"
            Margin="0,10,0,0"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
