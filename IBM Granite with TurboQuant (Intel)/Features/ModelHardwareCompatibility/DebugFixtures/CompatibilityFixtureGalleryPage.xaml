<?xml version="1.0" encoding="utf-8" ?>

<!--
    A reviewer's window onto the ten screen states.

    Nine of them cannot be reached by running the real thing, because the
    adapters that would feed the engine do not exist yet. Without this page they
    could not be looked at at all, and a design nobody can see is a design nobody
    can correct.

    Debug builds only, and only when the fixture gallery constant is defined.
-->
<Page
    x:Class="GraniteEdgeAI.Features.ModelHardwareCompatibility.DebugFixtures.CompatibilityFixtureGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelHardwareCompatibility/Presentation/CompatibilityTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource CompatibilityCanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The list of states, so one click moves between them -->
        <Border
            Background="{ThemeResource CompatibilitySurfaceBrush}"
            BorderBrush="{ThemeResource CompatibilityBorderLightBrush}"
            BorderThickness="0,0,1,0"
            Width="300">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="16,16,16,10">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{ThemeResource CompatibilityTextPrimaryBrush}"
                        Text="Compatibility screens" />
                    <TextBlock
                        FontSize="9"
                        Foreground="{ThemeResource CompatibilityTextMutedBrush}"
                        Margin="0,3,0,0"
                        Text="Every state, rendered without hardware or a model."
                        TextWrapping="Wrap" />
                </StackPanel>

                <ListView
                    x:Name="FixtureList"
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    SelectionChanged="OnFixtureSelected" />
            </Grid>
        </Border>

        <Frame x:Name="PreviewHost" Grid.Column="1" />
    </Grid>
</Page>
