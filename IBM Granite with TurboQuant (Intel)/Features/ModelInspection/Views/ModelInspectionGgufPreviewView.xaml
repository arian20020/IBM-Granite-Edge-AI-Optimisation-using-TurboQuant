                                    <Grid>
                                        <FontIcon x:Name="InspectionCancelledStage3Glyph" Visibility="Collapsed" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" FontSize="13" Foreground="{ThemeResource InspectionErrorBrush}" Glyph="&#xE711;" AutomationProperties.AccessibilityView="Raw" />
