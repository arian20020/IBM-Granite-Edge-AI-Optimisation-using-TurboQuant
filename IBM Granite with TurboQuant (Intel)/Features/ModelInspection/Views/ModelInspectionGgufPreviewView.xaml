                            <Border x:Name="ReadyNextStepBand" Grid.Row="4" Margin="0,12,0,0" Padding="14,12" Background="{ThemeResource InspectionSubtleSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderBrush}" BorderThickness="{ThemeResource InspectionTopOutlineThickness}">
