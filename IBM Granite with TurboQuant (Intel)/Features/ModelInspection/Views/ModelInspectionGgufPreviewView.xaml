                                <StackPanel x:Name="WarningMetadataPublisher" Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource InspectionLabelStyle}" Text="PUBLISHER" /><TextBlock Style="{StaticResource InspectionValueStyle}" Text="Not reported" /></StackPanel>
                                <StackPanel x:Name="WarningMetadataParameters" Grid.Column="2" Spacing="4"><TextBlock Style="{StaticResource InspectionLabelStyle}" Text="PARAMETERS" /><TextBlock Style="{StaticResource InspectionValueStyle}" Text="8B" /></StackPanel>
                                <StackPanel x:Name="WarningMetadataModelType" Grid.Column="3" Spacing="4"><TextBlock Style="{StaticResource InspectionLabelStyle}" Text="MODEL TYPE" /><TextBlock Style="{StaticResource InspectionValueStyle}" Text="Not reported" /></StackPanel>
