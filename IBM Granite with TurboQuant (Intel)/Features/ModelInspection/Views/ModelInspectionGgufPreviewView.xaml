                                        <FontIcon x:Name="InspectionCancelledStage4Glyph" Visibility="Collapsed" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" FontSize="13" Foreground="{ThemeResource InspectionWaitingTextBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
