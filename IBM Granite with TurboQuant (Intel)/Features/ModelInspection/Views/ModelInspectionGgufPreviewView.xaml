                                <StackPanel x:Name="WarningMetadataFormat" Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock Style="{StaticResource InspectionLabelStyle}" Text="FORMAT" /><TextBlock Style="{StaticResource InspectionValueStyle}" Text="GGUF" /></StackPanel>
