                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Foreground="{ThemeResource InspectionSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Tokenizer and chat setup" /><TextBlock Style="{StaticResource InspectionBodyStyle}" Text="Tokenizer metadata and chat configuration were checked." /></StackPanel></Grid>
