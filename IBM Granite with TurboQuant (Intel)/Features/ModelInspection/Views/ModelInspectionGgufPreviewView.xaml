                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Validate model structure" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="InspectionCancelledStage4Status" Grid.Column="2" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Not run" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem
                            x:Name="InspectionCancelledStage5"
                            Style="{StaticResource InspectionProgressItemStyle}"
                            AutomationProperties.AutomationId="InspectionCancelledStageConfirmRuntime"
                            AutomationProperties.ItemStatus="Not run"
                            AutomationProperties.Name="Confirm core runtime compatibility. Not run. Step 5 of 5."
                            AutomationProperties.PositionInSet="5"
                            AutomationProperties.SizeOfSet="5">
                            <Grid MinHeight="48" Padding="8,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="InspectionCancelledStage5GlyphSurface" Width="32" Height="32" Background="{ThemeResource InspectionWaitingSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderBrush}" BorderThickness="{ThemeResource InspectionOutlineThickness}" CornerRadius="16" UseLayoutRounding="True">
                                    <Grid>
                                        <FontIcon x:Name="InspectionCancelledStage5Glyph" Visibility="Collapsed" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" FontSize="13" Foreground="{ThemeResource InspectionWaitingTextBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="InspectionCancelledStage5Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="5" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Confirm core runtime compatibility" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="InspectionCancelledStage5Status" Grid.Column="2" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Not run" />
                            </Grid>
                        </ListViewItem>
                    </ItemsControl>

                    <Border
                        x:Name="CancelledNextStepBand"
                        Grid.Row="2"
                        Margin="0,2,0,4"
                        MinHeight="74"
                        Padding="14,4"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource InspectionSubtleSurfaceBrush}"
                        BorderBrush="{ThemeResource InspectionBorderBrush}"
                        BorderThickness="{ThemeResource InspectionTopOutlineThickness}">
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <StackPanel x:Name="CancelledNextStepCopyRow" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Choose what happens next" TextAlignment="Center" TextWrapping="WrapWholeWords" AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource InspectionMutedTextBrush}" Text="Choose another model to continue." TextAlignment="Center" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="InspectionCancelledSupportingCopy" />
                            </StackPanel>
                            <StackPanel x:Name="CancelledActions" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="BtnChooseAnotherModelCancelled" MinWidth="176" Style="{StaticResource InspectionQuietNeutralButtonStyle}" AutomationProperties.AutomationId="BtnChooseAnotherModelCancelled" Content="Choose another model" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="InspectionFailurePanel" Visibility="Collapsed" AutomationProperties.AutomationId="InspectionFailurePanel" AutomationProperties.Name="Inspection operational failure" AutomationProperties.AccessibilityView="Content" AutomationProperties.LiveSetting="Assertive">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="FailureOutcomeBand" Padding="0,0,0,12" ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="FailureOutcomeGlyphSurface" Width="40" Height="40" Background="{ThemeResource InspectionErrorSurfaceBrush}" BorderBrush="{ThemeResource InspectionErrorBorderBrush}" BorderThickness="{ThemeResource InspectionOutlineThickness}" CornerRadius="20" UseLayoutRounding="True">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionErrorBrush}" Glyph="&#xEA39;" AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="InspectionFailureHeading" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Inspection could not be completed" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="InspectionOutcomeFocusTargetFailure" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Style="{StaticResource InspectionBodyStyle}" Text="A temporary inspection error prevented the model from being checked." />
                        </StackPanel>
                    </Grid>
                    <Border
                        x:Name="FailureDetailsArea"
                        Grid.Row="1"
                        Padding="14,10"
                        Background="{ThemeResource InspectionSubtleSurfaceBrush}"
                        BorderBrush="{ThemeResource InspectionBorderBrush}"
                        BorderThickness="{ThemeResource InspectionTopOutlineThickness}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource InspectionLabelStyle}" Text="INSPECTION DETAILS" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InspectionErrorBrush}" Text="Diagnostic code: INSPECT-OP-001" TextWrapping="WrapWholeWords" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource InspectionMutedTextBrush}" Text="No model data was changed." TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="FailureNextStepBand"
                        Grid.Row="3"
                        Padding="14,12"
                        Background="{ThemeResource InspectionSubtleSurfaceBrush}"
                        BorderBrush="{ThemeResource InspectionBorderBrush}"
                        BorderThickness="{ThemeResource InspectionTopOutlineThickness}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Choose what happens next" TextAlignment="Center" TextWrapping="WrapWholeWords" AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource InspectionMutedTextBrush}" Text="Choose another model to continue." TextAlignment="Center" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Grid x:Name="FailureActionGrid" HorizontalAlignment="Center">
                                <StackPanel x:Name="FailureActions" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="BtnChooseAnotherModelFailure" MinWidth="176" MinHeight="44" HorizontalAlignment="Stretch" Style="{StaticResource InspectionQuietNeutralButtonStyle}" Content="Choose another model" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Grid>
</UserControl>
