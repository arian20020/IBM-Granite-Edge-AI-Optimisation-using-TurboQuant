                                    <Grid>
                                        <FontIcon x:Name="InspectionCancelledStage2Glyph" Visibility="Collapsed" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" FontSize="13" Foreground="{ThemeResource InspectionWaitingTextBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="InspectionCancelledStage2Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="2" AutomationProperties.AccessibilityView="Raw" />
