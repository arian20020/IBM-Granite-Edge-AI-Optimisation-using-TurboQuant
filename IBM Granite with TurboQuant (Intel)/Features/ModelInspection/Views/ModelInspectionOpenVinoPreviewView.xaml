                                <StackPanel x:Name="WarningMetadataModelType" Grid.Column="3" Spacing="4"><TextBlock Style="{StaticResource InspectionLabelStyle}" Text="DECLARED CONTEXT" /><TextBlock Style="{StaticResource InspectionValueStyle}" Text="128K tokens" /></StackPanel>
