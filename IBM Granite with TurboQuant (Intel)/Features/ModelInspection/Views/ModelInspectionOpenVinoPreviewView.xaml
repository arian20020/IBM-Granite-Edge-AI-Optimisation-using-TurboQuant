<?xml version="1.0" encoding="utf-8"?>
<!--
  DESIGN PREVIEW ONLY. This classless WinUI fragment is loaded only by the
  backend-disconnected external review host. The shared shell owns the page
  title, native title bar, Journey Preview Lab controls, and five-stage footer.
-->
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Views.ModelInspectionOpenVinoPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="OpenVinoInspectionApplicationCanvas"
    AutomationProperties.AutomationId="ModelInspectionOpenVinoPreview"
    AutomationProperties.Name="OpenVINO model inspection work surface">

    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Thickness x:Key="InspectionOutlineThickness">1</Thickness>
                    <Thickness x:Key="InspectionTopOutlineThickness">0,1,0,0</Thickness>
                    <Thickness x:Key="InspectionSideBottomOutlineThickness">1,0,1,1</Thickness>
                    <SolidColorBrush x:Key="InspectionSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InspectionSubtleSurfaceBrush" Color="#F8FAFD" />
                    <SolidColorBrush x:Key="InspectionBorderBrush" Color="#D7E0EC" />
                    <SolidColorBrush x:Key="InspectionTextBrush" Color="#111827" />
                    <SolidColorBrush x:Key="InspectionMutedTextBrush" Color="#5B677A" />
                    <SolidColorBrush x:Key="InspectionSubtleTextBrush" Color="#758196" />
                    <SolidColorBrush x:Key="InspectionAccentBrush" Color="#0F62FE" />
                    <SolidColorBrush x:Key="InspectionAccentSurfaceBrush" Color="#EDF4FF" />
                    <SolidColorBrush x:Key="InspectionAccentBorderBrush" Color="#8BB4FF" />
                    <SolidColorBrush x:Key="InspectionAccentForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InspectionSuccessBrush" Color="#087A55" />
                    <SolidColorBrush x:Key="InspectionSuccessSurfaceBrush" Color="#ECF8F3" />
                    <SolidColorBrush x:Key="InspectionSuccessBorderBrush" Color="#A9DDCB" />
                    <SolidColorBrush x:Key="InspectionStatusSuccessSurfaceBrush" Color="#F4F9F7" />
                    <SolidColorBrush x:Key="InspectionStatusSuccessBorderBrush" Color="#C9E4D9" />
                    <SolidColorBrush x:Key="InspectionWarningBrush" Color="#8A4B08" />
                    <SolidColorBrush x:Key="InspectionWarningSurfaceBrush" Color="#FFF7E8" />
                    <SolidColorBrush x:Key="InspectionWarningBorderBrush" Color="#E9C98B" />
                    <SolidColorBrush x:Key="InspectionErrorBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="InspectionErrorSurfaceBrush" Color="#FFF1F0" />
                    <SolidColorBrush x:Key="InspectionErrorBorderBrush" Color="#F2B8B5" />
                    <SolidColorBrush x:Key="InspectionWaitingSurfaceBrush" Color="#EEF1F5" />
                    <SolidColorBrush x:Key="InspectionWaitingTextBrush" Color="#667085" />
                    <SolidColorBrush x:Key="InspectionTertiaryPointerOverBrush" Color="#F1F4F8" />
                    <SolidColorBrush x:Key="InspectionTertiaryPressedBrush" Color="#E4E9F0" />
                    <SolidColorBrush x:Key="InspectionTertiaryFocusBrush" Color="#8BB4FF" />
                    <SolidColorBrush x:Key="InspectionTertiaryInteractiveForegroundBrush" Color="#5B677A" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F62FE" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0B57D0" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0847AA" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- One physical pixel at the review host's 125% raster scale. -->
                    <Thickness x:Key="InspectionOutlineThickness">0.8</Thickness>
                    <Thickness x:Key="InspectionTopOutlineThickness">0,0.8,0,0</Thickness>
                    <Thickness x:Key="InspectionSideBottomOutlineThickness">0.8,0,0.8,0.8</Thickness>
                    <SolidColorBrush x:Key="InspectionSurfaceBrush" Color="#151D2B" />
                    <SolidColorBrush x:Key="InspectionSubtleSurfaceBrush" Color="#1B2535" />
                    <SolidColorBrush x:Key="InspectionBorderBrush" Color="#344054" />
                    <SolidColorBrush x:Key="InspectionTextBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="InspectionMutedTextBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="InspectionSubtleTextBrush" Color="#98A2B3" />
                    <SolidColorBrush x:Key="InspectionAccentBrush" Color="#78A9FF" />
                    <SolidColorBrush x:Key="InspectionAccentSurfaceBrush" Color="#162B49" />
                    <SolidColorBrush x:Key="InspectionAccentBorderBrush" Color="#4589FF" />
                    <SolidColorBrush x:Key="InspectionAccentForegroundBrush" Color="#07111F" />
                    <SolidColorBrush x:Key="InspectionSuccessBrush" Color="#6FD2AE" />
                    <SolidColorBrush x:Key="InspectionSuccessSurfaceBrush" Color="#12372E" />
                    <SolidColorBrush x:Key="InspectionSuccessBorderBrush" Color="#236B59" />
                    <SolidColorBrush x:Key="InspectionStatusSuccessSurfaceBrush" Color="#183128" />
                    <SolidColorBrush x:Key="InspectionStatusSuccessBorderBrush" Color="#2C5A4C" />
                    <SolidColorBrush x:Key="InspectionWarningBrush" Color="#F4C97A" />
                    <SolidColorBrush x:Key="InspectionWarningSurfaceBrush" Color="#392B16" />
                    <SolidColorBrush x:Key="InspectionWarningBorderBrush" Color="#725A2D" />
                    <SolidColorBrush x:Key="InspectionErrorBrush" Color="#FFB4AB" />
                    <SolidColorBrush x:Key="InspectionErrorSurfaceBrush" Color="#3D2021" />
                    <SolidColorBrush x:Key="InspectionErrorBorderBrush" Color="#7D3C3F" />
                    <SolidColorBrush x:Key="InspectionWaitingSurfaceBrush" Color="#273142" />
                    <SolidColorBrush x:Key="InspectionWaitingTextBrush" Color="#98A2B3" />
                    <SolidColorBrush x:Key="InspectionTertiaryPointerOverBrush" Color="#202A39" />
                    <SolidColorBrush x:Key="InspectionTertiaryPressedBrush" Color="#293547" />
                    <SolidColorBrush x:Key="InspectionTertiaryFocusBrush" Color="#78A9FF" />
                    <SolidColorBrush x:Key="InspectionTertiaryInteractiveForegroundBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#78A9FF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#8CB7FF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A6C8FF" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#07111F" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#07111F" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#07111F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Thickness x:Key="InspectionOutlineThickness">1</Thickness>
                    <Thickness x:Key="InspectionTopOutlineThickness">0,1,0,0</Thickness>
                    <Thickness x:Key="InspectionSideBottomOutlineThickness">1,0,1,1</Thickness>
                    <SolidColorBrush x:Key="InspectionSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InspectionSubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InspectionBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionSubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="InspectionAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InspectionAccentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InspectionAccentBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InspectionAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="InspectionSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionSuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InspectionSuccessBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionStatusSuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InspectionStatusSuccessBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionWarningSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InspectionWarningBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionErrorSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InspectionErrorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="InspectionWaitingSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InspectionWaitingTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="InspectionTertiaryPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InspectionTertiaryPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InspectionTertiaryFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="InspectionTertiaryInteractiveForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="InspectionBodyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource HardwareInspectionFontFamilyRegular}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="InspectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionSubtleTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
            <Style x:Key="InspectionValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>
            <Style x:Key="InspectionPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="176" />
                <Setter Property="MaxWidth" Value="240" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource InspectionAccentBorderBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="FocusVisualMargin" Value="-2" />
            </Style>
            <Style x:Key="InspectionSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="176" />
                <Setter Property="MaxWidth" Value="240" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource InspectionSubtleSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InspectionBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource InspectionOutlineThickness}" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionTextBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource InspectionAccentBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                x:Name="InspectionSecondaryButtonSurface"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="InspectionSecondaryButtonSurface.Background" Value="{ThemeResource InspectionTertiaryPointerOverBrush}" />
                                                <Setter Target="InspectionSecondaryButtonSurface.BorderBrush" Value="{ThemeResource InspectionAccentBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="InspectionSecondaryButtonSurface.Background" Value="{ThemeResource InspectionTertiaryPressedBrush}" />
                                                <Setter Target="InspectionSecondaryButtonSurface.BorderBrush" Value="{ThemeResource InspectionAccentBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="InspectionSecondaryButtonSurface.Background" Value="{ThemeResource InspectionWaitingSurfaceBrush}" />
                                                <Setter Target="InspectionSecondaryButtonSurface.BorderBrush" Value="{ThemeResource InspectionBorderBrush}" />
                                                <Setter Target="InspectionSecondaryButtonContent.Foreground" Value="{ThemeResource InspectionSubtleTextBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="InspectionSecondaryButtonContent"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InspectionQuietNeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource InspectionSecondaryButtonStyle}">
                <Setter Property="Height" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Background" Value="{ThemeResource InspectionWaitingSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InspectionBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource InspectionOutlineThickness}" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource InspectionAccentBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="FocusVisualMargin" Value="-2" />
            </Style>
            <Style x:Key="InspectionTertiaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="{ThemeResource InspectionOutlineThickness}" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionTertiaryInteractiveForegroundBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource InspectionTertiaryFocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="FocusVisualMargin" Value="-2" />
            </Style>
            <Style x:Key="InspectionEvidenceHeaderToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionMutedTextBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource InspectionAccentBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid
                                x:Name="InspectionEvidenceHeaderSurface"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InspectionEvidenceExpanderStyle" TargetType="Expander">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid
                                MinWidth="{TemplateBinding MinWidth}"
                                MaxWidth="{TemplateBinding MaxWidth}"
                                HorizontalAlignment="Stretch">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="ExpandStates">
                                        <VisualState x:Name="ExpandUp">
                                            <VisualState.Setters>
                                                <Setter Target="ExpanderHeader.CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomCornerRadiusFilterConverter}}" />
                                                <Setter Target="ExpanderContent.Visibility" Value="Visible" />
                                                <Setter Target="InspectionEvidenceChevron.Glyph" Value="&#xE70E;" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CollapseDown">
                                            <VisualState.Setters>
                                                <Setter Target="ExpanderContent.Visibility" Value="Collapsed" />
                                                <Setter Target="InspectionEvidenceChevron.Glyph" Value="&#xE70D;" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="ExpandDown">
                                            <VisualState.Setters>
                                                <Setter Target="ExpanderHeader.CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopCornerRadiusFilterConverter}}" />
                                                <Setter Target="ExpanderContent.Visibility" Value="Visible" />
                                                <Setter Target="InspectionEvidenceChevron.Glyph" Value="&#xE70E;" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CollapseUp">
                                            <VisualState.Setters>
                                                <Setter Target="ExpanderContent.Visibility" Value="Collapsed" />
                                                <Setter Target="InspectionEvidenceChevron.Glyph" Value="&#xE70D;" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ExpandDirectionStates">
                                        <VisualState x:Name="Down" />
                                        <VisualState x:Name="Up">
                                            <VisualState.Setters>
                                                <Setter Target="ExpanderHeader.Style" Value="{StaticResource InspectionEvidenceHeaderToggleStyle}" />
                                                <Setter Target="ExpanderContent.BorderThickness" Value="{StaticResource ExpanderContentUpBorderThickness}" />
                                                <Setter Target="ExpanderContent.CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopCornerRadiusFilterConverter}}" />
                                                <Setter Target="ExpanderHeaderRow.(Grid.Row)" Value="1" />
                                                <Setter Target="ExpanderContentClip.(Grid.Row)" Value="0" />
                                                <Setter Target="Row0.Height" Value="*" />
                                                <Setter Target="Row1.Height" Value="Auto" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="Row0" Height="Auto" />
                                    <RowDefinition x:Name="Row1" Height="*" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="ExpanderHeaderRow" Grid.Row="0">
                                    <ToggleButton
                                        x:Name="ExpanderHeader"
                                        MinHeight="{TemplateBinding MinHeight}"
                                        Padding="12,0,56,0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="{StaticResource ExpanderHeaderHorizontalContentAlignment}"
                                        VerticalContentAlignment="{StaticResource ExpanderHeaderVerticalContentAlignment}"
                                        AutomationProperties.AutomationId="ExpanderToggleButton"
                                        Background="{TemplateBinding Background}"
                                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsEnabled="{TemplateBinding IsEnabled}"
                                        Style="{StaticResource InspectionEvidenceHeaderToggleStyle}" />
                                    <FontIcon
                                        x:Name="InspectionEvidenceChevron"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource InspectionMutedTextBrush}"
                                        Glyph="&#xE70D;"
                                        IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                                <!-- WinUI applies the composition clip to this native template part. -->
                                <Border x:Name="ExpanderContentClip" Grid.Row="1">
                                    <Border
                                        x:Name="ExpanderContent"
                                        MinHeight="{TemplateBinding MinHeight}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="{TemplateBinding Background}"
                                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{ThemeResource InspectionSideBottomOutlineThickness}"
                                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomCornerRadiusFilterConverter}}"
                                        Visibility="Collapsed">
                                        <ContentPresenter
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                                    </Border>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InspectionProgressItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </Grid.Resources>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="InspectionResponsiveStates">
            <VisualState x:Name="InspectionWideState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1008" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="InspectionBay.Padding" Value="24,20,24,16" />
                    <Setter Target="ReadyActions.Orientation" Value="Horizontal" />
                    <Setter Target="WarningActions.Orientation" Value="Horizontal" />
                    <Setter Target="CancelledActions.Orientation" Value="Horizontal" />
                    <Setter Target="FailureActions.Orientation" Value="Horizontal" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="InspectionMediumState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="640" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="InspectionBay.Padding" Value="24,20,24,16" />
                    <Setter Target="ReadyActions.Orientation" Value="Horizontal" />
                    <Setter Target="WarningActions.Orientation" Value="Horizontal" />
                    <Setter Target="CancelledActions.Orientation" Value="Horizontal" />
                    <Setter Target="FailureActions.Orientation" Value="Horizontal" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="InspectionCompactState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="InspectionBay.Padding" Value="16,18,16,14" />
                    <Setter Target="InspectionBay.MinWidth" Value="0" />
                    <Setter Target="IdentityStatusColumn.Width" Value="0" />
                    <Setter Target="IdentityHeader.ColumnSpacing" Value="10" />
                    <Setter Target="InspectionIdentityStatus.(Grid.Row)" Value="1" />
                    <Setter Target="InspectionIdentityStatus.(Grid.Column)" Value="1" />
                    <Setter Target="InspectionIdentityStatus.(Grid.ColumnSpan)" Value="2" />
                    <Setter Target="InspectionIdentityStatus.HorizontalAlignment" Value="Left" />
                    <Setter Target="InspectionIdentityStatus.Margin" Value="0,10,0,0" />
                    <Setter Target="ReadyActions.Orientation" Value="Vertical" />
                    <Setter Target="ReadyActions.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="WarningActions.Orientation" Value="Vertical" />
                    <Setter Target="WarningActions.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="CancelledActions.Orientation" Value="Vertical" />
                    <Setter Target="CancelledActions.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="CancelledNextStepCopyRow.Orientation" Value="Vertical" />
                    <Setter Target="CancelledNextStepCopyRow.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="FailureActions.Orientation" Value="Vertical" />
                    <Setter Target="FailureActions.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="FailureActionGrid.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="OpenVinoConversionRequiredActions.Orientation" Value="Vertical" />
                    <Setter Target="OpenVinoConversionRequiredActions.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="OpenVinoTimedOutActions.Orientation" Value="Vertical" />
                    <Setter Target="OpenVinoTimedOutActions.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="OpenVinoConversionCancelledActions.Orientation" Value="Vertical" />
                    <Setter Target="OpenVinoConversionCancelledActions.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="OpenVinoConversionFailedActions.Orientation" Value="Vertical" />
                    <Setter Target="OpenVinoConversionFailedActions.HorizontalAlignment" Value="Stretch" />
                    <Setter Target="ReadyEvidenceHeaderStatus.(Grid.Row)" Value="1" />
                    <Setter Target="ReadyEvidenceHeaderStatus.(Grid.Column)" Value="0" />
                    <Setter Target="ReadyEvidenceHeaderStatus.(Grid.ColumnSpan)" Value="2" />
                    <Setter Target="ReadyEvidenceHeaderStatus.HorizontalAlignment" Value="Left" />
                    <Setter Target="ReadyEvidenceHeaderStatus.Margin" Value="0,3,0,0" />
                    <Setter Target="ReadyEvidenceHeaderStatus.TextAlignment" Value="Left" />
                    <Setter Target="WarningEvidenceHeaderStatus.(Grid.Row)" Value="1" />
                    <Setter Target="WarningEvidenceHeaderStatus.(Grid.Column)" Value="0" />
                    <Setter Target="WarningEvidenceHeaderStatus.(Grid.ColumnSpan)" Value="2" />
                    <Setter Target="WarningEvidenceHeaderStatus.HorizontalAlignment" Value="Left" />
                    <Setter Target="WarningEvidenceHeaderStatus.Margin" Value="0,3,0,0" />
                    <Setter Target="WarningEvidenceHeaderStatus.TextAlignment" Value="Left" />
                    <Setter Target="MetadataColumn2.Width" Value="0" />
                    <Setter Target="MetadataColumn3.Width" Value="0" />
                    <Setter Target="MetadataParameters.(Grid.Row)" Value="1" />
                    <Setter Target="MetadataParameters.(Grid.Column)" Value="0" />
                    <Setter Target="MetadataModelType.(Grid.Row)" Value="1" />
                    <Setter Target="MetadataModelType.(Grid.Column)" Value="1" />
                    <Setter Target="MetadataContext.(Grid.Row)" Value="2" />
                    <Setter Target="MetadataContext.(Grid.Column)" Value="0" />
                    <Setter Target="MetadataFileSize.(Grid.Row)" Value="2" />
                    <Setter Target="MetadataFileSize.(Grid.Column)" Value="1" />
                    <Setter Target="MetadataFormat.(Grid.Row)" Value="3" />
                    <Setter Target="MetadataFormat.(Grid.Column)" Value="0" />
                    <Setter Target="MetadataQuantisation.(Grid.Row)" Value="3" />
                    <Setter Target="MetadataQuantisation.(Grid.Column)" Value="1" />
                    <Setter Target="WarningMetadataColumn2.Width" Value="0" />
                    <Setter Target="WarningMetadataColumn3.Width" Value="0" />
                    <Setter Target="WarningMetadataParameters.(Grid.Row)" Value="1" />
                    <Setter Target="WarningMetadataParameters.(Grid.Column)" Value="0" />
                    <Setter Target="WarningMetadataModelType.(Grid.Row)" Value="1" />
                    <Setter Target="WarningMetadataModelType.(Grid.Column)" Value="1" />
                    <Setter Target="WarningMetadataContext.(Grid.Row)" Value="2" />
                    <Setter Target="WarningMetadataContext.(Grid.Column)" Value="0" />
                    <Setter Target="WarningMetadataFileSize.(Grid.Row)" Value="2" />
                    <Setter Target="WarningMetadataFileSize.(Grid.Column)" Value="1" />
                    <Setter Target="WarningMetadataFormat.(Grid.Row)" Value="3" />
                    <Setter Target="WarningMetadataFormat.(Grid.Column)" Value="0" />
                    <Setter Target="WarningMetadataQuantisation.(Grid.Row)" Value="3" />
                    <Setter Target="WarningMetadataQuantisation.(Grid.Column)" Value="1" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border
        x:Name="InspectionBay"
        MaxWidth="960"
        Padding="24,20,24,16"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Background="{ThemeResource InspectionSurfaceBrush}"
        BorderBrush="{ThemeResource InspectionBorderBrush}"
        BorderThickness="{ThemeResource InspectionOutlineThickness}"
        CornerRadius="12"
        AutomationProperties.AutomationId="InspectionBay"
        AutomationProperties.Name="Measured model inspection bay">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="IdentityHeader" ColumnSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="IdentityStatusColumn" Width="176" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Background="{ThemeResource InspectionAccentSurfaceBrush}" CornerRadius="10">
                    <SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionAccentBrush}" Symbol="Folder" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="CompactModelName"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource InspectionTextBrush}"
                        Text="Granite-4.1-3B-OpenVINO-Raw"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="Granite-4.1-3B-OpenVINO-Raw" />
                    <TextBlock
                        Style="{StaticResource InspectionBodyStyle}"
                        Text="OpenVINO GenAI package"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="OpenVINO GenAI package" />
                </StackPanel>
                <Border
                    x:Name="InspectionIdentityStatus"
                    Grid.Column="2"
                    Height="32"
                    Padding="12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    UseLayoutRounding="True"
                    Background="{ThemeResource InspectionAccentSurfaceBrush}"
                    BorderBrush="{ThemeResource InspectionAccentBorderBrush}"
                    BorderThickness="{ThemeResource InspectionOutlineThickness}"
                    CornerRadius="16"
                    AutomationProperties.AutomationId="InspectionIdentityStatus"
                    AutomationProperties.Name="Inspection in progress">
                    <TextBlock
                        x:Name="InspectionIdentityStatusText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource InspectionAccentBrush}"
                        Text="Inspection in progress" />
                </Border>
            </Grid>

            <Rectangle Grid.Row="1" Fill="{ThemeResource InspectionBorderBrush}" />

            <Grid x:Name="InspectionStateHost" Grid.Row="2">
                <Grid
                    x:Name="InspectionProgressPanel"
                    AutomationProperties.AutomationId="InspectionProgressPanel"
                    AutomationProperties.Name="Inspection progress"
                    AutomationProperties.AccessibilityView="Content"
                    AutomationProperties.LiveSetting="Polite">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="InspectionProgressHeader" MinHeight="68" ColumnSpacing="24" RowSpacing="2" UseLayoutRounding="True">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Spacing="6">
                            <ProgressBar x:Name="InspectionOverallProgress" Minimum="0" Maximum="5" Value="0" IsTabStop="False" Foreground="{ThemeResource InspectionAccentBrush}" AutomationProperties.AutomationId="InspectionOverallProgress" AutomationProperties.Name="Overall model inspection progress" />
                            <TextBlock x:Name="InspectionOverallPercentage" Text="0%" FontSize="12" Foreground="{ThemeResource InspectionMutedTextBrush}" AutomationProperties.AutomationId="InspectionOverallPercentage" AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                        <StackPanel x:Name="InspectionProgressCopy" Grid.RowSpan="2" Spacing="6">
                            <TextBlock
                                x:Name="InspectionProgressHeading"
                                FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource InspectionTextBrush}"
                                Text="Starting secure inspection…"
                                TextWrapping="WrapWholeWords"
                                AutomationProperties.AutomationId="InspectionProgressHeading"
                                AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock
                                x:Name="InspectionProgressSupportingText"
                                MinHeight="38"
                                Style="{StaticResource InspectionBodyStyle}"
                                Text="Reading and verifying the large model file securely. This can take up to a minute." />
                        </StackPanel>
                        <TextBlock
                            x:Name="InspectionProgressCount"
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            Margin="16,2,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            FontSize="12"
                            FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource InspectionMutedTextBrush}"
                            Text="0 of 5 checks complete"
                            TextAlignment="Right"
                            TextWrapping="NoWrap"
                            AutomationProperties.AutomationId="InspectionProgressCount" />
                    </Grid>

                    <ItemsControl
                        x:Name="InspectionProgressRows"
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="InspectionProgressRows"
                        AutomationProperties.Name="Model inspection checks">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ListViewItem
                            x:Name="InspectionStage1"
                            Style="{StaticResource InspectionProgressItemStyle}"
                            AutomationProperties.AutomationId="InspectionStageCheckPackage"
                            AutomationProperties.ItemStatus="Checking"
                            AutomationProperties.Name="Check model package. Checking. Step 1 of 5."
                            AutomationProperties.PositionInSet="1"
                            AutomationProperties.SizeOfSet="5">
                            <Grid MinHeight="48" Padding="8,6" ColumnSpacing="12" UseLayoutRounding="True">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="InspectionStage1GlyphSurface" Width="32" Height="32" VerticalAlignment="Center" Background="{ThemeResource InspectionAccentSurfaceBrush}" BorderBrush="{ThemeResource InspectionAccentBorderBrush}" BorderThickness="0" CornerRadius="16">
                                    <Grid>
                                        <ProgressRing x:Name="InspectionStage1Ring" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionAccentBrush}" IsActive="False" AutomationProperties.AccessibilityView="Raw" />
                                        <Grid x:Name="InspectionStage1Arc" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" AutomationProperties.AccessibilityView="Raw">
                                            <Ellipse x:Name="InspectionStage1ArcEllipse" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource InspectionAccentBrush}" StrokeThickness="1.6" StrokeDashArray="26,13.27" StrokeDashCap="Round" UseLayoutRounding="False" />
                                        </Grid>
                                        <FontIcon x:Name="InspectionStage1Glyph" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource InspectionAccentBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="InspectionStage1Number" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource InspectionAccentBrush}" Text="1" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="InspectionStage1Title" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Check model package" TextWrapping="WrapWholeWords" /><TextBlock x:Name="InspectionStage1Detail" Style="{StaticResource InspectionBodyStyle}" FontSize="12" Text="The OpenVINO package is complete and unchanged." /></StackPanel>
                                <TextBlock x:Name="InspectionStage1Status" Grid.Column="2" VerticalAlignment="Center" MinHeight="32" TextAlignment="Right" FontSize="12" Foreground="{ThemeResource InspectionAccentBrush}" Text="Checking" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem
                            x:Name="InspectionStage2"
                            Style="{StaticResource InspectionProgressItemStyle}"
                            AutomationProperties.AutomationId="InspectionStageReadConfiguration"
                            AutomationProperties.ItemStatus="Waiting"
                            AutomationProperties.Name="Read model configuration. Waiting. Step 2 of 5."
                            AutomationProperties.PositionInSet="2"
                            AutomationProperties.SizeOfSet="5">
                            <Grid MinHeight="48" Padding="8,6" ColumnSpacing="12" UseLayoutRounding="True">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="InspectionStage2GlyphSurface" Width="32" Height="32" VerticalAlignment="Center" Background="{ThemeResource InspectionWaitingSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderBrush}" BorderThickness="0" CornerRadius="16">
                                    <Grid>
                                        <ProgressRing x:Name="InspectionStage2Ring" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionAccentBrush}" IsActive="False" AutomationProperties.AccessibilityView="Raw" />
                                        <Grid x:Name="InspectionStage2Arc" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" AutomationProperties.AccessibilityView="Raw"><Ellipse x:Name="InspectionStage2ArcEllipse" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource InspectionAccentBrush}" StrokeThickness="1.6" StrokeDashArray="26,13.27" StrokeDashCap="Round" UseLayoutRounding="False" /></Grid>
                                        <FontIcon x:Name="InspectionStage2Glyph" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource InspectionSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="InspectionStage2Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="2" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="InspectionStage2Title" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Read model configuration" TextWrapping="WrapWholeWords" /><TextBlock x:Name="InspectionStage2Detail" Style="{StaticResource InspectionBodyStyle}" FontSize="12" Text="The model configuration is valid." /></StackPanel>
                                <TextBlock x:Name="InspectionStage2Status" Grid.Column="2" VerticalAlignment="Center" MinHeight="32" TextAlignment="Right" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Waiting" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem
                            x:Name="InspectionStage3"
                            Style="{StaticResource InspectionProgressItemStyle}"
                            AutomationProperties.AutomationId="InspectionStageValidateTokenizer"
                            AutomationProperties.ItemStatus="Waiting"
                            AutomationProperties.Name="Validate tokenizer and chat setup. Waiting. Step 3 of 5."
                            AutomationProperties.PositionInSet="3"
                            AutomationProperties.SizeOfSet="5">
                            <Grid MinHeight="48" Padding="8,6" ColumnSpacing="12" UseLayoutRounding="True">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="InspectionStage3GlyphSurface" Width="32" Height="32" VerticalAlignment="Center" Background="{ThemeResource InspectionWaitingSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderBrush}" BorderThickness="0" CornerRadius="16">
                                    <Grid>
                                        <ProgressRing x:Name="InspectionStage3Ring" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionAccentBrush}" IsActive="False" AutomationProperties.AccessibilityView="Raw" />
                                        <Grid x:Name="InspectionStage3Arc" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" AutomationProperties.AccessibilityView="Raw"><Ellipse x:Name="InspectionStage3ArcEllipse" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource InspectionAccentBrush}" StrokeThickness="1.6" StrokeDashArray="26,13.27" StrokeDashCap="Round" UseLayoutRounding="False" /></Grid>
                                        <FontIcon x:Name="InspectionStage3Glyph" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource InspectionSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="InspectionStage3Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="3" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="InspectionStage3Title" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Validate tokenizer and chat setup" TextWrapping="WrapWholeWords" /><TextBlock x:Name="InspectionStage3Detail" Style="{StaticResource InspectionBodyStyle}" FontSize="12" Text="The tokenizer and chat setup are valid." /></StackPanel>
                                <TextBlock x:Name="InspectionStage3Status" Grid.Column="2" VerticalAlignment="Center" MinHeight="32" TextAlignment="Right" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Waiting" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem
                            x:Name="InspectionStage4"
                            Style="{StaticResource InspectionProgressItemStyle}"
                            AutomationProperties.AutomationId="InspectionStageValidateStructure"
                            AutomationProperties.ItemStatus="Waiting"
                            AutomationProperties.Name="Validate model structure. Waiting. Step 4 of 5."
                            AutomationProperties.PositionInSet="4"
                            AutomationProperties.SizeOfSet="5">
                            <Grid MinHeight="48" Padding="8,6" ColumnSpacing="12" UseLayoutRounding="True">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="InspectionStage4GlyphSurface" Width="32" Height="32" VerticalAlignment="Center" Background="{ThemeResource InspectionWaitingSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderBrush}" BorderThickness="0" CornerRadius="16">
                                    <Grid>
                                        <ProgressRing x:Name="InspectionStage4Ring" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionAccentBrush}" IsActive="False" AutomationProperties.AccessibilityView="Raw" />
                                        <Grid x:Name="InspectionStage4Arc" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" AutomationProperties.AccessibilityView="Raw"><Ellipse x:Name="InspectionStage4ArcEllipse" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource InspectionAccentBrush}" StrokeThickness="1.6" StrokeDashArray="26,13.27" StrokeDashCap="Round" UseLayoutRounding="False" /></Grid>
                                        <FontIcon x:Name="InspectionStage4Glyph" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource InspectionSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="InspectionStage4Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="4" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="InspectionStage4Title" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Validate model structure" TextWrapping="WrapWholeWords" /><TextBlock x:Name="InspectionStage4Detail" Style="{StaticResource InspectionBodyStyle}" FontSize="12" Text="The model structure is valid." /></StackPanel>
                                <TextBlock x:Name="InspectionStage4Status" Grid.Column="2" VerticalAlignment="Center" MinHeight="32" TextAlignment="Right" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Waiting" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem
                            x:Name="InspectionStage5"
                            Style="{StaticResource InspectionProgressItemStyle}"
                            AutomationProperties.AutomationId="InspectionStageConfirmRuntime"
                            AutomationProperties.ItemStatus="Waiting"
                            AutomationProperties.Name="Confirm core runtime compatibility. Waiting. Step 5 of 5."
                            AutomationProperties.PositionInSet="5"
                            AutomationProperties.SizeOfSet="5">
                            <Grid MinHeight="48" Padding="8,6" ColumnSpacing="12" UseLayoutRounding="True">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="InspectionStage5GlyphSurface" Width="32" Height="32" VerticalAlignment="Center" Background="{ThemeResource InspectionWaitingSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderBrush}" BorderThickness="0" CornerRadius="16">
                                    <Grid>
                                        <ProgressRing x:Name="InspectionStage5Ring" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionAccentBrush}" IsActive="False" AutomationProperties.AccessibilityView="Raw" />
                                        <Grid x:Name="InspectionStage5Arc" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" AutomationProperties.AccessibilityView="Raw"><Ellipse x:Name="InspectionStage5ArcEllipse" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{ThemeResource InspectionAccentBrush}" StrokeThickness="1.6" StrokeDashArray="26,13.27" StrokeDashCap="Round" UseLayoutRounding="False" /></Grid>
                                        <FontIcon x:Name="InspectionStage5Glyph" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource InspectionSuccessBrush}" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="InspectionStage5Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="5" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="InspectionStage5Title" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Confirm core runtime compatibility" TextWrapping="WrapWholeWords" /><TextBlock x:Name="InspectionStage5Detail" Style="{StaticResource InspectionBodyStyle}" FontSize="12" Text="Confirming core OpenVINO runtime compatibility." /></StackPanel>
                                <TextBlock x:Name="InspectionStage5Status" Grid.Column="2" VerticalAlignment="Center" MinHeight="32" TextAlignment="Right" FontSize="12" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Waiting" />
                            </Grid>
                        </ListViewItem>
                    </ItemsControl>

                    <Border
                        Grid.Row="2"
                        Margin="0,24,0,0"
                        Padding="14,8"
                        BorderBrush="{ThemeResource InspectionBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel
                        x:Name="ProgressActions"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Spacing="6"
                        AutomationProperties.AutomationId="InspectionProgressActions"
                        AutomationProperties.Name="Inspection cancellation actions">
                        <TextBlock
                            x:Name="ProgressSafetyCopy"
                            HorizontalAlignment="Center"
                            Style="{StaticResource InspectionBodyStyle}"
                            Text="Inspection runs locally in a protected worker."
                            TextAlignment="Center"
                            AutomationProperties.AutomationId="InspectionProgressSafetyCopy" />
                            <Button
                                x:Name="BtnCancelInspection"
                                MinWidth="176"
                                MaxWidth="240"
                                Height="44"
                                MinHeight="44"
                                HorizontalAlignment="Center"
                                Style="{StaticResource InspectionSecondaryButtonStyle}"
                                Content="Cancel"
                                AutomationProperties.AutomationId="BtnCancelInspection"
                                AutomationProperties.Name="Cancel OpenVINO inspection" />
                    </StackPanel>
                    </Border>
