                        <ListViewItem x:Name="ConversionStage4" Style="{StaticResource InspectionProgressItemStyle}" AutomationProperties.ItemStatus="Waiting" AutomationProperties.Name="Smoke testing. Waiting. Step 4 of 6." AutomationProperties.PositionInSet="4" AutomationProperties.SizeOfSet="6"><Grid MinHeight="48" Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{ThemeResource InspectionWaitingSurfaceBrush}" CornerRadius="16"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="4" /></Border><TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Smoke testing" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Waiting" /></Grid></ListViewItem>
                        <ListViewItem x:Name="ConversionStage5" Style="{StaticResource InspectionProgressItemStyle}" AutomationProperties.ItemStatus="Waiting" AutomationProperties.Name="Publishing. Waiting. Step 5 of 6." AutomationProperties.PositionInSet="5" AutomationProperties.SizeOfSet="6"><Grid MinHeight="48" Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{ThemeResource InspectionWaitingSurfaceBrush}" CornerRadius="16"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="5" /></Border><TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Publishing" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Waiting" /></Grid></ListViewItem>
                        <ListViewItem x:Name="ConversionStage6" Style="{StaticResource InspectionProgressItemStyle}" AutomationProperties.ItemStatus="Waiting" AutomationProperties.Name="Reinspecting. Waiting. Step 6 of 6." AutomationProperties.PositionInSet="6" AutomationProperties.SizeOfSet="6"><Grid MinHeight="48" Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{ThemeResource InspectionWaitingSurfaceBrush}" CornerRadius="16"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="6" /></Border><TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Reinspecting" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource InspectionWaitingTextBrush}" Text="Waiting" /></Grid></ListViewItem>
                    </ItemsControl>
                    <Button x:Name="BtnCancelOpenVinoConversion" Grid.Row="2" MinWidth="176" MaxWidth="240" Height="44" MinHeight="44" HorizontalAlignment="Center" Style="{StaticResource InspectionSecondaryButtonStyle}" AutomationProperties.AutomationId="BtnCancelOpenVinoConversion" AutomationProperties.Name="Cancel OpenVINO conversion" Content="Cancel" />
                </Grid>

                <Grid x:Name="OpenVinoConversionCancelledPanel" Visibility="Collapsed" AutomationProperties.AutomationId="OpenVinoConversionCancelledPanel" AutomationProperties.Name="OpenVINO conversion cancelled" AutomationProperties.AccessibilityView="Content" AutomationProperties.LiveSetting="Assertive">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock x:Name="OpenVinoConversionCancelledHeading" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Conversion cancelled" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Name="OpenVinoConversionCancelledMessage" Style="{StaticResource InspectionBodyStyle}" Text="Inspect the source again to start a new conversion." /><TextBlock x:Name="OpenVinoConversionCancelledDiagnostic" Style="{StaticResource InspectionLabelStyle}" Text="operation_cancelled" /></StackPanel><Border Grid.Row="2" Padding="14,12" Background="{ThemeResource InspectionSubtleSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderBrush}" BorderThickness="{ThemeResource InspectionTopOutlineThickness}"><StackPanel Spacing="8"><TextBlock x:Name="OpenVinoConversionCancelledRecovery" HorizontalAlignment="Center" Style="{StaticResource InspectionBodyStyle}" Text="Retry the verified conversion or choose another model." TextAlignment="Center" /><StackPanel x:Name="OpenVinoConversionCancelledActions" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10"><Button x:Name="BtnChooseAnotherModelConversionCancelled" MinWidth="176" Style="{StaticResource InspectionSecondaryButtonStyle}" AutomationProperties.AutomationId="InspectionAction.choose-another" Content="Choose another model" /><Button x:Name="BtnRetryOpenVinoConversionCancelled" MinWidth="176" Style="{StaticResource InspectionPrimaryButtonStyle}" AutomationProperties.AutomationId="BtnRetryOpenVinoConversion" Content="Retry conversion" /></StackPanel></StackPanel></Border>
                </Grid>

                <Grid x:Name="OpenVinoConversionFailedPanel" Visibility="Collapsed" AutomationProperties.AutomationId="OpenVinoConversionFailedPanel" AutomationProperties.Name="OpenVINO conversion failed" AutomationProperties.AccessibilityView="Content" AutomationProperties.LiveSetting="Assertive">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock x:Name="OpenVinoConversionFailedHeading" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InspectionTextBrush}" Text="Conversion failed" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Name="OpenVinoConversionFailedMessage" Style="{StaticResource InspectionBodyStyle}" Text="No package was published. Inspect the source again and retry." /></StackPanel><Border x:Name="OpenVinoConversionFailedDiagnosticContainer" Grid.Row="1" Margin="0,12,0,0" Padding="14,10" Background="{ThemeResource InspectionErrorSurfaceBrush}" BorderBrush="{ThemeResource InspectionErrorBorderBrush}" BorderThickness="{ThemeResource InspectionOutlineThickness}" CornerRadius="8"><StackPanel Spacing="4"><TextBlock Style="{StaticResource InspectionLabelStyle}" Text="DIAGNOSTIC CODE" /><TextBlock x:Name="OpenVinoConversionFailedDiagnostic" FontWeight="SemiBold" Foreground="{ThemeResource InspectionErrorBrush}" Text="conversion_failed" /></StackPanel></Border><Border Grid.Row="3" Padding="14,12" Background="{ThemeResource InspectionSubtleSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderBrush}" BorderThickness="{ThemeResource InspectionTopOutlineThickness}"><StackPanel Spacing="8"><TextBlock x:Name="OpenVinoConversionFailedRecovery" HorizontalAlignment="Center" Style="{StaticResource InspectionBodyStyle}" Text="Retry the verified conversion or choose another model." TextAlignment="Center" /><StackPanel x:Name="OpenVinoConversionFailedActions" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10"><Button x:Name="BtnChooseAnotherModelConversionFailed" MinWidth="176" Style="{StaticResource InspectionSecondaryButtonStyle}" AutomationProperties.AutomationId="InspectionAction.choose-another" Content="Choose another model" /><Button x:Name="BtnRetryOpenVinoConversionFailed" MinWidth="176" Style="{StaticResource InspectionPrimaryButtonStyle}" AutomationProperties.AutomationId="BtnRetryOpenVinoConversionFailed" Content="Retry conversion" /></StackPanel></StackPanel></Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>

    <ContentDialog
        x:Name="DlgOpenVinoConversion"
        Title="Create an OpenVINO package?"
        PrimaryButtonText="Convert"
        CloseButtonText="Cancel"
        DefaultButton="Primary"
        AutomationProperties.AutomationId="DlgOpenVinoConversion"
        AutomationProperties.Name="Create an OpenVINO package?">
        <TextBlock
            MaxWidth="440"
            Foreground="{ThemeResource InspectionTextBrush}"
            Text="A new FP16 package will be created beside the selected source. The source will not be changed."
            TextWrapping="WrapWholeWords" />
    </ContentDialog>

    <Grid x:Name="OpenVinoInspectionMessageCatalogue" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw">
        <TextBlock x:Name="OpenVinoPackageMessageStart" Text="Reading and verifying the large model file securely. This can take up to a minute." />
        <TextBlock x:Name="OpenVinoPackageMessageContinue" Text="Continuing the secure read of the large model file." />
        <TextBlock x:Name="OpenVinoPackageMessageUnchanged" Text="Confirming the large model file did not change during inspection." />
        <TextBlock x:Name="OpenVinoPackageMessageConsistency" Text="Continuing the model-file consistency check." />
        <TextBlock x:Name="OpenVinoPackageMessageFinish" Text="Finishing secure model-file verification." />
        <TextBlock x:Name="OpenVinoPackageMessageComplete" Text="The OpenVINO package is complete and unchanged." />
        <TextBlock x:Name="OpenVinoConfigurationMessageActive" Text="Reading the model configuration." />
        <TextBlock x:Name="OpenVinoConfigurationMessageComplete" Text="The model configuration is valid." />
        <TextBlock x:Name="OpenVinoTokenizerMessageActive" Text="Validating the tokenizer and chat setup." />
        <TextBlock x:Name="OpenVinoTokenizerMessageMidpoint" Text="The model graph is readable; checking tokenizer resources." />
        <TextBlock x:Name="OpenVinoTokenizerMessageComplete" Text="The tokenizer and chat setup are valid." />
        <TextBlock x:Name="OpenVinoStructureMessageActive" Text="Validating the model structure." />
        <TextBlock x:Name="OpenVinoStructureMessageComplete" Text="The model structure is valid." />
        <TextBlock x:Name="OpenVinoRuntimeMessageActive" Text="Confirming core OpenVINO runtime compatibility." />
        <TextBlock x:Name="OpenVinoRuntimeMessageComplete" Text="The OpenVINO package is ready for hardware inspection." />
    </Grid>
</Grid>
</UserControl>
