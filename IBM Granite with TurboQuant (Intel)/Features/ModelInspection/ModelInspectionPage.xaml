<?xml version="1.0" encoding="utf-8" ?>

<Page
    x:Class="GraniteEdgeAI.Features.ModelInspection.ModelInspectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.ModelInspection.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1024"
    d:DesignWidth="1440"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <!--
        One retained Grid/ScrollViewer tree owns the page for the complete
        navigation attempt. Individual cards keep their own semantic regions.
    -->
    <Grid
        x:Name="LayoutRoot"
        Background="{ThemeResource InspectionSurfaceBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsivePageStates">
                <VisualState x:Name="DesktopPageState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="888" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InspectionContentHost.Margin" Value="24,28,24,32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumPageState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InspectionContentHost.Margin" Value="24,28,24,32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowPageState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="InspectionContentHost.Margin" Value="16,28,16,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            x:Name="InspectionPageScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            ZoomMode="Disabled">

            <Grid
                x:Name="InspectionScrollContent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <Grid
                    x:Name="InspectionContentHost"
                    MaxWidth="{StaticResource InspectionContentColumnWidth}"
                    Margin="16,28,16,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                    <Grid
                        x:Name="InspectionReflowHost"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            x:Name="Header"
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            Spacing="8">
                            <TextBlock
                                x:Name="PageTitle"
                                HorizontalAlignment="Stretch"
                                FontFamily="{StaticResource InspectionPageTitleFontFamily}"
                                FontSize="{StaticResource InspectionPageTitleFontSize}"
                                FontWeight="{StaticResource InspectionPageTitleFontWeight}"
                                Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                                Text="Model inspection"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="ModelInspectionExplanation"
                                MaxWidth="720"
                                HorizontalAlignment="Center"
                                FontFamily="{StaticResource InspectionBodyFontFamily}"
                                FontSize="{StaticResource InspectionBodyFontSize}"
                                FontWeight="{StaticResource InspectionBodyFontWeight}"
                                Foreground="{ThemeResource InspectionTextSecondaryMutedBrush}"
                                Text="We are checking that the model package, tokenizer, structure, and runtime are supported before checking hardware fit."
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Border
                            x:Name="HeaderToFirstCardGap"
                            Grid.Row="1"
                            Height="{StaticResource InspectionHeaderToCardGap}"
                            AutomationProperties.AccessibilityView="Raw"
                            IsHitTestVisible="False" />

                        <controls:InspectionOutcomeCard
                            x:Name="InspectionOutcomeCardControl"
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.LiveSetting="Assertive"
                            AutomationProperties.Name="Model inspection outcome"
                            Visibility="{Binding CardVisibility, ElementName=InspectionOutcomeCardControl}" />

                        <Border
                            x:Name="OutcomeToModelCardGap"
                            Grid.Row="3"
                            Height="{StaticResource InspectionCardGap}"
                            AutomationProperties.AccessibilityView="Raw"
                            IsHitTestVisible="False"
                            Visibility="{Binding Visibility, ElementName=InspectionOutcomeCardControl}" />

                        <controls:InspectionModelCard
                            x:Name="InspectionModelCardControl"
                            Grid.Row="4"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Selected model information" />

                        <Grid Grid.Row="5">
                            <Border
                                x:Name="ModelToContentLiveGap"
                                Height="{StaticResource InspectionCardGap}"
                                AutomationProperties.AccessibilityView="Raw"
                                IsHitTestVisible="False"
                                Visibility="{Binding Visibility, ElementName=InspectionContentCardControl}" />
                            <Border
                                x:Name="ModelToContentOutgoingGap"
                                Height="{StaticResource InspectionCardGap}"
                                AutomationProperties.AccessibilityView="Raw"
                                IsHitTestVisible="False"
                                Visibility="{Binding Visibility, ElementName=OutgoingProgressContentCard}" />
                        </Grid>

                        <controls:InspectionContentCard
                            x:Name="InspectionContentCardControl"
                            Grid.Row="6"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Model inspection progress and findings"
                            Visibility="{Binding CardVisibility, ElementName=InspectionContentCardControl}" />

                        <!--
                            One inert outgoing progress layer remains realized only
                            for the terminal crossfade. It never participates in
                            hit testing, live regions, or the automation tree.
                        -->
                        <controls:InspectionContentCard
                            x:Name="OutgoingProgressContentCard"
                            Grid.Row="6"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AccessibilityView="Raw"
                            Canvas.ZIndex="2"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />

                        <Border
                            x:Name="ContentToActionCardGap"
                            Grid.Row="7"
                            Height="{StaticResource InspectionCardGap}"
                            AutomationProperties.AccessibilityView="Raw"
                            IsHitTestVisible="False" />

                        <controls:InspectionActionCard
                            x:Name="InspectionActionCardControl"
                            Grid.Row="8"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Model inspection actions" />
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
