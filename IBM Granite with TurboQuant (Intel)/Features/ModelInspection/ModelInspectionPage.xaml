<?xml version="1.0" encoding="utf-8" ?>

<!--
    Represents the complete Model Inspection screen.
    
    This page arranges the reusable inspection controls.
    The individual controls remain responsible for their own internal design.
-->
<Page
    x:Class="GraniteEdgeAI.Features.ModelInspection.ModelInspectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.ModelInspection.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <!--
        A Page can contain one root object.
        
        This Grid becomes the root layout container for the complete page.
    -->
    <Grid
        Background="White">

        <!--
            Allows the inspection content to scroll when:
            
            - The application window is short.
            - Windows text scaling is increased.
            - An inspection-details Expander is opened.
        -->
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">

            <!--
                Arranges the heading and all four cards in one vertical column.
                
                MaxWidth keeps every major card aligned to the same
                840-pixel centre line used by the prototypes.
                
                The Margin creates space around the complete page content.
            -->
            <StackPanel
                MaxWidth="840"
                Margin="32,28,32,32"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Orientation="Vertical"
                Spacing="16">

                <!--  =================================================  -->
                <!--  PERMANENT PAGE HEADING  -->
                <!--  =================================================  -->

                <!--
                    This heading remains visible throughout every
                    inspection state.
                -->
                <StackPanel
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Spacing="8">

                    <!--  Permanent page title.  -->
                    <TextBlock
                        HorizontalAlignment="Stretch"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="#101828"
                        Text="Model inspection"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />

                    <!--  Permanent page explanation.  -->
                    <TextBlock
                        MaxWidth="720"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="#667085"
                        Text="We are checking that the model package, tokenizer, structure and runtime is support before checking hardware fit."
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />

                </StackPanel>

                <!--  =================================================  -->
                <!--  1. INSPECTION OUTCOME CARD  -->
                <!--  =================================================  -->

                <!--
                    Hidden while inspection is running.
                    
                    Later displays:
                    - Ready
                    - Ready with warnings
                    - Conversion required
                    - Incomplete package
                    - Unsupported
                    - Invalid
                    - Cancelled
                    - Operational failure
                -->
                <controls:InspectionOutcomeCard
                    x:Name="InspectionOutcomeCardControl"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Model inspection outcome" />

                <!--  =================================================  -->
                <!--  2. SELECTED MODEL CARD  -->
                <!--  =================================================  -->

                <!--
                    Displays the selected model throughout the journey.
                    
                    During inspection it uses the compact layout.
                    For the Ready result it uses the detailed layout.
                -->
                <controls:InspectionModelCard
                    x:Name="InspectionModelCardControl"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Selected model information" />

                <!--  =================================================  -->
                <!--  3. INSPECTION CONTENT CARD  -->
                <!--  =================================================  -->

                <!--
                    Displays the changing centre section.
                    
                    Initially this will contain the five-stage
                    inspection progress tracker.
                    
                    After inspection it can display warnings,
                    conversion information or failure details.
                -->
                <controls:InspectionContentCard
                    x:Name="InspectionContentCardControl"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Model inspection progress and findings" />

                <!--  =================================================  -->
                <!--  4. INSPECTION ACTION CARD  -->
                <!--  =================================================  -->

                <!--
                    Displays the actions available for the current state.
                    
                    Initially this will display:
                    - Cancel inspection
                    
                    Completed states will display their relevant
                    primary and secondary actions.
                -->
                <controls:InspectionActionCard
                    x:Name="InspectionActionCardControl"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Model inspection actions" />

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>