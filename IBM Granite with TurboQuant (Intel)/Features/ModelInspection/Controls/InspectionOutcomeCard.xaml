<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionOutcomeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelInspection.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="82"
    d:DesignWidth="840"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="InspectionOutcomeTitleStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionStrongBodyFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionBodyFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionStrongBodyFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="InspectionOutcomeMessageStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionHelperFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionHelperFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionHelperFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        MaxWidth="{StaticResource InspectionContentColumnWidth}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        AutomationProperties.Name="{x:Bind Presentation.AutomationName, Mode=OneWay}"
        Visibility="{x:Bind CardVisibility, Mode=OneWay}">
        <Border
            x:Name="OutcomeCardBorder"
            MinHeight="82"
            Padding="26,16"
            HorizontalAlignment="Stretch"
            BorderThickness="1"
            CornerRadius="{StaticResource InspectionCardCornerRadius}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="OutcomeIconContainer"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    BorderThickness="1"
                    CornerRadius="{StaticResource InspectionCardCornerRadius}">
                    <local:InspectionStatusGlyph
                        x:Name="OutcomeIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Kind="{x:Bind Presentation.GlyphKind, Mode=OneWay}"
                        SurfaceSize="40" />
                </Border>

                <ContentControl
                    x:Name="OutcomeFocusTarget"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Content"
                    AutomationProperties.HeadingLevel="Level2"
                    AutomationProperties.Name="{x:Bind Presentation.Title, Mode=OneWay}"
                    IsTabStop="False"
                    UseSystemFocusVisuals="True">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="OutcomeTitle"
                            d:Text="Ready for hardware check"
                            Style="{StaticResource InspectionOutcomeTitleStyle}"
                            Text="{x:Bind Presentation.Title, Mode=OneWay}" />
                        <TextBlock
                            x:Name="OutcomeMessage"
                            d:Text="The package, tokenizer, model structure and selected runtime all passed inspection."
                            Style="{StaticResource InspectionOutcomeMessageStyle}"
                            Text="{x:Bind Presentation.Message, Mode=OneWay}" />
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OutcomeToneStates">
                <VisualState x:Name="SuccessTone">
                    <VisualState.Setters>
                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionSuccessSurfaceBrush}" />
                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionSuccessBorderBrush}" />
                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionSuccessSurfaceBrush}" />
                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionSuccessTextBrush}" />
                        <Setter Target="OutcomeTitle.Foreground" Value="{ThemeResource InspectionSuccessTextStrongBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WarningTone">
                    <VisualState.Setters>
                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionWarningSurfaceBrush}" />
                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionWarningBorderBrush}" />
                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionWarningSurfaceBrush}" />
                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionWarningAccentBrush}" />
                        <Setter Target="OutcomeTitle.Foreground" Value="{ThemeResource InspectionWarningTextStrongBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InformationTone">
                    <VisualState.Setters>
                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionBlueSurfaceBrush}" />
                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionBlueBorderStrongBrush}" />
                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionBlueSurfaceBrush}" />
                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionPrimaryBlueBrush}" />
                        <Setter Target="OutcomeTitle.Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ErrorTone">
                    <VisualState.Setters>
                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionErrorSurfaceBrush}" />
                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionErrorBorderBrush}" />
                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionErrorSurfaceBrush}" />
                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionErrorTextBrush}" />
                        <Setter Target="OutcomeTitle.Foreground" Value="{ThemeResource InspectionErrorTextStrongBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NeutralTone">
                    <VisualState.Setters>
                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionSurfaceMutedBrush}" />
                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionBorderMutedBrush}" />
                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionSurfaceMutedBrush}" />
                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionTextSecondaryMutedBrush}" />
                        <Setter Target="OutcomeTitle.Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
