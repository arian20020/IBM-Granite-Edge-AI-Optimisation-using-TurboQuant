<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionOutcomeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="96"
    d:DesignWidth="840"
    mc:Ignorable="d">

    <!--
        Displays the high-level result of model inspection.
        
        This control owns only:
        - The outcome icon
        - The outcome title
        - The short outcome explanation
        
        It does not own:
        - Model identity or model metadata
        - Detailed warnings or diagnostic evidence
        - User actions or navigation
        - Model-outcome classification logic
    -->

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  ======================================================  -->
            <!--  THEME-AWARE OUTCOME COLOURS  -->
            <!--  ======================================================  -->

            <ResourceDictionary.ThemeDictionaries>

                <!--  Dark theme.  -->
                <ResourceDictionary
                    x:Key="Dark">

                    <!--  Shared text colours.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomePrimaryTextBrush"
                        Color="#F7F8FA" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSecondaryTextBrush"
                        Color="#D0D5DD" />

                    <!--  Success tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessBackgroundBrush"
                        Color="#153A33" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessBorderBrush"
                        Color="#2B6C5E" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessAccentBrush"
                        Color="#42BEA7" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessIconBackgroundBrush"
                        Color="#204D43" />

                    <!--  Warning tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningBackgroundBrush"
                        Color="#44370A" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningBorderBrush"
                        Color="#7B6510" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningAccentBrush"
                        Color="#F1C21B" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningIconBackgroundBrush"
                        Color="#5A490B" />

                    <!--  Information tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationBackgroundBrush"
                        Color="#172A46" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationBorderBrush"
                        Color="#355C91" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationAccentBrush"
                        Color="#78A9FF" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationIconBackgroundBrush"
                        Color="#203D66" />

                    <!--  Error tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorBackgroundBrush"
                        Color="#4A1E22" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorBorderBrush"
                        Color="#80323A" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorAccentBrush"
                        Color="#FA4D56" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorIconBackgroundBrush"
                        Color="#61272D" />

                    <!--  Neutral tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralBackgroundBrush"
                        Color="#30343A" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralBorderBrush"
                        Color="#515862" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralAccentBrush"
                        Color="#C4CAD4" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralIconBackgroundBrush"
                        Color="#41464E" />

                </ResourceDictionary>

                <!--  Light theme matching the approved prototype.  -->
                <ResourceDictionary
                    x:Key="Light">

                    <!--  Shared text colours.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomePrimaryTextBrush"
                        Color="#101828" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSecondaryTextBrush"
                        Color="#475467" />

                    <!--  Success tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessBackgroundBrush"
                        Color="#F2FBF7" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessBorderBrush"
                        Color="#A7DEC7" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessAccentBrush"
                        Color="#067A57" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessIconBackgroundBrush"
                        Color="#DDF5EA" />

                    <!--  Warning tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningBackgroundBrush"
                        Color="#FFF9EB" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningBorderBrush"
                        Color="#E7C878" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningAccentBrush"
                        Color="#8A6100" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningIconBackgroundBrush"
                        Color="#FFF1C2" />

                    <!--  Information tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationBackgroundBrush"
                        Color="#F3F7FF" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationBorderBrush"
                        Color="#B6CCF2" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationAccentBrush"
                        Color="#0F62FE" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationIconBackgroundBrush"
                        Color="#DFEAFF" />

                    <!--  Error tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorBackgroundBrush"
                        Color="#FFF4F3" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorBorderBrush"
                        Color="#F1B6B2" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorAccentBrush"
                        Color="#B42318" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorIconBackgroundBrush"
                        Color="#FEE4E2" />

                    <!--  Neutral tone.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralBackgroundBrush"
                        Color="#F8FAFC" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralBorderBrush"
                        Color="#D7E0EA" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralAccentBrush"
                        Color="#475467" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralIconBackgroundBrush"
                        Color="#EAECF0" />

                </ResourceDictionary>

                <!--  System-managed high-contrast theme.  -->
                <ResourceDictionary
                    x:Key="HighContrast">

                    <!--  Shared text colours.  -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomePrimaryTextBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSecondaryTextBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <!--
                        In High Contrast, every tone uses system colours.
                        The explicit title and description retain the meaning.
                    -->
                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessBorderBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessAccentBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeSuccessIconBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningBorderBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningAccentBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeWarningIconBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationBorderBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationAccentBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeInformationIconBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorBorderBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorAccentBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeErrorIconBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralBorderBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralAccentBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush
                        x:Key="InspectionOutcomeNeutralIconBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!--  ======================================================  -->
            <!--  TYPOGRAPHY  -->
            <!--  ======================================================  -->

            <Style
                x:Key="InspectionOutcomeTitleStyle"
                TargetType="TextBlock">

                <Setter Property="FontSize" Value="15" />

                <Setter Property="FontWeight" Value="SemiBold" />

                <Setter Property="Foreground" Value="{ThemeResource InspectionOutcomePrimaryTextBrush}" />

                <Setter Property="TextWrapping" Value="WrapWholeWords" />

            </Style>

            <Style
                x:Key="InspectionOutcomeMessageStyle"
                TargetType="TextBlock">

                <Setter Property="FontSize" Value="12" />

                <Setter Property="Foreground" Value="{ThemeResource InspectionOutcomeSecondaryTextBrush}" />

                <Setter Property="TextWrapping" Value="WrapWholeWords" />

            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        ModelInspectionPage owns the spacing around this control.
        No external Margin is set here.
    -->
    <Grid
        x:Name="LayoutRoot"
        MaxWidth="840"
        HorizontalAlignment="Stretch"
        AutomationProperties.LiveSetting="Polite"
        AutomationProperties.Name="{x:Bind Presentation.AutomationName, Mode=OneWay}"
        Visibility="{x:Bind CardVisibility, Mode=OneWay}">
        <!--  Shared outcome-banner shell.  -->
        <Border
            x:Name="OutcomeCardBorder"
            MinHeight="82"
            Padding="26,16"
            HorizontalAlignment="Stretch"
            BorderThickness="1"
            CornerRadius="18">

            <Grid
                ColumnSpacing="17">

                <Grid.ColumnDefinitions>

                    <!--  Fixed status-icon area.  -->
                    <ColumnDefinition
                        Width="40" />

                    <!--  Flexible title and message.  -->
                    <ColumnDefinition
                        Width="*" />

                </Grid.ColumnDefinitions>

                <!--  Outcome icon.  -->
                <Border
                    x:Name="OutcomeIconContainer"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    BorderThickness="1"
                    CornerRadius="12">

                    <SymbolIcon
                        x:Name="OutcomeIcon"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Symbol="{x:Bind Presentation.IconSymbol, Mode=OneWay}" />

                </Border>

                <!--  Outcome title and short explanation.  -->
                <StackPanel
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Spacing="5">

                    <TextBlock
                        d:Text="Ready for hardware check"
                        MaxLines="2"
                        Style="{StaticResource InspectionOutcomeTitleStyle}"
                        Text="{x:Bind Presentation.Title, Mode=OneWay}" />

                    <TextBlock
                        d:Text="The package, tokenizer, model structure and selected runtime all passed inspection."
                        MaxLines="3"
                        Style="{StaticResource InspectionOutcomeMessageStyle}"
                        Text="{x:Bind Presentation.Message, Mode=OneWay}" />

                </StackPanel>

            </Grid>

        </Border>

        <!--
            Five visual tones cover all eight displayed outcomes:
            
            Success:
            Ready
            
            Warning:
            Ready with warnings
            Incomplete package
            
            Information:
            Conversion required
            
            Error:
            Unsupported
            Invalid
            Operational failure
            
            Neutral:
            Cancelled
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup
                x:Name="OutcomeToneStates">

                <VisualState
                    x:Name="SuccessTone">
                    <VisualState.Setters>

                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionOutcomeSuccessBackgroundBrush}" />

                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionOutcomeSuccessBorderBrush}" />

                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionOutcomeSuccessIconBackgroundBrush}" />

                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionOutcomeSuccessBorderBrush}" />

                        <Setter Target="OutcomeIcon.Foreground" Value="{ThemeResource InspectionOutcomeSuccessAccentBrush}" />

                    </VisualState.Setters>
                </VisualState>

                <VisualState
                    x:Name="WarningTone">
                    <VisualState.Setters>

                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionOutcomeWarningBackgroundBrush}" />

                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionOutcomeWarningBorderBrush}" />

                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionOutcomeWarningIconBackgroundBrush}" />

                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionOutcomeWarningBorderBrush}" />

                        <Setter Target="OutcomeIcon.Foreground" Value="{ThemeResource InspectionOutcomeWarningAccentBrush}" />

                    </VisualState.Setters>
                </VisualState>

                <VisualState
                    x:Name="InformationTone">
                    <VisualState.Setters>

                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionOutcomeInformationBackgroundBrush}" />

                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionOutcomeInformationBorderBrush}" />

                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionOutcomeInformationIconBackgroundBrush}" />

                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionOutcomeInformationBorderBrush}" />

                        <Setter Target="OutcomeIcon.Foreground" Value="{ThemeResource InspectionOutcomeInformationAccentBrush}" />

                    </VisualState.Setters>
                </VisualState>

                <VisualState
                    x:Name="ErrorTone">
                    <VisualState.Setters>

                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionOutcomeErrorBackgroundBrush}" />

                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionOutcomeErrorBorderBrush}" />

                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionOutcomeErrorIconBackgroundBrush}" />

                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionOutcomeErrorBorderBrush}" />

                        <Setter Target="OutcomeIcon.Foreground" Value="{ThemeResource InspectionOutcomeErrorAccentBrush}" />

                    </VisualState.Setters>
                </VisualState>

                <VisualState
                    x:Name="NeutralTone">
                    <VisualState.Setters>

                        <Setter Target="OutcomeCardBorder.Background" Value="{ThemeResource InspectionOutcomeNeutralBackgroundBrush}" />

                        <Setter Target="OutcomeCardBorder.BorderBrush" Value="{ThemeResource InspectionOutcomeNeutralBorderBrush}" />

                        <Setter Target="OutcomeIconContainer.Background" Value="{ThemeResource InspectionOutcomeNeutralIconBackgroundBrush}" />

                        <Setter Target="OutcomeIconContainer.BorderBrush" Value="{ThemeResource InspectionOutcomeNeutralBorderBrush}" />

                        <Setter Target="OutcomeIcon.Foreground" Value="{ThemeResource InspectionOutcomeNeutralAccentBrush}" />

                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</UserControl>
