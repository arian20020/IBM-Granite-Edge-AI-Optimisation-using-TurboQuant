<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionModelCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelInspection.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GraniteEdgeAI.Features.ModelInspection.Models"
    x:Name="Root"
    d:DesignHeight="470"
    d:DesignWidth="840"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="MetadataLabelStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionLabelFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource InspectionLabelFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionLabelFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextSecondaryMutedBrush}" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="MetadataValueStyle"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource InspectionStrongBodyFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource InspectionBodyFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionStrongBodyFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="InspectionCheckStatusStyle"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            <Setter Property="FontFamily" Value="{StaticResource InspectionLabelFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource InspectionLabelFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionLabelFontWeight}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <DataTemplate
            x:Key="InspectionCheckTemplate"
            x:DataType="models:InspectionCheckPresentation">
            <Border
                Tag="InspectionCheckRow"
                MinHeight="56"
                Padding="0,10"
                AutomationProperties.AccessibilityView="Raw"
                BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Column="0"
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw">
                        <Border
                            Tag="InspectionCheckStatusIcon"
                            Background="{ThemeResource InspectionSuccessSurfaceBrush}"
                            CornerRadius="11"
                            Visibility="{x:Bind local:InspectionModelCard.GetPassedVisibility(Status)}">
                            <SymbolIcon
                                Width="12"
                                Height="12"
                                Foreground="{ThemeResource InspectionSuccessTextBrush}"
                                Symbol="Accept" />
                        </Border>
                        <Border
                            Tag="InspectionCheckStatusIcon"
                            Background="{ThemeResource InspectionWarningSurfaceBrush}"
                            CornerRadius="11"
                            Visibility="{x:Bind local:InspectionModelCard.GetWarningVisibility(Status)}">
                            <SymbolIcon
                                Width="12"
                                Height="12"
                                Foreground="{ThemeResource InspectionWarningTextBrush}"
                                Symbol="Important" />
                        </Border>
                        <Border
                            Tag="InspectionCheckStatusIcon"
                            Background="{ThemeResource InspectionErrorSurfaceBrush}"
                            CornerRadius="11"
                            Visibility="{x:Bind local:InspectionModelCard.GetErrorVisibility(Status)}">
                            <SymbolIcon
                                Width="12"
                                Height="12"
                                Foreground="{ThemeResource InspectionErrorTextBrush}"
                                Symbol="Cancel" />
                        </Border>
                        <Border
                            Tag="InspectionCheckStatusIcon"
                            Background="{ThemeResource InspectionBlueSurfaceBrush}"
                            CornerRadius="11"
                            Visibility="{x:Bind local:InspectionModelCard.GetInformationVisibility(Status)}">
                            <SymbolIcon
                                Width="12"
                                Height="12"
                                Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                                Symbol="Help" />
                        </Border>
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock
                            Tag="InspectionCheckAutomationElement"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                            FontSize="{StaticResource InspectionBodyFontSize}"
                            FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                            Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="{StaticResource InspectionHelperFontFamily}"
                            FontSize="{StaticResource InspectionHelperFontSize}"
                            FontWeight="{StaticResource InspectionHelperFontWeight}"
                            Foreground="{ThemeResource InspectionTextMutedBrush}"
                            Text="{x:Bind Detail}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <TextBlock
                            Foreground="{ThemeResource InspectionSuccessTextBrush}"
                            Style="{StaticResource InspectionCheckStatusStyle}"
                            Text="{x:Bind StatusText}"
                            Visibility="{x:Bind local:InspectionModelCard.GetPassedVisibility(Status)}" />
                        <TextBlock
                            Foreground="{ThemeResource InspectionWarningTextBrush}"
                            Style="{StaticResource InspectionCheckStatusStyle}"
                            Text="{x:Bind StatusText}"
                            Visibility="{x:Bind local:InspectionModelCard.GetWarningVisibility(Status)}" />
                        <TextBlock
                            Foreground="{ThemeResource InspectionErrorTextBrush}"
                            Style="{StaticResource InspectionCheckStatusStyle}"
                            Text="{x:Bind StatusText}"
                            Visibility="{x:Bind local:InspectionModelCard.GetErrorVisibility(Status)}" />
                        <TextBlock
                            Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                            Style="{StaticResource InspectionCheckStatusStyle}"
                            Text="{x:Bind StatusText}"
                            Visibility="{x:Bind local:InspectionModelCard.GetInformationVisibility(Status)}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        MaxWidth="{StaticResource InspectionContentColumnWidth}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        SizeChanged="LayoutRoot_SizeChanged">

        <Border
            x:Name="CompactView"
            MinHeight="94"
            Padding="24,15"
            Background="{ThemeResource InspectionSurfaceBrush}"
            BorderBrush="{ThemeResource InspectionBorderMutedBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource InspectionCardCornerRadius}">
            <Grid
                x:Name="CompactGrid"
                ColumnSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="CompactFormatTile"
                    Grid.Row="0"
                    Grid.Column="0"
                    MinWidth="62"
                    MinHeight="62"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind FormatShortName}"
                    Background="{ThemeResource InspectionBlueSurfaceBrush}"
                    BorderBrush="{ThemeResource InspectionBlueBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource InspectionCardCornerRadius}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="GGUF"
                        FontFamily="{StaticResource InspectionLabelFontFamily}"
                        FontSize="{StaticResource InspectionLabelFontSize}"
                        FontWeight="{StaticResource InspectionLabelFontWeight}"
                        Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                        Text="{x:Bind FormatShortName}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
                <StackPanel
                    x:Name="CompactModelSummaryPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <TextBlock
                        d:Text="Selected model"
                        FontFamily="{StaticResource InspectionSectionTitleFontFamily}"
                        FontSize="{StaticResource InspectionSectionTitleFontSize}"
                        FontWeight="{StaticResource InspectionSectionTitleFontWeight}"
                        Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                        Text="{x:Bind ModelName}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        d:Text="GGUF · Not reported · 2.08 GB"
                        FontFamily="{StaticResource InspectionBodyFontFamily}"
                        FontSize="{StaticResource InspectionBodyFontSize}"
                        FontWeight="{StaticResource InspectionBodyFontWeight}"
                        Foreground="{ThemeResource InspectionTextSecondaryBrush}"
                        Text="{x:Bind CompactSummary}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border
                    x:Name="CompactStatusChip"
                    Grid.Row="0"
                    Grid.Column="2"
                    MinHeight="34"
                    MinWidth="120"
                    MaxWidth="184"
                    Padding="15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind GetBadgeAutomationName(BadgeState)}"
                    Background="{ThemeResource InspectionBlueSurfaceBrush}"
                    BorderBrush="{ThemeResource InspectionPrimaryBlueBrush}"
                    BorderThickness="1"
                    CornerRadius="17">
                    <Grid
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="CompactStatusMarker"
                            Grid.Column="0"
                            Width="9"
                            Height="9"
                            AutomationProperties.AccessibilityView="Raw"
                            Fill="{ThemeResource InspectionPrimaryBlueBrush}" />
                        <TextBlock
                            x:Name="CompactStatusText"
                            Grid.Column="1"
                            d:Text="MODEL SELECTED"
                            FontFamily="{StaticResource InspectionLabelFontFamily}"
                            FontSize="{StaticResource InspectionLabelFontSize}"
                            FontWeight="{StaticResource InspectionLabelFontWeight}"
                            Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                            Text="{x:Bind GetBadgeText(BadgeState)}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border
            x:Name="DetailedView"
            MinHeight="304"
            Background="{ThemeResource InspectionSurfaceBrush}"
            BorderBrush="{ThemeResource InspectionBorderMutedBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource InspectionCardCornerRadius}"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="DetailedHeader"
                    Grid.Row="0"
                    MinHeight="63"
                    Margin="31,0"
                    ColumnSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ModelOverviewTitle"
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource InspectionSectionTitleFontFamily}"
                        FontSize="{StaticResource InspectionSectionTitleFontSize}"
                        FontWeight="{StaticResource InspectionSectionTitleFontWeight}"
                        Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                        Text="Model overview"
                        TextWrapping="WrapWholeWords" />
                    <Border
                        x:Name="OverviewFormatChip"
                        Grid.Row="0"
                        Grid.Column="1"
                        MinHeight="30"
                        MinWidth="108"
                        MaxWidth="240"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource InspectionBlueSurfaceBrush}"
                        BorderBrush="{ThemeResource InspectionBlueBorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="15">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Text="GGUF MODEL"
                            FontFamily="{StaticResource InspectionLabelFontFamily}"
                            FontSize="{StaticResource InspectionLabelFontSize}"
                            FontWeight="{StaticResource InspectionLabelFontWeight}"
                            Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                            Text="{x:Bind OverviewFormatBadgeText}"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="MetadataGrid"
                    Grid.Row="1"
                    MinHeight="156"
                    Margin="31,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MetadataColumnOne" Width="*" />
                        <ColumnDefinition x:Name="MetadataColumnTwo" Width="*" />
                        <ColumnDefinition x:Name="MetadataColumnThree" Width="*" />
                        <ColumnDefinition x:Name="MetadataColumnFour" Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="ModelNameField"
                        Grid.Row="0"
                        Grid.Column="0"
                        MinHeight="78"
                        Padding="0,10,20,10"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="0,0,1,1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="MODEL NAME" />
                            <TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ModelName}" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="PublisherField"
                        Grid.Row="0"
                        Grid.Column="1"
                        MinHeight="78"
                        Padding="20,10"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="0,0,1,1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="PUBLISHER" />
                            <TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind Publisher}" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="FormatField"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinHeight="78"
                        Padding="20,10"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="0,0,1,1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="FORMAT" />
                            <TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind FormatName}" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="QuantisationField"
                        Grid.Row="0"
                        Grid.Column="3"
                        MinHeight="78"
                        Padding="20,10,0,10"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="0,0,0,1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="QUANTISATION" />
                            <TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind Quantisation}" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="ParametersField"
                        Grid.Row="1"
                        Grid.Column="0"
                        MinHeight="78"
                        Padding="0,10,20,10"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="0,0,1,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="PARAMETERS" />
                            <TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ParameterCount}" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="ModelTypeField"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinHeight="78"
                        Padding="20,10"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="0,0,1,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="MODEL TYPE" />
                            <TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ModelType}" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="DeclaredContextField"
                        Grid.Row="1"
                        Grid.Column="2"
                        MinHeight="78"
                        Padding="20,10"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="0,0,1,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="DECLARED MAX CONTEXT" />
                            <TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind DeclaredContext}" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="FileSizeField"
                        Grid.Row="1"
                        Grid.Column="3"
                        MinHeight="78"
                        Padding="20,10,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetadataLabelStyle}" Text="FILE SIZE" />
                            <TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind FileSize}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <local:InspectionDisclosure
                    x:Name="InspectionDetailsDisclosure"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind GetInspectionDetailsAutomationName(Presentation.IsInspectionDetailsExpanded), Mode=OneWay}"
                    HeaderMinHeight="58"
                    Visibility="{x:Bind InspectionDetailsVisibility}">
                    <local:InspectionDisclosure.HeaderContent>
                        <Grid
                            x:Name="InspectionDetailsHeader"
                            MinHeight="58"
                            Padding="24,0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{ThemeResource InspectionSuccessSurfaceBrush}"
                                CornerRadius="11">
                                <SymbolIcon
                                    Width="12"
                                    Height="12"
                                    Foreground="{ThemeResource InspectionSuccessTextBrush}"
                                    Symbol="Accept" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                                FontSize="{StaticResource InspectionBodyFontSize}"
                                FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                                Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                                Text="{x:Bind InspectionChecksSummary}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="InspectionDetailsActionText"
                                Grid.Column="2"
                                Margin="12,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                                FontSize="{StaticResource InspectionBodyFontSize}"
                                FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                                Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                                Text="{x:Bind GetInspectionDetailsActionText(Presentation.IsInspectionDetailsExpanded), Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </local:InspectionDisclosure.HeaderContent>

                    <local:InspectionDisclosure.ViewportContent>
                        <Border
                            x:Name="InspectionDetailsViewport"
                            Height="172"
                            Margin="23,-5,23,19"
                            Padding="18,8,10,12"
                            Background="{ThemeResource InspectionSurfaceSubtleBrush}"
                            BorderBrush="{ThemeResource InspectionBorderMutedBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource InspectionCardCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    x:Name="InspectionChecksScrollViewer"
                                    Grid.Row="0"
                                    MaxHeight="172"
                                    AutomationProperties.HelpText="Use the arrow and Page Up or Page Down keys to review all five inspection checks."
                                    AutomationProperties.Name="{x:Bind InspectionChecksSummary}"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="True"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Enabled"
                                    ZoomMode="Disabled">
                                    <ItemsControl
                                        x:Name="InspectionChecksItemsControl"
                                        ItemTemplate="{StaticResource InspectionCheckTemplate}"
                                        ItemsSource="{x:Bind InspectionChecks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid
                                    x:Name="InspectionChecksBottomFade"
                                    Grid.Row="0"
                                    Height="24"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AccessibilityView="Raw"
                                    IsHitTestVisible="False">
                                    <Border Height="8" VerticalAlignment="Top" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.25" />
                                    <Border Height="8" VerticalAlignment="Center" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.55" />
                                    <Border Height="8" VerticalAlignment="Bottom" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.85" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,7,8,0"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource InspectionLabelFontFamily}"
                                    FontSize="{StaticResource InspectionLabelFontSize}"
                                    FontWeight="{StaticResource InspectionLabelFontWeight}"
                                    Foreground="{ThemeResource InspectionTextMutedBrush}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Text="Scroll for more" />
                            </Grid>
                        </Border>
                    </local:InspectionDisclosure.ViewportContent>
                </local:InspectionDisclosure>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DisplayModeStates">
                <VisualState x:Name="CompactState">
                    <VisualState.Setters>
                        <Setter Target="CompactView.Visibility" Value="Visible" />
                        <Setter Target="DetailedView.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailedState">
                    <VisualState.Setters>
                        <Setter Target="CompactView.Visibility" Value="Collapsed" />
                        <Setter Target="DetailedView.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="BadgeToneStates">
                <VisualState x:Name="InformationBadgeState">
                    <VisualState.Setters>
                        <Setter Target="CompactStatusChip.Background" Value="{ThemeResource InspectionBlueSurfaceBrush}" />
                        <Setter Target="CompactStatusChip.BorderBrush" Value="{ThemeResource InspectionPrimaryBlueBrush}" />
                        <Setter Target="CompactStatusMarker.Fill" Value="{ThemeResource InspectionPrimaryBlueBrush}" />
                        <Setter Target="CompactStatusText.Foreground" Value="{ThemeResource InspectionPrimaryBlueBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InspectedBadgeState">
                    <VisualState.Setters>
                        <Setter Target="CompactStatusChip.Background" Value="{ThemeResource InspectionSuccessSurfaceBrush}" />
                        <Setter Target="CompactStatusChip.BorderBrush" Value="{ThemeResource InspectionSuccessTextBrush}" />
                        <Setter Target="CompactStatusMarker.Fill" Value="{ThemeResource InspectionSuccessTextBrush}" />
                        <Setter Target="CompactStatusText.Foreground" Value="{ThemeResource InspectionSuccessTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WarningBadgeState">
                    <VisualState.Setters>
                        <Setter Target="CompactStatusChip.Background" Value="{ThemeResource InspectionWarningSurfaceBrush}" />
                        <Setter Target="CompactStatusChip.BorderBrush" Value="{ThemeResource InspectionWarningTextBrush}" />
                        <Setter Target="CompactStatusMarker.Fill" Value="{ThemeResource InspectionWarningTextBrush}" />
                        <Setter Target="CompactStatusText.Foreground" Value="{ThemeResource InspectionWarningTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ErrorBadgeState">
                    <VisualState.Setters>
                        <Setter Target="CompactStatusChip.Background" Value="{ThemeResource InspectionErrorSurfaceBrush}" />
                        <Setter Target="CompactStatusChip.BorderBrush" Value="{ThemeResource InspectionErrorTextBrush}" />
                        <Setter Target="CompactStatusMarker.Fill" Value="{ThemeResource InspectionErrorTextBrush}" />
                        <Setter Target="CompactStatusText.Foreground" Value="{ThemeResource InspectionErrorTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NeutralBadgeState">
                    <VisualState.Setters>
                        <Setter Target="CompactStatusChip.Background" Value="{ThemeResource InspectionSurfaceMutedBrush}" />
                        <Setter Target="CompactStatusChip.BorderBrush" Value="{ThemeResource InspectionTextSecondaryMutedBrush}" />
                        <Setter Target="CompactStatusMarker.Fill" Value="{ThemeResource InspectionTextSecondaryMutedBrush}" />
                        <Setter Target="CompactStatusText.Foreground" Value="{ThemeResource InspectionTextSecondaryMutedBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="InspectionDetailsStates">
                <VisualState x:Name="CollapsedDetailsState">
                    <VisualState.Setters>
                        <Setter Target="InspectionDetailsDisclosure.MinHeight" Value="83" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ExpandedDetailsState">
                    <VisualState.Setters>
                        <Setter Target="DetailedView.MinHeight" Value="470" />
                        <Setter Target="InspectionDetailsDisclosure.MinHeight" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="ResponsiveModelStates">
                <VisualState x:Name="WideModelState">
                    <VisualState.Setters>
                        <Setter Target="MetadataColumnOne.Width" Value="*" />
                        <Setter Target="MetadataColumnTwo.Width" Value="*" />
                        <Setter Target="MetadataColumnThree.Width" Value="*" />
                        <Setter Target="MetadataColumnFour.Width" Value="*" />
                        <Setter Target="DetailedHeader.Margin" Value="31,0" />
                        <Setter Target="MetadataGrid.Margin" Value="31,0" />
