<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionModelCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelInspection.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GraniteEdgeAI.Features.ModelInspection.Models"
    x:Name="Root"
    AutomationProperties.AutomationControlType="Group"
    d:DesignHeight="470"
    d:DesignWidth="840"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="MetadataLabelStyle"
            TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionLabelFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionLabelFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionLabelFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextSecondaryMutedBrush}" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style
            x:Key="MetadataValueStyle"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource InspectionStrongBodyFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionBodyFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionStrongBodyFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="InspectionCheckStatusStyle"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            <Setter Property="FontFamily" Value="{StaticResource InspectionLabelFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionLabelFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionLabelFontWeight}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <DataTemplate
            x:Key="InspectionCheckTemplate"
            x:DataType="models:InspectionCheckPresentation">
            <Border
                Tag="InspectionCheckRow"
                MinHeight="56"
                Padding="0,10"
                AutomationProperties.AccessibilityView="Raw"
                BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <local:InspectionStatusGlyph
                            Kind="{x:Bind local:InspectionModelCard.GetStatusGlyphKind(Status)}"
                            SurfaceSize="22" />
                    </Viewbox>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock
                            Tag="InspectionCheckAutomationElement"
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                            FontSize="{ThemeResource InspectionBodyFontSize}"
                            FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                            Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="{StaticResource InspectionHelperFontFamily}"
                            FontSize="{ThemeResource InspectionHelperFontSize}"
                            FontWeight="{StaticResource InspectionHelperFontWeight}"
                            Foreground="{ThemeResource InspectionTextMutedBrush}"
                            Text="{x:Bind Detail}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <TextBlock
                            Foreground="{ThemeResource InspectionSuccessTextBrush}"
                            Style="{StaticResource InspectionCheckStatusStyle}"
                            Text="{x:Bind StatusText}"
                            Visibility="{x:Bind local:InspectionModelCard.GetPassedVisibility(Status)}" />
                        <TextBlock
                            Foreground="{ThemeResource InspectionWarningTextBrush}"
                            Style="{StaticResource InspectionCheckStatusStyle}"
                            Text="{x:Bind StatusText}"
                            Visibility="{x:Bind local:InspectionModelCard.GetWarningVisibility(Status)}" />
                        <TextBlock
                            Foreground="{ThemeResource InspectionErrorTextBrush}"
                            Style="{StaticResource InspectionCheckStatusStyle}"
                            Text="{x:Bind StatusText}"
                            Visibility="{x:Bind local:InspectionModelCard.GetErrorVisibility(Status)}" />
                        <TextBlock
                            Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                            Style="{StaticResource InspectionCheckStatusStyle}"
                            Text="{x:Bind StatusText}"
                            Visibility="{x:Bind local:InspectionModelCard.GetInformationVisibility(Status)}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        MaxWidth="{StaticResource InspectionContentColumnWidth}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="CompactView"
            Grid.Row="0"
            Padding="{StaticResource InspectionCardPadding}"
            Background="{ThemeResource InspectionSurfaceBrush}"
            BorderBrush="{ThemeResource InspectionBorderMutedBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource InspectionCardCornerRadius}">
            <Grid
                x:Name="CompactGrid"
                ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="CompactFormatTile"
                    Grid.Row="0"
                    Grid.Column="0"
                    MinWidth="62"
                    MinHeight="62"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind FormatShortName}"
                    Background="{ThemeResource InspectionBlueSurfaceBrush}"
                    BorderBrush="{ThemeResource InspectionBlueBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource InspectionCardCornerRadius}"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="GGUF"
                        FontFamily="{StaticResource InspectionLabelFontFamily}"
                        FontSize="{ThemeResource InspectionLabelFontSize}"
                        FontWeight="{StaticResource InspectionLabelFontWeight}"
                        Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                        Text="{x:Bind FormatShortName}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
                <StackPanel
                    x:Name="CompactModelSummaryPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <TextBlock
                        x:Name="CompactModelName"
                        d:Text="Selected model"
                        FontFamily="{StaticResource InspectionSectionTitleFontFamily}"
                        FontSize="{ThemeResource InspectionSectionTitleFontSize}"
                        FontWeight="{StaticResource InspectionSectionTitleFontWeight}"
                        Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                        Text="{x:Bind ModelName}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        d:Text="GGUF · Not reported · 2.08 GB"
                        FontFamily="{StaticResource InspectionBodyFontFamily}"
                        FontSize="{ThemeResource InspectionBodyFontSize}"
                        FontWeight="{StaticResource InspectionBodyFontWeight}"
                        Foreground="{ThemeResource InspectionTextSecondaryBrush}"
                        Text="{x:Bind CompactSummary}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border
                    x:Name="CompactStatusChip"
                    Grid.Row="0"
                    Grid.Column="2"
                    MinHeight="34"
                    MinWidth="120"
                    MaxWidth="184"
                    Padding="15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind GetBadgeAutomationName(BadgeState)}"
                    Background="{ThemeResource InspectionBlueSurfaceBrush}"
                    BorderBrush="{ThemeResource InspectionPrimaryBlueBrush}"
                    BorderThickness="1"
                    CornerRadius="17">
                    <Grid
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="CompactStatusMarker"
                            Grid.Column="0"
                            Width="9"
                            Height="9"
                            AutomationProperties.AccessibilityView="Raw"
                            Fill="{ThemeResource InspectionPrimaryBlueBrush}" />
                        <TextBlock
                            x:Name="CompactStatusText"
                            Grid.Column="1"
                            d:Text="MODEL SELECTED"
                            FontFamily="{StaticResource InspectionLabelFontFamily}"
                            FontSize="{ThemeResource InspectionLabelFontSize}"
                            FontWeight="{StaticResource InspectionLabelFontWeight}"
                            Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                            Text="{x:Bind GetBadgeText(BadgeState)}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border
            x:Name="DetailedView"
            Grid.Row="0"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="{StaticResource InspectionCardCornerRadius}"
            Visibility="Collapsed">
            <Grid
                x:Name="MetadataGrid"
                Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MetadataColumnOne" Width="4*" />
                    <ColumnDefinition x:Name="MetadataColumnTwo" Width="4*" />
                    <ColumnDefinition x:Name="MetadataColumnThree" Width="2.5*" />
                    <ColumnDefinition x:Name="MetadataColumnFour" Width="2.5*" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="BalancedOverviewGrid"
                    Grid.ColumnSpan="4"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BalancedOverviewPrimaryColumn" Width="1.6*" />
                        <ColumnDefinition x:Name="BalancedOverviewSupportColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="ModelOverviewPanel"
                        Grid.Row="0"
                        Grid.Column="0">
                        <Border x:Name="ModelOverviewSurface" Background="{ThemeResource InspectionSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderMutedBrush}" BorderThickness="1" CornerRadius="{StaticResource InspectionCardCornerRadius}" IsHitTestVisible="False" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="DetailedHeader" MinHeight="70" Margin="18,14,18,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="DetailedHeaderLeadingColumn" Width="0" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="DetailedHeaderTrailingColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="ModelOverviewTitleHost" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock x:Name="ModelOverviewTitle" HorizontalAlignment="Left" FontFamily="{StaticResource InspectionSectionTitleFontFamily}" FontSize="{ThemeResource InspectionSectionTitleFontSize}" FontWeight="{StaticResource InspectionSectionTitleFontWeight}" Foreground="{ThemeResource InspectionTextPrimaryBrush}" Text="Model overview" TextAlignment="Left" TextWrapping="WrapWholeWords" />
                                        <TextBlock x:Name="ModelOverviewCopy" Margin="0,5,0,0" FontFamily="{StaticResource InspectionBodyFontFamily}" FontSize="{ThemeResource InspectionBodyFontSize}" FontWeight="{StaticResource InspectionBodyFontWeight}" Foreground="{ThemeResource InspectionTextSecondaryBrush}" Text="The selected model information used by this inspection." TextAlignment="Left" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="OverviewFormatChip" Grid.Column="2" MinHeight="30" MinWidth="108" MaxWidth="240" Padding="16,0" VerticalAlignment="Center" SizeChanged="OverviewFormatChip_SizeChanged" Background="{ThemeResource InspectionBlueSurfaceBrush}" BorderBrush="{ThemeResource InspectionBlueBorderStrongBrush}" BorderThickness="1" CornerRadius="15" Visibility="Collapsed">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" d:Text="GGUF MODEL" FontFamily="{StaticResource InspectionLabelFontFamily}" FontSize="{ThemeResource InspectionLabelFontSize}" FontWeight="{StaticResource InspectionLabelFontWeight}" Foreground="{ThemeResource InspectionPrimaryBlueBrush}" Text="{x:Bind OverviewFormatBadgeText}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                            <Grid x:Name="ModelFactGrid" Grid.Row="1" Margin="18,0,18,18" ColumnSpacing="10" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ModelFactColumnOne" Width="*" />
                                    <ColumnDefinition x:Name="ModelFactColumnTwo" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ModelNameField" Grid.Row="0" Grid.Column="0" MinHeight="61" Padding="11,10" Background="{ThemeResource InspectionSurfaceSubtleBrush}" BorderBrush="{ThemeResource InspectionBorderLightBrush}" BorderThickness="1" CornerRadius="9"><StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource MetadataLabelStyle}" Text="MODEL NAME" /><TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ModelName}" /></StackPanel></Border>
                                <Border x:Name="PublisherField" Grid.Row="0" Grid.Column="1" MinHeight="61" Padding="11,10" Background="{ThemeResource InspectionSurfaceSubtleBrush}" BorderBrush="{ThemeResource InspectionBorderLightBrush}" BorderThickness="1" CornerRadius="9"><StackPanel VerticalAlignment="Center"><TextBlock AutomationProperties.Name="Publisher" Style="{StaticResource MetadataLabelStyle}" Text="PUBLISHER" /><TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind Publisher}" /></StackPanel></Border>
                                <Border x:Name="ParametersField" Grid.Row="1" Grid.Column="0" MinHeight="61" Padding="11,10" Background="{ThemeResource InspectionSurfaceSubtleBrush}" BorderBrush="{ThemeResource InspectionBorderLightBrush}" BorderThickness="1" CornerRadius="9"><StackPanel VerticalAlignment="Center"><TextBlock AutomationProperties.Name="Parameters" Style="{StaticResource MetadataLabelStyle}" Text="PARAMETERS" /><TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ParameterCount}" /></StackPanel></Border>
                                <Border x:Name="ModelTypeField" Grid.Row="1" Grid.Column="1" MinHeight="61" Padding="11,10" Background="{ThemeResource InspectionSurfaceSubtleBrush}" BorderBrush="{ThemeResource InspectionBorderLightBrush}" BorderThickness="1" CornerRadius="9"><StackPanel VerticalAlignment="Center"><TextBlock AutomationProperties.Name="Model type" Style="{StaticResource MetadataLabelStyle}" Text="MODEL TYPE" /><TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind ModelType}" /></StackPanel></Border>
                                <Border x:Name="DeclaredContextField" Grid.Row="2" Grid.Column="0" MinHeight="61" Padding="11,10" Background="{ThemeResource InspectionSurfaceSubtleBrush}" BorderBrush="{ThemeResource InspectionBorderLightBrush}" BorderThickness="1" CornerRadius="9"><StackPanel VerticalAlignment="Center"><TextBlock AutomationProperties.Name="Context" Style="{StaticResource MetadataLabelStyle}" Text="DECLARED MAX CONTEXT" /><TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind DeclaredContext}" /></StackPanel></Border>
                                <Border x:Name="FileSizeField" Grid.Row="2" Grid.Column="1" MinHeight="61" Padding="11,10" Background="{ThemeResource InspectionSurfaceSubtleBrush}" BorderBrush="{ThemeResource InspectionBorderLightBrush}" BorderThickness="1" CornerRadius="9"><StackPanel VerticalAlignment="Center"><TextBlock AutomationProperties.Name="File size" Style="{StaticResource MetadataLabelStyle}" Text="FILE SIZE" /><TextBlock Style="{StaticResource MetadataValueStyle}" Text="{x:Bind FileSize}" /></StackPanel></Border>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ModelSupportStack" Grid.Row="0" Grid.Column="1" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:Name="ModelConfigurationPanel" Grid.Row="0">
                            <Border x:Name="ModelConfigurationSurface" Background="{ThemeResource InspectionSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderMutedBrush}" BorderThickness="1" CornerRadius="{StaticResource InspectionCardCornerRadius}" IsHitTestVisible="False" />
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock x:Name="ModelConfigurationHeading" Margin="18,14,18,12" FontFamily="{StaticResource InspectionSectionTitleFontFamily}" FontSize="{ThemeResource InspectionSectionTitleFontSize}" FontWeight="{StaticResource InspectionSectionTitleFontWeight}" Foreground="{ThemeResource InspectionTextPrimaryBrush}" Text="Model configuration" TextAlignment="Left" TextWrapping="WrapWholeWords" />
                                <Border x:Name="FormatField" Grid.Row="1" MinHeight="61" Margin="18,0" Padding="0,10" BorderBrush="{ThemeResource InspectionBorderLightBrush}" BorderThickness="0,1,0,0"><Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock AutomationProperties.Name="Format" Style="{StaticResource MetadataLabelStyle}" Text="FORMAT" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MetadataValueStyle}" Text="{x:Bind FormatName}" TextAlignment="Right" /></Grid></Border>
                                <Border x:Name="QuantisationField" Grid.Row="2" MinHeight="61" Margin="18,0,18,12" Padding="0,10" BorderBrush="{ThemeResource InspectionBorderLightBrush}" BorderThickness="0,1,0,0"><Grid ColumnSpacing="12" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock AutomationProperties.Name="Quantisation" Style="{StaticResource MetadataLabelStyle}" Text="QUANTISATION" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MetadataValueStyle}" Text="{x:Bind Quantisation}" TextAlignment="Right" /></Grid></Border>
                            </Grid>
                        </Grid>
                        <Grid x:Name="ModelResultSummaryPanel" Grid.Row="1">
                            <Border x:Name="ModelResultSummarySurface" Background="{ThemeResource InspectionSurfaceBrush}" BorderBrush="{ThemeResource InspectionBorderMutedBrush}" BorderThickness="1" CornerRadius="{StaticResource InspectionCardCornerRadius}" IsHitTestVisible="False" />
                            <Grid x:Name="ReadyResultContentGrid" MinHeight="61" Padding="18,11" ColumnSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ReadyResultSummaryColumn" Width="*" /><ColumnDefinition x:Name="ReadyResultBadgeColumn" Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReadyResultSummary" VerticalAlignment="Center" FontFamily="{StaticResource InspectionStrongBodyFontFamily}" FontSize="{ThemeResource InspectionBodyFontSize}" FontWeight="{StaticResource InspectionStrongBodyFontWeight}" Foreground="{ThemeResource InspectionTextPrimaryBrush}" Text="{x:Bind InspectionChecksSummary}" TextAlignment="Left" TextWrapping="WrapWholeWords" />
                                <Border x:Name="ReadyResultBadgeSurface" Grid.Column="1" MinHeight="26" Padding="8,4" VerticalAlignment="Center" Background="{ThemeResource InspectionSuccessSurfaceBrush}" BorderBrush="{ThemeResource InspectionSuccessBorderBrush}" BorderThickness="1" CornerRadius="13"><TextBlock x:Name="ReadyResultBadgeText" VerticalAlignment="Center" FontFamily="{StaticResource InspectionLabelFontFamily}" FontSize="{ThemeResource InspectionLabelFontSize}" FontWeight="{StaticResource InspectionLabelFontWeight}" Foreground="{ThemeResource InspectionSuccessTextBrush}" Text="{x:Bind GetBadgeText(BadgeState), Mode=OneWay}" TextWrapping="WrapWholeWords" /></Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <local:InspectionDisclosure
            x:Name="InspectionDetailsDisclosure"
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="{x:Bind GetInspectionDetailsAutomationName(Presentation.IsInspectionDetailsExpanded), Mode=OneWay}"
            HeaderMinHeight="68"
            Visibility="{x:Bind InspectionDetailsVisibility}">
                    <local:InspectionDisclosure.HeaderContent>
                        <Grid
                            x:Name="InspectionDetailsHeader"
                            MinHeight="68"
                            Padding="24,0"
                            ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <local:InspectionStatusGlyph
                                    Kind="Success"
                                    SurfaceSize="22" />
                            </Viewbox>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                                FontSize="{ThemeResource InspectionBodyFontSize}"
                                FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                                Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                                Text="{x:Bind InspectionChecksSummary}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="InspectionDetailsActionText"
                                Grid.Column="2"
                                Margin="12,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                                FontSize="{ThemeResource InspectionBodyFontSize}"
                                FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                                Foreground="{ThemeResource InspectionTextPrimaryBrush}"
                                Text="{x:Bind GetInspectionDetailsActionText(Presentation.IsInspectionDetailsExpanded), Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </local:InspectionDisclosure.HeaderContent>

                    <local:InspectionDisclosure.ViewportContent>
                        <Border
                            x:Name="InspectionDetailsViewport"
                            Height="172"
                            Margin="24,0,24,24"
                            Padding="18,8,10,12"
                            Background="{ThemeResource InspectionSurfaceSubtleBrush}"
                            BorderBrush="{ThemeResource InspectionBorderMutedBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource InspectionCardCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    x:Name="InspectionChecksScrollViewer"
                                    Grid.Row="0"
                                    MaxHeight="172"
                                    AutomationProperties.HelpText="Use the arrow and Page Up or Page Down keys to review all five inspection checks."
                                    AutomationProperties.Name="{x:Bind InspectionChecksSummary}"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="True"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Enabled"
                                    ZoomMode="Disabled">
                                    <ItemsControl
                                        x:Name="InspectionChecksItemsControl"
                                        IsTabStop="False"
                                        ItemTemplate="{StaticResource InspectionCheckTemplate}"
                                        ItemsSource="{x:Bind InspectionChecks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid
                                    x:Name="InspectionChecksBottomFade"
                                    Grid.Row="0"
                                    Height="24"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AccessibilityView="Raw"
                                    IsHitTestVisible="False">
                                    <Border Height="8" VerticalAlignment="Top" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.25" />
                                    <Border Height="8" VerticalAlignment="Center" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.55" />
                                    <Border Height="8" VerticalAlignment="Bottom" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.85" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,7,8,0"
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource InspectionLabelFontFamily}"
                                    FontSize="{ThemeResource InspectionLabelFontSize}"
                                    FontWeight="{StaticResource InspectionLabelFontWeight}"
                                    Foreground="{ThemeResource InspectionTextMutedBrush}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Text="Scroll for more" />
                            </Grid>
                        </Border>
                    </local:InspectionDisclosure.ViewportContent>
        </local:InspectionDisclosure>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DisplayModeStates">
                <VisualState x:Name="CompactState">
                    <VisualState.Setters>
                        <Setter Target="CompactView.Visibility" Value="Visible" />
                        <Setter Target="DetailedView.Visibility" Value="Collapsed" />
                        <Setter Target="InspectionDetailsDisclosure.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DetailedState">
                    <VisualState.Setters>
                        <Setter Target="CompactView.Visibility" Value="Collapsed" />
                        <Setter Target="DetailedView.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="BadgeToneStates">
                <VisualState x:Name="InformationBadgeState">
                    <VisualState.Setters>
                        <Setter Target="CompactStatusChip.Background" Value="{ThemeResource InspectionBlueSurfaceBrush}" />
                        <Setter Target="CompactStatusChip.BorderBrush" Value="{ThemeResource InspectionPrimaryBlueBrush}" />
                        <Setter Target="CompactStatusMarker.Fill" Value="{ThemeResource InspectionPrimaryBlueBrush}" />
                        <Setter Target="CompactStatusText.Foreground" Value="{ThemeResource InspectionPrimaryBlueBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InspectedBadgeState">
                    <VisualState.Setters>
                        <Setter Target="CompactStatusChip.Background" Value="{ThemeResource InspectionSuccessSurfaceBrush}" />
                        <Setter Target="CompactStatusChip.BorderBrush" Value="{ThemeResource InspectionSuccessTextBrush}" />
                        <Setter Target="CompactStatusMarker.Fill" Value="{ThemeResource InspectionSuccessTextBrush}" />
                        <Setter Target="CompactStatusText.Foreground" Value="{ThemeResource InspectionSuccessTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WarningBadgeState">
                    <VisualState.Setters>
                        <Setter Target="CompactStatusChip.Background" Value="{ThemeResource InspectionWarningSurfaceBrush}" />
