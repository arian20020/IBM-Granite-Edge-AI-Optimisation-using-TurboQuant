<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionDisclosure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    IsTabStop="True"
    KeyDown="Root_KeyDown"
    UseSystemFocusVisuals="True"
    mc:Ignorable="d">

    <Border
        x:Name="DisclosureCardSurface"
        Background="{ThemeResource InspectionSurfaceBrush}"
        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource InspectionCardCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Button
            x:Name="DisclosureToggleButton"
            MinHeight="{x:Bind HeaderMinHeight, Mode=OneWay}"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.AccessibilityView="Raw"
            Background="Transparent"
            BorderThickness="0"
            Click="DisclosureToggleButton_Click"
            CornerRadius="0"
            IsTabStop="False"
            UseSystemFocusVisuals="True">
            <Grid
                x:Name="DisclosureHeaderShell"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    x:Name="DisclosureHeaderContentPresenter"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="{x:Bind HeaderContent, Mode=OneWay}" />
                <Grid
                    x:Name="DisclosureHeaderActionHost"
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw">
                    <Grid
                        x:Name="DisclosureChevron"
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource InspectionTextSecondaryStrongBrush}"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Grid>
            </Grid>
        </Button>

        <Border
            x:Name="DisclosureViewportHost"
            Grid.Row="1"
            AutomationProperties.AccessibilityView="Raw"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    x:Name="DisclosureDivider"
                    Height="1"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{ThemeResource InspectionBorderLightBrush}" />
                <Border
                    x:Name="DisclosureViewport"
                    Grid.Row="1"
                    Opacity="0"
                    Visibility="Collapsed">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="{x:Bind ViewportContent, Mode=OneWay}" />
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Border>
</UserControl>
