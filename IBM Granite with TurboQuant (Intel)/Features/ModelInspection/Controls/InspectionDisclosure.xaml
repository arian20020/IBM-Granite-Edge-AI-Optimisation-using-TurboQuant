<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionDisclosure"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    IsTabStop="True"
    KeyDown="Root_KeyDown"
    UseSystemFocusVisuals="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            x:Name="DisclosureToggleButton"
            MinHeight="{x:Bind HeaderMinHeight, Mode=OneWay}"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.AccessibilityView="Raw"
            Background="Transparent"
            BorderBrush="{ThemeResource InspectionBorderLightBrush}"
            BorderThickness="0,1,0,0"
            Click="DisclosureToggleButton_Click"
            IsTabStop="False"
            UseSystemFocusVisuals="True">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="{x:Bind HeaderContent, Mode=OneWay}" />
                <Grid
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw">
                    <FontIcon
                        x:Name="DisclosureChevron"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource InspectionTextSecondaryStrongBrush}"
                        Glyph="&#xE70D;">
                        <FontIcon.RenderTransform>
                            <RotateTransform x:Name="DisclosureChevronRotation" CenterX="6" CenterY="6" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Grid>
            </Grid>
        </Button>

        <Border
            x:Name="DisclosureViewport"
            Grid.Row="1"
            Opacity="0"
            Visibility="Collapsed">
            <ContentPresenter
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Content="{x:Bind ViewportContent, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>
