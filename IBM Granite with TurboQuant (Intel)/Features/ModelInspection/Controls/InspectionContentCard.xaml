<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionContentCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelInspection.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GraniteEdgeAI.Features.ModelInspection.Models"
    x:Name="Root"
    d:DesignHeight="430"
    d:DesignWidth="840"
    mc:Ignorable="d">

    <!--
        Displays inspection progress or inspection findings.
        
        It does not own:
        - The page-level outcome banner
        - Model identity and model metadata
        - Primary navigation and recovery buttons
        - The onboarding stage indicator
    -->

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  ======================================================  -->
            <!--  THEME-AWARE COLOURS  -->
            <!--  ======================================================  -->

            <ResourceDictionary.ThemeDictionaries>

                <!--  Dark theme.  -->
                <ResourceDictionary
                    x:Key="Default">
                    <SolidColorBrush
                        x:Key="InspectionCardBackgroundBrush"
                        Color="#1F1F1F" />
                    <SolidColorBrush
                        x:Key="InspectionSubtleBackgroundBrush"
                        Color="#25282D" />
                    <SolidColorBrush
                        x:Key="InspectionCardBorderBrush"
                        Color="#424852" />
                    <SolidColorBrush
                        x:Key="InspectionDividerBrush"
                        Color="#363C45" />
                    <SolidColorBrush
                        x:Key="InspectionPrimaryTextBrush"
                        Color="#F7F8FA" />
                    <SolidColorBrush
                        x:Key="InspectionSecondaryTextBrush"
                        Color="#D0D5DD" />
                    <SolidColorBrush
                        x:Key="InspectionMutedTextBrush"
                        Color="#AAB2BF" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBrush"
                        Color="#78A9FF" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBackgroundBrush"
                        Color="#172A46" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBorderBrush"
                        Color="#355C91" />
                    <SolidColorBrush
                        x:Key="InspectionSuccessBrush"
                        Color="#42BEA7" />
                    <SolidColorBrush
                        x:Key="InspectionSuccessBackgroundBrush"
                        Color="#153A33" />
                    <SolidColorBrush
                        x:Key="InspectionWarningBrush"
                        Color="#F1C21B" />
                    <SolidColorBrush
                        x:Key="InspectionWarningBackgroundBrush"
                        Color="#44370A" />
                    <SolidColorBrush
                        x:Key="InspectionErrorBrush"
                        Color="#FA4D56" />
                    <SolidColorBrush
                        x:Key="InspectionErrorBackgroundBrush"
                        Color="#4A1E22" />
                    <SolidColorBrush
                        x:Key="InspectionNeutralBrush"
                        Color="#AAB2BF" />
                    <SolidColorBrush
                        x:Key="InspectionNeutralBackgroundBrush"
                        Color="#30343A" />
                </ResourceDictionary>

                <!--  Light theme matching the approved prototype.  -->
                <ResourceDictionary
                    x:Key="Light">
                    <SolidColorBrush
                        x:Key="InspectionCardBackgroundBrush"
                        Color="#FFFFFF" />
                    <SolidColorBrush
                        x:Key="InspectionSubtleBackgroundBrush"
                        Color="#F8FAFC" />
                    <SolidColorBrush
                        x:Key="InspectionCardBorderBrush"
                        Color="#D7E0EA" />
                    <SolidColorBrush
                        x:Key="InspectionDividerBrush"
                        Color="#E8EDF3" />
                    <SolidColorBrush
                        x:Key="InspectionPrimaryTextBrush"
                        Color="#101828" />
                    <SolidColorBrush
                        x:Key="InspectionSecondaryTextBrush"
                        Color="#475467" />
                    <SolidColorBrush
                        x:Key="InspectionMutedTextBrush"
                        Color="#667085" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBrush"
                        Color="#0F62FE" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBackgroundBrush"
                        Color="#EEF5FF" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBorderBrush"
                        Color="#C6D7F2" />
                    <SolidColorBrush
                        x:Key="InspectionSuccessBrush"
                        Color="#067A57" />
                    <SolidColorBrush
                        x:Key="InspectionSuccessBackgroundBrush"
                        Color="#E9F7F1" />
                    <SolidColorBrush
                        x:Key="InspectionWarningBrush"
                        Color="#9A6700" />
                    <SolidColorBrush
                        x:Key="InspectionWarningBackgroundBrush"
                        Color="#FFF6E0" />
                    <SolidColorBrush
                        x:Key="InspectionErrorBrush"
                        Color="#B42318" />
                    <SolidColorBrush
                        x:Key="InspectionErrorBackgroundBrush"
                        Color="#FFF0EF" />
                    <SolidColorBrush
                        x:Key="InspectionNeutralBrush"
                        Color="#667085" />
                    <SolidColorBrush
                        x:Key="InspectionNeutralBackgroundBrush"
                        Color="#F2F4F7" />
                </ResourceDictionary>

                <!--  System-managed high-contrast theme.  -->
                <ResourceDictionary
                    x:Key="HighContrast">
                    <SolidColorBrush
                        x:Key="InspectionCardBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush
                        x:Key="InspectionSubtleBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush
                        x:Key="InspectionCardBorderBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionDividerBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionPrimaryTextBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionSecondaryTextBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionMutedTextBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush
                        x:Key="InspectionBlueBorderBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush
                        x:Key="InspectionSuccessBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionSuccessBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush
                        x:Key="InspectionWarningBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionWarningBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush
                        x:Key="InspectionErrorBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionErrorBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush
                        x:Key="InspectionNeutralBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush
                        x:Key="InspectionNeutralBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!--  ======================================================  -->
            <!--  SHARED TYPOGRAPHY  -->
            <!--  ======================================================  -->

            <Style
                x:Key="ContentHeadingStyle"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionPrimaryTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style
                x:Key="ContentPrimaryTextStyle"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionPrimaryTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style
                x:Key="ContentSecondaryTextStyle"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <!--  Borderless disclosure action used inside the card.  -->
            <Style
                x:Key="ContentTextButtonStyle"
                TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionPrimaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!--  ======================================================  -->
            <!--  REUSABLE ROW: FINDINGS, WARNINGS AND DIAGNOSTICS  -->
            <!--  ======================================================  -->

            <DataTemplate
                x:Key="FindingRowTemplate"
                x:DataType="models:InspectionContentItemPresentation">

                <Border
                    MinHeight="62"
                    Padding="0,10"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    BorderBrush="{ThemeResource InspectionDividerBrush}"
                    BorderThickness="0,0,0,1">

                    <Grid
                        ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="24" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Status icon.  -->
                        <Border
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{x:Bind local:InspectionContentCard.GetStatusBackground(Status), Mode=OneWay}"
                            CornerRadius="11">

                            <SymbolIcon
                                Width="12"
                                Height="12"
                                Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                                Symbol="{x:Bind local:InspectionContentCard.GetStatusSymbol(Status), Mode=OneWay}" />

                        </Border>

                        <!--  Finding title and explanation.  -->
                        <StackPanel
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                Style="{StaticResource ContentPrimaryTextStyle}"
                                Text="{x:Bind Title}" />

                            <TextBlock
                                Style="{StaticResource ContentSecondaryTextStyle}"
                                Text="{x:Bind Detail}"
                                Visibility="{x:Bind DetailVisibility}" />

                        </StackPanel>

                        <!--  Text label ensures colour is never the only status cue.  -->
                        <Border
                            Grid.Column="2"
                            MinWidth="88"
                            MinHeight="28"
                            MaxWidth="148"
                            Padding="11,5"
                            VerticalAlignment="Center"
                            Background="{x:Bind local:InspectionContentCard.GetStatusBackground(Status), Mode=OneWay}"
                            CornerRadius="14">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                                MaxLines="2"
                                Text="{x:Bind StatusText}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />

                        </Border>

                    </Grid>

                </Border>

            </DataTemplate>

            <!--  Compact row used inside expanded reports.  -->
            <DataTemplate
                x:Key="ReportRowTemplate"
                x:DataType="models:InspectionContentItemPresentation">

                <Border
                    MinHeight="54"
                    Padding="0,9"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    BorderBrush="{ThemeResource InspectionDividerBrush}"
                    BorderThickness="0,0,0,1">

                    <Grid
                        ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="22" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{x:Bind local:InspectionContentCard.GetStatusBackground(Status), Mode=OneWay}"
                            CornerRadius="10">

                            <SymbolIcon
                                Width="11"
                                Height="11"
                                Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                                Symbol="{x:Bind local:InspectionContentCard.GetStatusSymbol(Status), Mode=OneWay}" />

                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Spacing="3">

                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource InspectionPrimaryTextBrush}"
                                Text="{x:Bind Title}"
                                TextWrapping="WrapWholeWords" />

                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource InspectionMutedTextBrush}"
                                Text="{x:Bind Detail}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind DetailVisibility}" />

                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Margin="12,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                            Text="{x:Bind StatusText}"
                            TextWrapping="NoWrap" />

                    </Grid>

                </Border>

            </DataTemplate>

            <!--  ======================================================  -->
            <!--  REUSABLE ROW: FIVE-STAGE INSPECTION TRACKER  -->
            <!--  ======================================================  -->

            <DataTemplate
                x:Key="ProgressStageTemplate"
                x:DataType="models:InspectionContentItemPresentation">

                <Grid
                    MinHeight="60"
                    AutomationProperties.Name="{x:Bind AutomationName}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="40" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Connector to the next stage.  -->
                    <Rectangle
                        Grid.Column="0"
                        Width="2"
                        Margin="14,30,0,-30"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        AutomationProperties.AccessibilityView="Raw"
                        Fill="{ThemeResource InspectionDividerBrush}"
                        Visibility="{x:Bind local:InspectionContentCard.GetConnectorVisibility(ShowConnector), Mode=OneWay}" />

                    <!--  Stage marker.  -->
                    <Border
                        Grid.Column="0"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AccessibilityView="Raw"
                        Background="{x:Bind local:InspectionContentCard.GetStatusBackground(Status), Mode=OneWay}"
                        BorderBrush="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="15">

                        <Grid>

                            <!--  Passed stages.  -->
                            <SymbolIcon
                                Width="13"
                                Height="13"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                                Symbol="Accept"
                                Visibility="{x:Bind local:InspectionContentCard.GetPassedVisibility(Status), Mode=OneWay}" />

                            <!--  Currently running stage.  -->
                            <ProgressRing
                                Width="17"
                                Height="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                                IsActive="{x:Bind IsActive}"
                                Visibility="{x:Bind local:InspectionContentCard.GetActiveVisibility(Status), Mode=OneWay}" />

                            <!--  Waiting stage number.  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                                Text="{x:Bind StageNumber}"
                                Visibility="{x:Bind local:InspectionContentCard.GetWaitingVisibility(Status), Mode=OneWay}" />

                        </Grid>

                    </Border>

                    <!--  Stage name and active-stage explanation.  -->
                    <StackPanel
                        Grid.Column="1"
                        MinWidth="0"
                        Margin="0,1,0,10"
                        VerticalAlignment="Top"
                        Spacing="4">

                        <TextBlock
                            Style="{StaticResource ContentPrimaryTextStyle}"
                            Text="{x:Bind Title}" />

                        <TextBlock
                            Style="{StaticResource ContentSecondaryTextStyle}"
                            Text="{x:Bind Detail}"
                            Visibility="{x:Bind DetailVisibility}" />

                    </StackPanel>

                    <!--  Passed, Checking or Waiting.  -->
                    <TextBlock
                        Grid.Column="2"
                        Margin="18,2,0,0"
                        VerticalAlignment="Top"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(Status), Mode=OneWay}"
                        Text="{x:Bind StatusText}"
                        TextWrapping="NoWrap" />

                </Grid>

            </DataTemplate>

            <!--  ======================================================  -->
            <!--  MODE TEMPLATE: INSPECTION IN PROGRESS  -->
            <!--  ======================================================  -->

            <DataTemplate
                x:Key="ProgressTemplate"
                x:DataType="models:InspectionContentCardPresentation">

                <Grid
                    Padding="24,20,24,18">

                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        ColumnSpacing="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            d:Text="Inspection progress"
                            Style="{StaticResource ContentHeadingStyle}"
                            Text="{x:Bind SectionTitle}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            d:Text="3 of 5 checks complete"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource InspectionSecondaryTextBrush}"
                            Text="{x:Bind ProgressSummary}" />

                    </Grid>

                    <ItemsRepeater
                        Grid.Row="1"
                        Margin="0,18,0,0"
                        ItemTemplate="{StaticResource ProgressStageTemplate}"
                        ItemsSource="{x:Bind Items}">

                        <ItemsRepeater.Layout>
                            <StackLayout
                                Orientation="Vertical"
                                Spacing="0" />
                        </ItemsRepeater.Layout>

                    </ItemsRepeater>

                </Grid>

            </DataTemplate>

            <!--  ======================================================  -->
            <!--  MODE TEMPLATE: WARNINGS, CONVERSION AND FAILURES  -->
            <!--  ======================================================  -->

            <!--
                A single findings template is intentionally reused for:
                - Ready with warnings
                - Conversion required
                - Incomplete package
                - Unsupported
                - Invalid
                - Cancelled
                - Operational failure
                
                Their geometry is the same. Their text, statuses, disclosure
                content and optional technical action are presentation data.
            -->
            <DataTemplate
                x:Key="FindingsTemplate"
                x:DataType="models:InspectionContentCardPresentation">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  State-specific heading such as Warnings or Validation failure.  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="24,20,24,0"
                        d:Text="Warnings"
                        Style="{StaticResource ContentHeadingStyle}"
                        Text="{x:Bind SectionTitle}" />

                    <!--  State-specific findings.  -->
                    <ItemsRepeater
                        Grid.Row="1"
                        Margin="24,12,24,0"
                        ItemTemplate="{StaticResource FindingRowTemplate}"
                        ItemsSource="{x:Bind Items}">

                        <ItemsRepeater.Layout>
                            <StackLayout
                                Orientation="Vertical"
                                Spacing="0" />
                        </ItemsRepeater.Layout>

                    </ItemsRepeater>

                    <!--  Supporting instruction beneath the primary findings.  -->
                    <TextBlock
                        Grid.Row="2"
                        Margin="24,14,24,0"
                        d:Text="Keep all model shards in the same folder and select the first shard."
                        Style="{StaticResource ContentSecondaryTextStyle}"
                        Text="{x:Bind SupportingText}"
                        Visibility="{x:Bind SupportingTextVisibility}" />

                    <!--  Optional blocking or safety statement.  -->
                    <TextBlock
                        Grid.Row="3"
                        Margin="24,10,24,0"
                        d:Text="No verified conversion route is available"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(TertiaryStatus), Mode=OneWay}"
                        Text="{x:Bind TertiaryText}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind TertiaryTextVisibility}" />

                    <!--  Optional diagnostic code.  -->
                    <Border
                        Grid.Row="4"
                        Margin="24,12,24,14"
                        Padding="12,9"
                        Background="{x:Bind local:InspectionContentCard.GetStatusBackground(DiagnosticStatus), Mode=OneWay}"
                        CornerRadius="10"
                        Visibility="{x:Bind DiagnosticCodeVisibility}">

                        <TextBlock
                            d:Text="Diagnostic code: MI-INVALID-TENSOR-SHAPE"
                            FontFamily="Cascadia Mono"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(DiagnosticStatus), Mode=OneWay}"
                            Text="{x:Bind DiagnosticCode}"
                            TextWrapping="WrapWholeWords" />

                    </Border>

                    <!--
                        Three Figma states expose inline expanded content:
                        warnings, conversion required and invalid model.
                    -->
                    <Expander
                        Grid.Row="5"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind DisclosureAutomationName}"
                        Background="Transparent"
                        BorderBrush="{ThemeResource InspectionDividerBrush}"
                        BorderThickness="0,1,0,0"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        Visibility="{x:Bind DisclosureVisibility}">

                        <Expander.Header>

                            <Grid
                                MinHeight="58"
                                Padding="12,0"
                                ColumnSpacing="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="24" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Background="{x:Bind local:InspectionContentCard.GetStatusBackground(DisclosureStatus), Mode=OneWay}"
                                    CornerRadius="11">

                                    <SymbolIcon
                                        Width="12"
                                        Height="12"
                                        Foreground="{x:Bind local:InspectionContentCard.GetStatusForeground(DisclosureStatus), Mode=OneWay}"
                                        Symbol="{x:Bind local:InspectionContentCard.GetStatusSymbol(DisclosureStatus), Mode=OneWay}" />

                                </Border>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    d:Text="3 checks passed · 2 warnings"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource InspectionSecondaryTextBrush}"
                                    Text="{x:Bind DisclosureSummary}"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,0,6,0"
                                    VerticalAlignment="Center"
                                    d:Text="View full inspection details"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource InspectionPrimaryTextBrush}"
                                    Text="{x:Bind local:InspectionContentCard.GetDisclosureText(CollapsedDisclosureText, ExpandedDisclosureText, IsExpanded), Mode=OneWay}" />

                            </Grid>

                        </Expander.Header>

                        <!--  Bounded mini-card matching the expanded prototypes.  -->
                        <Border
                            Margin="24,0,24,20"
                            Padding="18,8,10,12"
                            Background="{ThemeResource InspectionSubtleBackgroundBrush}"
                            BorderBrush="{ThemeResource InspectionCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollViewer
                                    Grid.Row="0"
                                    MaxHeight="172"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Enabled"
                                    ZoomMode="Disabled">

                                    <ItemsRepeater
                                        ItemTemplate="{StaticResource ReportRowTemplate}"
                                        ItemsSource="{x:Bind ExpandedItems}">

                                        <ItemsRepeater.Layout>
                                            <StackLayout
                                                Orientation="Vertical"
                                                Spacing="0" />
                                        </ItemsRepeater.Layout>

                                    </ItemsRepeater>

                                </ScrollViewer>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,7,8,0"
                                    HorizontalAlignment="Right"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource InspectionMutedTextBrush}"
                                    Text="Scroll for more" />

                            </Grid>

                        </Border>

                    </Expander>

                    <!--
                        Incomplete, unsupported and operational-failure states
                        use a command instead of an empty Expander.
                    -->
                    <Grid
                        Grid.Row="5"
                        MinHeight="50"
                        BorderBrush="{ThemeResource InspectionDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{x:Bind TechnicalDetailsVisibility}">

                        <Button
                            Margin="24,9,24,9"
                            AutomationProperties.Name="{x:Bind TechnicalDetailsAutomationName}"
                            Command="{x:Bind OpenTechnicalDetailsCommand}"
                            Style="{StaticResource ContentTextButtonStyle}">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="7">
                                <TextBlock
                                    Text="{x:Bind TechnicalDetailsActionText}" />
                                <SymbolIcon
                                    Width="11"
                                    Height="11"
                                    Symbol="Forward" />
                            </StackPanel>

                        </Button>

                    </Grid>

                </Grid>

            </DataTemplate>

            <!--  ======================================================  -->
            <!--  TEMPLATE SELECTOR  -->
            <!--  ======================================================  -->

            <local:InspectionContentTemplateSelector
                x:Key="ContentTemplateSelector"
                FindingsTemplate="{StaticResource FindingsTemplate}"
                ProgressTemplate="{StaticResource ProgressTemplate}" />

        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        ModelInspectionPage controls vertical spacing around this component.
        No external Margin is defined in the reusable card.
    -->
    <Grid
        x:Name="LayoutRoot"
        MaxWidth="840"
        HorizontalAlignment="Stretch"
        Visibility="{x:Bind CardVisibility, Mode=OneWay}">

        <!--  Shared shell keeps all content-card states geometrically consistent.  -->
        <Border
            HorizontalAlignment="Stretch"
            Background="{ThemeResource InspectionCardBackgroundBrush}"
            BorderBrush="{ThemeResource InspectionCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="21">

            <!--  Only the active mode template is displayed.  -->
            <ContentControl
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind Presentation, Mode=OneWay}"
                ContentTemplateSelector="{StaticResource ContentTemplateSelector}" />

        </Border>

    </Grid>

</UserControl>
