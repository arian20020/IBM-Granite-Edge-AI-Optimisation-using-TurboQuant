<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionContentCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelInspection.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GraniteEdgeAI.Features.ModelInspection.Models"
    x:Name="Root"
    d:DesignHeight="430"
    d:DesignWidth="840"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ContentHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionSectionTitleFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionSectionTitleFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionSectionTitleFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="ContentPrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionStrongBodyFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionBodyFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionStrongBodyFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ContentSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionHelperFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionHelperFontSize}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ContentTextButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource InspectionStrongBodyFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionHelperFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionStrongBodyFontWeight}" />
        </Style>

        <DataTemplate x:Key="StatusMarkerTemplate" x:DataType="models:InspectionContentItemPresentation">
            <Grid Width="22" Height="22" AutomationProperties.AccessibilityView="Raw">
                <Border Background="{ThemeResource InspectionSuccessSurfaceBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetPassedVisibility(Status)}">
                    <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionSuccessTextBrush}" Symbol="Accept" />
                </Border>
                <Border Background="{ThemeResource InspectionWarningSurfaceBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetWarningVisibility(Status)}">
                    <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionWarningTextBrush}" Symbol="Important" />
                </Border>
                <Border Background="{ThemeResource InspectionErrorSurfaceBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetErrorVisibility(Status)}">
                    <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionErrorTextBrush}" Symbol="Cancel" />
                </Border>
                <Border Background="{ThemeResource InspectionBlueSurfaceBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetInformationVisibility(Status)}">
                    <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionPrimaryBlueBrush}" Symbol="Help" />
                </Border>
                <Border Background="{ThemeResource InspectionBlueSurfaceBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetActiveVisibility(Status)}">
                    <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionPrimaryBlueBrush}" Symbol="Clock" />
                </Border>
                <Border Background="{ThemeResource InspectionSurfaceMutedBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetWaitingVisibility(Status)}">
                    <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionTextSecondaryMutedBrush}" Symbol="Clock" />
                </Border>
                <Border Background="{ThemeResource InspectionSurfaceMutedBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetNeutralVisibility(Status)}">
                    <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionTextSecondaryMutedBrush}" Symbol="Help" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FindingRowTemplate" x:DataType="models:InspectionContentItemPresentation">
            <Border
                Tag="InspectionFindingRow"
                MinHeight="72"
                Padding="0,10"
                AutomationProperties.AccessibilityView="Content"
                AutomationProperties.AutomationControlType="ListItem"
                AutomationProperties.HelpText="{x:Bind AutomationHelpText}"
                AutomationProperties.Name="{x:Bind Title}"
                BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Content="{x:Bind}"
                        ContentTemplate="{StaticResource StatusMarkerTemplate}" />
                    <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            Style="{StaticResource ContentPrimaryTextStyle}"
                            Text="{x:Bind Title}" />
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            Style="{StaticResource ContentSecondaryTextStyle}"
                            Text="{x:Bind Detail}"
                            Visibility="{x:Bind DetailVisibility}" />
                    </StackPanel>
                    <Border
                        Grid.Column="2"
                        MinWidth="88"
                        MinHeight="28"
                        MaxWidth="148"
                        Padding="11,5"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Background="{ThemeResource InspectionSurfaceMutedBrush}"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="{StaticResource InspectionLabelFontFamily}"
                            FontSize="{ThemeResource InspectionLabelFontSize}"
                            FontWeight="{StaticResource InspectionLabelFontWeight}"
                            Foreground="{ThemeResource InspectionTextSecondaryStrongBrush}"
                            Text="{x:Bind StatusText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReportRowTemplate" x:DataType="models:InspectionContentItemPresentation">
            <Border
                Tag="InspectionReportRow"
                MinHeight="58"
                Padding="0,9"
                AutomationProperties.AccessibilityView="Raw"
                BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Content="{x:Bind}"
                        ContentTemplate="{StaticResource StatusMarkerTemplate}" />
                    <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            AutomationProperties.AccessibilityView="Content"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            Style="{StaticResource ContentPrimaryTextStyle}"
                            Text="{x:Bind Title}" />
                        <TextBlock
                            AutomationProperties.AccessibilityView="Raw"
                            Style="{StaticResource ContentSecondaryTextStyle}"
                            Text="{x:Bind Detail}"
                            Visibility="{x:Bind DetailVisibility}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="{StaticResource InspectionLabelFontFamily}"
                        FontSize="{ThemeResource InspectionLabelFontSize}"
                        FontWeight="{StaticResource InspectionLabelFontWeight}"
                        Foreground="{ThemeResource InspectionTextSecondaryStrongBrush}"
                        Text="{x:Bind StatusText}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProgressStageTemplate" x:DataType="models:InspectionContentItemPresentation">
            <Grid
                Tag="InspectionProgressRow"
                MinHeight="60"
                AutomationProperties.AccessibilityView="Content"
                AutomationProperties.AutomationControlType="ListItem"
                AutomationProperties.HelpText="{x:Bind AutomationHelpText, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle
                    Grid.Column="0"
                    Width="2"
                    Margin="14,30,0,-30"
                    HorizontalAlignment="Left"
                    AutomationProperties.AccessibilityView="Raw"
                    Fill="{ThemeResource InspectionBorderLightBrush}"
                    Visibility="{x:Bind local:InspectionContentCard.GetConnectorVisibility(ShowConnector)}" />
                <Border
                    x:Name="ProgressStatusMotionTarget"
                    Grid.Column="0"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{ThemeResource InspectionSurfaceMutedBrush}"
                    BorderBrush="{ThemeResource InspectionBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="15">
                    <Grid>
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{x:Bind}"
                            ContentTemplate="{StaticResource StatusMarkerTemplate}"
                            Visibility="{x:Bind local:InspectionContentCard.GetTerminalMarkerVisibility(Status), Mode=OneWay}" />
                        <ProgressRing
                            Width="17"
                            Height="17"
                            Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                            IsActive="{x:Bind IsActive, Mode=OneWay}"
                            IsIndeterminate="True"
                            Visibility="{x:Bind local:InspectionContentCard.GetActiveVisibility(Status), Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource InspectionLabelFontFamily}"
                            FontSize="{ThemeResource InspectionHelperFontSize}"
                            FontWeight="{StaticResource InspectionLabelFontWeight}"
                            Foreground="{ThemeResource InspectionTextSecondaryMutedBrush}"
                            Text="{x:Bind StageNumber}"
                            Visibility="{x:Bind local:InspectionContentCard.GetWaitingVisibility(Status), Mode=OneWay}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" MinWidth="0" Margin="0,1,0,10" Spacing="4">
                    <TextBlock Style="{StaticResource ContentPrimaryTextStyle}" Text="{x:Bind Title}" />
                    <TextBlock
                        x:Name="ProgressDetailMotionTarget"
                        Style="{StaticResource ContentSecondaryTextStyle}"
                        Text="{x:Bind Detail, Mode=OneWay}"
                        Visibility="{x:Bind DetailVisibility, Mode=OneWay}" />
                </StackPanel>
                <Grid
                    Grid.Column="2"
                    Margin="18,2,0,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                        FontSize="{ThemeResource InspectionHelperFontSize}"
                        FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                        Foreground="{ThemeResource InspectionTextSecondaryStrongBrush}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Grid.Column="1"
                        MinWidth="36"
                        HorizontalAlignment="Right"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                        FontSize="{ThemeResource InspectionHelperFontSize}"
                        FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                        Foreground="{ThemeResource InspectionTextSecondaryStrongBrush}"
                        Text="{x:Bind StageFractionText, Mode=OneWay}"
                        TextWrapping="NoWrap" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        MaxWidth="{StaticResource InspectionContentColumnWidth}"
        HorizontalAlignment="Stretch"
        SizeChanged="LayoutRoot_SizeChanged"
        Visibility="{x:Bind CardVisibility, Mode=OneWay}">
        <Border
            x:Name="ContentCardShell"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource InspectionSurfaceBrush}"
            BorderBrush="{ThemeResource InspectionBorderMutedBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid x:Name="ProgressView" Padding="23,20,23,16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ContentHeadingStyle}" Text="{x:Bind Presentation.SectionTitle, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                            FontSize="{ThemeResource InspectionHelperFontSize}"
                            FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                            Foreground="{ThemeResource InspectionTextSecondaryBrush}"
                            Text="{x:Bind Presentation.ProgressRows.ProgressSummary, Mode=OneWay}" />
                    </Grid>
                    <Grid
                        x:Name="StartupStatusRow"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        ColumnSpacing="10"
                        AutomationProperties.AccessibilityView="Content"
                        AutomationProperties.Name="{x:Bind Presentation.Startup.AutomationName, Mode=OneWay}"
                        Visibility="{x:Bind Presentation.Startup.Visibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="StartupActiveIndicatorHost"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw">
                            <ProgressRing
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource InspectionPrimaryBlueBrush}"
                                IsActive="True"
                                IsIndeterminate="True" />
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Style="{StaticResource ContentPrimaryTextStyle}"
                            Text="{x:Bind Presentation.Startup.Summary, Mode=OneWay}" />
                    </Grid>
                    <ItemsRepeater
                        x:Name="ProgressItemsRepeater"
                        Grid.Row="2"
                        Margin="0"
                        AutomationProperties.AccessibilityView="Content"
                        AutomationProperties.AutomationControlType="List"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{x:Bind Presentation.SectionTitle, Mode=OneWay}"
                        ElementClearing="ProgressItemsRepeater_ElementClearing"
                        ElementPrepared="ProgressItemsRepeater_ElementPrepared"
                        ItemTemplate="{StaticResource ProgressStageTemplate}"
                        ItemsSource="{x:Bind Presentation.ProgressRows.Items, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>

                <Grid x:Name="FindingsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="FindingsSectionTitle"
                        Margin="23,20,23,0"
                        Style="{StaticResource ContentHeadingStyle}"
                        Text="{x:Bind Presentation.SectionTitle, Mode=OneWay}" />
                    <ItemsControl
                        x:Name="FindingsItemsRepeater"
                        Grid.Row="1"
                        Margin="23,12,23,0"
                        AutomationProperties.AccessibilityView="Content"
                        AutomationProperties.AutomationControlType="List"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{x:Bind Presentation.SectionTitle, Mode=OneWay}"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource FindingRowTemplate}"
                        ItemsSource="{x:Bind Presentation.Items, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock
                        x:Name="SupportingText"
                        Grid.Row="2"
                        Margin="23,0,23,0"
                        Style="{StaticResource ContentSecondaryTextStyle}"
                        Text="{x:Bind Presentation.SupportingText, Mode=OneWay}"
                        Visibility="{x:Bind Presentation.SupportingTextVisibility, Mode=OneWay}" />
                    <TextBlock
                        x:Name="TertiaryText"
                        Grid.Row="3"
                        Margin="23,10,23,0"
                        FontFamily="{StaticResource InspectionStrongBodyFontFamily}"
                        FontSize="{ThemeResource InspectionHelperFontSize}"
                        FontWeight="{StaticResource InspectionStrongBodyFontWeight}"
                        Foreground="{ThemeResource InspectionTextSecondaryStrongBrush}"
                        Text="{x:Bind Presentation.TertiaryText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Presentation.TertiaryTextVisibility, Mode=OneWay}" />
                    <Border
                        x:Name="DiagnosticCodeBorder"
                        Grid.Row="4"
                        Margin="23,4,23,0"
                        Padding="12,4"
                        Background="{ThemeResource InspectionSurfaceMutedBrush}"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{x:Bind Presentation.DiagnosticCodeVisibility, Mode=OneWay}">
                        <TextBlock
                            FontFamily="Cascadia Mono"
                            FontSize="{ThemeResource InspectionHelperFontSize}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource InspectionTextSecondaryStrongBrush}"
                            Text="{x:Bind Presentation.DiagnosticCode, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>

                    <local:InspectionDisclosure
                        x:Name="FindingsDisclosure"
                        Grid.Row="5"
                        AutomationProperties.Name="{x:Bind Presentation.DisclosureAutomationName, Mode=OneWay}"
                        HeaderMinHeight="58"
                        Visibility="{x:Bind Presentation.DisclosureVisibility, Mode=OneWay}">
                        <local:InspectionDisclosure.HeaderContent>
                            <Grid Padding="23,0,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="22" Height="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                    <Border Background="{ThemeResource InspectionWarningSurfaceBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetWarningVisibility(Presentation.DisclosureStatus), Mode=OneWay}">
                                        <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionWarningTextBrush}" Symbol="Important" />
                                    </Border>
                                    <Border Background="{ThemeResource InspectionErrorSurfaceBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetErrorVisibility(Presentation.DisclosureStatus), Mode=OneWay}">
                                        <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionErrorTextBrush}" Symbol="Cancel" />
                                    </Border>
                                    <Border Background="{ThemeResource InspectionBlueSurfaceBrush}" CornerRadius="11" Visibility="{x:Bind local:InspectionContentCard.GetInformationVisibility(Presentation.DisclosureStatus), Mode=OneWay}">
                                        <SymbolIcon Width="12" Height="12" Foreground="{ThemeResource InspectionPrimaryBlueBrush}" Symbol="Help" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ContentPrimaryTextStyle}"
                                    Text="{x:Bind Presentation.DisclosureSummary, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ContentPrimaryTextStyle}"
                                    Text="{x:Bind local:InspectionContentCard.GetDisclosureText(Presentation.CollapsedDisclosureText, Presentation.ExpandedDisclosureText, Presentation.IsExpanded), Mode=OneWay}" />
                            </Grid>
                        </local:InspectionDisclosure.HeaderContent>
                        <local:InspectionDisclosure.ViewportContent>
                            <Border
                                x:Name="ExpandedReportViewport"
                                Height="148"
                                Margin="23,0,23,20"
                                Padding="18,8,10,8"
                                Background="{ThemeResource InspectionSurfaceSubtleBrush}"
                                BorderBrush="{ThemeResource InspectionBorderMutedBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer
                                        x:Name="ExpandedReportScrollViewer"
                                        MaxHeight="172"
                                        AutomationProperties.HelpText="Use the arrow and Page Up or Page Down keys to review all inspection details."
                                        AutomationProperties.Name="{x:Bind Presentation.DisclosureSummary, Mode=OneWay}"
                                        HorizontalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Disabled"
                                        IsTabStop="True"
                                        UseSystemFocusVisuals="True"
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Enabled"
                                        ZoomMode="Disabled">
                                        <ItemsControl
                                            x:Name="ExpandedReportItemsControl"
                                            IsTabStop="False"
                                            ItemTemplate="{StaticResource ReportRowTemplate}"
                                            ItemsSource="{x:Bind ExpandedItems, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Spacing="0" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Grid
                                        x:Name="ExpandedReportBottomFade"
                                        Grid.Row="0"
                                        Height="24"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AccessibilityView="Raw"
                                        IsHitTestVisible="False">
                                        <Border Height="8" VerticalAlignment="Top" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.25" />
                                        <Border Height="8" VerticalAlignment="Center" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.55" />
                                        <Border Height="8" VerticalAlignment="Bottom" Background="{ThemeResource InspectionSurfaceSubtleBrush}" Opacity="0.85" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="ExpandedReportScrollAffordance"
                                        Grid.Row="1"
                                        HorizontalAlignment="Right"
                                        FontFamily="{StaticResource InspectionLabelFontFamily}"
                                        FontSize="{ThemeResource InspectionLabelFontSize}"
                                        FontWeight="{StaticResource InspectionLabelFontWeight}"
                                        Foreground="{ThemeResource InspectionTextMutedBrush}"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Text="Scroll for more" />
                                </Grid>
                            </Border>
                        </local:InspectionDisclosure.ViewportContent>
                    </local:InspectionDisclosure>

                    <Grid
                        x:Name="TechnicalDetailsHost"
                        Grid.Row="5"
                        MinHeight="58"
                        BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{x:Bind Presentation.TechnicalDetailsVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TechnicalDetailsFutureHelpText"
                            Margin="23,0,12,0"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="{x:Bind Presentation.TechnicalDetailsAutomationHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:InspectionContentCard.GetTechnicalHelpAutomationName(Presentation), Mode=OneWay}"
                            Style="{StaticResource ContentSecondaryTextStyle}"
                            Text="{x:Bind Presentation.TechnicalDetailsAutomationHelpText, Mode=OneWay}"
                            Visibility="{x:Bind local:InspectionContentCard.GetTechnicalHelpVisibility(Presentation), Mode=OneWay}" />
                        <Button
                            x:Name="TechnicalDetailsButton"
                            Grid.Column="1"
                            Margin="12,7,23,7"
                            AutomationProperties.HelpText="{x:Bind Presentation.TechnicalDetailsAutomationHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Presentation.TechnicalDetailsAutomationName, Mode=OneWay}"
                            Command="{x:Bind Presentation.OpenTechnicalDetailsCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind Presentation.IsTechnicalDetailsEnabled, Mode=OneWay}"
                            Style="{StaticResource ContentTextButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Presentation.TechnicalDetailsAutomationHelpText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{x:Bind Presentation.TechnicalDetailsActionText, Mode=OneWay}" />
                                <SymbolIcon Width="11" Height="11" Symbol="Forward" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ContentModeStates">
                <VisualState x:Name="ProgressState">
                    <VisualState.Setters>
                        <Setter Target="ProgressView.Visibility" Value="Visible" />
                        <Setter Target="FindingsView.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="FindingsState">
                    <VisualState.Setters>
                        <Setter Target="ProgressView.Visibility" Value="Collapsed" />
                        <Setter Target="FindingsView.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ResponsiveContentStates">
                <VisualState x:Name="WideContentState" />
                <VisualState x:Name="MediumContentState" />
                <VisualState x:Name="NarrowContentState">
                    <VisualState.Setters>
                        <Setter Target="ProgressView.Padding" Value="16,20,16,16" />
                        <Setter Target="FindingsSectionTitle.Margin" Value="16,20,16,0" />
                        <Setter Target="FindingsItemsRepeater.Margin" Value="16,12,16,0" />
                        <Setter Target="SupportingText.Margin" Value="16,0,16,0" />
                        <Setter Target="TertiaryText.Margin" Value="16,10,16,0" />
                        <Setter Target="DiagnosticCodeBorder.Margin" Value="16,4,16,0" />
                        <Setter Target="ExpandedReportViewport.Margin" Value="16,0,16,20" />
