<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionActionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="160"
    d:DesignWidth="840"
    mc:Ignorable="d">
    <!--
        Displays the actions available for the current inspection state.
        
        This control owns only:
        - The inspecting-state cancel action
        - The completed-state action heading and explanation
        - Up to two secondary actions
        - One primary action
        - Responsive button arrangement
        
        It does not own:
        - Inspection outcome classification
        - Navigation decisions
        - Model inspection commands themselves
        - Model information, warnings or technical evidence
    -->

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  ======================================================  -->
            <!--  THEME-AWARE ACTION-CARD COLOURS  -->
            <!--  ======================================================  -->

            <ResourceDictionary.ThemeDictionaries>

                <!--  Dark theme.  -->
                <ResourceDictionary
                    x:Key="Default">

                    <SolidColorBrush
                        x:Key="InspectionActionCardBackgroundBrush"
                        Color="#25282D" />

                    <SolidColorBrush
                        x:Key="InspectionActionCardBorderBrush"
                        Color="#424852" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryTextBrush"
                        Color="#F7F8FA" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryTextBrush"
                        Color="#AAB2BF" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonBackgroundBrush"
                        Color="#1F2227" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonBorderBrush"
                        Color="#59616C" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonForegroundBrush"
                        Color="#F2F4F7" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonBackgroundBrush"
                        Color="#4589FF" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonBorderBrush"
                        Color="#4589FF" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonForegroundBrush"
                        Color="#FFFFFF" />

                </ResourceDictionary>

                <!--  Light theme matching the approved prototypes.  -->
                <ResourceDictionary
                    x:Key="Light">

                    <SolidColorBrush
                        x:Key="InspectionActionCardBackgroundBrush"
                        Color="#F8FAFC" />

                    <SolidColorBrush
                        x:Key="InspectionActionCardBorderBrush"
                        Color="#E8EDF3" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryTextBrush"
                        Color="#101828" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryTextBrush"
                        Color="#667085" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonBackgroundBrush"
                        Color="#FFFFFF" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonBorderBrush"
                        Color="#BFC9D6" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonForegroundBrush"
                        Color="#344054" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonBackgroundBrush"
                        Color="#0F62FE" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonBorderBrush"
                        Color="#0F62FE" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonForegroundBrush"
                        Color="#FFFFFF" />

                </ResourceDictionary>

                <!--  System-managed high-contrast theme.  -->
                <ResourceDictionary
                    x:Key="HighContrast">

                    <SolidColorBrush
                        x:Key="InspectionActionCardBackgroundBrush"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionCardBorderBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryTextBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryTextBrush"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonBackgroundBrush"
                        Color="{ThemeResource SystemColorButtonFaceColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonBorderBrush"
                        Color="{ThemeResource SystemColorButtonTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionSecondaryButtonForegroundBrush"
                        Color="{ThemeResource SystemColorButtonTextColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonBackgroundBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonBorderBrush"
                        Color="{ThemeResource SystemColorHighlightColor}" />

                    <SolidColorBrush
                        x:Key="InspectionActionPrimaryButtonForegroundBrush"
                        Color="{ThemeResource SystemColorHighlightTextColor}" />

                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!--  ======================================================  -->
            <!--  SHARED TEXT STYLES  -->
            <!--  ======================================================  -->

            <Style
                x:Key="InspectionActionHeadingStyle"
                TargetType="TextBlock">

                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionActionPrimaryTextBrush}" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />

            </Style>

            <Style
                x:Key="InspectionActionMessageStyle"
                TargetType="TextBlock">

                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource InspectionActionSecondaryTextBrush}" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />

            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        The parent page owns the spacing around this component.
        No external Margin is defined here.
    -->
    <Grid
        x:Name="LayoutRoot"
        MaxWidth="840"
        HorizontalAlignment="Stretch"
        AutomationProperties.Name="{x:Bind Presentation.AutomationName, Mode=OneWay}"
        Visibility="{x:Bind CardVisibility, Mode=OneWay}">

        <!--  =========================================================  -->
        <!--  MODE 1: INSPECTION IS CURRENTLY RUNNING  -->
        <!--  =========================================================  -->

        <StackPanel
            x:Name="InspectingView"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="Collapsed">

            <Button
                MinWidth="{x:Bind Presentation.CancelAction.MinimumWidth, Mode=OneWay}"
                MinHeight="46"
                Padding="20,10"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="{x:Bind Presentation.CancelAction.AutomationName, Mode=OneWay}"
                Background="{ThemeResource InspectionActionSecondaryButtonBackgroundBrush}"
                BorderBrush="{ThemeResource InspectionActionSecondaryButtonBorderBrush}"
                BorderThickness="1"
                Command="{x:Bind Presentation.CancelAction.Command, Mode=OneWay}"
                CommandParameter="{x:Bind Presentation.CancelAction.CommandParameter, Mode=OneWay}"
                CornerRadius="12"
                Foreground="{ThemeResource InspectionActionSecondaryButtonForegroundBrush}"
                IsEnabled="{x:Bind Presentation.CancelAction.IsEnabled, Mode=OneWay}"
                TabIndex="0"
                Visibility="{x:Bind Presentation.CancelAction.Visibility, Mode=OneWay}">

                <TextBlock
                    d:Text="Cancel inspection"
                    FontSize="13"
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{x:Bind Presentation.CancelAction.Text, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />

            </Button>

            <TextBlock
                MaxWidth="520"
                d:Text="You can safely return to model selection at any time."
                Style="{StaticResource InspectionActionMessageStyle}"
                Text="{x:Bind Presentation.Message, Mode=OneWay}" />

        </StackPanel>

        <!--  =========================================================  -->
        <!--  MODE 2: INSPECTION HAS REACHED AN END STATE  -->
        <!--  =========================================================  -->

        <Border
            x:Name="ResultView"
            MinHeight="140"
            Padding="24,18"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource InspectionActionCardBackgroundBrush}"
            BorderBrush="{ThemeResource InspectionActionCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Visibility="Collapsed">

            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                <TextBlock
                    d:Text="Next: check hardware fit"
                    Style="{StaticResource InspectionActionHeadingStyle}"
                    Text="{x:Bind Presentation.Title, Mode=OneWay}" />

                <TextBlock
                    Margin="0,6,0,0"
                    d:Text="Compare the model with this computer’s RAM, processor and available runtimes."
                    Style="{StaticResource InspectionActionMessageStyle}"
                    Text="{x:Bind Presentation.Message, Mode=OneWay}" />

                <!--
                    Base layout stacks vertically for narrow windows and high
                    text scaling. WideActionLayout changes this to horizontal.
                -->
                <StackPanel
                    x:Name="ResultButtonPanel"
                    MaxWidth="360"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Stretch"
                    Orientation="Vertical"
                    Spacing="12">

                    <!--  Optional first secondary action.  -->
                    <Button
                        x:Name="SecondaryActionOneButton"
                        MinWidth="{x:Bind Presentation.SecondaryActionOne.MinimumWidth, Mode=OneWay}"
                        MinHeight="46"
                        Padding="20,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="{x:Bind Presentation.SecondaryActionOne.AutomationName, Mode=OneWay}"
                        Background="{ThemeResource InspectionActionSecondaryButtonBackgroundBrush}"
                        BorderBrush="{ThemeResource InspectionActionSecondaryButtonBorderBrush}"
                        BorderThickness="1"
                        Command="{x:Bind Presentation.SecondaryActionOne.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind Presentation.SecondaryActionOne.CommandParameter, Mode=OneWay}"
                        CornerRadius="12"
                        Foreground="{ThemeResource InspectionActionSecondaryButtonForegroundBrush}"
                        IsEnabled="{x:Bind Presentation.SecondaryActionOne.IsEnabled, Mode=OneWay}"
                        TabIndex="0"
                        Visibility="{x:Bind Presentation.SecondaryActionOne.Visibility, Mode=OneWay}">

                        <TextBlock
                            d:Text="Choose another model"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxLines="2"
                            Text="{x:Bind Presentation.SecondaryActionOne.Text, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />

                    </Button>

                    <!--  Optional second secondary action.  -->
                    <Button
                        x:Name="SecondaryActionTwoButton"
                        MinWidth="{x:Bind Presentation.SecondaryActionTwo.MinimumWidth, Mode=OneWay}"
                        MinHeight="46"
                        Padding="20,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="{x:Bind Presentation.SecondaryActionTwo.AutomationName, Mode=OneWay}"
                        Background="{ThemeResource InspectionActionSecondaryButtonBackgroundBrush}"
                        BorderBrush="{ThemeResource InspectionActionSecondaryButtonBorderBrush}"
                        BorderThickness="1"
                        Command="{x:Bind Presentation.SecondaryActionTwo.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind Presentation.SecondaryActionTwo.CommandParameter, Mode=OneWay}"
                        CornerRadius="12"
                        Foreground="{ThemeResource InspectionActionSecondaryButtonForegroundBrush}"
                        IsEnabled="{x:Bind Presentation.SecondaryActionTwo.IsEnabled, Mode=OneWay}"
                        TabIndex="1"
                        Visibility="{x:Bind Presentation.SecondaryActionTwo.Visibility, Mode=OneWay}">

                        <TextBlock
                            d:Text="View technical report"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxLines="2"
                            Text="{x:Bind Presentation.SecondaryActionTwo.Text, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />

                    </Button>

                    <!--  The primary action is always last in visual and keyboard order.  -->
                    <Button
                        x:Name="PrimaryActionButton"
                        MinWidth="{x:Bind Presentation.PrimaryAction.MinimumWidth, Mode=OneWay}"
                        MinHeight="46"
                        Padding="20,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="{x:Bind Presentation.PrimaryAction.AutomationName, Mode=OneWay}"
                        Background="{ThemeResource InspectionActionPrimaryButtonBackgroundBrush}"
                        BorderBrush="{ThemeResource InspectionActionPrimaryButtonBorderBrush}"
                        BorderThickness="1"
                        Command="{x:Bind Presentation.PrimaryAction.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind Presentation.PrimaryAction.CommandParameter, Mode=OneWay}"
                        CornerRadius="12"
                        Foreground="{ThemeResource InspectionActionPrimaryButtonForegroundBrush}"
                        IsEnabled="{x:Bind Presentation.PrimaryAction.IsEnabled, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        TabIndex="2"
                        Visibility="{x:Bind Presentation.PrimaryAction.Visibility, Mode=OneWay}">

                        <TextBlock
                            d:Text="Check hardware fit"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxLines="2"
                            Text="{x:Bind Presentation.PrimaryAction.Text, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />

                    </Button>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

    <!--  =============================================================  -->
    <!--  VISUAL STATES  -->
    <!--  =============================================================  -->

    <VisualStateManager.VisualStateGroups>

        <!--
            Code-behind selects one of these states when Presentation.Mode
            changes. Hidden mode collapses the complete LayoutRoot.
        -->
        <VisualStateGroup
            x:Name="CardModeStates">

            <VisualState
                x:Name="InspectingState">
                <VisualState.Setters>
                    <Setter Target="InspectingView.Visibility" Value="Visible" />
                    <Setter Target="ResultView.Visibility" Value="Collapsed" />
                </VisualState.Setters>
            </VisualState>

            <VisualState
                x:Name="ResultState">
                <VisualState.Setters>
                    <Setter Target="InspectingView.Visibility" Value="Collapsed" />
                    <Setter Target="ResultView.Visibility" Value="Visible" />
                </VisualState.Setters>
            </VisualState>

        </VisualStateGroup>

        <!--
            The compact vertical layout is the safe default.
            
            At wider window sizes, the buttons switch to the horizontal
            arrangement used in the approved desktop prototypes.
        -->
        <VisualStateGroup
            x:Name="ResponsiveStates">

            <VisualState
                x:Name="WideActionLayout">

                <VisualState.StateTriggers>
                    <AdaptiveTrigger
                        MinWindowWidth="900" />
                </VisualState.StateTriggers>

                <VisualState.Setters>
                    <Setter Target="ResultButtonPanel.Orientation" Value="Horizontal" />
                    <Setter Target="ResultButtonPanel.HorizontalAlignment" Value="Center" />
                    <Setter Target="ResultButtonPanel.MaxWidth" Value="760" />
                    <Setter Target="SecondaryActionOneButton.HorizontalAlignment" Value="Center" />
                    <Setter Target="SecondaryActionTwoButton.HorizontalAlignment" Value="Center" />
                    <Setter Target="PrimaryActionButton.HorizontalAlignment" Value="Center" />
                </VisualState.Setters>

            </VisualState>

        </VisualStateGroup>

    </VisualStateManager.VisualStateGroups>
</UserControl>
