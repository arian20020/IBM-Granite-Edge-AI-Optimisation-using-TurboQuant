<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelInspection.Controls.InspectionActionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelInspection.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="160"
    d:DesignWidth="840"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/Onboarding/Presentation/GraniteJourneyActionPalette.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="InspectionActionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionStrongBodyFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionBodyFontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource InspectionStrongBodyFontWeight}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="InspectionActionMessageStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionHelperFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionHelperFontSize}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextSecondaryMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        <Style x:Key="InspectionActionButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InspectionStrongBodyFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionHelperFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MaxLines" Value="0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="InspectionSecondaryActionButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="{StaticResource GraniteJourneyActionHeight}" />
            <Setter Property="Padding" Value="{StaticResource GraniteJourneyActionPadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource GraniteJourneySecondaryBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraniteJourneySecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource GraniteJourneyActionCornerRadius}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource GraniteJourneySecondaryForegroundBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style
            x:Key="InspectionPrimaryActionButtonStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="{StaticResource GraniteJourneyActionHeight}" />
            <Setter Property="Padding" Value="{StaticResource GraniteJourneyActionPadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource GraniteJourneyPrimaryBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GraniteJourneyPrimaryBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource GraniteJourneyActionCornerRadius}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource GraniteJourneyPrimaryForegroundBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="InspectionFutureHelpStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="{StaticResource InspectionActionFutureHelpMargin}" />
            <Setter Property="FontFamily" Value="{StaticResource InspectionHelperFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource InspectionLabelFontSize}" />
            <Setter Property="Foreground" Value="{ThemeResource InspectionTextMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        MaxWidth="{StaticResource InspectionContentColumnWidth}"
        HorizontalAlignment="Stretch"
        AutomationProperties.Name="{x:Bind Presentation.AutomationName, Mode=OneWay}"
        SizeChanged="LayoutRoot_SizeChanged"
        Visibility="{x:Bind CardVisibility, Mode=OneWay}">

        <StackPanel
            x:Name="InspectingView"
            HorizontalAlignment="Stretch"
            Visibility="Collapsed">
            <Border
                x:Name="InspectingCardSurface"
                Padding="{StaticResource InspectionCardPadding}"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource InspectionSurfaceMutedBrush}"
                BorderBrush="{ThemeResource InspectionBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource InspectionCardCornerRadius}">
                <Grid
                    x:Name="InspectingLayout"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="InspectingMessage"
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        Style="{StaticResource InspectionActionMessageStyle}"
                        Text="{x:Bind Presentation.Message, Mode=OneWay}" />
                    <Button
                        x:Name="CancelActionButton"
                        Grid.Row="1"
                        MinWidth="{x:Bind Presentation.CancelAction.MinimumWidth, Mode=OneWay}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Presentation.CancelAction.AutomationName, Mode=OneWay}"
                        Command="{x:Bind Presentation.CancelAction.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind Presentation.CancelAction.CommandParameter, Mode=OneWay}"
                        IsEnabled="{x:Bind Presentation.CancelAction.IsEnabled, Mode=OneWay}"
                        Style="{StaticResource InspectionSecondaryActionButtonStyle}"
                        Tag="{x:Bind Presentation.CancelAction.ActionId, Mode=OneWay}"
                        TabIndex="0"
                        Visibility="{x:Bind Presentation.CancelAction.Visibility, Mode=OneWay}">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="GraniteJourneySecondaryPointerOverBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="GraniteJourneySecondaryPointerOverBorderBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="GraniteJourneySecondaryPressedBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="GraniteJourneySecondaryPressedBorderBrush" />
                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="GraniteJourneyDisabledBackgroundBrush" />
                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="GraniteJourneyDisabledForegroundBrush" />
                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="GraniteJourneyDisabledBorderBrush" />
                        </Button.Resources>
                        <TextBlock
                            Style="{StaticResource InspectionActionButtonTextStyle}"
                            Text="{x:Bind Presentation.CancelAction.Text, Mode=OneWay}" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <Border
            x:Name="ResultView"
            Padding="{StaticResource InspectionResultActionPadding}"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource InspectionSurfaceMutedBrush}"
            BorderBrush="{ThemeResource InspectionBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Style="{StaticResource InspectionActionHeadingStyle}"
                    Text="{x:Bind Presentation.Title, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="{StaticResource InspectionActionMessageMargin}"
                    Style="{StaticResource InspectionActionMessageStyle}"
                    Text="{x:Bind Presentation.Message, Mode=OneWay}" />

                <Grid
                    x:Name="ResultButtonPanel"
                    Grid.Row="2"
                    MaxWidth="760"
                    Margin="{StaticResource InspectionActionPanelMargin}"
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="0"
                    RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ActionColumnOne" Width="*" />
                        <ColumnDefinition x:Name="ActionColumnTwo" Width="*" />
                        <ColumnDefinition x:Name="ActionColumnThree" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="SecondaryActionOneHost" Grid.Row="0" Grid.ColumnSpan="3">
                        <Button
                            x:Name="SecondaryActionOneButton"
                            MinWidth="{StaticResource InspectionMinimumTargetSize}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="{x:Bind Presentation.SecondaryActionOne.AutomationHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Presentation.SecondaryActionOne.AutomationName, Mode=OneWay}"
                            Command="{x:Bind Presentation.SecondaryActionOne.Command, Mode=OneWay}"
                            CommandParameter="{x:Bind Presentation.SecondaryActionOne.CommandParameter, Mode=OneWay}"
                            IsEnabled="{x:Bind Presentation.SecondaryActionOne.IsEnabled, Mode=OneWay}"
                            Style="{StaticResource InspectionSecondaryActionButtonStyle}"
                            Tag="{x:Bind Presentation.SecondaryActionOne.ActionId, Mode=OneWay}"
                            TabIndex="0"
                            ToolTipService.ToolTip="{x:Bind Presentation.SecondaryActionOne.AutomationHelpText, Mode=OneWay}"
                            Visibility="{x:Bind Presentation.SecondaryActionOne.Visibility, Mode=OneWay}">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="GraniteJourneySecondaryPointerOverBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="GraniteJourneySecondaryPointerOverBorderBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="GraniteJourneySecondaryPressedBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="GraniteJourneySecondaryPressedBorderBrush" />
                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="GraniteJourneyDisabledBackgroundBrush" />
                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="GraniteJourneyDisabledForegroundBrush" />
                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="GraniteJourneyDisabledBorderBrush" />
                            </Button.Resources>
                            <TextBlock Style="{StaticResource InspectionActionButtonTextStyle}" Text="{x:Bind Presentation.SecondaryActionOne.Text, Mode=OneWay}" />
                        </Button>
                        <TextBlock
                            x:Name="SecondaryActionOneFutureHelpText"
                            AutomationProperties.HelpText="{x:Bind Presentation.SecondaryActionOne.AutomationHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:InspectionActionCard.GetFutureHelpAutomationName(Presentation.SecondaryActionOne), Mode=OneWay}"
                            Style="{StaticResource InspectionFutureHelpStyle}"
                            Text="{x:Bind Presentation.SecondaryActionOne.AutomationHelpText, Mode=OneWay}"
                            Visibility="{x:Bind local:InspectionActionCard.GetFutureHelpVisibility(Presentation.SecondaryActionOne), Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel x:Name="SecondaryActionTwoHost" Grid.Row="1" Grid.ColumnSpan="3">
                        <Button
                            x:Name="SecondaryActionTwoButton"
                            MinWidth="{StaticResource InspectionMinimumTargetSize}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="{x:Bind Presentation.SecondaryActionTwo.AutomationHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Presentation.SecondaryActionTwo.AutomationName, Mode=OneWay}"
                            Command="{x:Bind Presentation.SecondaryActionTwo.Command, Mode=OneWay}"
                            CommandParameter="{x:Bind Presentation.SecondaryActionTwo.CommandParameter, Mode=OneWay}"
                            IsEnabled="{x:Bind Presentation.SecondaryActionTwo.IsEnabled, Mode=OneWay}"
                            Style="{StaticResource InspectionSecondaryActionButtonStyle}"
                            Tag="{x:Bind Presentation.SecondaryActionTwo.ActionId, Mode=OneWay}"
                            TabIndex="1"
                            ToolTipService.ToolTip="{x:Bind Presentation.SecondaryActionTwo.AutomationHelpText, Mode=OneWay}"
                            Visibility="{x:Bind Presentation.SecondaryActionTwo.Visibility, Mode=OneWay}">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="GraniteJourneySecondaryPointerOverBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="GraniteJourneySecondaryPointerOverBorderBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="GraniteJourneySecondaryPressedBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="GraniteJourneySecondaryPressedBorderBrush" />
                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="GraniteJourneyDisabledBackgroundBrush" />
                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="GraniteJourneyDisabledForegroundBrush" />
                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="GraniteJourneyDisabledBorderBrush" />
                            </Button.Resources>
                            <TextBlock Style="{StaticResource InspectionActionButtonTextStyle}" Text="{x:Bind Presentation.SecondaryActionTwo.Text, Mode=OneWay}" />
                        </Button>
                        <TextBlock
                            x:Name="SecondaryActionTwoFutureHelpText"
                            AutomationProperties.HelpText="{x:Bind Presentation.SecondaryActionTwo.AutomationHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:InspectionActionCard.GetFutureHelpAutomationName(Presentation.SecondaryActionTwo), Mode=OneWay}"
                            Style="{StaticResource InspectionFutureHelpStyle}"
                            Text="{x:Bind Presentation.SecondaryActionTwo.AutomationHelpText, Mode=OneWay}"
                            Visibility="{x:Bind local:InspectionActionCard.GetFutureHelpVisibility(Presentation.SecondaryActionTwo), Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel x:Name="PrimaryActionHost" Grid.Row="2" Grid.ColumnSpan="3">
                        <Button
                            x:Name="PrimaryActionButton"
                            MinWidth="{StaticResource InspectionMinimumTargetSize}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="{x:Bind Presentation.PrimaryAction.AutomationHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Presentation.PrimaryAction.AutomationName, Mode=OneWay}"
                            Command="{x:Bind Presentation.PrimaryAction.Command, Mode=OneWay}"
                            CommandParameter="{x:Bind Presentation.PrimaryAction.CommandParameter, Mode=OneWay}"
                            IsEnabled="{x:Bind Presentation.PrimaryAction.IsEnabled, Mode=OneWay}"
                            Style="{StaticResource InspectionPrimaryActionButtonStyle}"
                            Tag="{x:Bind Presentation.PrimaryAction.ActionId, Mode=OneWay}"
                            TabIndex="2"
                            ToolTipService.ToolTip="{x:Bind Presentation.PrimaryAction.AutomationHelpText, Mode=OneWay}"
                            Visibility="{x:Bind Presentation.PrimaryAction.Visibility, Mode=OneWay}">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="GraniteJourneyPrimaryPointerOverBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="GraniteJourneyPrimaryPointerOverBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="GraniteJourneyPrimaryPressedBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="GraniteJourneyPrimaryPressedBrush" />
                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="GraniteJourneyDisabledBackgroundBrush" />
                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="GraniteJourneyDisabledForegroundBrush" />
                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="GraniteJourneyDisabledBorderBrush" />
                            </Button.Resources>
                            <TextBlock Style="{StaticResource InspectionActionButtonTextStyle}" Text="{x:Bind Presentation.PrimaryAction.Text, Mode=OneWay}" />
                        </Button>
                        <TextBlock
                            x:Name="PrimaryActionFutureHelpText"
                            AutomationProperties.HelpText="{x:Bind Presentation.PrimaryAction.AutomationHelpText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:InspectionActionCard.GetFutureHelpAutomationName(Presentation.PrimaryAction), Mode=OneWay}"
                            Style="{StaticResource InspectionFutureHelpStyle}"
                            Text="{x:Bind Presentation.PrimaryAction.AutomationHelpText, Mode=OneWay}"
                            Visibility="{x:Bind local:InspectionActionCard.GetFutureHelpVisibility(Presentation.PrimaryAction), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CardModeStates">
                <VisualState x:Name="InspectingState">
                    <VisualState.Setters>
                        <Setter Target="InspectingView.Visibility" Value="Visible" />
                        <Setter Target="ResultView.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ResultState">
                    <VisualState.Setters>
                        <Setter Target="InspectingView.Visibility" Value="Collapsed" />
                        <Setter Target="ResultView.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="ResponsiveActionStates">
                <VisualState x:Name="WideActionState" />
                <VisualState x:Name="MediumActionState" />
                <VisualState x:Name="NarrowActionState" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
