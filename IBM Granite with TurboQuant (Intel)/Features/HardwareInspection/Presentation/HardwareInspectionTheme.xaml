<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HardwareInspectionTextPrimaryBrush" Color="#111827" />
            <SolidColorBrush x:Key="HardwareInspectionTextSecondaryBrush" Color="#475467" />
            <SolidColorBrush x:Key="HardwareInspectionTextMutedBrush" Color="#758196" />
            <SolidColorBrush x:Key="HardwareInspectionAccentBrush" Color="#0F62FE" />
            <SolidColorBrush x:Key="HardwareInspectionAccentSurfaceBrush" Color="#EDF4FF" />
            <SolidColorBrush x:Key="HardwareInspectionAccentBorderBrush" Color="#8BB4FF" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessSurfaceBrush" Color="#ECF8F3" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessTextBrush" Color="#087A55" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessBorderBrush" Color="#A9DDCB" />
            <SolidColorBrush x:Key="HardwareInspectionWarningSurfaceBrush" Color="#FFF7E8" />
            <SolidColorBrush x:Key="HardwareInspectionWarningTextBrush" Color="#8A4B08" />
            <SolidColorBrush x:Key="HardwareInspectionWarningBorderBrush" Color="#E9C98B" />
            <SolidColorBrush x:Key="HardwareInspectionErrorSurfaceBrush" Color="#FFF1F0" />
            <SolidColorBrush x:Key="HardwareInspectionErrorTextBrush" Color="#B42318" />
            <SolidColorBrush x:Key="HardwareInspectionErrorBorderBrush" Color="#F2B8B5" />
            <SolidColorBrush x:Key="HardwareInspectionCanvasBrush" Color="#F8FAFD" />
            <SolidColorBrush x:Key="HardwareInspectionSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HardwareInspectionSurfaceSubtleBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="HardwareInspectionBorderBrush" Color="#D7E0EC" />
            <SolidColorBrush x:Key="HardwareInspectionBorderStrongBrush" Color="#8BB4FF" />
            <SolidColorBrush x:Key="HardwareInspectionDisabledTextBrush" Color="#7A8797" />
            <SolidColorBrush x:Key="HardwareInspectionFocusBrush" Color="#0F62FE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HardwareInspectionTextPrimaryBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="HardwareInspectionTextSecondaryBrush" Color="#D0D5DD" />
            <SolidColorBrush x:Key="HardwareInspectionTextMutedBrush" Color="#98A2B3" />
            <SolidColorBrush x:Key="HardwareInspectionAccentBrush" Color="#78A9FF" />
            <SolidColorBrush x:Key="HardwareInspectionAccentSurfaceBrush" Color="#102A56" />
            <SolidColorBrush x:Key="HardwareInspectionAccentBorderBrush" Color="#4589FF" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessSurfaceBrush" Color="#12372E" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessTextBrush" Color="#6FD2AE" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessBorderBrush" Color="#368F70" />
            <SolidColorBrush x:Key="HardwareInspectionWarningSurfaceBrush" Color="#3D2F12" />
            <SolidColorBrush x:Key="HardwareInspectionWarningTextBrush" Color="#F4CE80" />
            <SolidColorBrush x:Key="HardwareInspectionWarningBorderBrush" Color="#9F762A" />
            <SolidColorBrush x:Key="HardwareInspectionErrorSurfaceBrush" Color="#4A1D1A" />
            <SolidColorBrush x:Key="HardwareInspectionErrorTextBrush" Color="#FDA29B" />
            <SolidColorBrush x:Key="HardwareInspectionErrorBorderBrush" Color="#D92D20" />
            <SolidColorBrush x:Key="HardwareInspectionCanvasBrush" Color="#0C111D" />
            <SolidColorBrush x:Key="HardwareInspectionSurfaceBrush" Color="#101828" />
            <SolidColorBrush x:Key="HardwareInspectionSurfaceSubtleBrush" Color="#182230" />
            <SolidColorBrush x:Key="HardwareInspectionBorderBrush" Color="#344054" />
            <SolidColorBrush x:Key="HardwareInspectionBorderStrongBrush" Color="#475467" />
            <SolidColorBrush x:Key="HardwareInspectionDisabledTextBrush" Color="#98A2B3" />
            <SolidColorBrush x:Key="HardwareInspectionFocusBrush" Color="#78A9FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="HardwareInspectionTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionTextMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="HardwareInspectionAccentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HardwareInspectionAccentBorderBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionSuccessBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionWarningSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HardwareInspectionWarningTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionWarningBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionErrorSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HardwareInspectionErrorTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionErrorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HardwareInspectionSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HardwareInspectionSurfaceSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HardwareInspectionBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionDisabledTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="HardwareInspectionFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="HardwareInspectionFontFamilyRegular">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
    <FontFamily x:Key="HardwareInspectionFontFamilyBold">ms-appx:///Assets/Fonts/Inter-Bold.ttf#Inter</FontFamily>
    <FontWeight x:Key="HardwareInspectionFontWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="HardwareInspectionFontWeightBold">Bold</FontWeight>

    <x:Double x:Key="HardwareInspectionPageTitleFontSize">32</x:Double>
    <x:Double x:Key="HardwareInspectionSectionTitleFontSize">18</x:Double>
    <x:Double x:Key="HardwareInspectionBodyFontSize">14</x:Double>
    <x:Double x:Key="HardwareInspectionHelperFontSize">12</x:Double>
    <x:Double x:Key="HardwareInspectionLabelFontSize">10</x:Double>
    <x:Double x:Key="HardwareInspectionContentColumnWidth">960</x:Double>
    <x:Double x:Key="HardwareInspectionWideBreakpoint">1008</x:Double>
    <x:Double x:Key="HardwareInspectionCompactBreakpoint">640</x:Double>
    <x:Double x:Key="HardwareInspectionMinimumTargetSize">44</x:Double>
    <x:Double x:Key="HardwareInspectionMajorGap">16</x:Double>
    <x:Double x:Key="HardwareInspectionFactTileGap">12</x:Double>
    <Thickness x:Key="HardwareInspectionPageMargin">24,28,24,32</Thickness>
    <Thickness x:Key="HardwareInspectionCompactPageMargin">16,24,16,24</Thickness>
    <Thickness x:Key="HardwareInspectionCardPadding">24</Thickness>
    <Thickness x:Key="HardwareInspectionCompactCardPadding">16</Thickness>
    <CornerRadius x:Key="HardwareInspectionCardCornerRadius">12</CornerRadius>
    <Thickness x:Key="HardwareInspectionBorderThickness">1</Thickness>
</ResourceDictionary>
