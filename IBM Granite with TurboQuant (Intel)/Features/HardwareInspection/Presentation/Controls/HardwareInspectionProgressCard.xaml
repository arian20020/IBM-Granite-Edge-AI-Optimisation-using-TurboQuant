<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls.HardwareInspectionProgressCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        MaxWidth="{ThemeResource HardwareInspectionContentColumnWidth}"
        Padding="0"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        BorderThickness="0">
        <StackPanel Spacing="14">
            <Grid x:Name="ProgressHeaderGrid" MinHeight="68" ColumnSpacing="24" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.RowSpan="2" Spacing="6">
                    <TextBlock x:Name="KickerTextBlock" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="TitleTextBlock"
                        AutomationProperties.LiveSetting="Polite"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="BodyTextBlock"
                        MinHeight="38"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                        FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <TextBlock x:Name="CountTextBlock" Grid.Column="1" Grid.RowSpan="2" Margin="16,2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}" />
                <TextBlock x:Name="CountLabelTextBlock" Visibility="Collapsed" />
            </Grid>

            <ProgressBar x:Name="OverallProgressBar" Minimum="0" Maximum="7" Value="0" IsTabStop="False"
                AutomationProperties.AutomationId="HardwareInspectionOverallProgress"
                AutomationProperties.Name="Overall hardware inspection progress" />
            <TextBlock x:Name="OverallPercentage" Text="0%" FontSize="12" Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}" AutomationProperties.AutomationId="HardwareInspectionOverallPercentage" AutomationProperties.AccessibilityView="Raw" />
            <ListView
                x:Name="ProgressRowsItemsControl"
                IsItemClickEnabled="False"
                IsTabStop="False"
                ItemsSource="{x:Bind Rows, Mode=OneWay}"
                ContainerContentChanging="ProgressRowsItemsControl_ContainerContentChanging"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{ThemeResource HardwareInspectionFactTileGap}" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="8,6"
                            BorderThickness="0"
                            AutomationProperties.AccessibilityView="Raw">
                          <Grid
                              MinHeight="48"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="32" Height="32">
                                <Border
                                    Background="{ThemeResource HardwareInspectionSuccessSurfaceBrush}"
                                    CornerRadius="16"
                                    Visibility="{Binding CompletedVisibility}">
                                    <FontIcon
                                        x:Name="CompletedGlyphIcon"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Foreground="{ThemeResource HardwareInspectionSuccessTextBrush}"
                                        Glyph="&#xE73E;" />
                                </Border>
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="{ThemeResource HardwareInspectionAccentSurfaceBrush}"
                                    BorderBrush="{ThemeResource HardwareInspectionAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Visibility="{Binding ActiveVisibility}">
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                                        IsActive="{Binding IsActive}" />
                                </Border>
                                <Border
                                    Background="{ThemeResource HardwareInspectionSurfaceSubtleBrush}"
                                    BorderBrush="{ThemeResource HardwareInspectionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Visibility="{Binding WaitingVisibility}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                        FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                        Foreground="{ThemeResource HardwareInspectionTextMutedBrush}"
                                        Text="{Binding Number}" />
                                </Border>
                                <Border
                                    Background="{ThemeResource HardwareInspectionErrorSurfaceBrush}"
                                    BorderBrush="{ThemeResource HardwareInspectionErrorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Visibility="{Binding CancelledVisibility}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Foreground="{ThemeResource HardwareInspectionErrorTextBrush}"
                                        Glyph="&#xE711;" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                                    FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                                    Text="{Binding Title}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                    Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                    Text="{Binding Sentence}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Grid Grid.Column="2" Margin="8,0,0,0" MinHeight="32" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                    Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                                    TextAlignment="Right"
                                    Text="{Binding DisplayStatus}"
                                    Visibility="{Binding ActiveVisibility}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                    Foreground="{ThemeResource HardwareInspectionSuccessTextBrush}"
                                    TextAlignment="Center"
                                    Text="{Binding DisplayStatus}"
                                    Visibility="{Binding CompletedVisibility}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                    Foreground="{ThemeResource HardwareInspectionTextMutedBrush}"
                                    TextAlignment="Center"
                                    Text="{Binding DisplayStatus}"
                                    Visibility="{Binding WaitingVisibility}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                    Foreground="{ThemeResource HardwareInspectionErrorTextBrush}"
                                    TextAlignment="Center"
                                    Text="{Binding DisplayStatus}"
                                    Visibility="{Binding CancelledVisibility}" />
                            </Grid>
                          </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
