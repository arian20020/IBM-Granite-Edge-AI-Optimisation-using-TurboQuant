<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls.HardwareInspectionProgressCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        MaxWidth="{ThemeResource HardwareInspectionContentColumnWidth}"
        Padding="{ThemeResource HardwareInspectionCardPadding}"
        HorizontalAlignment="Stretch"
        Background="{ThemeResource HardwareInspectionSurfaceBrush}"
        BorderBrush="{ThemeResource HardwareInspectionBorderBrush}"
        BorderThickness="{ThemeResource HardwareInspectionBorderThickness}"
        CornerRadius="{ThemeResource HardwareInspectionCardCornerRadius}">
        <StackPanel Spacing="{ThemeResource HardwareInspectionMajorGap}">
            <Grid x:Name="ProgressHeaderGrid" ColumnSpacing="24" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.RowSpan="2" Spacing="6">
                    <TextBlock
                        x:Name="KickerTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                        FontSize="{ThemeResource HardwareInspectionLabelFontSize}"
                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                        Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                        Text="Inspection in progress"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TitleTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                        FontSize="{ThemeResource HardwareInspectionSectionTitleFontSize}"
                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="BodyTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                        FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <TextBlock
                    x:Name="CountTextBlock"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                    FontSize="{ThemeResource HardwareInspectionSectionTitleFontSize}"
                    FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                    Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}" />
                <TextBlock
                    x:Name="CountLabelTextBlock"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                    Foreground="{ThemeResource HardwareInspectionTextMutedBrush}"
                    Text="checks complete" />
            </Grid>

            <ItemsControl ItemsSource="{x:Bind Rows, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{ThemeResource HardwareInspectionFactTileGap}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="0,4"
                            BorderBrush="{ThemeResource HardwareInspectionBorderBrush}"
                            BorderThickness="0,0,0,1">
                          <Grid
                              MinHeight="{ThemeResource HardwareInspectionMinimumTargetSize}"
                              ColumnSpacing="12"
                              AutomationProperties.Name="{Binding AccessibleName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="44" Height="44">
                                <Border
                                    Background="{ThemeResource HardwareInspectionSuccessSurfaceBrush}"
                                    CornerRadius="22"
                                    Visibility="{Binding CompletedVisibility}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                        FontSize="16"
                                        Foreground="{ThemeResource HardwareInspectionSuccessTextBrush}"
                                        Text="✓" />
                                </Border>
                                <ProgressRing
                                    Width="26"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                                    IsActive="{Binding IsActive}"
                                    Visibility="{Binding ActiveVisibility}" />
                                <Border
                                    Background="{ThemeResource HardwareInspectionSurfaceSubtleBrush}"
                                    BorderBrush="{ThemeResource HardwareInspectionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Visibility="{Binding WaitingVisibility}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                        FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                        Foreground="{ThemeResource HardwareInspectionTextMutedBrush}"
                                        Text="{Binding Number}" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                    FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                                    FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                                    Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                                    Text="{Binding Title}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                    Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                    Text="{Binding Sentence}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                Foreground="{ThemeResource HardwareInspectionTextMutedBrush}"
                                Text="{Binding Status}" />
                          </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
