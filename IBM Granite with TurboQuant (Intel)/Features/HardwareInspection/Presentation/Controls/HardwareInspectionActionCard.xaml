<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls.HardwareInspectionActionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
                <ResourceDictionary Source="ms-appx:///Features/Onboarding/Presentation/GraniteJourneyActionPalette.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="HardwareInspectionPrimaryActionStyle"
                BasedOn="{StaticResource AccentButtonStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="{StaticResource GraniteJourneyActionHeight}" />
                <Setter Property="Padding" Value="{StaticResource GraniteJourneyActionPadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource GraniteJourneyActionCornerRadius}" />
                <Setter Property="FontFamily" Value="{ThemeResource HardwareInspectionFontFamilyBold}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource GraniteJourneyPrimaryBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GraniteJourneyPrimaryBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource GraniteJourneyPrimaryForegroundBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style
                x:Key="HardwareInspectionSecondaryActionStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="{StaticResource GraniteJourneyActionHeight}" />
                <Setter Property="Padding" Value="{StaticResource GraniteJourneyActionPadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource GraniteJourneyActionCornerRadius}" />
                <Setter Property="FontFamily" Value="{ThemeResource HardwareInspectionFontFamilyBold}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource GraniteJourneySecondaryBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GraniteJourneySecondaryBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource GraniteJourneySecondaryForegroundBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="ActionBandBorder" Padding="14,12" BorderBrush="{ThemeResource HardwareInspectionBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Stretch" Spacing="6">
        <TextBlock x:Name="ActionHeadingTextBlock" HorizontalAlignment="Center" FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}" TextAlignment="Center" TextWrapping="WrapWholeWords" Visibility="Collapsed" />
        <TextBlock x:Name="ActionBodyTextBlock" HorizontalAlignment="Center" FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}" FontSize="12" Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}" TextAlignment="Center" TextWrapping="WrapWholeWords" Visibility="Collapsed" />
        <StackPanel
            x:Name="ActionsPanel"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12" />
      </StackPanel>
    </Border>
</UserControl>
