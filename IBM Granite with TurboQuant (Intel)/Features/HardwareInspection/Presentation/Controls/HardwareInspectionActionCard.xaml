<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls.HardwareInspectionActionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="HardwareInspectionPrimaryActionStyle"
                BasedOn="{StaticResource AccentButtonStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontFamily" Value="{ThemeResource HardwareInspectionFontFamilyBold}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style
                x:Key="HardwareInspectionSecondaryActionStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontFamily" Value="{ThemeResource HardwareInspectionFontFamilyBold}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource HardwareInspectionSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HardwareInspectionBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource HardwareInspectionTextPrimaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel
        x:Name="ActionsPanel"
        HorizontalAlignment="Center"
        Orientation="Horizontal"
        Spacing="12" />
</UserControl>
