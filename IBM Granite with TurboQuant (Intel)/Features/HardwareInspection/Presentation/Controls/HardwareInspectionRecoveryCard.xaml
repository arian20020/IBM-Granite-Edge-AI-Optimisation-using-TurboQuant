<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls.HardwareInspectionRecoveryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="RecoveryCardBorder"
        Padding="24"
        Background="{ThemeResource HardwareInspectionSurfaceBrush}"
        BorderBrush="{ThemeResource HardwareInspectionBorderStrongBrush}"
        BorderThickness="{ThemeResource HardwareInspectionBorderThickness}"
        CornerRadius="{ThemeResource HardwareInspectionCardCornerRadius}">
        <StackPanel Spacing="18">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="4"
                    MinHeight="44"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource HardwareInspectionAccentBrush}"
                    CornerRadius="2" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock
                        x:Name="RecoveryHeadingTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                        FontSize="{ThemeResource HardwareInspectionSectionTitleFontSize}"
                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="RecoveryHelperTextBlock"
                        FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>
            <ItemsControl
                x:Name="RecoveryItemsControl"
                ItemsSource="{x:Bind Items, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="RecoveryStepSurface"
                            MinHeight="64"
                            Padding="16,14"
                            Background="{ThemeResource HardwareInspectionSurfaceSubtleBrush}"
                            BorderBrush="{ThemeResource HardwareInspectionBorderBrush}"
                            BorderThickness="{ThemeResource HardwareInspectionBorderThickness}"
                            CornerRadius="10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="RecoveryStepMarker"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource HardwareInspectionAccentSurfaceBrush}"
                                    BorderBrush="{ThemeResource HardwareInspectionAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                        FontSize="12"
                                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                                        Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                                        Text="{Binding Marker}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                        Text="{Binding Body}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="{ThemeResource HardwareInspectionLabelFontSize}"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource HardwareInspectionTextMutedBrush}"
                                    Text="{Binding Status}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
