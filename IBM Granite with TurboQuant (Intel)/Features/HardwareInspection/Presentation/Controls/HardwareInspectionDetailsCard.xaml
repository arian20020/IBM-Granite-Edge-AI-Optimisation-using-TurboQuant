<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls.HardwareInspectionDetailsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="DetailsSurfaceBorder"
        Background="{ThemeResource HardwareInspectionSurfaceBrush}"
        BorderBrush="{ThemeResource HardwareInspectionBorderStrongBrush}"
        BorderThickness="{ThemeResource HardwareInspectionBorderThickness}"
        CornerRadius="{ThemeResource HardwareInspectionCardCornerRadius}">
      <Expander
          x:Name="DetailsExpander"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch">
        <Expander.Header>
            <Grid MinHeight="52" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{ThemeResource HardwareInspectionAccentSurfaceBrush}"
                    CornerRadius="14">
                    <FontIcon
                        x:Name="DetailsInformationGlyph"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="13"
                        Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                        Glyph="&#xE946;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="DetailsTitleTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                        FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                        Text="Inspection details" />
                    <TextBlock
                        x:Name="DetailsHelperTextBlock"
                        FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <TextBlock
                    x:Name="DetailsActionTextBlock"
                    Grid.Column="2"
                    Margin="12,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                    FontWeight="Bold"
                    Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                    Text="Show details" />
            </Grid>
        </Expander.Header>
        <StackPanel Padding="0,12,0,0" Spacing="16">
            <TextBlock
                x:Name="SummaryTextBlock"
                Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Name="ReportDescriptionTextBlock"
                Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                TextWrapping="WrapWholeWords" />
            <Border
                HorizontalAlignment="Left"
                Padding="10,5"
                Background="{ThemeResource HardwareInspectionSuccessSurfaceBrush}"
                CornerRadius="10">
                <TextBlock
                    x:Name="ReportBadgeTextBlock"
                    Foreground="{ThemeResource HardwareInspectionSuccessTextBrush}" />
            </Border>
            <Border
                x:Name="StageRowsBorder"
                BorderBrush="{ThemeResource HardwareInspectionBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ItemsControl
                    x:Name="DetailRowsItemsControl"
                    ItemsSource="{x:Bind DetailRows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12,8"
                                BorderBrush="{ThemeResource HardwareInspectionBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid
                                    MinHeight="44"
                                    ColumnSpacing="12"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource HardwareInspectionSuccessSurfaceBrush}"
                                        CornerRadius="10">
                                        <FontIcon
                                            x:Name="StageStatusFontIcon"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="11"
                                            Foreground="{ThemeResource HardwareInspectionSuccessTextBrush}"
                                            Glyph="{Binding Glyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                                            Text="{Binding Title}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                            Text="{Binding Sentence}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="{ThemeResource HardwareInspectionLabelFontSize}"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource HardwareInspectionTextMutedBrush}"
                                        Text="{Binding Status}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Expander
                x:Name="TechnicalExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid
                        x:Name="TechnicalHeaderGrid"
                        MinHeight="52"
                        HorizontalAlignment="Stretch"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Background="{ThemeResource HardwareInspectionAccentSurfaceBrush}"
                            CornerRadius="14">
                            <FontIcon
                                x:Name="TechnicalInformationGlyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13"
                                Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                                Glyph="&#xE946;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                x:Name="TechnicalTitleTextBlock"
                                FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                                FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                                Text="Technical information for IT" />
                            <TextBlock
                                FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                Text="Sources, versions, timestamps, and safe support codes"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TechnicalActionTextBlock"
                            Grid.Column="2"
                            Margin="12,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                            FontWeight="Bold"
                            Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                            Text="Show IT details" />
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{x:Bind TechnicalGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,8" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                    Text="{Binding Helper}"
                                    TextWrapping="WrapWholeWords" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
      </Expander>
    </Border>
</UserControl>
