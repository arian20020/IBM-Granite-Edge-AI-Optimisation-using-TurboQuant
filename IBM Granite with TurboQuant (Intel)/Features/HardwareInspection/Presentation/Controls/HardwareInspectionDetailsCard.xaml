<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls.HardwareInspectionDetailsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Expander
        x:Name="DetailsExpander"
        HorizontalAlignment="Stretch">
        <Expander.Header>
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="DetailsTitleTextBlock"
                    FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                    FontSize="{ThemeResource HardwareInspectionSectionTitleFontSize}"
                    FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                    Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                    Text="Inspection details" />
                <TextBlock
                    x:Name="DetailsHelperTextBlock"
                    FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                    Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Expander.Header>
        <StackPanel Padding="0,12,0,0" Spacing="16">
            <TextBlock
                x:Name="SummaryTextBlock"
                Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Name="ReportDescriptionTextBlock"
                Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                TextWrapping="WrapWholeWords" />
            <Border
                HorizontalAlignment="Left"
                Padding="10,5"
                Background="{ThemeResource HardwareInspectionSuccessSurfaceBrush}"
                CornerRadius="10">
                <TextBlock
                    x:Name="ReportBadgeTextBlock"
                    Foreground="{ThemeResource HardwareInspectionSuccessTextBrush}" />
            </Border>
            <ItemsControl ItemsSource="{x:Bind DetailRows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            MinHeight="44"
                            Padding="0,8"
                            ColumnSpacing="12"
                            AutomationProperties.Name="{Binding AccessibleName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                    Text="{Binding Sentence}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource HardwareInspectionTextMutedBrush}"
                                Text="{Binding Status}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander x:Name="TechnicalExpander">
                <Expander.Header>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="TechnicalTitleTextBlock"
                            FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                            FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                            FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                            Text="Technical information for IT" />
                        <TextBlock
                            FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                            Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                            Text="Sources, versions, timestamps, and safe support codes"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{x:Bind TechnicalGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,8" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                    Text="{Binding Helper}"
                                    TextWrapping="WrapWholeWords" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Expander>
</UserControl>
