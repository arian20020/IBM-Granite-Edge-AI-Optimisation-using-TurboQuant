<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls.HardwareInspectionOutcomeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OutcomeToneStates">
                <VisualState x:Name="Neutral">
                    <VisualState.Setters>
                        <Setter Target="OutcomeBorder.Background" Value="Transparent" />
                        <Setter Target="GlyphBorder.Background" Value="{ThemeResource HardwareInspectionAccentSurfaceBrush}" />
                        <Setter Target="GlyphBorder.BorderBrush" Value="{ThemeResource HardwareInspectionAccentBorderBrush}" />
                        <Setter Target="GlyphFontIcon.Foreground" Value="{ThemeResource HardwareInspectionAccentBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="OutcomeBorder.Background" Value="Transparent" />
                        <Setter Target="GlyphBorder.Background" Value="{ThemeResource HardwareInspectionSuccessSurfaceBrush}" />
                        <Setter Target="GlyphBorder.BorderBrush" Value="{ThemeResource HardwareInspectionSuccessBorderBrush}" />
                        <Setter Target="GlyphFontIcon.Foreground" Value="{ThemeResource HardwareInspectionSuccessTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="OutcomeBorder.Background" Value="Transparent" />
                        <Setter Target="GlyphBorder.Background" Value="{ThemeResource HardwareInspectionWarningSurfaceBrush}" />
                        <Setter Target="GlyphBorder.BorderBrush" Value="{ThemeResource HardwareInspectionWarningBorderBrush}" />
                        <Setter Target="GlyphFontIcon.Foreground" Value="{ThemeResource HardwareInspectionWarningTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="OutcomeBorder.Background" Value="Transparent" />
                        <Setter Target="GlyphBorder.Background" Value="{ThemeResource HardwareInspectionErrorSurfaceBrush}" />
                        <Setter Target="GlyphBorder.BorderBrush" Value="{ThemeResource HardwareInspectionErrorBorderBrush}" />
                        <Setter Target="GlyphFontIcon.Foreground" Value="{ThemeResource HardwareInspectionErrorTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="OutcomeBorder"
            MaxWidth="{ThemeResource HardwareInspectionContentColumnWidth}"
            Padding="0"
            HorizontalAlignment="Stretch"
            BorderThickness="0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="GlyphBorder"
                    Width="40"
                    Height="40"
                    BorderThickness="1"
                    CornerRadius="20">
                    <Grid>
                        <FontIcon
                            x:Name="GlyphFontIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="17" />
                        <ProgressRing
                            x:Name="OutcomeProgressRing"
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource HardwareInspectionAccentBrush}"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        x:Name="TitleTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                        FontSize="{ThemeResource HardwareInspectionSectionTitleFontSize}"
                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="BodyTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                        FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <!-- Binding bridge retained off-surface for the existing control
                     contract. The approved preview has no visible kicker or
                     review-count treatment. -->
                <Grid Visibility="Collapsed">
                    <TextBlock x:Name="KickerTextBlock" />
                    <StackPanel x:Name="ReviewCountPanel">
                        <TextBlock x:Name="ReviewCountTextBlock" />
                        <TextBlock x:Name="ReviewCountLabelTextBlock" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
