<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GraniteEdgeAI.Features.HardwareInspection.HardwareInspectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls"
    RequestedTheme="Light">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" Background="{ThemeResource HardwareInspectionCanvasBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="888" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrimaryColumn.Width" Value="2*" />
                        <Setter Target="SupportColumn.Width" Value="*" />
                        <Setter Target="SupportPanel.(Grid.Row)" Value="0" />
                        <Setter Target="SupportPanel.(Grid.Column)" Value="1" />
                        <Setter Target="SupportPanel.Margin" Value="16,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrimaryColumn.Width" Value="*" />
                        <Setter Target="SupportColumn.Width" Value="0" />
                        <Setter Target="SupportPanel.(Grid.Row)" Value="1" />
                        <Setter Target="SupportPanel.(Grid.Column)" Value="0" />
                        <Setter Target="SupportPanel.Margin" Value="0,16,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrimaryColumn.Width" Value="*" />
                        <Setter Target="SupportColumn.Width" Value="0" />
                        <Setter Target="SupportPanel.(Grid.Row)" Value="1" />
                        <Setter Target="SupportPanel.(Grid.Column)" Value="0" />
                        <Setter Target="SupportPanel.Margin" Value="0,16,0,0" />
                        <Setter Target="ContentStack.Margin" Value="16,24,16,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                x:Name="ContentStack"
                MaxWidth="{ThemeResource HardwareInspectionContentColumnWidth}"
                Margin="{ThemeResource HardwareInspectionPageMargin}"
                HorizontalAlignment="Center"
                Spacing="{ThemeResource HardwareInspectionMajorGap}">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="PageTitleTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                        FontSize="{ThemeResource HardwareInspectionPageTitleFontSize}"
                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                        Text="Hardware inspection"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="PageSubtitleTextBlock"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                        FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <controls:HardwareInspectionProgressCard
                    x:Name="ProgressCard"
                    Visibility="Collapsed" />
                <controls:HardwareInspectionActionCard
                    x:Name="ActiveActionCard"
                    Visibility="Collapsed" />

                <StackPanel
                    x:Name="TerminalPanel"
                    Spacing="{ThemeResource HardwareInspectionMajorGap}"
                    Visibility="Collapsed">
                    <controls:HardwareInspectionOutcomeCard x:Name="OutcomeCard" />
                    <controls:HardwareInspectionRecoveryCard
                        x:Name="RecoveryPanel"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="ReviewPanel"
                        Padding="24"
                        Background="{ThemeResource HardwareInspectionWarningSurfaceBrush}"
                        BorderBrush="{ThemeResource HardwareInspectionWarningBorderBrush}"
                        BorderThickness="{ThemeResource HardwareInspectionBorderThickness}"
                        CornerRadius="{ThemeResource HardwareInspectionCardCornerRadius}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <TextBlock
                                x:Name="ReviewHeadingTextBlock"
                                FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                FontSize="{ThemeResource HardwareInspectionSectionTitleFontSize}"
                                FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                                Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                                Text="What needs review" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{ThemeResource HardwareInspectionWarningTextBrush}"
                                    Text="!" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                                        Text="Neural processor" />
                                    <TextBlock
                                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                        Text="This optional detail could not be confirmed."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource HardwareInspectionWarningTextBrush}"
                                    Text="Could not check" />
                                <TextBlock
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource HardwareInspectionSuccessTextBrush}"
                                    Text="✓" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                                        Text="Memory information" />
                                    <TextBlock
                                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                        Text="A source difference was resolved using the reliable value."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource HardwareInspectionSuccessTextBrush}"
                                    Text="Resolved" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="LimitationPanel"
                        Padding="14,12"
                        Background="{ThemeResource HardwareInspectionAccentSurfaceBrush}"
                        BorderBrush="{ThemeResource HardwareInspectionAccentBorderBrush}"
                        BorderThickness="{ThemeResource HardwareInspectionBorderThickness}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                                FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                                Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                                Text="Hardware facts only" />
                            <TextBlock
                                FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                                Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                                Text="This report records hardware facts only. It does not decide whether the selected model will run."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                    <Grid x:Name="SummaryGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PrimaryColumn" Width="2*" />
                            <ColumnDefinition x:Name="SupportColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:HardwareInspectionSummaryCard x:Name="ComputerSummaryCard" />
                        <StackPanel
                            x:Name="SupportPanel"
                            Grid.Column="1"
                            Spacing="{ThemeResource HardwareInspectionMajorGap}">
                            <controls:HardwareInspectionSummaryCard x:Name="RuntimeSummaryCard" />
                            <controls:HardwareInspectionSummaryCard x:Name="SourcesSummaryCard" />
                        </StackPanel>
                    </Grid>
                    <controls:HardwareInspectionDetailsCard
                        x:Name="DetailsCard"
                        Visibility="Collapsed" />
                    <controls:HardwareInspectionActionCard
                        x:Name="ActionCard"
                        Visibility="Collapsed" />
                </StackPanel>
                <ContentPresenter
                    x:Name="FooterPresenter"
                    HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
