<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GraniteEdgeAI.Features.HardwareInspection.HardwareInspectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.HardwareInspection.Presentation.Controls">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/HardwareInspection/Presentation/HardwareInspectionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid
        x:Name="LayoutRoot"
        Background="{ThemeResource GraniteAppCanvasBrush}"
        SizeChanged="LayoutRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentStack.Margin" Value="16,24,16,24" />
                        <Setter Target="InspectionBay.Padding" Value="16,18,16,14" />
                        <Setter Target="IdentityStatusColumn.Width" Value="0" />
                        <Setter Target="InspectionIdentityStatus.(Grid.Row)" Value="1" />
                        <Setter Target="InspectionIdentityStatus.(Grid.Column)" Value="1" />
                        <Setter Target="InspectionIdentityStatus.Margin" Value="0,10,0,0" />
                        <Setter Target="InspectionIdentityStatus.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="IdentityStatusStates">
                <VisualState x:Name="IdentityInProgress">
                    <VisualState.Setters>
                        <Setter Target="InspectionIdentityStatus.Background" Value="{ThemeResource HardwareInspectionAccentSurfaceBrush}" />
                        <Setter Target="InspectionIdentityStatus.BorderBrush" Value="{ThemeResource HardwareInspectionAccentBorderBrush}" />
                        <Setter Target="InspectionIdentityStatusText.Foreground" Value="{ThemeResource HardwareInspectionAccentBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IdentityReady">
                    <VisualState.Setters>
                        <Setter Target="InspectionIdentityStatus.Background" Value="{ThemeResource HardwareInspectionSuccessSurfaceBrush}" />
                        <Setter Target="InspectionIdentityStatus.BorderBrush" Value="{ThemeResource HardwareInspectionSuccessBorderBrush}" />
                        <Setter Target="InspectionIdentityStatusText.Foreground" Value="{ThemeResource HardwareInspectionSuccessTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IdentityNeedsAttention">
                    <VisualState.Setters>
                        <Setter Target="InspectionIdentityStatus.Background" Value="{ThemeResource HardwareInspectionWarningSurfaceBrush}" />
                        <Setter Target="InspectionIdentityStatus.BorderBrush" Value="{ThemeResource HardwareInspectionWarningBorderBrush}" />
                        <Setter Target="InspectionIdentityStatusText.Foreground" Value="{ThemeResource HardwareInspectionWarningTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IdentityFailed">
                    <VisualState.Setters>
                        <Setter Target="InspectionIdentityStatus.Background" Value="{ThemeResource HardwareInspectionErrorSurfaceBrush}" />
                        <Setter Target="InspectionIdentityStatus.BorderBrush" Value="{ThemeResource HardwareInspectionErrorBorderBrush}" />
                        <Setter Target="InspectionIdentityStatusText.Foreground" Value="{ThemeResource HardwareInspectionErrorTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Visible"
            VerticalScrollMode="Auto">
          <Grid
              x:Name="ContentWidthHost"
              HorizontalAlignment="Left">
            <StackPanel
                x:Name="ContentStack"
                MaxWidth="{ThemeResource HardwareInspectionContentColumnWidth}"
                Margin="{ThemeResource HardwareInspectionPageMargin}"
                HorizontalAlignment="Stretch"
                Spacing="{ThemeResource HardwareInspectionMajorGap}">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="PageTitleTextBlock"
                        HorizontalAlignment="Stretch"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}"
                        FontSize="{ThemeResource HardwareInspectionPageTitleFontSize}"
                        FontWeight="{ThemeResource HardwareInspectionFontWeightBold}"
                        Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}"
                        Text="Hardware inspection"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords"
                        AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock
                        x:Name="PageSubtitleTextBlock"
                        HorizontalAlignment="Stretch"
                        FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}"
                        FontSize="{ThemeResource HardwareInspectionBodyFontSize}"
                        Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border
                    x:Name="InspectionBay"
                    MaxWidth="960"
                    Padding="24,20,24,16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{ThemeResource HardwareInspectionSurfaceBrush}"
                    BorderBrush="{ThemeResource HardwareInspectionBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    UseLayoutRounding="True"
                    AutomationProperties.AutomationId="HardwareInspectionBay"
                    AutomationProperties.Name="Hardware inspection">
                  <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="IdentityHeader" ColumnSpacing="14">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="IdentityStatusColumn" Width="176" />
                      </Grid.ColumnDefinitions>
                      <Border Width="48" Height="48" Background="{ThemeResource HardwareInspectionAccentSurfaceBrush}" CornerRadius="10">
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{ThemeResource HardwareInspectionAccentBrush}" Glyph="&#xE770;" AutomationProperties.AccessibilityView="Raw" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource HardwareInspectionTextPrimaryBrush}" Text="This computer" />
                        <TextBlock FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}" FontSize="12" Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}" Text="Hardware information is collected and processed locally on this device." TextWrapping="WrapWholeWords" />
                      </StackPanel>
                      <Border x:Name="InspectionIdentityStatus" Grid.Column="2" Height="32" Padding="12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{ThemeResource HardwareInspectionAccentSurfaceBrush}" BorderBrush="{ThemeResource HardwareInspectionAccentBorderBrush}" BorderThickness="1" CornerRadius="16">
                        <TextBlock x:Name="InspectionIdentityStatusText" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{ThemeResource HardwareInspectionFontFamilyBold}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HardwareInspectionAccentBrush}" Text="Inspection in progress" TextAlignment="Center" />
                      </Border>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{ThemeResource HardwareInspectionBorderBrush}" AutomationProperties.AccessibilityView="Raw" />

                    <Grid x:Name="HardwareStateHost" Grid.Row="2">
                      <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                        <controls:HardwareInspectionProgressCard x:Name="ProgressCard" />
                        <Border Margin="0,24,0,0" Padding="14,8" BorderBrush="{ThemeResource HardwareInspectionBorderBrush}" BorderThickness="0,1,0,0">
                          <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="ActiveSafetyTextBlock" HorizontalAlignment="Center" FontFamily="{ThemeResource HardwareInspectionFontFamilyRegular}" FontSize="12" Foreground="{ThemeResource HardwareInspectionTextSecondaryBrush}" Text="You can safely return to model inspection while this local check is running." TextAlignment="Center" TextWrapping="WrapWholeWords" />
                            <controls:HardwareInspectionActionCard x:Name="ActiveActionCard" />
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <StackPanel
                          x:Name="TerminalPanel"
                          Spacing="{ThemeResource HardwareInspectionMajorGap}"
                          Visibility="Collapsed">
                    <controls:HardwareInspectionOutcomeCard x:Name="OutcomeCard" />
                    <controls:HardwareInspectionRecoveryCard
                        x:Name="RecoveryPanel"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="LocalProcessingPanel"
                        Padding="14,12"
                        Background="{ThemeResource HardwareInspectionErrorSurfaceBrush}"
                        BorderBrush="{ThemeResource HardwareInspectionErrorBorderBrush}"
                        BorderThickness="{ThemeResource HardwareInspectionBorderThickness}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="LocalProcessingTextBlock"
                            FontSize="{ThemeResource HardwareInspectionHelperFontSize}"
                            Foreground="{ThemeResource HardwareInspectionErrorTextBrush}"
                            Text="Repair or reinstall the application before trying hardware inspection again."
                            TextWrapping="WrapWholeWords" />
                    </Border>
                    <controls:HardwareInspectionDetailsCard
                        x:Name="DetailsCard"
                        Visibility="Collapsed" />
                    <controls:HardwareInspectionActionCard
                        x:Name="ActionCard"
                        Visibility="Collapsed" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
                <ContentPresenter
                    x:Name="FooterPresenter"
                    HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
    </Grid>
</Page>
