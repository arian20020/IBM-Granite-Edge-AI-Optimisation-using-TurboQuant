<?xml version="1.0" encoding="utf-8" ?>

<!--
    Displays the model-format selection dialog above ModelImportPage.
    
    This uses a custom ContentDialog so the original page remains visible
    and dimmed in the background while the dialog is open.
-->
<ContentDialog
    x:Class="GraniteEdgeAI.Features.ModelImport.FileImport.ModelFormatSelectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelImport.FileImport"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootDialog"
    d:DesignHeight="580"
    d:DesignWidth="696"
    BorderThickness="1"
    CornerRadius="28"
    DefaultButton="None"
    mc:Ignorable="d">

    <!--
        Contains styles and shared interaction-state colours used
        throughout this dialog.
    -->
    <ContentDialog.Resources>

        <ResourceDictionary>

        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="ModelImportSurfaceBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ModelImportSubtleSurfaceBrush" Color="#F8FAFD" />
                <SolidColorBrush x:Key="ModelImportBorderBrush" Color="#D7E0EC" />
                <SolidColorBrush x:Key="ModelImportTextBrush" Color="#111827" />
                <SolidColorBrush x:Key="ModelImportMutedTextBrush" Color="#5B677A" />
                <SolidColorBrush x:Key="ModelImportSubtleTextBrush" Color="#758196" />
                <SolidColorBrush x:Key="ModelImportAccentBrush" Color="#0F62FE" />
                <SolidColorBrush x:Key="ModelImportOnAccentBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ModelImportAccentSurfaceBrush" Color="#EDF4FF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="ModelImportSurfaceBrush" Color="#151D2B" />
                <SolidColorBrush x:Key="ModelImportSubtleSurfaceBrush" Color="#1B2535" />
                <SolidColorBrush x:Key="ModelImportBorderBrush" Color="#344054" />
                <SolidColorBrush x:Key="ModelImportTextBrush" Color="#F9FAFB" />
                <SolidColorBrush x:Key="ModelImportMutedTextBrush" Color="#CBD5E1" />
                <SolidColorBrush x:Key="ModelImportSubtleTextBrush" Color="#98A2B3" />
                <SolidColorBrush x:Key="ModelImportAccentBrush" Color="#78A9FF" />
                <SolidColorBrush x:Key="ModelImportOnAccentBrush" Color="#111827" />
                <SolidColorBrush x:Key="ModelImportAccentSurfaceBrush" Color="#162B49" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="ModelImportSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="ModelImportSubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="ModelImportBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ModelImportTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ModelImportMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ModelImportSubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                <SolidColorBrush x:Key="ModelImportAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="ModelImportOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                <SolidColorBrush x:Key="ModelImportAccentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <!--
            Increases the standard maximum ContentDialog width so
            both model-format cards fit comfortably side by side.
        -->
        <x:Double
            x:Key="ContentDialogMaxWidth">
            760
        </x:Double>

        <!--
            Retains WinUI's normal ContentDialog focus, keyboard,
            accessibility and modal behaviour.
        -->
        <Style
            BasedOn="{StaticResource DefaultContentDialogStyle}"
            TargetType="local:ModelFormatSelectionCard">
            <Setter Property="Background" Value="{ThemeResource ModelImportSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ModelImportBorderBrush}" />
        </Style>

        <!--
            shared style for both model-format action buttons
        -->
        <Style
            x:Key="FormatActionButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">

            <!--  Gives both buttons identical dimensions.  -->
            <Setter Property="Height" Value="44" />

            <Setter Property="Padding" Value="18,0" />

            <!--  makes each button fill its card width  -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />

            <Setter Property="HorizontalContentAlignment" Value="Center" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <!--  Defines the standard blue button appearance.  -->
            <Setter Property="Background" Value="{ThemeResource ModelImportAccentBrush}" />

            <Setter Property="Foreground" Value="{ThemeResource ModelImportOnAccentBrush}" />

            <Setter Property="BorderBrush" Value="{ThemeResource ModelImportAccentBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="CornerRadius" Value="11" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="UseSystemFocusVisuals" Value="True" />

        </Style>

        <!--
            normal state used by both blue format buttons
        -->
        <SolidColorBrush
            x:Key="ButtonBackground"
            Color="{ThemeResource SystemColorHighlightColor}" />

        <SolidColorBrush
            x:Key="ButtonForeground"
            Color="{ThemeResource SystemColorHighlightTextColor}" />

        <SolidColorBrush
            x:Key="ButtonBorderBrush"
            Color="{ThemeResource SystemColorHighlightColor}" />

        <!--
            Pointer-over state.
            
            The button becomes slightly darker rather than turning white.
        -->
        <SolidColorBrush
            x:Key="ButtonBackgroundPointerOver"
            Color="{ThemeResource SystemColorHighlightColor}" />

        <SolidColorBrush
            x:Key="ButtonForegroundPointerOver"
            Color="{ThemeResource SystemColorHighlightTextColor}" />

        <SolidColorBrush
            x:Key="ButtonBorderBrushPointerOver"
            Color="{ThemeResource SystemColorHighlightColor}" />

        <!--
            Pressed state.
            
            The button becomes darker again while being clicked.
        -->
        <SolidColorBrush
            x:Key="ButtonBackgroundPressed"
            Color="{ThemeResource SystemColorHighlightColor}" />

        <SolidColorBrush
            x:Key="ButtonForegroundPressed"
            Color="{ThemeResource SystemColorHighlightTextColor}" />

        <SolidColorBrush
            x:Key="ButtonBorderBrushPressed"
            Color="{ThemeResource SystemColorHighlightColor}" />

        <!--
            Disabled state.
        -->
        <SolidColorBrush
            x:Key="ButtonBackgroundDisabled"
            Color="{ThemeResource SystemColorGrayTextColor}" />

        <SolidColorBrush
            x:Key="ButtonForegroundDisabled"
            Color="{ThemeResource SystemColorWindowColor}" />

        <SolidColorBrush
            x:Key="ButtonBorderBrushDisabled"
            Color="{ThemeResource SystemColorGrayTextColor}" />

        </ResourceDictionary>

    </ContentDialog.Resources>

    <!--
        Defines the complete dialog layout.
        
        A fixed width ensures that the two star-sized columns receive
        exactly the same amount of horizontal space.
    -->
    <Grid
        x:Name="RootLayout"
        Width="640"
        HorizontalAlignment="Center"
        RowSpacing="20">

        <!--
            Defines rows for the heading, supporting text, format cards,
            drag-and-drop message and custom Cancel footer.
        -->
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="280" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Displays the main dialog question.
        -->
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            FontSize="28"
            FontWeight="SemiBold"
            Foreground="{ThemeResource ModelImportTextBrush}"
            Text="What are you importing?"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!--
            Explains why the user must choose between the two formats.
        -->
        <TextBlock
            Grid.Row="1"
            MaxWidth="560"
            HorizontalAlignment="Center"
            FontSize="15"
            Foreground="{ThemeResource ModelImportMutedTextBrush}"
            Text="Choose the model format you will be importing."
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!--
            Places the two model-format cards beside one another.
        -->
        <Grid
            x:Name="FormatCardsGrid"
            Grid.Row="2"
            Width="640"
            Height="280"
            HorizontalAlignment="Center"
            ColumnSpacing="16">

            <!--
                Gives each model-format card exactly half of the
                available width.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                GGUF model-file option.
            -->
            <Border
                x:Name="GgufFormatCard"
                Grid.Column="0"
                Height="280"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource ModelImportSubtleSurfaceBrush}"
                BorderBrush="{ThemeResource ModelImportBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">

                <!--
                    uses fixed and flexible rows so both card buttons
                    remain aligned at the bottom
                -->
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="58" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="*" />
                        <RowDefinition
                            Height="44" />
                    </Grid.RowDefinitions>

                    <!--
                        Displays the GGUF document icon.
                    -->
                    <Border
                        Grid.Row="0"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                        CornerRadius="16">

                        <SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource ModelImportAccentBrush}"
                            Symbol="Document" />

                    </Border>

                    <!--
                        Displays the GGUF option title.
                    -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ModelImportTextBrush}"
                        Text="GGUF model file"
                        TextWrapping="Wrap" />

                    <!--
                        Describes what the user selects.
                    -->
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,7,0,0"
                        FontSize="14"
                        Foreground="{ThemeResource ModelImportMutedTextBrush}"
                        Text="Select one local .gguf file."
                        TextWrapping="Wrap" />

                    <!--
                        Provides extra compatibility information.
                    -->
                    <TextBlock
                        Grid.Row="3"
                        Margin="0,13,0,16"
                        VerticalAlignment="Top"
                        FontSize="13"
                        Foreground="{ThemeResource ModelImportSubtleTextBrush}"
                        Text="Best for llama.cpp-compatible models."
                        TextWrapping="Wrap" />

                    <!--
                        Opens the GGUF single-file picker after the
                        Click handler is connected.
                    -->
                    <Button
                        x:Name="GgufFormatButton"
                        Grid.Row="4"
                        AccessKey="G"
                        AutomationProperties.AutomationId="GgufFormatButton"
                        AutomationProperties.HelpText="Choose one local GGUF model file."
                        AutomationProperties.Name="Choose GGUF file"
                        Click="GgufFormatButton_ClickAsync"
                        Content="Choose GGUF file"
                        Style="{StaticResource FormatActionButtonStyle}"
                        TabIndex="0" />

                </Grid>

            </Border>

            <!--
                OpenVINO model-folder option.
            -->
            <Border
                x:Name="OpenVinoFormatCard"
                Grid.Column="1"
                Height="280"
                Padding="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource ModelImportSubtleSurfaceBrush}"
                BorderBrush="{ThemeResource ModelImportBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">

                <!--
                    Uses the same row layout as the GGUF card so all
                    content and buttons remain visually aligned.
                -->
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="58" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="*" />
                        <RowDefinition
                            Height="44" />
                    </Grid.RowDefinitions>

                    <!--
                        Displays the OpenVINO folder icon.
                    -->
                    <Border
                        Grid.Row="0"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                        CornerRadius="16">

                        <SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource ModelImportAccentBrush}"
                            Symbol="Folder" />

                    </Border>

                    <!--
                        Displays the OpenVINO option title.
                    -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ModelImportTextBrush}"
                        Text="OpenVINO model folder"
                        TextWrapping="Wrap" />

                    <!--
                        Describes what the user selects.
                    -->
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,7,0,0"
                        FontSize="14"
                        Foreground="{ThemeResource ModelImportMutedTextBrush}"
                        Text="Select the complete model folder."
                        TextWrapping="Wrap" />

                    <!--
                        Explains why the complete model folder is needed.
                    -->
                    <TextBlock
                        Grid.Row="3"
                        Margin="0,13,0,16"
                        VerticalAlignment="Top"
                        FontSize="13"
                        Foreground="{ThemeResource ModelImportSubtleTextBrush}"
                        Text="Includes XML, BIN and tokenizer files."
                        TextWrapping="Wrap" />

                    <!--
                        Opens the OpenVINO folder picker after the
                        Click handler is connected.
                    -->
                    <Button
                        x:Name="OpenVinoFormatButton"
                        Grid.Row="4"
                        AccessKey="O"
                        AutomationProperties.AutomationId="OpenVinoFormatButton"
                        AutomationProperties.HelpText="Choose the complete OpenVINO model folder."
                        AutomationProperties.Name="Choose OpenVINO folder"
                        Click="OpenVINOFormatButton_ClickAsync"
                        Content="Choose OpenVINO folder"
                        Style="{StaticResource FormatActionButtonStyle}"
                        TabIndex="1" />

                </Grid>

            </Border>

        </Grid>

        <!--
            Reminds users that drag and drop remains available.
        -->
        <TextBlock
            Grid.Row="3"
            MaxWidth="560"
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource ModelImportMutedTextBrush}"
            Text="You can also drag and drop a model directly onto the import page."
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!--
            Creates a custom footer.
            
            Using our own footer allows the Cancel button to be genuinely
            centred across the complete dialog.
        -->
        <Grid
            Grid.Row="4"
            Margin="0,4,0,-4"
            HorizontalAlignment="Stretch">

            <!--
                Separates the Cancel action from the main dialog content.
            -->
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="1" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Draws the subtle divider shown in the Figma design.
            -->
            <Border
                Grid.Row="0"
                Height="1"
                Margin="-28,0,-28,0"
                Background="{ThemeResource ModelImportBorderBrush}" />

            <!--
                Provides a borderless, horizontally centred Cancel action.
            -->
            <Button
                x:Name="CancelButton"
                Grid.Row="1"
                Width="136"
                Height="40"
                MinHeight="40"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="Cancel model-format selection"
                AutomationProperties.AutomationId="CancelModelFormatSelectionButton"
                AutomationProperties.HelpText="Close model-format selection without choosing a model."
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="CancelButton_Click"
                Content="Cancel"
                CornerRadius="10"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource ModelImportMutedTextBrush}"
                ToolTipService.ToolTip="Cancel model-format selection"
                TabIndex="2"
                UseSystemFocusVisuals="True">

                <!--
                    Overrides the global blue-button resources so the
                    Cancel action remains a quiet text-style button.
                -->
                <Button.Resources>

                    <!--  Normal state.  -->
                    <SolidColorBrush
                        x:Key="ButtonBackground"
                        Color="Transparent" />

                    <SolidColorBrush
                        x:Key="ButtonForeground"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="ButtonBorderBrush"
                        Color="Transparent" />

                    <!--  Hover state.  -->
                    <SolidColorBrush
                        x:Key="ButtonBackgroundPointerOver"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="ButtonForegroundPointerOver"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="ButtonBorderBrushPointerOver"
                        Color="Transparent" />

                    <!--  Pressed state.  -->
                    <SolidColorBrush
                        x:Key="ButtonBackgroundPressed"
                        Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush
                        x:Key="ButtonForegroundPressed"
                        Color="{ThemeResource SystemColorWindowTextColor}" />

                    <SolidColorBrush
                        x:Key="ButtonBorderBrushPressed"
                        Color="Transparent" />

                </Button.Resources>

            </Button>

        </Grid>

    </Grid>

</ContentDialog>
