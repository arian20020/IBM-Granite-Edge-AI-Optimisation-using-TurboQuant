<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="GraniteEdgeAI.Features.ModelImport.Controls.ImportModelCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ImportModelBadgeBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="ImportModelBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="ImportModelErrorBadgeBorderStyle" BasedOn="{StaticResource ImportModelBadgeBorderStyle}" TargetType="Border">
            <Setter Property="Height" Value="27" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{ThemeResource ModelImportErrorSurfaceBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid
        MinHeight="360"
        HorizontalAlignment="Stretch">

        <!--  STATE 1: AWAITING MODEL SELECTION  -->
        <Grid
            x:Name="AwaitingSelectionView"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            Visibility="Visible">

            <Rectangle
                x:Name="AwaitingSelectionBorder"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Fill="{ThemeResource ModelImportSurfaceBrush}"
                IsHitTestVisible="False"
                RadiusX="20"
                RadiusY="20"
                Stroke="{ThemeResource ModelImportBorderBrush}"
                StrokeDashArray="6,5"
                StrokeDashCap="Round"
                StrokeThickness="1.5"
                UseLayoutRounding="False" />

            <!-- Neutral 6%-opacity overlay: visible only while a native-valid file drag is over the card. -->
            <Rectangle
                x:Name="ValidDragHoverOverlay"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Fill="{ThemeResource ModelImportAccentSurfaceBrush}"
                IsHitTestVisible="False"
                RadiusX="20"
                RadiusY="20"
                Stroke="{ThemeResource ModelImportAccentBorderBrush}"
                StrokeDashArray="6,5"
                StrokeDashCap="Round"
                StrokeThickness="1.5"
                UseLayoutRounding="False"
                Visibility="Collapsed" />

            <ScrollViewer
                MaxHeight="300"
                HorizontalContentAlignment="Center"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ZoomMode="Disabled">
                <StackPanel
                    MaxWidth="600"
                    Margin="20"
                    HorizontalAlignment="Center"
                    Spacing="10">

                <FontIcon
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="30"
                    Foreground="{ThemeResource ModelImportAccentBrush}"
                    Glyph="&#xE8B7;" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource ModelImportTextBrush}"
                    Text="Drop a model here"
                    TextAlignment="Center" />

                <TextBlock
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource ModelImportMutedTextBrush}"
                    Text="GGUF file or OpenVINO model folder"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="ChooseModelFileButton"
                    Width="220"
                    Height="44"
                    MinHeight="44"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    AutomationProperties.AutomationId="ChooseModelFileButton"
                    AutomationProperties.Name="Choose model"
                    AutomationProperties.HelpText="Choose a GGUF model file or select OpenVINO to choose a model folder."
                    ToolTipService.ToolTip="Choose a GGUF file or OpenVINO model folder"
                    Background="{ThemeResource ModelImportAccentBrush}"
                    BorderBrush="{ThemeResource ModelImportAccentBrush}"
                    BorderThickness="1"
                    Click="BrowseFilesButton_Click"
                    Content="Choose model"
                    CornerRadius="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GraniteJourneyPrimaryForegroundBrush}"
                    UseSystemFocusVisuals="True">

                    <Button.Resources>
                        <SolidColorBrush
                            x:Key="ButtonBackground"
                            Color="#2563EB" />
                        <SolidColorBrush
                            x:Key="ButtonForeground"
                            Color="#FFFFFF" />
                        <SolidColorBrush
                            x:Key="ButtonBorderBrush"
                            Color="#2563EB" />

                        <SolidColorBrush
                            x:Key="ButtonBackgroundPointerOver"
                            Color="#1D4ED8" />
                        <SolidColorBrush
                            x:Key="ButtonForegroundPointerOver"
                            Color="#FFFFFF" />
                        <SolidColorBrush
                            x:Key="ButtonBorderBrushPointerOver"
                            Color="#1D4ED8" />

                        <SolidColorBrush
                            x:Key="ButtonBackgroundPressed"
                            Color="#1E40AF" />
                        <SolidColorBrush
                            x:Key="ButtonForegroundPressed"
                            Color="#FFFFFF" />
                        <SolidColorBrush
                            x:Key="ButtonBorderBrushPressed"
                            Color="#1E40AF" />

                        <SolidColorBrush
                            x:Key="ButtonBackgroundDisabled"
                            Color="#E5E7EB" />
                        <SolidColorBrush
                            x:Key="ButtonForegroundDisabled"
                            Color="#9CA3AF" />
                        <SolidColorBrush
                            x:Key="ButtonBorderBrushDisabled"
                            Color="#D1D5DB" />
                    </Button.Resources>

                </Button>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <Border
            x:Name="FolderAcceptedView"
            Height="360"
            Padding="12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{ThemeResource ModelImportSurfaceBrush}"
            BorderBrush="{ThemeResource ModelImportBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Visibility="Collapsed">

            <ScrollViewer
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ZoomMode="Disabled">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                        CornerRadius="15">

                        <Viewbox
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid Width="48" Height="48">
                                <Path
                                    Data="M10,4 L29,4 L42,17 L42,44 L10,44 Z M29,4 L29,17 L42,17"
                                    Stroke="{ThemeResource ModelImportAccentBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="2" />
                                <TextBlock
                                    Margin="0,22,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="7"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource ModelImportAccentBrush}"
                                    Text="OV"
                                    TextAlignment="Center" />
                            </Grid>
                        </Viewbox>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="3">
                        <TextBlock
                            x:Name="FolderAcceptedNameTextBlock"
                            HorizontalAlignment="Stretch"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            MaxLines="2"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource ModelImportSubtleTextBrush}"
                            Text="Selected local model folder"
                            MaxLines="2"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="{ThemeResource ModelImportAccentSurfaceBrush}" Style="{StaticResource ImportModelBadgeBorderStyle}">
                                <TextBlock x:Name="FolderAcceptedFormatTextBlock" Foreground="{ThemeResource ModelImportAccentBrush}" Style="{StaticResource ImportModelBadgeTextStyle}" Text="OpenVINO" />
                            </Border>
                            <Border Background="{ThemeResource ModelImportAccentSurfaceBrush}" Style="{StaticResource ImportModelBadgeBorderStyle}">
                                <TextBlock Foreground="{ThemeResource ModelImportAccentBrush}" Style="{StaticResource ImportModelBadgeTextStyle}" Text="IR" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button
                        x:Name="RemoveFolderAcceptedModelButton"
                        Grid.Column="2"
                        Grid.RowSpan="4"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="RemoveFolderAcceptedModelButton"
                        AutomationProperties.Name="Remove selected OpenVINO model"
                        AutomationProperties.HelpText="Remove this selected OpenVINO model folder and return to model selection."
                        ToolTipService.ToolTip="Remove selected OpenVINO model"
                        Background="{ThemeResource ModelImportSurfaceBrush}"
                        BorderBrush="{ThemeResource ModelImportErrorBorderBrush}"
                        BorderThickness="1"
                        Click="CancelScanButton_Click"
                        CornerRadius="11"
                        UseSystemFocusVisuals="True">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource ModelImportErrorBrush}"
                            Glyph="&#xE74D;" />

                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="#FF2D2D" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFC2C2" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF7F7" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#DC2626" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FCA5A5" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FEE2E2" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#B91C1C" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#F87171" />
                        </Button.Resources>
                    </Button>
                </Grid>

                <Rectangle
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Fill="{ThemeResource ModelImportBorderBrush}" />

                <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="PARAMETERS" /><TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="Pending" TextAlignment="Center" /></StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="ARCHITECTURE" /><TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="OpenVINO IR" TextAlignment="Center" /></StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="FILE SIZE" /><TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="Model folder" TextAlignment="Center" /></StackPanel>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="DECLARED CONTEXT" /><TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="Pending" TextAlignment="Center" /></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="RUNTIME ROUTE" /><TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="OpenVINO GenAI" TextAlignment="Center" /></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="NEXT STEP" /><TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="Model inspection" TextAlignment="Center" /></StackPanel>
                </Grid>

                <Border
                    Grid.Row="3"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource ModelImportSuccessSurfaceBrush}"
                    CornerRadius="17">
                    <Grid
                        Margin="12,5"
                        VerticalAlignment="Center"
                        ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            FontSize="15"
                            Foreground="{ThemeResource ModelImportSuccessBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportSuccessBrush}"
                            Text="Model folder imported · Ready for model inspection"
                            TextWrapping="WrapWholeWords"
                            ToolTipService.ToolTip="Model folder imported · Ready for model inspection" />
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
        </Border>

        <!--  STATE 2: GGUF QUICK SCAN IN PROGRESS  -->
        <Border
            x:Name="ScanningView"
            Height="360"
            Padding="32,18,32,16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{ThemeResource ModelImportSurfaceBrush}"
            BorderBrush="{ThemeResource ModelImportBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="22"
            Visibility="Collapsed">

            <ScrollViewer
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ZoomMode="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto"
                        MinHeight="112" />
                    <RowDefinition
                        Height="1" />
                    <RowDefinition
                        Height="Auto"
                        MinHeight="79" />
                    <RowDefinition
                        Height="Auto"
                        MinHeight="34" />
                </Grid.RowDefinitions>

                <!--  Selected model header  -->
                <Grid
                    Grid.Row="0"
                    ColumnSpacing="14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="58" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="40" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                        CornerRadius="15">

                        <Viewbox
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Grid
                                Width="48"
                                Height="48">

                                <Path
                                    Data="M10,4 L29,4 L42,17 L42,44 L10,44 Z M29,4 L29,17 L42,17"
                                    Stroke="{ThemeResource ModelImportAccentBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="2" />

                                <TextBlock
                                    Margin="0,22,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="7"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource ModelImportAccentBrush}"
                                    Text="GGUF" />

                            </Grid>

                        </Viewbox>

                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="3">

                        <TextBlock
                            x:Name="ScanningFileNameTextBlock"
                            HorizontalAlignment="Stretch"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            MaxLines="2"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource ModelImportSubtleTextBrush}"
                            Text="Selected local model"
                            MaxLines="2"
                            TextWrapping="WrapWholeWords" />

                        <Border
                            Margin="0,4,0,0"
                            Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                            Style="{StaticResource ImportModelBadgeBorderStyle}">

                            <TextBlock
                                Foreground="{ThemeResource ModelImportAccentBrush}"
                                Style="{StaticResource ImportModelBadgeTextStyle}"
                                Text="GGUF" />

                        </Border>

                    </StackPanel>

                    <Button
                        x:Name="CancelScanButton"
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="CancelQuickScanButton"
                        AutomationProperties.Name="Remove selected model and cancel quick scan"
                        AutomationProperties.HelpText="Cancel the current quick scan, remove the selected model, and return to model selection."
                        ToolTipService.ToolTip="Cancel quick scan"
                        Background="{ThemeResource ModelImportSurfaceBrush}"
                        BorderBrush="{ThemeResource ModelImportErrorBorderBrush}"
                        BorderThickness="1"
                        Click="CancelScanButton_Click"
                        CornerRadius="11"
                        UseSystemFocusVisuals="True">

                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource ModelImportErrorBrush}"
                            Glyph="&#xE74D;" />

                        <Button.Resources>
                            <SolidColorBrush
                                x:Key="ButtonBackground"
                                Color="#FFFFFF" />
                            <SolidColorBrush
                                x:Key="ButtonForeground"
                                Color="#FF2D2D" />
                            <SolidColorBrush
                                x:Key="ButtonBorderBrush"
                                Color="#FFC2C2" />

                            <SolidColorBrush
                                x:Key="ButtonBackgroundPointerOver"
                                Color="#FFF7F7" />
                            <SolidColorBrush
                                x:Key="ButtonForegroundPointerOver"
                                Color="#DC2626" />
                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPointerOver"
                                Color="#FCA5A5" />

                            <SolidColorBrush
                                x:Key="ButtonBackgroundPressed"
                                Color="#FEE2E2" />
                            <SolidColorBrush
                                x:Key="ButtonForegroundPressed"
                                Color="#B91C1C" />
                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPressed"
                                Color="#F87171" />
                        </Button.Resources>

                    </Button>

                </Grid>

                <Rectangle
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Fill="{ThemeResource ModelImportBorderBrush}" />

                <!--  Metadata skeletons  -->
                <Grid
                    Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="185" />
                        <ColumnDefinition
                            Width="200" />
                        <ColumnDefinition
                            Width="175" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top"
                        Spacing="10">

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="PARAMETERS" />

                        <Border
                            Width="78"
                            Height="14"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource ModelImportBorderBrush}"
                            CornerRadius="7" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top"
                        Spacing="10">

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="ARCHITECTURE" />

                        <Border
                            Width="116"
                            Height="14"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource ModelImportBorderBrush}"
                            CornerRadius="7" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top"
                        Spacing="10">

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="FILE SIZE" />

                        <Border
                            Width="84"
                            Height="14"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource ModelImportBorderBrush}"
                            CornerRadius="7" />

                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top"
                        Spacing="10">

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="DECLARED CONTEXT" />

                        <Border
                            Width="126"
                            Height="14"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource ModelImportBorderBrush}"
                            CornerRadius="7" />

                    </StackPanel>

                </Grid>

                <!--  Quick-scan status  -->
                <Border
                    Grid.Row="3"
                    Height="34"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                    CornerRadius="17">

                    <StackPanel
                        Margin="12,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">

                        <ProgressRing
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Quick scan in progress"
                            Foreground="{ThemeResource ModelImportAccentBrush}"
                            IsActive="True" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportAccentBrush}"
                            Text="Quick scan in progress · Reading model metadata"
                            TextWrapping="NoWrap" />

                    </StackPanel>

                </Border>

            </Grid>
            </ScrollViewer>

        </Border>

        <!--  STATE 3: GGUF QUICK SCAN FAILED  -->
        <Border
            x:Name="FailureView"
            MinHeight="360"
            MaxHeight="480"
            MaxWidth="804"
            Padding="32,18,32,24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{ThemeResource ModelImportSurfaceBrush}"
            BorderBrush="{ThemeResource ModelImportBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="22"
            Visibility="Collapsed">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition
                        Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Selected model header  -->
                <Grid
                    x:Name="FailureHeaderGrid"
                    Grid.Row="0"
                    ColumnSpacing="14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="58" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="40" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                        CornerRadius="15">

                        <Grid>
                            <Viewbox
                                x:Name="FailureGgufIcon"
                                Width="38"
                                Height="38"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Grid
                                    Width="48"
                                    Height="48">

                                    <Path
                                        Data="M10,4 L29,4 L42,17 L42,44 L10,44 Z M29,4 L29,17 L42,17"
                                        Stroke="{ThemeResource ModelImportAccentBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="2" />

                                    <TextBlock
                                        Margin="0,22,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="7"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource ModelImportAccentBrush}"
                                        Text="GGUF" />

                                </Grid>

                            </Viewbox>

                            <FontIcon
                                x:Name="FailureFolderIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="26"
                                Foreground="{ThemeResource ModelImportAccentBrush}"
                                Glyph="&#xE8B7;"
                                Visibility="Collapsed" />
                        </Grid>

                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="3">

                        <TextBlock
                            x:Name="FailureFileNameTextBlock"
                            HorizontalAlignment="Stretch"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            MaxLines="2"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            x:Name="FailureSourceSubtitleTextBlock"
                            FontSize="12"
                            Foreground="{ThemeResource ModelImportSubtleTextBrush}"
                            Text="Selected local model"
                            MaxLines="2"
                            TextWrapping="WrapWholeWords" />

                        <Border
                            x:Name="FailureFormatBadgeBorder"
                            Margin="0,0,0,6"
                            Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                            Style="{StaticResource ImportModelBadgeBorderStyle}">

                            <TextBlock
                                x:Name="FailureFormatBadgeTextBlock"
                                Foreground="{ThemeResource ModelImportAccentBrush}"
                                Style="{StaticResource ImportModelBadgeTextStyle}"
                                Text="GGUF" />

                        </Border>

                    </StackPanel>

                    <Button
                        x:Name="RemoveFailedModelButton"
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="RemoveFailedModelButton"
                        AutomationProperties.Name="Remove failed model"
                        AutomationProperties.HelpText="Remove this failed model and return to model selection."
                        ToolTipService.ToolTip="Remove failed model"
                        Background="{ThemeResource ModelImportSurfaceBrush}"
                        BorderBrush="{ThemeResource ModelImportErrorBorderBrush}"
                        BorderThickness="1"
                        Click="CancelScanButton_Click"
                        CornerRadius="11"
                        UseSystemFocusVisuals="True">

                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource ModelImportErrorBrush}"
                            Glyph="&#xE74D;" />

                        <Button.Resources>
                            <SolidColorBrush
                                x:Key="ButtonBackground"
                                Color="#FFFFFF" />
                            <SolidColorBrush
                                x:Key="ButtonForeground"
                                Color="#FF2D2D" />
                            <SolidColorBrush
                                x:Key="ButtonBorderBrush"
                                Color="#FFC2C2" />

                            <SolidColorBrush
                                x:Key="ButtonBackgroundPointerOver"
                                Color="#FFF7F7" />
                            <SolidColorBrush
                                x:Key="ButtonForegroundPointerOver"
                                Color="#DC2626" />
                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPointerOver"
                                Color="#FCA5A5" />

                            <SolidColorBrush
                                x:Key="ButtonBackgroundPressed"
                                Color="#FEE2E2" />
                            <SolidColorBrush
                                x:Key="ButtonForegroundPressed"
                                Color="#B91C1C" />
                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPressed"
                                Color="#F87171" />
                        </Button.Resources>

                    </Button>

                </Grid>

                <Rectangle
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Fill="{ThemeResource ModelImportBorderBrush}" />

                <!--
                    keep the selected-model identity and divider stationary. only
                    unusually long diagnostics scroll, so ordinary failures remain
                    compact while every recovery instruction stays reachable
                -->
                <ScrollViewer
                    Grid.Row="2"
                    MaxHeight="300"
                    Margin="0,16,0,0"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    ZoomMode="Disabled">

                <!--  Failure details  -->
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8">

                        <Border
                            Width="18"
                            Height="18"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ModelImportErrorSurfaceBrush}"
                            CornerRadius="9">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{ThemeResource ModelImportErrorBrush}"
                                Text="!" />

                        </Border>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{ThemeResource ModelImportErrorBrush}"
                            Text="QUICK SCAN FAILED" />

                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ModelImportTextBrush}"
                        Text="Model could not be imported" />

                    <Grid
                        Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="178" />
                            <ColumnDefinition
                                Width="24" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Spacing="5">

                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource ModelImportMutedTextBrush}"
                                Text="FAILURE CODE" />

                            <Border
                                Style="{StaticResource ImportModelErrorBadgeBorderStyle}">

                                <TextBlock
                                    x:Name="FailureCodeTextBlock"
                                    Foreground="{ThemeResource ModelImportErrorBrush}"
                                    Style="{StaticResource ImportModelBadgeTextStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="154" />

                            </Border>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Spacing="4">

                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource ModelImportMutedTextBrush}"
                                Text="MESSAGE" />

                            <TextBlock
                                x:Name="FailureMessageTextBlock"
                                FontSize="13"
                                Foreground="{ThemeResource ModelImportMutedTextBrush}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Grid>

                    <!--
                        Displays recovery guidance in a content-sized panel.

                        MinHeight preserves the intended visual weight, while automatic
                        sizing prevents wrapped guidance from being clipped.
                    -->
                    <Border
                        Grid.Row="3"
                        MinHeight="60"
                        Margin="0,0,0,0"
                        Padding="14,6"
                        Background="{ThemeResource ModelImportErrorSurfaceBrush}"
                        BorderBrush="{ThemeResource ModelImportErrorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">

                        <!--  Arranges the numbered recovery steps vertically.  -->
                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="3">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="16" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource ModelImportErrorBrush}"
                                    Text="1." />

                                <TextBlock
                                    x:Name="FailureRecoveryPrimaryTextBlock"
                                    Grid.Column="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource ModelImportMutedTextBrush}"
                                    Text="Make sure the file is a valid GGUF model with the required header and metadata."
                                    TextWrapping="Wrap" />

                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="16" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource ModelImportErrorBrush}"
                                    Text="2." />

                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource ModelImportMutedTextBrush}"
                                    Text="Otherwise, remove this model and import another one."
                                    TextWrapping="Wrap" />

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>

                </ScrollViewer>

            </Grid>

        </Border>

        <!--  STATE 4: GGUF QUICK SCAN SUCCEEDED  -->
        <Border
            x:Name="SuccessView"
            Height="360"
            Padding="12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{ThemeResource ModelImportSurfaceBrush}"
            BorderBrush="{ThemeResource ModelImportBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Visibility="Collapsed">

            <ScrollViewer
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ZoomMode="Disabled">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <!--  Selected-model header.  -->
                    <RowDefinition Height="Auto" />

                    <!--  Divider.  -->
                    <RowDefinition
                        Height="1" />

                    <!--  Metadata values.  -->
                    <RowDefinition Height="*" />

                    <!--  Completion status.  -->
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!--  Selected-model header  -->
                <Grid
                    Grid.Row="0"
                    ColumnSpacing="14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <!--  GGUF document icon  -->
                    <Border
                        Grid.Column="0"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                        CornerRadius="15">

                        <Viewbox
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Grid
                                Width="48"
                                Height="48">

                                <Path
                                    Data="M10,4 L29,4 L42,17 L42,44 L10,44 Z M29,4 L29,17 L42,17"
                                    Stroke="{ThemeResource ModelImportAccentBrush}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="2" />

                                <TextBlock
                                    Margin="0,22,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="7"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource ModelImportAccentBrush}"
                                    Text="GGUF" />

                            </Grid>

                        </Viewbox>

                    </Border>

                    <!--  model name, filename and badges  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="3">

                        <TextBlock
                            x:Name="SuccessModelNameTextBlock"
                            HorizontalAlignment="Stretch"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            x:Name="SuccessFileNameTextBlock"
                            HorizontalAlignment="Stretch"
                            FontSize="12"
                            Foreground="{ThemeResource ModelImportSubtleTextBrush}"
                            TextWrapping="WrapWholeWords" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">

                            <!--  Format badge  -->
                            <Border
                                Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                                Style="{StaticResource ImportModelBadgeBorderStyle}">

                                <TextBlock
                                    Foreground="{ThemeResource ModelImportAccentBrush}"
                                    Style="{StaticResource ImportModelBadgeTextStyle}"
                                    Text="GGUF" />

                            </Border>

                            <!--  Quantisation badge  -->
                            <Border
                                Background="{ThemeResource ModelImportAccentSurfaceBrush}"
                                Style="{StaticResource ImportModelBadgeBorderStyle}">

                                <TextBlock
                                    x:Name="SuccessQuantizationTextBlock"
                                    Foreground="{ThemeResource ModelImportAccentBrush}"
                                    Style="{StaticResource ImportModelBadgeTextStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />

                            </Border>

                        </StackPanel>

                    </StackPanel>

                    <!--  remove imported model  -->
                    <Button
                        x:Name="RemoveSucceededModelButton"
                        Grid.Column="2"
                        Grid.RowSpan="4"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        MinHeight="40"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="RemoveSucceededModelButton"
                        AutomationProperties.Name="Remove imported model"
                        AutomationProperties.HelpText="Remove this imported model and return to model selection."
                        ToolTipService.ToolTip="Remove imported model"
                        Background="{ThemeResource ModelImportSurfaceBrush}"
                        BorderBrush="{ThemeResource ModelImportErrorBorderBrush}"
                        BorderThickness="1"
                        Click="CancelScanButton_Click"
                        CornerRadius="11"
                        UseSystemFocusVisuals="True">

                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource ModelImportErrorBrush}"
                            Glyph="&#xE74D;" />

                        <Button.Resources>
                            <SolidColorBrush
                                x:Key="ButtonBackground"
                                Color="#FFFFFF" />

                            <SolidColorBrush
                                x:Key="ButtonForeground"
                                Color="#FF2D2D" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrush"
                                Color="#FFC2C2" />

                            <SolidColorBrush
                                x:Key="ButtonBackgroundPointerOver"
                                Color="#FFF7F7" />

                            <SolidColorBrush
                                x:Key="ButtonForegroundPointerOver"
                                Color="#DC2626" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPointerOver"
                                Color="#FCA5A5" />

                            <SolidColorBrush
                                x:Key="ButtonBackgroundPressed"
                                Color="#FEE2E2" />

                            <SolidColorBrush
                                x:Key="ButtonForegroundPressed"
                                Color="#B91C1C" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPressed"
                                Color="#F87171" />
                        </Button.Resources>

                    </Button>

                </Grid>

                <!--  Header divider  -->
                <Rectangle
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Fill="{ThemeResource ModelImportBorderBrush}" />

                <!--  successful metadata values  -->
                <Grid
                    Grid.Row="2"
                    ColumnSpacing="10"
                    RowSpacing="6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Parameters  -->
                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="3">

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="PARAMETERS"
                            TextAlignment="Center" />

                        <TextBlock
                            x:Name="SuccessParametersTextBlock"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />

                    </StackPanel>

                    <!--  Architecture  -->
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="3">

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="ARCHITECTURE"
                            TextAlignment="Center" />

                        <TextBlock
                            x:Name="SuccessArchitectureTextBlock"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />

                    </StackPanel>

                    <!--  File size  -->
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="3">

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="FILE SIZE"
                            TextAlignment="Center" />

                        <TextBlock
                            x:Name="SuccessFileSizeTextBlock"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />

                    </StackPanel>

                    <!--  Declared context  -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="3">

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="DECLARED CONTEXT"
                            TextAlignment="Center" />

                        <TextBlock
                            x:Name="SuccessDeclaredContextTextBlock"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />

                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="RUNTIME ROUTE" TextAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="llama.cpp" TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="NEXT STEP" TextAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="Model inspection" TextAlignment="Center" />
                    </StackPanel>

                </Grid>

                <!--  successful quick-scan status  -->
                <Border
                    Grid.Row="3"
                    Height="40"
                    Padding="12,0"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource ModelImportSuccessSurfaceBrush}"
                    CornerRadius="17">

                    <!--
                        the grid gives the icon a fixed inset from the rounded edge
                        and keeps both the icon and message vertically centred
                    -->
                    <Grid
                        VerticalAlignment="Stretch">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="16" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  successful scan indicator  -->
                        <Border
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ModelImportSuccessBrush}"
                            CornerRadius="8">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{ThemeResource GraniteJourneyPrimaryForegroundBrush}"
                                Text="✓"
                                TextAlignment="Center" />

                        </Border>

                        <!--  successful scan message  -->
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportSuccessBrush}"
                            Text="Quick scan complete · Ready for model inspection"
                            TextAlignment="Left"
                            TextWrapping="NoWrap" />

                    </Grid>

                </Border>

            </Grid>
            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>
