<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="GraniteEdgeAI.Features.ModelImport.ModelDownload.ModelDownloadCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelImport.ModelDownload"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="CardLayoutRoot">
        <!--
            TODO(THEMING):
            Move repeated colours, spacing and corner radii into shared theme resources.
            This will eventually support consistent styling and dark mode.
        -->
        <Border
            Padding="20"
            Background="#F9FAFB"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="20">

            <!--  Arranges the card content vertically.  -->
            <StackPanel
                Spacing="8">

                <!--
                    TODO(MODEL DATA):
                    The values below are temporary development seed data.
                    
                    Planned data flow:
                    ModelSeedData or ModelCatalogService
                    → ModelImportViewModel.SelectedModel
                    → ModelCard.Model
                    → these TextBlock bindings.
                -->
                <Grid
                    x:Name="ModelHeaderGrid"
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>

                        <!--  Uses the remaining width for the model name.  -->
                        <ColumnDefinition
                            Width="*" />

                        <!--  Uses only the width required by the package summary.  -->
                        <ColumnDefinition
                            Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        TEMPORARY SEED VALUE:
                        Future source: ModelProfile.DisplayName.
                    -->
                    <TextBlock
                        x:Name="ModelNameText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        Text="Verified recommendation required"
                        TextTrimming="None"
                        TextWrapping="WrapWholeWords" />

                    <!--
                        TEMPORARY SEED VALUES:
                        Parameter count will come from ModelProfile.
                        Download size must come from the exact downloadable file metadata.
                        ModelCard should never calculate or guess the download size.
                    -->
                    <TextBlock
                        x:Name="ModelPackageSummaryText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#6B7280"
                        Text="Not available"
                        TextAlignment="Right"
                        TextTrimming="None"
                        TextWrapping="WrapWholeWords" />

                </Grid>

                <!--
                    TEMPORARY SEED VALUE:
                    Future source: ModelProfile.Description.
                    The model catalogue will provide this description.
                -->
                <TextBlock
                    x:Name="ModelDescriptionText"
                    FontSize="14"
                    Foreground="#6B7280"
                    Text="Connect a verified model catalogue to view a recommendation."
                    TextTrimming="None"
                    TextWrapping="WrapWholeWords" />

                <Grid
                    x:Name="ModelFactsGrid"
                    Margin="0,4,0,0"
                    ColumnSpacing="16"
                    RowSpacing="4">

                    <!--  Creates four equally sized property columns.  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            x:Name="FactsColumn2"
                            Width="*" />
                        <ColumnDefinition
                            x:Name="FactsColumn3"
                            Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Supports one wide label/value pair or two stacked narrow pairs.  -->
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        STATIC UI:
                        These labels describe the fields and do not depend on the model.
                    -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"
                        Text="FORMAT" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"
                        Text="QUANTIZATION" />

                    <TextBlock
                        x:Name="EstimatedMemoryLabelText"
                        Grid.Row="0"
                        Grid.Column="2"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"
                        Text="ESTIMATED MEMORY"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="ContextLengthLabelText"
                        Grid.Row="0"
                        Grid.Column="3"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#6B7280"
                        Text="CONTEXT LENGTH"
                        TextWrapping="Wrap" />

                    <!--
                        TEMPORARY SEED VALUE:
                        Future source: the selected downloadable artifact's format.
                        This may be GGUF or OpenVINO IR.
                    -->
                    <TextBlock
                        x:Name="ModelFormatValueText"
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        Text="Not available" />

                    <!--
                        TEMPORARY SEED VALUE:
                        Future source: the selected artifact's quantization metadata.
                    -->
                    <TextBlock
                        x:Name="ModelOptimizationValueText"
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        Text="Not available" />

                    <!--
                        DYNAMIC RESULT:
                        This must eventually come from ModelCompatibilityService.
                        That service will combine model requirements with results from
                        DeviceProfileService and the project's Intel hardware benchmarks.
                    -->
                    <TextBlock
                        x:Name="EstimatedMemoryValueText"
                        Grid.Row="1"
                        Grid.Column="2"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        Text="Not available"
                        TextTrimming="None"
                        TextWrapping="WrapWholeWords" />

                    <!--
                        TEMPORARY SEED VALUE:
                        Future source: ModelProfile.ContextLengthTokens.
                        This should come from verified model configuration metadata.
                    -->
                    <TextBlock
                        x:Name="ContextLengthValueText"
                        Grid.Row="1"
                        Grid.Column="3"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        Text="Not available"
                        TextTrimming="None"
                        TextWrapping="WrapWholeWords" />

                </Grid>

                <!--  Separates the model details from the model-preference control.  -->
                <Rectangle
                    Height="1"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Stretch"
                    Fill="#E5E7EB" />

                <!--  Groups the slider heading, control and endpoint labels.  -->
                <StackPanel
                    Margin="0,2,0,0"
                    Spacing="2">

                    <!--  Displays the slider heading and current preference.  -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#6B7280"
                            Text="MODEL PREFERENCE" />

                        <!--
                            TEMPORARY SEED VALUE:
                            This will later bind to ModelImportViewModel and change
                            while the user moves the slider.
                        -->
                        <TextBlock
                            x:Name="ModelScaleValueText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#2563EB"
                            Text="Balanced" />

                    </Grid>

                    <!--
                        CONTINUOUS PREFERENCE CONTROL:
                        
                        The slider travels from 0 to 100.
                        
                        StepFrequency="0.1" provides 1,001 possible positions, making
                        pointer movement feel continuous rather than snapping to five stages.
                        
                        The ViewModel will later translate ranges of values into exact
                        downloadable model packages.
                    -->
                    <local:ModelPreferenceSlider
                        x:Name="ModelScaleSlider"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.HelpText="Choose between maximum efficiency and maximum model capability"
                        AutomationProperties.Name="Model preference"
                        IsThumbToolTipEnabled="False"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="1"
                        SnapsTo="StepValues"
                        StepFrequency="0.1"
                        TickPlacement="None"
                        UseSystemFocusVisuals="True"
                        ValueChanged="ModelScaleSlider_ValueChanged"
                        Value="50">

                        <local:ModelPreferenceSlider.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="ms-appx:///Features/ModelImport/ModelDownload/ModelPreferenceSliderTheme.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </local:ModelPreferenceSlider.Resources>

                    </local:ModelPreferenceSlider>

                    <!--  Explains what the two ends of the scale represent.  -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="EfficiencyEndpointText"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Foreground="#6B7280"
                            Text="Maximum efficiency"
                            TextTrimming="None"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            x:Name="CapabilityEndpointText"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="#6B7280"
                            Text="Maximum capability"
                            TextAlignment="Right"
                            TextTrimming="None"
                            TextWrapping="WrapWholeWords" />

                    </Grid>

                </StackPanel>

                <Button
                    x:Name="DownloadModelButton"
                    Height="48"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    AutomationProperties.AutomationId="RecommendedModelDownload.Start"
                    AutomationProperties.HelpText="Available only when a verified model offer and download service are connected"
                    AutomationProperties.Name="Download the selected model"
                    Background="#2563EB"
                    BorderBrush="#2563EB"
                    BorderThickness="1"
                    Content="Download selected model"
                    CornerRadius="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    IsEnabled="False"
                    Click="DownloadModelButton_Click"
                    UseSystemFocusVisuals="True">

                    <!--
                        TODO(THEMING):
                        Move these repeated button colours into shared resources
                        so BrowseModelButton and DownloadModelButton use one style.
                    -->
                    <Button.Resources>

                        <!--  Normal state.  -->
                        <SolidColorBrush
                            x:Key="ButtonBackground"
                            Color="#2563EB" />

                        <SolidColorBrush
                            x:Key="ButtonForeground"
                            Color="#FFFFFF" />

                        <SolidColorBrush
                            x:Key="ButtonBorderBrush"
                            Color="#2563EB" />

                        <!--  Mouse-hover state.  -->
                        <SolidColorBrush
                            x:Key="ButtonBackgroundPointerOver"
                            Color="#1D4ED8" />

                        <SolidColorBrush
                            x:Key="ButtonForegroundPointerOver"
                            Color="#FFFFFF" />

                        <SolidColorBrush
                            x:Key="ButtonBorderBrushPointerOver"
                            Color="#1D4ED8" />

                        <!--  Pressed state.  -->
                        <SolidColorBrush
                            x:Key="ButtonBackgroundPressed"
                            Color="#1E40AF" />

                        <SolidColorBrush
                            x:Key="ButtonForegroundPressed"
                            Color="#FFFFFF" />

                        <SolidColorBrush
                            x:Key="ButtonBorderBrushPressed"
                            Color="#1E40AF" />

                        <!--  Disabled state.  -->
                        <SolidColorBrush
                            x:Key="ButtonBackgroundDisabled"
                            Color="#E5E7EB" />

                        <SolidColorBrush
                            x:Key="ButtonForegroundDisabled"
                            Color="#9CA3AF" />

                        <SolidColorBrush
                            x:Key="ButtonBorderBrushDisabled"
                            Color="#D1D5DB" />

                    </Button.Resources>

                </Button>

                <ProgressBar
                    x:Name="DownloadProgressBar"
                    Height="6"
                    AutomationProperties.AutomationId="RecommendedModelDownload.Progress"
                    AutomationProperties.Name="Recommended model download progress"
                    IsIndeterminate="True"
                    Maximum="100"
                    Minimum="0"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="DownloadStatusText"
                    AutomationProperties.AutomationId="RecommendedModelDownload.Status"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Recommended model download status"
                    Foreground="#374151"
                    Text="A verified model recommendation is not available yet."
                    TextTrimming="None"
                    TextWrapping="WrapWholeWords" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="CancelDownloadButton"
                        Grid.Column="0"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RecommendedModelDownload.Cancel"
                        AutomationProperties.Name="Cancel model download"
                        Click="CancelDownloadButton_Click"
                        Content="Cancel download"
                        UseSystemFocusVisuals="True"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="RetryDownloadButton"
                        Grid.Column="1"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RecommendedModelDownload.Retry"
                        AutomationProperties.Name="Retry model download"
                        Click="RetryDownloadButton_Click"
                        Content="Try download again"
                        UseSystemFocusVisuals="True"
                        Visibility="Collapsed" />
                </Grid>

            </StackPanel>

        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup
                x:Name="CardLayoutStates">

                <VisualState
                    x:Name="NarrowLayout">

                    <VisualState.StateTriggers>
                        <AdaptiveTrigger
                            MinWindowWidth="0" />
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter Target="ModelPackageSummaryText.(Grid.Row)" Value="1" />
                        <Setter Target="ModelPackageSummaryText.(Grid.Column)" Value="0" />
                        <Setter Target="ModelPackageSummaryText.HorizontalAlignment" Value="Left" />
                        <Setter Target="ModelPackageSummaryText.TextAlignment" Value="Left" />
                        <Setter Target="ModelPackageSummaryText.Margin" Value="0,4,0,0" />
                        <Setter Target="FactsColumn2.Width" Value="0" />
                        <Setter Target="FactsColumn3.Width" Value="0" />
                        <Setter Target="EstimatedMemoryLabelText.(Grid.Row)" Value="2" />
                        <Setter Target="EstimatedMemoryLabelText.(Grid.Column)" Value="0" />
                        <Setter Target="EstimatedMemoryValueText.(Grid.Row)" Value="3" />
                        <Setter Target="EstimatedMemoryValueText.(Grid.Column)" Value="0" />
                        <Setter Target="ContextLengthLabelText.(Grid.Row)" Value="2" />
                        <Setter Target="ContextLengthLabelText.(Grid.Column)" Value="1" />
                        <Setter Target="ContextLengthValueText.(Grid.Row)" Value="3" />
                        <Setter Target="ContextLengthValueText.(Grid.Column)" Value="1" />
                    </VisualState.Setters>

                </VisualState>

                <VisualState
                    x:Name="WideLayout">

                    <VisualState.StateTriggers>
                        <AdaptiveTrigger
                            MinWindowWidth="720" />
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter Target="ModelPackageSummaryText.(Grid.Row)" Value="0" />
                        <Setter Target="ModelPackageSummaryText.(Grid.Column)" Value="1" />
                        <Setter Target="ModelPackageSummaryText.HorizontalAlignment" Value="Right" />
                        <Setter Target="ModelPackageSummaryText.TextAlignment" Value="Right" />
                        <Setter Target="ModelPackageSummaryText.Margin" Value="0" />
                        <Setter Target="FactsColumn2.Width" Value="*" />
                        <Setter Target="FactsColumn3.Width" Value="*" />
                        <Setter Target="EstimatedMemoryLabelText.(Grid.Row)" Value="0" />
                        <Setter Target="EstimatedMemoryLabelText.(Grid.Column)" Value="2" />
                        <Setter Target="EstimatedMemoryValueText.(Grid.Row)" Value="1" />
                        <Setter Target="EstimatedMemoryValueText.(Grid.Column)" Value="2" />
                        <Setter Target="ContextLengthLabelText.(Grid.Row)" Value="0" />
                        <Setter Target="ContextLengthLabelText.(Grid.Column)" Value="3" />
                        <Setter Target="ContextLengthValueText.(Grid.Row)" Value="1" />
                        <Setter Target="ContextLengthValueText.(Grid.Column)" Value="3" />
                    </VisualState.Setters>

                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</UserControl>
