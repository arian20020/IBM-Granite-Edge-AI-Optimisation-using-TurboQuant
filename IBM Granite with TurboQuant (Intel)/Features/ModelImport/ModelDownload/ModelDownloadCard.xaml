<?xml version="1.0" encoding="utf-8" ?>

<UserControl
    x:Class="GraniteEdgeAI.Features.ModelImport.ModelDownload.ModelDownloadCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelImport.ModelDownload"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    SizeChanged="ModelDownloadCard_SizeChanged"
    mc:Ignorable="d">

    <Grid
        x:Name="CardLayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>
        <Border
            x:Name="RecommendedModelDetailsCard"
            Grid.Row="0"
            MinHeight="360"
            Padding="14"
            Background="{ThemeResource ModelImportSurfaceBrush}"
            BorderBrush="{ThemeResource ModelImportBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            AutomationProperties.Name="Recommended model details">

            <!--  Arranges the card content vertically.  -->
            <StackPanel
                Spacing="10">

                <Grid
                    x:Name="ModelHeaderGrid"
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>

                        <!--  uses the remaining width for the model name  -->
                        <ColumnDefinition
                            Width="*" />

                        <!--  uses only the width required by the package summary  -->
                        <ColumnDefinition
                            Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        TEMPORARY SEED VALUE:
                        Future source: ModelProfile.DisplayName.
                    -->
                    <TextBlock
                        x:Name="ModelNameText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ModelImportTextBrush}"
                        Text="IBM Granite 4.0 H Micro"
                        TextTrimming="None"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="14"
                        Foreground="{ThemeResource ModelImportMutedTextBrush}"
                        Text="Official pinned GGUF package"
                        TextWrapping="WrapWholeWords" />

                    <!--
                        TEMPORARY SEED VALUES:
                        Parameter count will come from ModelProfile.
                        Download size must come from the exact downloadable file metadata.
                        ModelCard should never calculate or guess the download size.
                    -->
                    <TextBlock
                        x:Name="ModelPackageSummaryText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource ModelImportMutedTextBrush}"
                        Text="3B parameters · 1.94 GB"
                        TextAlignment="Right"
                        TextTrimming="None"
                        TextWrapping="WrapWholeWords" />

                </Grid>

                <Grid
                    x:Name="ModelFactsGrid"
                    ColumnSpacing="16"
                    RowSpacing="10">

                    <!--  creates four equally sized property columns  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            x:Name="FactsColumn2"
                            Width="0" />
                        <ColumnDefinition
                            x:Name="FactsColumn3"
                            Width="0" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="FORMAT" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="GGUF" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="QUANTISATION" />
                        <TextBlock x:Name="QuantizationValueText" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="Q4_K_M" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                        <TextBlock x:Name="ContextLengthLabelText" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="DECLARED CONTEXT" TextWrapping="Wrap" />
                        <TextBlock x:Name="ContextLengthValueText" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="128K tokens" TextTrimming="None" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="EstimatedMemoryLabelText" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportMutedTextBrush}" Text="BENCHMARK" TextWrapping="Wrap" />
                        <TextBlock x:Name="EstimatedMemoryValueText" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ModelImportTextBrush}" Text="Pending benchmark" TextTrimming="None" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                </Grid>

                <!--  Groups the slider heading, control and endpoint labels.  -->
                <StackPanel Spacing="2">

                    <!--  Displays the slider heading and current preference.  -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportTextBrush}"
                            Text="Preference" />

                        <!--
                            TEMPORARY SEED VALUE:
                            This will later bind to ModelImportViewModel and change
                            while the user moves the slider.
                        -->
                        <TextBlock
                            x:Name="ModelScaleValueText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportAccentBrush}"
                            Text="Balanced" />

                    </Grid>

                    <!--
                        CONTINUOUS PREFERENCE CONTROL:
                        
                        The slider travels from 0 to 100.
                        
                        StepFrequency="0.1" provides 1,001 possible positions, making
                        pointer movement feel continuous rather than snapping to five stages.
                        
                        The ViewModel will later translate ranges of values into exact
                        downloadable model packages.
                    -->
                    <Slider
                        x:Name="ModelScaleSlider"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.HelpText="Choose between maximum efficiency and maximum model capability"
                        AutomationProperties.Name="Model preference"
                        IsThumbToolTipEnabled="False"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="1"
                        SnapsTo="StepValues"
                        StepFrequency="0.1"
                        TickPlacement="None"
                        UseSystemFocusVisuals="True"
                        ValueChanged="ModelScaleSlider_ValueChanged"
                        Value="50" />

                    <!--  Explains what the two ends of the scale represent.  -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="EfficiencyEndpointText"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            FontSize="10"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            MaxLines="2"
                            Text="Maximum efficiency"
                            TextAlignment="Center"
                            TextTrimming="None"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            x:Name="EfficientBandText"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="Efficient"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="-10" />
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock
                            x:Name="BalancedBandText"
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            FontWeight="Normal"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="Balanced"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            x:Name="HighCapabilityBandText"
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            Text="High capability"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="10" />
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock
                            x:Name="CapabilityEndpointText"
                            Grid.Column="4"
                            HorizontalAlignment="Stretch"
                            FontSize="10"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            MaxLines="2"
                            Text="Maximum capability"
                            TextAlignment="Center"
                            TextTrimming="None"
                            TextWrapping="WrapWholeWords" />

                    </Grid>

                </StackPanel>

            </StackPanel>
        </Border>

        <Grid
            x:Name="RecommendedDownloadFooterRegion"
            Grid.Row="2"
            Height="220"
            AutomationProperties.AutomationId="RecommendedDownloadFooterRegion"
            AutomationProperties.Name="Recommended download actions and status">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="12" />
                <RowDefinition Height="96" />
                <RowDefinition Height="12" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="DownloadStatusRegion"
                Grid.Row="0"
                Height="56"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="DownloadActivityRing"
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource ModelImportAccentBrush}"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="DownloadStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource ModelImportMutedTextBrush}"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                    <ProgressBar
                        x:Name="DownloadProgressBar"
                        Height="6"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.HelpText="Progress from zero to one hundred percent when the total download size is known."
                        AutomationProperties.Name="Recommended model download progress"
                        Maximum="100"
                        Minimum="0" />
                    <TextBlock
                        x:Name="DownloadProgressText"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12"
                        Foreground="{ThemeResource ModelImportMutedTextBrush}" />
                </StackPanel>
                <Button
                    x:Name="DiscardDownloadButton"
                    Grid.Column="1"
                    MinWidth="40"
                    MinHeight="40"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Padding="8,2"
                    AutomationProperties.Name="Discard partial model download"
                    Click="DiscardDownloadButton_Click"
                    Content="Discard"
                    Visibility="Collapsed" />
            </Grid>

            <Border
                Grid.Row="2"
                Height="96"
                Background="Transparent"
                AutomationProperties.Name="Recommended verification notice">
                <InfoBar
                    Height="96"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Success"
                    Title="Verified package metadata"
                    Message="The production route verifies the pinned size and SHA-256 before making the model available." />
            </Border>

            <Button
                    x:Name="DownloadModelButton"
                    Grid.Row="4"
                    Height="44"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="Download the selected model"
                    Background="{ThemeResource ModelImportAccentBrush}"
                    BorderBrush="{ThemeResource ModelImportAccentBrush}"
                    BorderThickness="1"
                    Click="DownloadModelButton_Click"
                    Content="Download selected model"
                    CornerRadius="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GraniteJourneyPrimaryForegroundBrush}"
                    UseSystemFocusVisuals="True">

                    <Button.Resources>

                        <!--  Normal state.  -->
                        <SolidColorBrush
                            x:Key="ButtonBackground"
                            Color="#2563EB" />

                        <SolidColorBrush
                            x:Key="ButtonForeground"
                            Color="#FFFFFF" />

                        <SolidColorBrush
                            x:Key="ButtonBorderBrush"
                            Color="#2563EB" />

                        <!--  Mouse-hover state.  -->
                        <SolidColorBrush
                            x:Key="ButtonBackgroundPointerOver"
                            Color="#1D4ED8" />

                        <SolidColorBrush
                            x:Key="ButtonForegroundPointerOver"
                            Color="#FFFFFF" />

                        <SolidColorBrush
                            x:Key="ButtonBorderBrushPointerOver"
                            Color="#1D4ED8" />

                        <!--  Pressed state.  -->
                        <SolidColorBrush
                            x:Key="ButtonBackgroundPressed"
                            Color="#1E40AF" />

                        <SolidColorBrush
                            x:Key="ButtonForegroundPressed"
                            Color="#FFFFFF" />

                        <SolidColorBrush
                            x:Key="ButtonBorderBrushPressed"
                            Color="#1E40AF" />

                        <!--  Disabled state.  -->
                        <SolidColorBrush
                            x:Key="ButtonBackgroundDisabled"
                            Color="#E5E7EB" />

                        <SolidColorBrush
                            x:Key="ButtonForegroundDisabled"
                            Color="#9CA3AF" />

                        <SolidColorBrush
                            x:Key="ButtonBorderBrushDisabled"
                            Color="#D1D5DB" />

                    </Button.Resources>

            </Button>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup
                x:Name="CardLayoutStates">

                <VisualState
                    x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="ModelPackageSummaryText.(Grid.Row)" Value="2" />
                        <Setter Target="ModelPackageSummaryText.(Grid.Column)" Value="0" />
                        <Setter Target="ModelPackageSummaryText.HorizontalAlignment" Value="Left" />
                        <Setter Target="ModelPackageSummaryText.TextAlignment" Value="Left" />
                        <Setter Target="ModelPackageSummaryText.Margin" Value="0,4,0,0" />
                        <Setter Target="FactsColumn2.Width" Value="0" />
                        <Setter Target="FactsColumn3.Width" Value="0" />
                        <Setter Target="EstimatedMemoryLabelText.(Grid.Row)" Value="2" />
                        <Setter Target="EstimatedMemoryLabelText.(Grid.Column)" Value="0" />
                        <Setter Target="EstimatedMemoryValueText.(Grid.Row)" Value="3" />
                        <Setter Target="EstimatedMemoryValueText.(Grid.Column)" Value="0" />
                        <Setter Target="ContextLengthLabelText.(Grid.Row)" Value="2" />
                        <Setter Target="ContextLengthLabelText.(Grid.Column)" Value="1" />
                        <Setter Target="ContextLengthValueText.(Grid.Row)" Value="3" />
                        <Setter Target="ContextLengthValueText.(Grid.Column)" Value="1" />
                    </VisualState.Setters>

                </VisualState>

                <VisualState
                    x:Name="WideLayout">
                    <VisualState.Setters>
                        <Setter Target="ModelPackageSummaryText.(Grid.Row)" Value="0" />
                        <Setter Target="ModelPackageSummaryText.(Grid.Column)" Value="1" />
                        <Setter Target="ModelPackageSummaryText.HorizontalAlignment" Value="Right" />
                        <Setter Target="ModelPackageSummaryText.TextAlignment" Value="Right" />
                        <Setter Target="ModelPackageSummaryText.Margin" Value="0" />
                        <Setter Target="FactsColumn2.Width" Value="0" />
                        <Setter Target="FactsColumn3.Width" Value="0" />
                        <Setter Target="EstimatedMemoryLabelText.(Grid.Row)" Value="2" />
                        <Setter Target="EstimatedMemoryLabelText.(Grid.Column)" Value="0" />
                        <Setter Target="EstimatedMemoryValueText.(Grid.Row)" Value="3" />
                        <Setter Target="EstimatedMemoryValueText.(Grid.Column)" Value="0" />
                        <Setter Target="ContextLengthLabelText.(Grid.Row)" Value="2" />
                        <Setter Target="ContextLengthLabelText.(Grid.Column)" Value="1" />
                        <Setter Target="ContextLengthValueText.(Grid.Row)" Value="3" />
                        <Setter Target="ContextLengthValueText.(Grid.Column)" Value="1" />
                    </VisualState.Setters>

                </VisualState>

            </VisualStateGroup>

            <VisualStateGroup
                x:Name="ModelScaleBandStates">

                <VisualState
                    x:Name="MaximumEfficiencyBand">
                    <VisualState.Setters>
                        <Setter Target="EfficiencyEndpointText.Foreground" Value="{ThemeResource ModelImportAccentBrush}" />
                        <Setter Target="EfficiencyEndpointText.FontWeight" Value="SemiBold" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState
                    x:Name="EfficientBand">
                    <VisualState.Setters>
                        <Setter Target="EfficientBandText.Foreground" Value="{ThemeResource ModelImportAccentBrush}" />
                        <Setter Target="EfficientBandText.FontWeight" Value="SemiBold" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState
                    x:Name="BalancedBand">
                    <VisualState.Setters>
                        <Setter Target="BalancedBandText.Foreground" Value="{ThemeResource ModelImportAccentBrush}" />
                        <Setter Target="BalancedBandText.FontWeight" Value="SemiBold" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState
                    x:Name="HighCapabilityBand">
                    <VisualState.Setters>
                        <Setter Target="HighCapabilityBandText.Foreground" Value="{ThemeResource ModelImportAccentBrush}" />
                        <Setter Target="HighCapabilityBandText.FontWeight" Value="SemiBold" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState
                    x:Name="MaximumCapabilityBand">
                    <VisualState.Setters>
                        <Setter Target="CapabilityEndpointText.Foreground" Value="{ThemeResource ModelImportAccentBrush}" />
                        <Setter Target="CapabilityEndpointText.FontWeight" Value="SemiBold" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</UserControl>
