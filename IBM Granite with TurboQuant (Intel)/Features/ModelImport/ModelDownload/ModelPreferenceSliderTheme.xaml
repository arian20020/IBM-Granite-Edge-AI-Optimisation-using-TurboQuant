<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SliderOuterThumbBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderOuterThumbBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SliderThumbBorderBrushPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SliderThumbBorderBrushPressed" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- One shared visual authority for the Model Download and optimisation sliders. -->
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
    <SolidColorBrush x:Key="SliderOuterThumbBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="SliderOuterThumbBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#2563EB" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#1E40AF" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SliderThumbBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="SliderThumbBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#2563EB" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#2563EB" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#2563EB" />
    <x:Double x:Key="SliderInnerThumbWidth">14</x:Double>
    <x:Double x:Key="SliderInnerThumbHeight">14</x:Double>
</ResourceDictionary>
