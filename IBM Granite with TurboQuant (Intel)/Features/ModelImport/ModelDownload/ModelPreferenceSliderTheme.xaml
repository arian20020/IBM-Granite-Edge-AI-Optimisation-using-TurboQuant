<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One shared visual authority for the Model Download and optimisation sliders. -->
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
    <SolidColorBrush x:Key="SliderOuterThumbBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="SliderOuterThumbBackgroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#2563EB" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#1E40AF" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SliderThumbBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="SliderThumbBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#2563EB" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#2563EB" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#2563EB" />
    <x:Double x:Key="SliderInnerThumbWidth">14</x:Double>
    <x:Double x:Key="SliderInnerThumbHeight">14</x:Double>
</ResourceDictionary>
