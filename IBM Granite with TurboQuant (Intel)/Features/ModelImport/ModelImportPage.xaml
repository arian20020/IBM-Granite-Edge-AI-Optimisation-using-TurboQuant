<?xml version="1.0" encoding="utf-8" ?>

<!--  Defines the visual half of ModelImportPage.  -->
<Page
    x:Class="GraniteEdgeAI.Features.ModelImport.ModelImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GraniteEdgeAI.Features.ModelImport"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  Fills the page and provides its light-grey background.  -->
    <Grid
        Background="#F5F6FA">

        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">

            <!--  Creates the main white onboarding card.  -->
            <Border
                MaxWidth="920"
                Margin="32"
                Padding="48"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="White"
                CornerRadius="28">

                <!--  Arranges the card content vertically.  -->
                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Orientation="Vertical"
                    Spacing="12">

                    <!--  Creates the circular Granite logo background.  -->
                    <Border
                        Width="92"
                        Height="92"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        Background="#E8F0FE"
                        CornerRadius="46">

                        <!--  Displays the temporary Granite logo letter.  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Foreground="#2563EB"
                            Text="G" />

                    </Border>

                    <!--  Displays the page heading.  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="#111827"
                        Text="Choose a model to begin"
                        TextAlignment="Center" />

                    <!--  Creates the complete model-file drop target.  -->
                    <!--  Grid allows the dashed Rectangle and content to overlap.  -->
                    <!--  Transparent ensures the Grid can receive drag events later.  -->
                    <Grid
                        MinHeight="185"
                        Margin="0,28,0,0"
                        HorizontalAlignment="Stretch"
                        Background="Transparent">

                        <!--  Draws the drop area's background and dashed outline.  -->
                        <!--  This Rectangle is decorative, so it ignores input.  -->
                        <Rectangle
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Fill="#F9FAFB"
                            IsHitTestVisible="False"
                            RadiusX="22"
                            RadiusY="22"
                            Stroke="#CBD5E1"
                            StrokeDashArray="6,5"
                            StrokeDashCap="Round"
                            StrokeThickness="1.5" />

                        <!--  Arranges the drop-area content vertically.  -->
                        <!--  Margin replaces the Padding previously supplied by Border.  -->
                        <StackPanel
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">

                            <!--  Displays the temporary upload symbol.  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="#2563EB"
                                Text="↑"
                                TextAlignment="Center" />

                            <!--  Displays the primary drag-and-drop instruction.  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="#111827"
                                Text="Drag model file here"
                                TextAlignment="Center" />

                            <!--  Lists the supported model formats.  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                Foreground="#6B7280"
                                Text="Supported formats: GGUF (.gguf) or OpenVINO IR (.xml + .bin)"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <!--  Creates the button that will open the file picker.  -->
                            <Button
                                Width="220"
                                Height="48"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="Browse for a model file"
                                Background="#2563EB"
                                BorderBrush="#2563EB"
                                BorderThickness="1"
                                Content="Browse files"
                                CornerRadius="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                UseSystemFocusVisuals="True">

                                <!--  Controls the button's interaction-state colours.  -->
                                <Button.Resources>

                                    <!--  Normal state.  -->
                                    <SolidColorBrush
                                        x:Key="ButtonBackground"
                                        Color="#2563EB" />

                                    <SolidColorBrush
                                        x:Key="ButtonForeground"
                                        Color="#FFFFFF" />

                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrush"
                                        Color="#2563EB" />

                                    <!--  Mouse-hover state.  -->
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPointerOver"
                                        Color="#1D4ED8" />

                                    <SolidColorBrush
                                        x:Key="ButtonForegroundPointerOver"
                                        Color="#FFFFFF" />

                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPointerOver"
                                        Color="#1D4ED8" />

                                    <!--  Pressed state.  -->
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundPressed"
                                        Color="#1E40AF" />

                                    <SolidColorBrush
                                        x:Key="ButtonForegroundPressed"
                                        Color="#FFFFFF" />

                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushPressed"
                                        Color="#1E40AF" />

                                    <!--  Disabled state.  -->
                                    <SolidColorBrush
                                        x:Key="ButtonBackgroundDisabled"
                                        Color="#E5E7EB" />

                                    <SolidColorBrush
                                        x:Key="ButtonForegroundDisabled"
                                        Color="#9CA3AF" />

                                    <SolidColorBrush
                                        x:Key="ButtonBorderBrushDisabled"
                                        Color="#D1D5DB" />

                                </Button.Resources>

                            </Button>

                        </StackPanel>

                    </Grid>

                    <!--
                        Opens or closes the recommended-model section.
                        
                        This is a Button because the text performs an action.
                        Its transparent styling makes it appear like simple grey text.
                    -->
                    <Button
                        x:Name="RecommendedModelToggleButton"
                        Margin="0,4,0,0"
                        Padding="8,4"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        AutomationProperties.HelpText="Shows or hides the recommended model options"
                        AutomationProperties.Name="Show recommended model options"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="RecommendedModelToggleButton_Click"
                        Foreground="#9CA3AF"
                        UseSystemFocusVisuals="True">

                        <!--  Prevents the Button from displaying a white box.  -->
                        <Button.Resources>

                            <!--  Normal state.  -->
                            <SolidColorBrush
                                x:Key="ButtonBackground"
                                Color="Transparent" />

                            <SolidColorBrush
                                x:Key="ButtonForeground"
                                Color="#9CA3AF" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrush"
                                Color="Transparent" />

                            <!--  Mouse-hover state.  -->
                            <SolidColorBrush
                                x:Key="ButtonBackgroundPointerOver"
                                Color="Transparent" />

                            <SolidColorBrush
                                x:Key="ButtonForegroundPointerOver"
                                Color="#6B7280" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPointerOver"
                                Color="Transparent" />

                            <!--  Pressed state.  -->
                            <SolidColorBrush
                                x:Key="ButtonBackgroundPressed"
                                Color="Transparent" />

                            <SolidColorBrush
                                x:Key="ButtonForegroundPressed"
                                Color="#4B5563" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPressed"
                                Color="Transparent" />

                        </Button.Resources>

                        <!--  Places the instruction and arrow beside each other.  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="Or download a recommended model" />

                            <!--
                                The arrow changes direction when the recommended-model
                                section is opened or closed.
                            -->
                            <TextBlock
                                x:Name="RecommendedModelToggleArrow"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="↓" />

                        </StackPanel>

                    </Button>

                    <!--
                        Starts completely hidden.
                        
                        Collapsed means the card is invisible and takes up no layout space.
                        Its download button is hidden because it is inside ModelCard.
                    -->
                    <local:ModelCard
                        x:Name="RecommendedModelCard"
                        Margin="0,8,0,0"
                        Visibility="Collapsed" />

                    <!--
                        TODO(MODEL READINESS):
                        
                        This button must remain disabled until either:
                        
                        1. A local model has been successfully imported and validated.
                        2. A recommended model has finished downloading and validating.
                        
                        ModelImportViewModel.IsModelReady will eventually control
                        this button's IsEnabled property.
                    -->
                    <Button
                        x:Name="ContinueToModelInspectionButton"
                        Height="48"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.HelpText="Available after a model has been imported or downloaded"
                        AutomationProperties.Name="Continue to model inspection"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        Content="Continue to model inspection"
                        CornerRadius="12"
                        FontWeight="SemiBold"
                        Foreground="White"
                        IsEnabled="False"
                        UseSystemFocusVisuals="True">

                        <!--
                            The normal colours will appear after the button is enabled.
                            The disabled colours make it visibly grey initially.
                        -->
                        <Button.Resources>

                            <!--  Normal enabled state.  -->
                            <SolidColorBrush
                                x:Key="ButtonBackground"
                                Color="#2563EB" />

                            <SolidColorBrush
                                x:Key="ButtonForeground"
                                Color="#FFFFFF" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrush"
                                Color="#2563EB" />

                            <!--  Mouse-hover state.  -->
                            <SolidColorBrush
                                x:Key="ButtonBackgroundPointerOver"
                                Color="#1D4ED8" />

                            <SolidColorBrush
                                x:Key="ButtonForegroundPointerOver"
                                Color="#FFFFFF" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPointerOver"
                                Color="#1D4ED8" />

                            <!--  Pressed state.  -->
                            <SolidColorBrush
                                x:Key="ButtonBackgroundPressed"
                                Color="#1E40AF" />

                            <SolidColorBrush
                                x:Key="ButtonForegroundPressed"
                                Color="#FFFFFF" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrushPressed"
                                Color="#1E40AF" />

                            <!--  Initial disabled state.  -->
                            <SolidColorBrush
                                x:Key="ButtonBackgroundDisabled"
                                Color="#E5E7EB" />

                            <SolidColorBrush
                                x:Key="ButtonForegroundDisabled"
                                Color="#9CA3AF" />

                            <SolidColorBrush
                                x:Key="ButtonBorderBrushDisabled"
                                Color="#D1D5DB" />

                        </Button.Resources>

                    </Button>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Page>