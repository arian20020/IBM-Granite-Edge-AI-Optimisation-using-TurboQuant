<?xml version="1.0" encoding="utf-8" ?>

<!--  Defines the visual half of ModelImportPage.  -->
<Page
    x:Class="GraniteEdgeAI.Features.ModelImport.ModelImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.ModelImport.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelDownload="using:GraniteEdgeAI.Features.ModelImport.ModelDownload"
    mc:Ignorable="d">

    <!--  Fills the page and provides its light-grey background.  -->
    <Grid
        Background="White">

        <!--  Allows the page to scroll when the available window height is limited.  -->
        <ScrollViewer
            x:Name="ModelImportPageScrollViewer"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">

            <Grid
                HorizontalAlignment="Stretch">

                <!--  Creates the main white onboarding card.  -->
                <Border
                    MaxWidth="920"
                    Margin="32,32,32,16"
                    Padding="48,48,48,24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">

                    <!--  Arranges the page content vertically.  -->
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Orientation="Vertical"
                        Spacing="12">

                        <!--  Displays the page heading.  -->
                        <TextBlock
                            x:Name="ImportPageHeading"
                            HorizontalAlignment="Stretch"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Foreground="#111827"
                            Text="Import a model to begin"
                            TextAlignment="Center"
                            TextTrimming="None"
                            TextWrapping="WrapWholeWords" />

                        <Grid
                            x:Name="ModelDropTarget"
                            AllowDrop="True"
                            Background="Transparent"
                            AutomationProperties.HelpText="Optional. Choose model file or Choose model folder provides the same selection options."
                            AutomationProperties.Name="Model drop area"
                            DragLeave="ModelDropTarget_DragLeave"
                            DragOver="ModelDropTarget_DragOver"
                            Drop="ModelDropTarget_Drop">
                            <controls:ImportModelCard
                                x:Name="ImportModelCardControl"
                                HorizontalAlignment="Stretch"
                                BrowseFilesRequested="ImportModelCard_BrowseFilesRequested"
                                CancelScanRequested="ImportModelCard_CancelScanRequested"
                                ChooseModelFolderRequested="ImportModelCard_ChooseModelFolderRequested" />
                        </Grid>
                        <TextBlock
                            x:Name="SelectionAnnouncement"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="Collapsed" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="or"
                            TextAlignment="Center" />

                        <Button
                            x:Name="FindDownloadedModelsButton"
                            HorizontalAlignment="Center"
                            Click="FindDownloadedModelsButton_Click"
                            Content="Find downloaded models"
                            AutomationProperties.HelpText="Search Downloads, Documents, and Desktop only after you approve the one-time search." />

                        <modelDownload:ModelDownloadCard
                            x:Name="RecommendedModelDownloadCard"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Recommended model download option" />

                        <!--
                            TODO(MODEL READINESS):
                            
                            This button must remain disabled until either:
                            
                            1. A local model has been successfully imported and validated.
                            2. A recommended model has finished downloading and validating.
                            
                            ModelImportViewModel.IsModelReady will eventually control
                            this button's IsEnabled property.
                        -->
                        <Button
                            x:Name="ContinueToModelInspectionButton"
                            Height="48"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            AutomationProperties.HelpText="Available after a model has been imported or downloaded"
                            AutomationProperties.Name="Continue to model inspection"
                            Background="#2563EB"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            Click="ContinueToModelInspectionButton_Click"
                            Content="Continue to model inspection"
                            CornerRadius="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            IsEnabled="False"
                            UseSystemFocusVisuals="True">

                            <!--
                                The normal colours appear after the button is enabled.
                                The disabled colours make it visibly grey initially.
                            -->
                            <Button.Resources>

                                <!--  Normal enabled state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackground"
                                    Color="#2563EB" />

                                <SolidColorBrush
                                    x:Key="ButtonForeground"
                                    Color="#FFFFFF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrush"
                                    Color="#2563EB" />

                                <!--  Mouse-hover state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPointerOver"
                                    Color="#1D4ED8" />

                                <SolidColorBrush
                                    x:Key="ButtonForegroundPointerOver"
                                    Color="#FFFFFF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPointerOver"
                                    Color="#1D4ED8" />

                                <!--  Pressed state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPressed"
                                    Color="#1E40AF" />

                                <SolidColorBrush
                                    x:Key="ButtonForegroundPressed"
                                    Color="#FFFFFF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPressed"
                                    Color="#1E40AF" />

                                <!--  Initial disabled state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundDisabled"
                                    Color="#E5E7EB" />

                                <SolidColorBrush
                                    x:Key="ButtonForegroundDisabled"
                                    Color="#9CA3AF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushDisabled"
                                    Color="#D1D5DB" />

                            </Button.Resources>

                        </Button>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Page>
