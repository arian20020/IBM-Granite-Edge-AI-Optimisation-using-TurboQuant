<?xml version="1.0" encoding="utf-8" ?>

<!--  Defines the visual half of ModelImportPage.  -->
<Page
    x:Class="GraniteEdgeAI.Features.ModelImport.ModelImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.ModelImport.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  Fills the page and provides its light-grey background.  -->
    <Grid
        Background="#F5F6FA">

        <!--  Allows the page to scroll when the available window height is limited.  -->
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">

            <Grid
                HorizontalAlignment="Stretch">

                <!--  Creates the main white onboarding card.  -->
                <Border
                    MaxWidth="920"
                    Margin="32"
                    Padding="48"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="White"
                    CornerRadius="28">

                    <!--  Arranges the page content vertically.  -->
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Orientation="Vertical"
                        Spacing="12">

                        <!--  Displays the approved Granite Edge AI logo without a circular background.  -->
                        <Image
                            Width="112"
                            Height="112"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Granite Edge AI logo"
                            Source="ms-appx:///Assets/Branding/granite-edge-ai-icon.svg"
                            Stretch="Uniform" />

                        <!--  Displays the page heading.  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Foreground="#111827"
                            Text="Import a model to begin"
                            TextAlignment="Center" />

                        <!--
                            Creates the complete model-file drop target.
                            
                            TODO(FILE IMPORT):
                            This area will later receive drag-and-drop events and pass
                            the selected files to the model-import service.
                        -->

                        <controls:ImportModelCard
                            x:Name="ImportModelCardControl"
                            HorizontalAlignment="Stretch"
                            BrowseFilesRequested="ImportModelCard_BrowseFilesRequested"
                            CancelScanRequested="ImportModelCard_CancelScanRequested" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="#6B7280"
                            Text="or"
                            TextAlignment="Center" />

                        <!--
                            Navigates to RecommendedModelDownloadPage.
                            
                            The right arrow communicates navigation to another page.
                            A downward arrow would imply that content expands here.
                        -->
                        <Button
                            x:Name="RecommendedModelDownloadButton"
                            Width="300"
                            Height="48"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="Open recommended model downloads"
                            Background="#F9FAFB"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Click="RecommendedModelDownloadButton_Click"
                            Content="Download a recommended model →"
                            CornerRadius="12"
                            FontWeight="SemiBold"
                            Foreground="#2563EB"
                            UseSystemFocusVisuals="True">

                            <!--  Controls the navigation button's interaction colours.  -->
                            <Button.Resources>

                                <!--  Normal state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackground"
                                    Color="#F9FAFB" />

                                <SolidColorBrush
                                    x:Key="ButtonForeground"
                                    Color="#2563EB" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrush"
                                    Color="#CBD5E1" />

                                <!--  Mouse-hover state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPointerOver"
                                    Color="#EFF6FF" />

                                <SolidColorBrush
                                    x:Key="ButtonForegroundPointerOver"
                                    Color="#1D4ED8" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPointerOver"
                                    Color="#93C5FD" />

                                <!--  Pressed state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPressed"
                                    Color="#DBEAFE" />

                                <SolidColorBrush
                                    x:Key="ButtonForegroundPressed"
                                    Color="#1E40AF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPressed"
                                    Color="#60A5FA" />

                            </Button.Resources>

                        </Button>

                        <!--
                            TODO(MODEL READINESS):
                            
                            This button must remain disabled until either:
                            
                            1. A local model has been successfully imported and validated.
                            2. A recommended model has finished downloading and validating.
                            
                            ModelImportViewModel.IsModelReady will eventually control
                            this button's IsEnabled property.
                        -->
                        <Button
                            x:Name="ContinueToModelInspectionButton"
                            Height="48"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            AutomationProperties.HelpText="Available after a model has been imported or downloaded"
                            AutomationProperties.Name="Continue to model inspection"
                            Background="#2563EB"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            Content="Continue to model inspection"
                            CornerRadius="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            IsEnabled="False"
                            UseSystemFocusVisuals="True">

                            <!--
                                The normal colours appear after the button is enabled.
                                The disabled colours make it visibly grey initially.
                            -->
                            <Button.Resources>

                                <!--  Normal enabled state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackground"
                                    Color="#2563EB" />

                                <SolidColorBrush
                                    x:Key="ButtonForeground"
                                    Color="#FFFFFF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrush"
                                    Color="#2563EB" />

                                <!--  Mouse-hover state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPointerOver"
                                    Color="#1D4ED8" />

                                <SolidColorBrush
                                    x:Key="ButtonForegroundPointerOver"
                                    Color="#FFFFFF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPointerOver"
                                    Color="#1D4ED8" />

                                <!--  Pressed state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundPressed"
                                    Color="#1E40AF" />

                                <SolidColorBrush
                                    x:Key="ButtonForegroundPressed"
                                    Color="#FFFFFF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushPressed"
                                    Color="#1E40AF" />

                                <!--  Initial disabled state.  -->
                                <SolidColorBrush
                                    x:Key="ButtonBackgroundDisabled"
                                    Color="#E5E7EB" />

                                <SolidColorBrush
                                    x:Key="ButtonForegroundDisabled"
                                    Color="#9CA3AF" />

                                <SolidColorBrush
                                    x:Key="ButtonBorderBrushDisabled"
                                    Color="#D1D5DB" />

                            </Button.Resources>

                        </Button>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Page>