<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelOptimization.Controls.OptimizationConfirmationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelOptimization/Presentation/OptimizationTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <Border Style="{StaticResource OptimizationCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource OptimizationCardTitleStyle}" Text="Before you start" />
                <TextBlock x:Name="ConfirmationSummary" Style="{StaticResource OptimizationBodyStyle}" />
            </StackPanel>
        </Border>
        <controls:OptimizationConfigurationCard
            xmlns:controls="using:GraniteEdgeAI.Features.ModelOptimization.Controls"
            x:Name="ConfirmationConfiguration" />
        <StackPanel Spacing="10">
            <Button
                x:Name="BackButton"
                MinHeight="48"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.Name="Back"
                Click="OnBackClicked"
                Content="Back"
                UseSystemFocusVisuals="True" />
            <Button
                x:Name="ConfirmButton"
                MinHeight="48"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.Name="Start optimisation"
                Background="{ThemeResource OptimizationPrimaryBrush}"
                BorderBrush="{ThemeResource OptimizationPrimaryBrush}"
                Click="OnConfirmClicked"
                Content="Start optimisation"
                Foreground="{ThemeResource AccentButtonForeground}"
                UseSystemFocusVisuals="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
