<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelOptimization.Controls.OptimizationConfigurationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelOptimization/Presentation/OptimizationTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OptimizationCardStyle}">
        <StackPanel Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource OptimizationCardTitleStyle}" Text="Your configuration" />
                <TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="This updates live from the complete safe candidate selected by the planner." />
            </StackPanel>

            <Grid x:Name="ConfigurationFacts" ColumnSpacing="24" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="WEIGHTS" />
                    <TextBlock x:Name="WeightsValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="KV CACHE" />
                    <TextBlock x:Name="CacheValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="BACKEND AND DEVICE" />
                    <TextBlock x:Name="BackendDeviceValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="CONTEXT" />
                    <TextBlock x:Name="ContextValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="OFFLOAD" />
                    <TextBlock x:Name="OffloadValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="FLASH ATTENTION" />
                    <TextBlock x:Name="FlashAttentionValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="PREDICTED PEAK" />
                    <TextBlock x:Name="PeakValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="SAFE HEADROOM" />
                    <TextBlock x:Name="HeadroomValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="EVIDENCE" />
                    <TextBlock x:Name="EvidenceValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="3">
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="NEW MODEL COPY" />
                    <TextBlock x:Name="ConfigurationNewModelCopyValue" Style="{StaticResource OptimizationValueStyle}" />
                </StackPanel>
            </Grid>

            <Expander
                x:Name="TechnicalDetailsDisclosure"
                MinHeight="{StaticResource OptimizationMinimumTarget}"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Technical configuration details"
                Header="Technical details"
                UseSystemFocusVisuals="True">
                <StackPanel Padding="0,12,0,0" Spacing="10">
                    <TextBlock x:Name="MemoryBreakdownValue" Style="{StaticResource OptimizationBodyStyle}" />
                    <TextBlock x:Name="TradeoffValue" Style="{StaticResource OptimizationBodyStyle}" />
                    <TextBlock x:Name="LimitationsValue" Style="{StaticResource OptimizationBodyStyle}" />
                    <TextBlock x:Name="OutputValue" Style="{StaticResource OptimizationBodyStyle}" />
                    <TextBlock x:Name="WorkingDiskValue" Style="{StaticResource OptimizationBodyStyle}" />
                    <TextBlock x:Name="FinalDiskValue" Style="{StaticResource OptimizationBodyStyle}" />
                    <TextBlock x:Name="RouteValidationValue" Style="{StaticResource OptimizationBodyStyle}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
