<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelOptimization.Controls.OptimizationProgressCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelOptimization/Presentation/OptimizationTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OptimizationCardStyle}">
        <StackPanel Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource OptimizationCardTitleStyle}" Text="Optimisation progress" />
                <TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Seven checks take the configuration from preflight to a safe published result." />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource OptimizationBodyStyle}"
                    Text="Optimisation can take several minutes. Keep the app open while the active step completes."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <ListView
                x:Name="ProgressRowsHost"
                Height="392"
                IsItemClickEnabled="False"
                IsTabStop="False"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
            <Button
                x:Name="CancelButton"
                MinHeight="48"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.Name="Cancel optimisation"
                Click="OnCancelClicked"
                Content="Cancel"
                UseSystemFocusVisuals="True" />
        </StackPanel>
    </Border>
</UserControl>
