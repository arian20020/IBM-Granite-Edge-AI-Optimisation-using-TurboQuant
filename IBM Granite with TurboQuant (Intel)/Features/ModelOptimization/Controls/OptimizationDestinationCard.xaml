<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelOptimization.Controls.OptimizationDestinationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.ModelOptimization.Controls">
    <StackPanel Spacing="10">
        <controls:OptimizationOutcomeCard x:Name="DestinationCore" />
        <ProgressBar
            x:Name="ExportProgressBar"
            Height="6"
            AutomationProperties.AutomationId="OptimizationExport.Progress"
            AutomationProperties.Name="Verified model export progress"
            IsIndeterminate="True"
            Maximum="100"
            Minimum="0"
            Visibility="Collapsed" />
        <TextBlock
            x:Name="ExportStatusText"
            AutomationProperties.AutomationId="OptimizationExport.Status"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Verified model export status"
            Text="Export is unavailable until this exact model result is verified."
            TextWrapping="WrapWholeWords" />
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CancelExportButton"
                Grid.Column="0"
                MinHeight="44"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="OptimizationExport.Cancel"
                AutomationProperties.Name="Cancel model export"
                Click="CancelExportButton_Click"
                Content="Cancel export"
                UseSystemFocusVisuals="True"
                Visibility="Collapsed" />
            <Button
                x:Name="RetryExportButton"
                Grid.Column="1"
                MinHeight="44"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="OptimizationExport.Retry"
                AutomationProperties.Name="Retry model export"
                Click="RetryExportButton_Click"
                Content="Try export again"
                UseSystemFocusVisuals="True"
                Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</UserControl>
