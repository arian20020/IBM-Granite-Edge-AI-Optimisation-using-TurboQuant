<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelOptimization.Controls.OptimizationPreferenceCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modelDownload="using:GraniteEdgeAI.Features.ModelImport.ModelDownload">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelOptimization/Presentation/OptimizationTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <Border x:Name="AutomaticCard" Style="{StaticResource OptimizationCardStyle}">
            <RadioButton
                x:Name="AutomaticOption"
                MinHeight="{StaticResource OptimizationMinimumTarget}"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Automatic recommended optimisation"
                Checked="OnAutomaticChecked"
                GroupName="OptimizationPreference"
                UseSystemFocusVisuals="True">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="AutomaticTitle" Style="{StaticResource OptimizationCardTitleStyle}" Text="Automatic" />
                        <TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Recommended. Chooses the strongest safe overall result for this model and computer." />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Background="{ThemeResource OptimizationSelectedSurfaceBrush}"
                        CornerRadius="12">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource OptimizationPrimaryBrush}"
                            Text="Recommended" />
                    </Border>
                </Grid>
            </RadioButton>
        </Border>

        <Border x:Name="ManualCard" Style="{StaticResource OptimizationCardStyle}">
            <StackPanel Spacing="12">
                <RadioButton
                    x:Name="ManualOption"
                    MinHeight="{StaticResource OptimizationMinimumTarget}"
                    AutomationProperties.Name="Choose optimisation preference manually"
                    Checked="OnManualChecked"
                    GroupName="OptimizationPreference"
                    UseSystemFocusVisuals="True">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource OptimizationCardTitleStyle}" Text="Choose your preference" />
                        <TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Move continuously between memory efficiency and model capability." />
                    </StackPanel>
                </RadioButton>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="MODEL PREFERENCE" />
                    <TextBlock
                        x:Name="CurrentPreferenceLabel"
                        Grid.Column="1"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource OptimizationPrimaryBrush}"
                        Text="Balanced" />
                </Grid>

                <modelDownload:ModelPreferenceSlider
                    x:Name="PreferenceSlider"
                    MinHeight="{StaticResource OptimizationMinimumTarget}"
                    AutomationProperties.HelpText="Choose between maximum efficiency and maximum model capability"
                    AutomationProperties.Name="Model preference"
                    IsThumbToolTipEnabled="False"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    SnapsTo="StepValues"
                    StepFrequency="0.1"
                    TickPlacement="None"
                    UseSystemFocusVisuals="True"
                    Value="50"
                    ValueChanged="OnSliderValueChanged" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="MinimumPreferenceLabel"
                        HorizontalAlignment="Left"
                        Style="{StaticResource OptimizationBodyStyle}"
                        Text="Maximum efficiency" />
                    <TextBlock
                        x:Name="MaximumPreferenceLabel"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource OptimizationBodyStyle}"
                        Text="Maximum capability"
                        TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
