<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.ModelOptimization.Controls.OptimizationOutcomeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelOptimization/Presentation/OptimizationTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <Border Style="{StaticResource OptimizationCardStyle}">
            <StackPanel Spacing="18">
                <TextBlock
                    x:Name="OutcomeGlyph"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="36"
                    Text="✓" />
                <TextBlock
                    x:Name="OutcomeSummary"
                    HorizontalAlignment="Center"
                    Style="{StaticResource OptimizationBodyStyle}"
                    TextAlignment="Center" />
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="RESULT" />
                        <TextBlock x:Name="OutcomeResult" Style="{StaticResource OptimizationValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="NEW MODEL COPY" />
                        <TextBlock x:Name="OutcomeNewModelCopy" Style="{StaticResource OptimizationValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="3">
                        <TextBlock Style="{StaticResource OptimizationLabelStyle}" Text="VALIDATION" />
                        <TextBlock x:Name="OutcomeValidation" Style="{StaticResource OptimizationValueStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="SupportCodeText"
                    Style="{StaticResource OptimizationBodyStyle}"
                    AutomationProperties.Name="Support code"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="ActionsHost" Spacing="10" />
    </StackPanel>
</UserControl>
