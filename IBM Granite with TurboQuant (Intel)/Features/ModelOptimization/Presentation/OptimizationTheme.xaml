<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="OptimizationCanvasBrush" Color="#F8FAFD" />
            <SolidColorBrush x:Key="OptimizationSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OptimizationSurfaceSubtleBrush" Color="#F8FAFD" />
            <SolidColorBrush x:Key="OptimizationBorderBrush" Color="#D7E0EC" />
            <SolidColorBrush x:Key="OptimizationBorderStrongBrush" Color="#8BB4FF" />
            <SolidColorBrush x:Key="OptimizationTextBrush" Color="#111827" />
            <SolidColorBrush x:Key="OptimizationTextSecondaryBrush" Color="#5B677A" />
            <SolidColorBrush x:Key="OptimizationPrimaryBrush" Color="#0F62FE" />
            <SolidColorBrush x:Key="OptimizationPrimaryHoverBrush" Color="#0B57D0" />
            <SolidColorBrush x:Key="OptimizationPrimaryPressedBrush" Color="#0847AA" />
            <SolidColorBrush x:Key="OptimizationSelectedSurfaceBrush" Color="#EDF4FF" />
            <SolidColorBrush x:Key="OptimizationSuccessBrush" Color="#087A55" />
            <SolidColorBrush x:Key="OptimizationWarningBrush" Color="#8A4B08" />
            <SolidColorBrush x:Key="OptimizationErrorBrush" Color="#B42318" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="OptimizationCanvasBrush" Color="#101828" />
            <SolidColorBrush x:Key="OptimizationSurfaceBrush" Color="#151D2B" />
            <SolidColorBrush x:Key="OptimizationSurfaceSubtleBrush" Color="#1B2535" />
            <SolidColorBrush x:Key="OptimizationBorderBrush" Color="#344054" />
            <SolidColorBrush x:Key="OptimizationBorderStrongBrush" Color="#4589FF" />
            <SolidColorBrush x:Key="OptimizationTextBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="OptimizationTextSecondaryBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="OptimizationPrimaryBrush" Color="#78A9FF" />
            <SolidColorBrush x:Key="OptimizationPrimaryHoverBrush" Color="#8CB7FF" />
            <SolidColorBrush x:Key="OptimizationPrimaryPressedBrush" Color="#A6C8FF" />
            <SolidColorBrush x:Key="OptimizationSelectedSurfaceBrush" Color="#162B49" />
            <SolidColorBrush x:Key="OptimizationSuccessBrush" Color="#6FD2AE" />
            <SolidColorBrush x:Key="OptimizationWarningBrush" Color="#F4C97A" />
            <SolidColorBrush x:Key="OptimizationErrorBrush" Color="#FFB4AB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="OptimizationCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OptimizationSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OptimizationSurfaceSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OptimizationBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OptimizationBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OptimizationTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OptimizationTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OptimizationPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OptimizationPrimaryHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OptimizationPrimaryPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OptimizationSelectedSurfaceBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OptimizationSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OptimizationWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OptimizationErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="OptimizationContentWidth">960</x:Double>
    <Thickness x:Key="OptimizationPageMargin">24,48,24,64</Thickness>
    <Thickness x:Key="OptimizationCompactPageMargin">16,32,16,48</Thickness>
    <CornerRadius x:Key="OptimizationCardRadius">16</CornerRadius>
    <Thickness x:Key="OptimizationCardPadding">24</Thickness>
    <x:Double x:Key="OptimizationMinimumTarget">44</x:Double>

    <Style x:Key="OptimizationCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource OptimizationSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OptimizationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OptimizationCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource OptimizationCardPadding}" />
    </Style>

    <Style x:Key="OptimizationCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OptimizationTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="OptimizationBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource OptimizationTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="OptimizationLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OptimizationTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="OptimizationValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OptimizationTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
</ResourceDictionary>
