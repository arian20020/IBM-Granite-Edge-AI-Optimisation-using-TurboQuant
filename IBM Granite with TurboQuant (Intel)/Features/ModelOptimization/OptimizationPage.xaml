<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GraniteEdgeAI.Features.ModelOptimization.OptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="LayoutRoot"
    SizeChanged="LayoutRoot_SizeChanged"
    HorizontalAlignment="Stretch"
    AutomationProperties.AutomationId="OptimizationPreview"
    AutomationProperties.Name="Optimization work surface">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="PageLayoutStates">
            <VisualState x:Name="CompactPageState" />
            <VisualState x:Name="StandardPageState" />
            <VisualState x:Name="WidePageState" />
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Features/ModelOptimization/Presentation/OptimizationTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Thickness x:Key="OptimizationOutlineThickness">1</Thickness><Thickness x:Key="OptimizationTopOutlineThickness">0,1,0,0</Thickness>
                    <SolidColorBrush x:Key="OptimizationSurfaceBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="OptimizationSubtleSurfaceBrush" Color="#F8FAFD"/><SolidColorBrush x:Key="OptimizationBorderBrush" Color="#D7E0EC"/>
                    <SolidColorBrush x:Key="OptimizationTextBrush" Color="#111827"/><SolidColorBrush x:Key="OptimizationMutedTextBrush" Color="#5B677A"/><SolidColorBrush x:Key="OptimizationSubtleTextBrush" Color="#758196"/>
                    <SolidColorBrush x:Key="OptimizationAccentBrush" Color="#0F62FE"/><SolidColorBrush x:Key="OptimizationAccentSurfaceBrush" Color="#EDF4FF"/><SolidColorBrush x:Key="OptimizationAccentBorderBrush" Color="#8BB4FF"/>
                    <SolidColorBrush x:Key="OptimizationSuccessBrush" Color="#087A55"/><SolidColorBrush x:Key="OptimizationSuccessSurfaceBrush" Color="#ECF8F3"/><SolidColorBrush x:Key="OptimizationSuccessBorderBrush" Color="#A9DDCB"/>
                    <SolidColorBrush x:Key="OptimizationWarningBrush" Color="#8A4B08"/><SolidColorBrush x:Key="OptimizationWarningSurfaceBrush" Color="#FFF7E8"/><SolidColorBrush x:Key="OptimizationWarningBorderBrush" Color="#E9C98B"/>
                    <SolidColorBrush x:Key="OptimizationErrorBrush" Color="#B42318"/><SolidColorBrush x:Key="OptimizationErrorSurfaceBrush" Color="#FFF1F0"/><SolidColorBrush x:Key="OptimizationErrorBorderBrush" Color="#F2B8B5"/>
                    <SolidColorBrush x:Key="OptimizationWaitingSurfaceBrush" Color="#EEF1F5"/><SolidColorBrush x:Key="OptimizationWaitingTextBrush" Color="#667085"/>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F62FE"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0B57D0"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0847AA"/><SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/><SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF"/><SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Thickness x:Key="OptimizationOutlineThickness">0.8</Thickness><Thickness x:Key="OptimizationTopOutlineThickness">0,0.8,0,0</Thickness>
                    <SolidColorBrush x:Key="OptimizationSurfaceBrush" Color="#151D2B"/><SolidColorBrush x:Key="OptimizationSubtleSurfaceBrush" Color="#1B2535"/><SolidColorBrush x:Key="OptimizationBorderBrush" Color="#344054"/>
                    <SolidColorBrush x:Key="OptimizationTextBrush" Color="#F9FAFB"/><SolidColorBrush x:Key="OptimizationMutedTextBrush" Color="#CBD5E1"/><SolidColorBrush x:Key="OptimizationSubtleTextBrush" Color="#98A2B3"/>
                    <SolidColorBrush x:Key="OptimizationAccentBrush" Color="#78A9FF"/><SolidColorBrush x:Key="OptimizationAccentSurfaceBrush" Color="#162B49"/><SolidColorBrush x:Key="OptimizationAccentBorderBrush" Color="#4589FF"/>
                    <SolidColorBrush x:Key="OptimizationSuccessBrush" Color="#6FD2AE"/><SolidColorBrush x:Key="OptimizationSuccessSurfaceBrush" Color="#12372E"/><SolidColorBrush x:Key="OptimizationSuccessBorderBrush" Color="#236B59"/>
                    <SolidColorBrush x:Key="OptimizationWarningBrush" Color="#F4C97A"/><SolidColorBrush x:Key="OptimizationWarningSurfaceBrush" Color="#392B16"/><SolidColorBrush x:Key="OptimizationWarningBorderBrush" Color="#725A2D"/>
                    <SolidColorBrush x:Key="OptimizationErrorBrush" Color="#FFB4AB"/><SolidColorBrush x:Key="OptimizationErrorSurfaceBrush" Color="#3D2021"/><SolidColorBrush x:Key="OptimizationErrorBorderBrush" Color="#7D3C3F"/>
                    <SolidColorBrush x:Key="OptimizationWaitingSurfaceBrush" Color="#273142"/><SolidColorBrush x:Key="OptimizationWaitingTextBrush" Color="#98A2B3"/>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#78A9FF"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#8CB7FF"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A6C8FF"/><SolidColorBrush x:Key="AccentButtonForeground" Color="#07111F"/><SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#07111F"/><SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#07111F"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Thickness x:Key="OptimizationOutlineThickness">1</Thickness><Thickness x:Key="OptimizationTopOutlineThickness">0,1,0,0</Thickness>
                    <SolidColorBrush x:Key="OptimizationSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="OptimizationSubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="OptimizationBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="OptimizationTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="OptimizationMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="OptimizationSubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="OptimizationAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="OptimizationAccentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="OptimizationAccentBorderBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="OptimizationSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="OptimizationSuccessSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="OptimizationSuccessBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="OptimizationWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="OptimizationWarningSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="OptimizationWarningBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="OptimizationErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="OptimizationErrorSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="OptimizationErrorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="OptimizationWaitingSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="OptimizationWaitingTextBrush" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}"/><SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/><SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="OptimizationBodyStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{ThemeResource OptimizationMutedTextBrush}"/><Setter Property="TextWrapping" Value="WrapWholeWords"/></Style>
            <Style x:Key="OptimizationLabelStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CharacterSpacing" Value="40"/><Setter Property="Foreground" Value="{ThemeResource OptimizationSubtleTextBrush}"/><Setter Property="TextWrapping" Value="WrapWholeWords"/></Style>
            <Style x:Key="OptimizationValueStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{ThemeResource OptimizationTextBrush}"/><Setter Property="TextWrapping" Value="WrapWholeWords"/></Style>
            <Style x:Key="OptimizationPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="176"/><Setter Property="MaxWidth" Value="240"/><Setter Property="Padding" Value="18,10"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="UseSystemFocusVisuals" Value="True"/></Style>
            <Style x:Key="OptimizationSecondaryButtonStyle" TargetType="Button"><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="176"/><Setter Property="MaxWidth" Value="240"/><Setter Property="Padding" Value="18,10"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="{ThemeResource OptimizationSubtleSurfaceBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource OptimizationBorderBrush}"/><Setter Property="BorderThickness" Value="{ThemeResource OptimizationOutlineThickness}"/><Setter Property="Foreground" Value="{ThemeResource OptimizationTextBrush}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="UseSystemFocusVisuals" Value="True"/></Style>
            <Style x:Key="OptimizationDisclosureHeaderToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="52"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{ThemeResource OptimizationTextBrush}"/><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource OptimizationAccentBrush}"/><Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/><Setter Property="FocusVisualMargin" Value="-2"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="DisclosureHeaderSurface" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="DisclosureHeaderSurface.Background" Value="{ThemeResource OptimizationSurfaceBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="DisclosureHeaderSurface.Background" Value="{ThemeResource OptimizationWaitingSurfaceBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"/></VisualStateGroup><VisualStateGroup x:Name="CheckStates"><VisualState x:Name="Unchecked"/><VisualState x:Name="Checked"/><VisualState x:Name="Indeterminate"/></VisualStateGroup></VisualStateManager.VisualStateGroups><ContentPresenter HorizontalAlignment="Stretch" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/></Border></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="OptimizationDisclosureStyle" TargetType="Expander">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource OptimizationSubtleSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource OptimizationBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource OptimizationOutlineThickness}" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border x:Name="DisclosureOuterBorder" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" HorizontalAlignment="Stretch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" UseLayoutRounding="True">
                                <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="ExpandStates">
                                            <VisualState x:Name="ExpandUp"><VisualState.Setters><Setter Target="DisclosureContent.Visibility" Value="Visible" /><Setter Target="InspectionEvidenceChevronDown.Visibility" Value="Collapsed" /><Setter Target="InspectionEvidenceChevronUp.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="CollapseDown"><VisualState.Setters><Setter Target="DisclosureContent.Visibility" Value="Collapsed" /><Setter Target="InspectionEvidenceChevronDown.Visibility" Value="Visible" /><Setter Target="InspectionEvidenceChevronUp.Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="ExpandDown"><VisualState.Setters><Setter Target="DisclosureContent.Visibility" Value="Visible" /><Setter Target="InspectionEvidenceChevronDown.Visibility" Value="Collapsed" /><Setter Target="InspectionEvidenceChevronUp.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="CollapseUp"><VisualState.Setters><Setter Target="DisclosureContent.Visibility" Value="Collapsed" /><Setter Target="InspectionEvidenceChevronDown.Visibility" Value="Visible" /><Setter Target="InspectionEvidenceChevronUp.Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="ExpandDirectionStates"><VisualState x:Name="Down" /><VisualState x:Name="Up" /></VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <ToggleButton x:Name="ExpanderHeader" MinHeight="52" Padding="14,0,52,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" IsEnabled="{TemplateBinding IsEnabled}" Style="{StaticResource OptimizationDisclosureHeaderToggleStyle}" UseSystemFocusVisuals="True" AutomationProperties.AutomationId="ExpanderToggleButton" />
                                        <Grid Width="32" Height="32" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"><FontIcon x:Name="InspectionEvidenceChevronDown" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource OptimizationMutedTextBrush}" Glyph="&#xE70D;" AutomationProperties.AccessibilityView="Raw" /><FontIcon x:Name="InspectionEvidenceChevronUp" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource OptimizationMutedTextBrush}" Glyph="&#xE70E;" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" /></Grid>
                                    </Grid>
                                    <Border x:Name="ExpanderContentClip" Grid.Row="1"><Border x:Name="DisclosureContent" Padding="14,12" HorizontalAlignment="Stretch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed"><ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" /></Border></Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OptimizationProgressItemStyle" TargetType="ListViewItem"><Setter Property="IsTabStop" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="56"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer
        x:Name="OptimizationPageScrollViewer"
        HorizontalContentAlignment="Center"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollMode="Enabled"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Disabled">
    <Grid x:Name="OptimizationContentHost" Width="960" MaxWidth="960" HorizontalAlignment="Center" VerticalAlignment="Top">
    <Border x:Name="OptimizationBay" MaxWidth="960" Padding="24,20,24,16" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="{ThemeResource OptimizationSurfaceBrush}" BorderBrush="{ThemeResource OptimizationBorderBrush}" BorderThickness="{ThemeResource OptimizationOutlineThickness}" CornerRadius="12" UseLayoutRounding="True" AutomationProperties.AutomationId="OptimizationBay" AutomationProperties.Name="Optimization configuration and progress">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="OptimizationIdentityHeader" ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource OptimizationAccentSurfaceBrush}" BorderBrush="{ThemeResource OptimizationAccentBorderBrush}" BorderThickness="{ThemeResource OptimizationOutlineThickness}"><FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource OptimizationAccentBrush}" AutomationProperties.AccessibilityView="Raw"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource OptimizationTextBrush}" Text="Selected configuration"/><TextBlock x:Name="OptimizationIdentityDetail" Style="{StaticResource OptimizationBodyStyle}" Text="Balanced · llama.cpp · Intel integrated graphics and CPU"/></StackPanel>
                <Border x:Name="OptimizationIdentityStatus" Grid.Column="2" Height="32" Padding="12,0" VerticalAlignment="Center" Background="{ThemeResource OptimizationAccentSurfaceBrush}" BorderBrush="{ThemeResource OptimizationAccentBorderBrush}" BorderThickness="{ThemeResource OptimizationOutlineThickness}" CornerRadius="16" AutomationProperties.AutomationId="OptimizationIdentityStatus" AutomationProperties.Name="Ready to start"><TextBlock x:Name="OptimizationIdentityStatusText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource OptimizationAccentBrush}" Text="Ready to start"/></Border>
            </Grid>
            <Border Grid.Row="1" Margin="0,16,0,0" BorderBrush="{ThemeResource OptimizationBorderBrush}" BorderThickness="{ThemeResource OptimizationTopOutlineThickness}"/>
            <Grid x:Name="OptimizationStateHost" Grid.Row="2" Margin="0,16,0,0">
                <Grid x:Name="OptimizationConfirmingPanel" AutomationProperties.AutomationId="OptimizationConfirmingPanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3"><TextBlock x:Name="OptimizationConfirmingHeading" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource OptimizationTextBrush}" Text="Review this configuration" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="OptimizationConfirmingHeading" AutomationProperties.HeadingLevel="Level2"/><TextBlock x:Name="OptimizationConfirmingSummary" Style="{StaticResource OptimizationBodyStyle}" Text="A new validated model copy will be created. Your original model stays unchanged."/></StackPanel>
                        <Grid x:Name="OptimizationConfigurationFacts" ColumnSpacing="24" RowSpacing="14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="OptimizationFactsPrimaryColumn" Width="*"/><ColumnDefinition x:Name="OptimizationFactsSecondaryColumn" Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="OptimizationRuntimeFacts" Spacing="7"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource OptimizationTextBrush}" Text="Runtime"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Weights"/><TextBlock x:Name="OptimizationWeights" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="Q5_K_M"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Cache"/><TextBlock x:Name="OptimizationCache" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="Q8"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Backend"/><TextBlock x:Name="OptimizationBackend" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="llama.cpp"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Device"/><TextBlock x:Name="OptimizationDevice" Grid.Column="1" MaxWidth="260" TextAlignment="Right" Style="{StaticResource OptimizationValueStyle}" Text="Intel integrated graphics and CPU"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Context"/><TextBlock x:Name="OptimizationContext" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="16,384 tokens"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Offload"/><TextBlock x:Name="OptimizationOffload" Grid.Column="1" MaxWidth="260" TextAlignment="Right" Style="{StaticResource OptimizationValueStyle}" Text="Most layers on the integrated GPU"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Flash attention"/><TextBlock x:Name="OptimizationFlashAttention" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="On"/></Grid></StackPanel>
                            <StackPanel x:Name="OptimizationMemoryFacts" Grid.Column="1" Spacing="7"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource OptimizationTextBrush}" Text="Memory"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Model"/><TextBlock x:Name="OptimizationModelMemory" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="4.4 GB"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Cache"/><TextBlock x:Name="OptimizationCacheMemory" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="1.1 GB"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Runtime"/><TextBlock x:Name="OptimizationRuntimeMemory" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="0.8 GB"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Predicted peak"/><TextBlock x:Name="OptimizationPredictedPeak" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="6.3 GB"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Safe budget"/><TextBlock x:Name="OptimizationSafeBudget" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="8.0 GB"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Headroom"/><TextBlock x:Name="OptimizationHeadroom" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Foreground="{ThemeResource OptimizationSuccessBrush}" Text="1.7 GB"/></Grid></StackPanel>
                            <StackPanel x:Name="OptimizationOutputFacts" Grid.Row="1" Spacing="7"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource OptimizationTextBrush}" Text="Output and storage"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="New copy"/><TextBlock x:Name="OptimizationNewCopy" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="Yes · original unchanged"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Output"/><TextBlock x:Name="OptimizationOutput" Grid.Column="1" MaxWidth="260" TextAlignment="Right" Style="{StaticResource OptimizationValueStyle}" Text="GGUF model and validation manifest"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Working disk"/><TextBlock x:Name="OptimizationWorkingDisk" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="9.2 GB"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource OptimizationBodyStyle}" Text="Final disk"/><TextBlock x:Name="OptimizationFinalDisk" Grid.Column="1" Style="{StaticResource OptimizationValueStyle}" Text="5.1 GB"/></Grid></StackPanel>
                            <StackPanel x:Name="OptimizationTrustFacts" Grid.Row="1" Grid.Column="1" Spacing="7"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource OptimizationTextBrush}" Text="Trust and limitations"/><TextBlock x:Name="OptimizationEvidence" Style="{StaticResource OptimizationBodyStyle}" Text="Evidence: Verified for this backend and device"/><TextBlock x:Name="OptimizationTradeoff" Style="{StaticResource OptimizationBodyStyle}" Text="Trade-off: Keeps high capability while leaving working memory free."/><TextBlock x:Name="OptimizationLimitations" Style="{StaticResource OptimizationBodyStyle}" Text="Limitation: Longer conversations will use more cache memory."/><TextBlock x:Name="OptimizationRouteValidation" Style="{StaticResource OptimizationBodyStyle}" Text="Route validation: Validate, smoke test, and reinspect the new model"/></StackPanel>
                        </Grid>
                        <Expander x:Name="OptimizationTechnicalDetailsExpander" Style="{StaticResource OptimizationDisclosureStyle}" Header="Technical details" AutomationProperties.AutomationId="OptimizationTechnicalDetailsExpander" AutomationProperties.Name="Technical details"><Grid><TextBlock x:Name="OptimizationTechnicalDetails" Style="{StaticResource OptimizationBodyStyle}" IsTextSelectionEnabled="True" Text="Plan and configuration identities are revalidated only after Start optimisation is requested. Support code: OPT-CONFIRM-001."/></Grid></Expander>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,12" BorderBrush="{ThemeResource OptimizationBorderBrush}" BorderThickness="{ThemeResource OptimizationTopOutlineThickness}"><StackPanel x:Name="OptimizationConfirmingActions" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10"><Button x:Name="BtnOptimizationBack" MinWidth="176" MaxWidth="240" HorizontalAlignment="Center" Style="{StaticResource OptimizationSecondaryButtonStyle}" AutomationProperties.AutomationId="OptimizationAction.Back" Content="Back"/><Button x:Name="BtnStartOptimization" MinWidth="176" MaxWidth="240" HorizontalAlignment="Center" Style="{StaticResource OptimizationPrimaryButtonStyle}" AutomationProperties.AutomationId="OptimizationAction.Start" Content="Start optimisation"/></StackPanel></Border>
                </Grid>

                <Grid x:Name="OptimizationProgressPanel" Visibility="Collapsed" AutomationProperties.AutomationId="OptimizationProgressPanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
