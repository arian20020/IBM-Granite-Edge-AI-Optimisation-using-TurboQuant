<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GraniteEdgeAI.Features.GgufRuntime.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.GgufRuntime.Controls"
    Background="{ThemeResource GgufChatCanvasBrush}">
    <Grid x:Name="ChatLayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="840" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HistoryRail.Visibility" Value="Visible" />
                        <Setter Target="HistoryColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HistoryRail.Visibility" Value="Collapsed" />
                        <Setter Target="HistoryColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HistoryColumn" Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="HistoryRail"
            Grid.Column="0"
            Padding="24,28,20,24"
            Background="{ThemeResource GgufChatRailBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image
                    Width="44"
                    Height="44"
                    Source="ms-appx:///Assets/Branding/granite-edge-ai-icon.svg" />
                <TextBlock
                    Text="Granite Edge AI"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{ThemeResource GgufChatTextBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
            <Button
                x:Name="NewChatButton"
                Grid.Row="1"
                Height="52"
                Margin="0,28,0,12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="{ThemeResource GgufChatPrimaryBrush}"
                Foreground="White"
                FontWeight="SemiBold"
                Content="+  New Chat"
                AutomationProperties.Name="Start a new chat"
                Click="NewChatButton_Click" />
            <Button
                x:Name="ImportModelButton"
                Grid.Row="2"
                Height="48"
                Margin="0,0,0,20"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Import Model"
                AutomationProperties.Name="Import another model"
                Click="ImportModelButton_Click" />
            <StackPanel Grid.Row="3" Spacing="10">
                <TextBlock
                    Text="CHATS"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GgufChatMutedBrush}" />
                <ListView
                    x:Name="ChatHistoryList"
                    SelectionMode="None"
                    AutomationProperties.Name="Dated chat history" />
            </StackPanel>
            <Button
                Grid.Row="4"
                Height="48"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Settings"
                AutomationProperties.Name="Settings" />
        </Grid>

        <Grid Grid.Column="1" Padding="20">
            <Border
                Background="{ThemeResource GgufChatSurfaceBrush}"
                CornerRadius="24"
                Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="4,0,4,20" Spacing="6">
                        <TextBlock
                            Text="Chat"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{ThemeResource GgufChatTextBrush}" />
                        <TextBlock
                            x:Name="ModelNameText"
                            Text="No model selected"
                            Foreground="{ThemeResource GgufChatMutedBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Rectangle
                        Grid.Row="1"
                        Fill="{ThemeResource GgufChatBorderBrush}" />
                    <Grid Grid.Row="2">
                        <StackPanel
                            x:Name="EmptyConversationState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="18">
                            <Image
                                Width="88"
                                Height="88"
                                Source="ms-appx:///Assets/Branding/granite-edge-ai-icon.svg"
                                Opacity="0.9" />
                            <TextBlock
                                Text="Start a new conversation"
                                FontSize="21"
                                Foreground="{ThemeResource GgufChatMutedBrush}"
                                TextAlignment="Center" />
                        </StackPanel>
                        <ListView
                            x:Name="TranscriptList"
                            Padding="4,20"
                            SelectionMode="None"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Conversation messages"
                            AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <controls:ChatComposer
                        x:Name="Composer"
                        Grid.Row="3"
                        Margin="0,20,0,0"
                        SendRequested="Composer_SendRequested"
                        StopRequested="Composer_StopRequested" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
