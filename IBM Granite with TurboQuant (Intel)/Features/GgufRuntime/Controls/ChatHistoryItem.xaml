<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.GgufRuntime.Controls.ChatHistoryItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw">
    <Grid>
        <Button
            x:Name="HistoryButton"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            IsTabStop="False"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Padding="12,8"
            Style="{StaticResource GgufChatNavigationButtonStyle}">
            <StackPanel x:Name="HistoryContentGrid" Spacing="3">
                <TextBlock
                    x:Name="DateText"
                    Text="{x:Bind DateLabel, Mode=OneWay}"
                    FontSize="11"
                    Style="{StaticResource GgufChatHistoryDateStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="TitleText"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
