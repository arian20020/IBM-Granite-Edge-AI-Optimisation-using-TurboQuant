<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.GgufRuntime.Controls.ChatMessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border
            x:Name="BubbleBorder"
            MaxWidth="720"
            CornerRadius="16"
            Padding="16,12"
            Background="{ThemeResource GgufChatSurfaceBrush}"
            HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="AssistantIdentityText"
                    Text="Granite Edge AI"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource GgufChatAssistantBubbleTextBrush}" />
                <TextBlock
                    x:Name="MessageText"
                    Text="{x:Bind MessageContent, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Foreground="{ThemeResource GgufChatTextBrush}" />
                <TextBlock
                    x:Name="StatusTextBlock"
                    Text="{x:Bind StatusText, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource GgufChatMutedBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
