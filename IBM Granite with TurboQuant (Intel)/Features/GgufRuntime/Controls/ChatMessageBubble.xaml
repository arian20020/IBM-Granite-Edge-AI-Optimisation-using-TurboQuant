<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GraniteEdgeAI.Features.GgufRuntime.Controls.ChatMessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RoleStates">
                <VisualState x:Name="AssistantRole"><VisualState.Setters>
                    <Setter Target="BubbleBorder.Background" Value="{ThemeResource GgufChatAssistantBubbleBrush}" />
                    <Setter Target="BubbleBorder.Padding" Value="0" />
                    <Setter Target="BubbleBorder.CornerRadius" Value="0" />
                    <Setter Target="MessageText.Foreground" Value="{ThemeResource GgufChatAssistantBubbleTextBrush}" />
                    <Setter Target="MessageText.Visibility" Value="Collapsed" />
                    <Setter Target="MarkdownMessageText.Visibility" Value="Visible" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="UserRole"><VisualState.Setters>
                    <Setter Target="BubbleBorder.Background" Value="{ThemeResource GgufChatUserBubbleBrush}" />
                    <Setter Target="BubbleBorder.Padding" Value="14,10" />
                    <Setter Target="BubbleBorder.CornerRadius" Value="14,14,4,14" />
                    <Setter Target="MessageText.Foreground" Value="{ThemeResource GgufChatUserBubbleTextBrush}" />
                    <Setter Target="MessageText.Visibility" Value="Visible" />
                    <Setter Target="MarkdownMessageText.Visibility" Value="Collapsed" />
                    <Setter Target="AvatarColumn.Width" Value="0" />
                    <Setter Target="RoleLayout.ColumnSpacing" Value="0" />
                    <Setter Target="AssistantAvatar.Visibility" Value="Collapsed" />
                    <Setter Target="AssistantIdentityText.Visibility" Value="Collapsed" />
                </VisualState.Setters></VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel
            x:Name="MessageContainer"
            MaxWidth="720"
            HorizontalAlignment="Left"
            PointerEntered="MessageContainer_PointerEntered"
            PointerExited="MessageContainer_PointerExited">
            <Grid x:Name="RoleLayout" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="AvatarColumn" Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="AssistantAvatar" Width="24" Height="24" VerticalAlignment="Top"
                    Source="ms-appx:///Assets/Branding/granite-edge-ai-icon.svg" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1">
            <Border
                x:Name="BubbleBorder"
                AutomationProperties.AccessibilityView="Raw"
                CornerRadius="16"
                Padding="16,12"
                Background="{ThemeResource GgufChatSurfaceBrush}">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="AssistantIdentityText"
                        Text="Granite Edge AI"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource GgufChatMutedBrush}" />
                    <RichTextBlock
                        x:Name="MessageText"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource GgufChatTextBrush}" />
                    <RichTextBlock
                        x:Name="MarkdownMessageText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource GgufChatAssistantBubbleTextBrush}"
                        AutomationProperties.AutomationId="AssistantMarkdownText" />
                    <TextBlock
                        x:Name="StatusTextBlock"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource GgufChatMutedBrush}" />
                </StackPanel>
            </Border>
            <StackPanel
                Margin="4,6,4,0"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="ContinueButton"
                    MinHeight="44"
                    Padding="6,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="Continue generating"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="ContinueMessageButton"
                    AutomationProperties.Name="Continue generating"
                    AutomationProperties.HelpText="Continue generating this assistant response"
                    ToolTipService.ToolTip="Continue generating"
                    Click="ContinueButton_Click" />
                <Button
                    x:Name="CopyMessageButton"
                    Width="44"
                    Height="44"
                    MinWidth="44"
                    MinHeight="44"
                    Padding="6"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Opacity="0"
                    AutomationProperties.AutomationId="CopyMessageButton"
                    AutomationProperties.Name="Copy message"
                    AutomationProperties.HelpText="Copy this message to the clipboard"
                    ToolTipService.ToolTip="Copy message"
                    Click="CopyMessageButton_Click"
                    GotFocus="CopyMessageButton_GotFocus"
                    LostFocus="CopyMessageButton_LostFocus">
                    <FontIcon
                        x:Name="CopyMessageGlyph"
                        FontSize="14"
                        Glyph="&#xE8C8;" />
                </Button>
            </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
