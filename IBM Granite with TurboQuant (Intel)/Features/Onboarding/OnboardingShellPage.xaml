<?xml version="1.0" encoding="utf-8" ?>

<Page
    x:Class="GraniteEdgeAI.Features.Onboarding.OnboardingShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GraniteEdgeAI.Features.Onboarding.Controls">

    <!--
        The shell divides onboarding into two permanent areas:
        1. The current onboarding page.
        2. The persistent stage indicator.
    -->
    <Grid
        Background="{ThemeResource GraniteAppCanvasBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />

            <!--  uses all available space for the current onboarding page  -->
            <RowDefinition
                Height="*" />

            <!--  Sizes itself to the persistent stage indicator.  -->
            <RowDefinition
                Height="Auto" />

        </Grid.RowDefinitions>

        <Border x:Name="BackToChatRegion" Grid.Row="0" Visibility="Collapsed"
                MaxWidth="1184" HorizontalAlignment="Stretch" Padding="32,8,32,0">
            <Button x:Name="BackToChatButton" AutomationProperties.Name="Back to chat"
                    MinHeight="44" HorizontalAlignment="Left" Click="BackToChat_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock Text="Back to chat" />
                </StackPanel>
            </Button>
        </Border>

        <!--
            Displays one onboarding page at a time.
            It initially displays ModelImportPage.
        -->
        <Frame
            x:Name="StageFrame"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!--
            Remains outside StageFrame navigation so it stays visible
            while onboarding pages change.
        -->
        <controls:OnboardingStageIndicator
            x:Name="StageIndicator"
            Grid.Row="2"
            HorizontalAlignment="Stretch" />

    </Grid>

</Page>
