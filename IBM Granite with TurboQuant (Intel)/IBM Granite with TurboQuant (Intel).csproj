<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GraniteEdgeAI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants Condition="'$(Platform)' == 'x64'">$(DefineConstants);MODEL_INSPECTION_X64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DefineConstants>$(DefineConstants);MODEL_INSPECTION_FIXTURE_GALLERY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Features\ModelInspection\DebugFixtures\**" />
    <Page Remove="Features\ModelInspection\DebugFixtures\**" />
    <None Remove="Features\ModelInspection\DebugFixtures\**" />
    <Content Remove="Features\ModelInspection\DebugFixtures\**" />
    <EmbeddedResource Remove="Features\ModelInspection\DebugFixtures\**" />
    <PRIResource Remove="Features\ModelInspection\DebugFixtures\**" />
    <Compile Remove="Features\Onboarding\DebugFixtures\**" />
    <Page Remove="Features\Onboarding\DebugFixtures\**" />
    <None Remove="Features\Onboarding\DebugFixtures\**" />
    <Content Remove="Features\Onboarding\DebugFixtures\**" />
    <EmbeddedResource Remove="Features\Onboarding\DebugFixtures\**" />
    <PRIResource Remove="Features\Onboarding\DebugFixtures\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <Compile Include="Features\ModelInspection\DebugFixtures\**\*.cs" />
    <Page Include="Features\ModelInspection\DebugFixtures\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="Features\Onboarding\DebugFixtures\**\*.cs" />
    <Page Include="Features\Onboarding\DebugFixtures\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <ProjectReference Include="..\shared\GraniteEdgeAI.ModelInspection.Fixtures\GraniteEdgeAI.ModelInspection.Fixtures.csproj" />
    <Content Include="..\tests\TestFixtures\ModelInspectionScenarios\**\*.json">
      <Link>TestFixtures\ModelInspectionScenarios\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>TestFixtures\ModelInspectionScenarios\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Features\NewFolder\**" />
    <EmbeddedResource Remove="Features\NewFolder\**" />
    <None Remove="Features\NewFolder\**" />
    <Page Remove="Features\NewFolder\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Features\ModelImport\Controls\ImportModelCard.xaml" />
    <None Remove="Features\ModelImport\FileImport\ModelFormatSelectionCard.xaml" />
    <None Remove="Features\ModelImport\ModelImportPage.xaml" />
    <None Remove="Features\ModelInspection\Controls\InspectionActionCard.xaml" />
    <None Remove="Features\ModelInspection\Controls\InspectionContentCard.xaml" />
    <None Remove="Features\ModelInspection\Controls\InspectionDisclosure.xaml" />
    <None Remove="Features\ModelInspection\Controls\InspectionModelCard.xaml" />
    <None Remove="Features\ModelInspection\Controls\InspectionOutcomeCard.xaml" />
    <None Remove="Features\ModelInspection\Presentation\ModelInspectionTheme.xaml" />
    <None Remove="Features\ModelInspection\ModelInspectionPage.xaml" />
    <None Remove="Features\Onboarding\Controls\OnboardingStageIndicator.xaml" />
    <None Remove="Features\Onboarding\OnboardingShellPage.xaml" />
  </ItemGroup>

	<ItemGroup>
		<!-- Existing Windows application assets. -->
		<Content Include="Assets\SplashScreen.scale-200.png" />
		<Content Include="Assets\LockScreenLogo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
		<Content Include="Assets\StoreLogo.png" />
		<Content Include="Assets\Wide310x150Logo.scale-200.png" />

		<!-- Granite Edge AI branding used inside the application UI. -->
		<Content Include="Assets\Branding\granite-edge-ai-icon.svg" />

		<!-- Licensed Inter 4.1 faces and immutable provenance for Model Inspection. -->
		<Content Update="Assets\Fonts\Inter-Regular.ttf" />
		<Content Update="Assets\Fonts\Inter-Bold.ttf" />
		<Content Update="Assets\Fonts\OFL.txt" />
		<Content Update="Assets\Fonts\inter-manifest.json" />
	</ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WinUI process owns only the protocol contracts and protected
         client. LLamaSharp, the worker host and native CPU libraries remain
         in the child process. -->
    <ProjectReference
      Include="..\shared\GraniteEdgeAI.ModelInspection.Contracts\GraniteEdgeAI.ModelInspection.Contracts.csproj"
      Condition="'$(Platform)' == 'x64'" />
    <ProjectReference
      Include="..\infrastructure\GraniteEdgeAI.ModelInspection.WorkerClient\GraniteEdgeAI.ModelInspection.WorkerClient.csproj"
      Condition="'$(Platform)' == 'x64'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' != 'x64'">
    <Compile Remove="Features\ModelInspection\Infrastructure\**\*.cs" />
    <Compile Remove="Features\ModelInspection\Runtime\WorkerRequestMapper.cs" />
    <Compile Remove="Features\ModelInspection\Runtime\WorkerResultMapper.cs" />
    <Compile Remove="Features\ModelInspection\Runtime\WorkerProcessLlamaModelProbe.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelImport\FileImport\ModelFormatSelectionCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelImport\ModelDownload\ModelDownloadCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelImport\ModelImportPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelImport\Controls\ImportModelCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Features\ModelImport\FileImport\DragDropRoute\" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\Onboarding\Controls\OnboardingStageIndicator.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\Onboarding\OnboardingShellPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <!-- WorkerClient protocol serialization is reflection-based. Keep the
         supported x64 inspection path untrimmed until a source-generated
         protocol context is introduced and verified. -->
    <PublishTrimmed Condition="'$(Platform)' == 'x64'">False</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PRIResource Remove="Features\NewFolder\**" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelInspection\Presentation\ModelInspectionTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelInspection\Controls\InspectionActionCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelInspection\Controls\InspectionContentCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelInspection\Controls\InspectionModelCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelInspection\Controls\InspectionOutcomeCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelInspection\ModelInspectionPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Features\ModelInspection\Controls\InspectionDisclosure.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <Import
    Project="ModelInspection.WorkerPackaging.targets"
    Condition="'$(Platform)' == 'x64'" />
</Project>
