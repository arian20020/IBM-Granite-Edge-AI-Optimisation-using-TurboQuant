<Project>
  <PropertyGroup>
    <HardwareInspectionLlamaCppProbePackageRelativeDirectory>HardwareInspection\LlamaCppProbe</HardwareInspectionLlamaCppProbePackageRelativeDirectory>
    <!-- All importers reference one canonical staging area. This keeps the app and
         packaged-test content identities equal and lets MSBuild de-duplicate them. -->
    <_HardwareInspectionLlamaCppProbeRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_HardwareInspectionLlamaCppProbeRepositoryRoot>
    <_HardwareInspectionLlamaCppProbeIntermediateRoot>$([System.IO.Path]::GetFullPath('$(_HardwareInspectionLlamaCppProbeRepositoryRoot)\obj\hi-llamacpp-probe'))</_HardwareInspectionLlamaCppProbeIntermediateRoot>
    <_HardwareInspectionLlamaCppProbeRawRoot>$(_HardwareInspectionLlamaCppProbeIntermediateRoot)\hardware-inspection-llamacpp-probe-raw\$(Configuration)\win-x64</_HardwareInspectionLlamaCppProbeRawRoot>
    <_HardwareInspectionLlamaCppProbePackageRoot>$(_HardwareInspectionLlamaCppProbeIntermediateRoot)\hardware-inspection-llamacpp-probe\$(Configuration)\win-x64</_HardwareInspectionLlamaCppProbePackageRoot>
    <_HardwareInspectionLlamaCppProbeArtifactsRoot>$(_HardwareInspectionLlamaCppProbeIntermediateRoot)\hardware-inspection-llamacpp-probe-artifacts\$(Configuration)</_HardwareInspectionLlamaCppProbeArtifactsRoot>
    <_HardwareInspectionLlamaCppProbeManifestPath>$(_HardwareInspectionLlamaCppProbeIntermediateRoot)\hardware-inspection-llamacpp-probe\$(Configuration)\llamacpp-probe-manifest.json</_HardwareInspectionLlamaCppProbeManifestPath>
    <_HardwareInspectionLlamaCppProbeProject>$(MSBuildThisFileDirectory)..\workers\GraniteEdgeAI.HardwareInspection.LlamaCppProbe\GraniteEdgeAI.HardwareInspection.LlamaCppProbe.csproj</_HardwareInspectionLlamaCppProbeProject>
    <_HardwareInspectionLlamaCppProbeManifestGenerator>$(MSBuildThisFileDirectory)..\scripts\hardware-inspection\New-LlamaCppProbeManifest.ps1</_HardwareInspectionLlamaCppProbeManifestGenerator>
    <_HardwareInspectionLlamaCppProbeManifestVerifier>$(MSBuildThisFileDirectory)..\scripts\hardware-inspection\Test-LlamaCppProbeManifest.ps1</_HardwareInspectionLlamaCppProbeManifestVerifier>
    <_HardwareInspectionLlamaCppProbeDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_HardwareInspectionLlamaCppProbeDotNetHost>
    <_HardwareInspectionLlamaCppProbeDotNetHost Condition="'$(_HardwareInspectionLlamaCppProbeDotNetHost)' == ''">dotnet</_HardwareInspectionLlamaCppProbeDotNetHost>
  </PropertyGroup>

  <Target Name="PublishHardwareInspectionLlamaCppProbeForApplication"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(Platform)' == 'x64' and '$(DesignTimeBuild)' != 'true' and '$(HardwareInspectionLlamaCppProbeSkipPackaging)' != 'true'">
    <RemoveDir Directories="$(_HardwareInspectionLlamaCppProbeRawRoot)" />
    <RemoveDir Directories="$(_HardwareInspectionLlamaCppProbePackageRoot)" />
    <RemoveDir Directories="$(_HardwareInspectionLlamaCppProbeArtifactsRoot)" />
    <Delete Files="$(_HardwareInspectionLlamaCppProbeManifestPath)" />
    <MakeDir Directories="$(_HardwareInspectionLlamaCppProbeRawRoot);$(_HardwareInspectionLlamaCppProbePackageRoot)" />

    <Exec WorkingDirectory="$(_HardwareInspectionLlamaCppProbeRepositoryRoot)" Command="&quot;$(_HardwareInspectionLlamaCppProbeDotNetHost)&quot; restore &quot;$(_HardwareInspectionLlamaCppProbeProject)&quot; --runtime win-x64 --artifacts-path &quot;$(_HardwareInspectionLlamaCppProbeArtifactsRoot)&quot; -p:Configuration=Release -p:Platform=x64" />
    <Exec WorkingDirectory="$(_HardwareInspectionLlamaCppProbeRepositoryRoot)" Command="&quot;$(_HardwareInspectionLlamaCppProbeDotNetHost)&quot; publish &quot;$(_HardwareInspectionLlamaCppProbeProject)&quot; --configuration Release --runtime win-x64 --self-contained false --no-restore --artifacts-path &quot;$(_HardwareInspectionLlamaCppProbeArtifactsRoot)&quot; --output &quot;$(_HardwareInspectionLlamaCppProbeRawRoot)&quot; -p:Configuration=Release -p:Platform=x64 -p:UseAppHost=true -p:PublishTrimmed=false -p:PublishReadyToRun=false -p:DebugSymbols=false -p:DebugType=None -p:CopyDebugSymbolToPublishDirectory=false" />

    <ItemGroup>
      <_HardwareInspectionLlamaCppProbeManagedFiles Include="$(_HardwareInspectionLlamaCppProbeRawRoot)\*" Exclude="$(_HardwareInspectionLlamaCppProbeRawRoot)\*.pdb" />
      <_HardwareInspectionLlamaCppProbeNativeFiles Include="$(_HardwareInspectionLlamaCppProbeRawRoot)\runtimes\win-x64\native\noavx\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_HardwareInspectionLlamaCppProbeManagedFiles);@(_HardwareInspectionLlamaCppProbeNativeFiles)" DestinationFolder="$(_HardwareInspectionLlamaCppProbePackageRoot)" SkipUnchangedFiles="false" />

    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_HardwareInspectionLlamaCppProbeManifestGenerator)&quot; -ProbeDirectory &quot;$(_HardwareInspectionLlamaCppProbePackageRoot)&quot; -ManifestPath &quot;$(_HardwareInspectionLlamaCppProbeManifestPath)&quot;" />
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_HardwareInspectionLlamaCppProbeManifestVerifier)&quot; -ProbeDirectory &quot;$(_HardwareInspectionLlamaCppProbePackageRoot)&quot; -ManifestPath &quot;$(_HardwareInspectionLlamaCppProbeManifestPath)&quot;" />

    <ItemGroup>
      <_HardwareInspectionLlamaCppProbePublishedFiles Include="$(_HardwareInspectionLlamaCppProbePackageRoot)\*" />
      <Content Include="@(_HardwareInspectionLlamaCppProbePublishedFiles)">
        <Link>$(HardwareInspectionLlamaCppProbePackageRelativeDirectory)\%(Filename)%(Extension)</Link>
        <TargetPath>$(HardwareInspectionLlamaCppProbePackageRelativeDirectory)\%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="$(_HardwareInspectionLlamaCppProbeManifestPath)">
        <Link>HardwareInspection\llamacpp-probe-manifest.json</Link>
        <TargetPath>HardwareInspection\llamacpp-probe-manifest.json</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
