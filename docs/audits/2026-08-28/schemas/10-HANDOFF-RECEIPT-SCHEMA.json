{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/schemas/audit-worker-handoff-receipt-v1.json",
  "title": "Granite Edge AI audit worker handoff receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "workerId", "frozenSourceCommit", "frozenSourceTree",
    "branch", "finalTip", "finalTree", "worktreeClean", "completedAtUtc",
    "report", "transport", "remoteRef", "bundle", "evidenceManifest",
    "testTotals", "nativeDisposition"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workerId": { "enum": ["A1", "F1", "H1", "Q1", "S1", "T1", "E1", "M1"] },
    "frozenSourceCommit": { "const": "4748fe04f19afdf6b27c4c12502b84db325e7294" },
    "frozenSourceTree": { "const": "fe1fa8fb5fe4de8e7c1d867a83e08375bc1d0c91" },
    "branch": { "type": "string", "pattern": "^(audit|test)/[a-z0-9._/-]+$", "maxLength": 180 },
    "finalTip": { "$ref": "#/$defs/gitObject" },
    "finalTree": { "$ref": "#/$defs/gitObject" },
    "worktreeClean": { "const": true },
    "completedAtUtc": { "$ref": "#/$defs/utc" },
    "report": { "$ref": "#/$defs/fileRecord" },
    "transport": { "enum": ["remote", "bundle"] },
    "remoteRef": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^refs/remotes/origin/(audit|test)/[a-z0-9._/-]+$", "maxLength": 220 }
      ]
    },
    "bundle": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["filename", "sha256", "bytes"],
          "properties": {
            "filename": { "type": "string", "pattern": "^[^\\\\/:*?\"<>|]+\\.bundle$", "maxLength": 180 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "evidenceManifest": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "bytes", "evidenceSubjectCommit", "evidenceSubjectTree"],
          "properties": {
            "path": { "type": "string", "pattern": "^docs/audits/2026-08-28/evidence/[^\\\\]+\\.json$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "bytes": { "type": "integer", "minimum": 1 },
            "evidenceSubjectCommit": { "$ref": "#/$defs/gitObject" },
            "evidenceSubjectTree": { "$ref": "#/$defs/gitObject" }
          }
        }
      ]
    },
    "testTotals": {
      "type": "object", "additionalProperties": false,
      "required": ["discovered", "executed", "passed", "failed", "skipped"],
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "nativeDisposition": { "enum": ["passed", "failed", "blocked", "mixed", "not-applicable", "not-run"] }
  },
  "allOf": [
    {
      "if": { "properties": { "transport": { "const": "remote" } } },
      "then": { "properties": { "remoteRef": { "type": "string" }, "bundle": { "type": "null" } } }
    },
    {
      "if": { "properties": { "transport": { "const": "bundle" } } },
      "then": { "properties": { "remoteRef": { "type": "null" }, "bundle": { "type": "object" } } }
    },
    {
      "if": { "properties": { "workerId": { "enum": ["H1", "M1", "Q1"] } } },
      "then": { "properties": { "evidenceManifest": { "type": "object" } } },
      "else": { "properties": { "evidenceManifest": { "type": "null" } } }
    }
  ],
  "$defs": {
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "fileRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/audits/2026-08-28/[^\\\\]+\\.md$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
