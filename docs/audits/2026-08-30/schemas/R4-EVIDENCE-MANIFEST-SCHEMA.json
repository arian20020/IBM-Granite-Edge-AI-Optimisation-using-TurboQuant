{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/schemas/r4-evidence-manifest-v2.json",
  "title": "Granite Edge AI R4 evidence manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "workerId", "frozenSourceCommit", "evidenceSubjectCommit",
    "evidenceSubjectTree", "createdAtUtc", "route", "evidenceStatus", "report",
    "inputs", "outputs", "commands", "blockers", "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "workerId": { "enum": ["H1", "M1", "Q1", "C0", "E1"] },
    "frozenSourceCommit": { "const": "4748fe04f19afdf6b27c4c12502b84db325e7294" },
    "evidenceSubjectCommit": { "$ref": "#/$defs/gitObject" },
    "evidenceSubjectTree": { "$ref": "#/$defs/gitObject" },
    "createdAtUtc": { "$ref": "#/$defs/utc" },
    "route": {
      "oneOf": [
        { "enum": ["shared", "gguf", "openvino"] },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["shared", "gguf", "openvino"] } }
      ]
    },
    "evidenceStatus": { "enum": ["passed", "failed", "blocked", "mixed"] },
    "report": { "$ref": "#/$defs/fileRecord" },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceItem" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceItem" } },
    "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command" } },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "nonClaims": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  },
  "$defs": {
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/audits/2026-08-30/[^\\\\]+\\.md$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "evidenceGrade"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "digest": { "$ref": "#/$defs/sha256" },
        "evidenceGrade": { "enum": ["measured", "parsed", "verified", "estimated", "fixture", "blocked"] }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "exitCode", "discovered", "executed", "passed", "failed", "skipped", "disposition"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,79}$" },
        "exitCode": { "type": "integer" },
        "discovered": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "disposition": { "enum": ["passed", "failed", "blocked", "mixed", "not-applicable"] },
        "resultSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
