{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final results failure",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_id", "campaign_id", "test_case_id", "attempt_id", "failure_id", "status", "stage", "reason", "source_status", "evidence_ids"],
  "properties": {
    "route_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "test_case_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "failure_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["passed", "failed", "blocked", "artifact_unavailable", "not_executed", "not_applicable", "not_collected"]},
    "stage": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "source_status": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
