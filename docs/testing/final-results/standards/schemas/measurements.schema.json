{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final results measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_id", "campaign_id", "test_case_id", "attempt_id", "measurement_id", "run_id", "repetition_id", "source_evidence_id", "latency_ms", "prompt_tokens_per_second", "generation_tokens_per_second", "peak_working_set_bytes", "input_tokens", "output_tokens"],
  "properties": {
    "route_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "test_case_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "measurement_id": {"type": "string", "minLength": 1},
    "run_id": {"type": ["string", "null"]},
    "repetition_id": {"type": ["string", "null"]},
    "source_evidence_id": {"type": ["string", "null"]},
    "latency_ms": {"type": ["number", "null"]},
    "prompt_tokens_per_second": {"type": ["number", "null"]},
    "generation_tokens_per_second": {"type": ["number", "null"]},
    "peak_working_set_bytes": {"type": ["integer", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0}
  }
}
