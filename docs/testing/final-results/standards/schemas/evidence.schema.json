{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final results evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_id", "campaign_id", "evidence_id", "role", "relative_path", "sha256", "size_bytes", "source_label", "derived", "input_evidence_ids"],
  "properties": {
    "route_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+"},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "source_label": {"type": ["string", "null"]},
    "derived": {"type": "boolean"},
    "input_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
