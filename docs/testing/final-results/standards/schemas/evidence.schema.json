{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final results evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_id", "campaign_id", "evidence_id", "role", "relative_path", "sha256", "size_bytes", "source_label", "derived", "input_evidence_ids"],
  "properties": {
    "route_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "relative_path": {"type": "string", "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F])(?!/)(?![A-Za-z]:)(?!\\\\)(?![\\s\\S]*\\\\)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))[\\s\\S]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "source_label": {"type": ["string", "null"], "minLength": 1, "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F])(?!/)(?![A-Za-z]:)(?!\\\\)(?![\\s\\S]*\\\\)[\\s\\S]*\\S[\\s\\S]*$"},
    "derived": {"type": "boolean"},
    "input_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"derived": {"const": true}}, "required": ["derived"]},
      "then": {"properties": {"input_evidence_ids": {"minItems": 1}}, "required": ["input_evidence_ids"]}
    }
  ]
}
