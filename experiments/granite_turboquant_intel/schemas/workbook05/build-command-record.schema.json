{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/workbook05/build-command-record.schema.json",
  "title": "Workbook 05 build command record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "record_type",
    "command_id",
    "route_id",
    "component",
    "executable",
    "arguments",
    "working_directory",
    "environment_allowlist",
    "started_utc",
    "ended_utc",
    "elapsed_seconds",
    "exit_code",
    "stdout_path",
    "stderr_path"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "campaign_id": {
      "const": "GTQ-WB05-MF-v1"
    },
    "record_type": {
      "const": "build-command"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "route_id": {
      "enum": [
        "route-a-merged-openvino",
        "route-b-experimental-qjl-polar"
      ]
    },
    "component": {
      "enum": [
        "runtime",
        "genai"
      ]
    },
    "executable": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "environment_allowlist": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "started_utc": {
      "type": "string",
      "format": "date-time"
    },
    "ended_utc": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "exit_code": {
      "type": "integer"
    },
    "stdout_path": {
      "type": "string",
      "minLength": 1
    },
    "stderr_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
