{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/workbook05/build-dependency-record.schema.json",
  "title": "Workbook 05 build dependency record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "record_type",
    "route_id",
    "component",
    "name",
    "path",
    "source",
    "version",
    "sha256",
    "purpose",
    "producer_command_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"const": "GTQ-WB05-MF-v1"},
    "record_type": {"const": "build-dependency"},
    "route_id": {"enum": ["route-a-merged-openvino", "route-b-experimental-qjl-polar"]},
    "component": {"enum": ["runtime", "genai"]},
    "name": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "null"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "purpose": {"type": "string", "minLength": 1},
    "producer_command_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
  }
}
