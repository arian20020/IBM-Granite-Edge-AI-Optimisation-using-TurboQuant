{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/workbook05/build-decision.schema.json",
  "title": "Workbook 05 build decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "record_type",
    "route_id",
    "component",
    "source_commit",
    "status",
    "reasons",
    "required_components",
    "granite_model_test_authorised",
    "activation_claim_authorised",
    "packed_storage_claim_authorised",
    "performance_claim_authorised",
    "quality_claim_authorised"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"const": "GTQ-WB05-MF-v1"},
    "record_type": {"const": "build-decision"},
    "route_id": {"enum": ["route-a-merged-openvino", "route-b-experimental-qjl-polar"]},
    "component": {"enum": ["runtime", "genai", "route"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["Passed", "Failed", "Blocked", "Infrastructure interrupted", "Not applicable", "BuildCandidate"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "required_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "status", "evidence_path"],
        "properties": {
          "component": {"enum": ["runtime", "genai"]},
          "status": {"enum": ["Passed", "Failed", "Blocked", "Infrastructure interrupted", "Not applicable"]},
          "evidence_path": {"type": "string", "minLength": 1}
        }
      }
    },
    "granite_model_test_authorised": {"const": false},
    "activation_claim_authorised": {"const": false},
    "packed_storage_claim_authorised": {"const": false},
    "performance_claim_authorised": {"const": false},
    "quality_claim_authorised": {"const": false}
  }
}
