{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "generated_at_utc",
    "observation",
    "checks",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "campaign_id": {
      "const": "GTQ-WB05-MF-v1"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "observation": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required",
          "passed",
          "expected",
          "actual"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "passed": {
            "type": "boolean"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          }
        }
      }
    },
    "overall_status": {
      "enum": [
        "Passed",
        "Failed"
      ]
    }
  }
}
