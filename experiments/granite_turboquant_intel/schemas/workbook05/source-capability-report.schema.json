{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]{2})(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "phase_id",
    "route_id",
    "findings",
    "decision",
    "decision_reason"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "campaign_id": { "const": "GTQ-WB05-MF-v1" },
    "phase_id": { "const": "phase-1-source-admission" },
    "route_id": {
      "enum": [
        "route-a-merged-openvino",
        "route-b-experimental-qjl-polar"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "classification",
          "source_path",
          "matched_tokens",
          "missing_tokens",
          "contradictory_tokens",
          "source_sha256",
          "excerpt_path"
        ],
        "properties": {
          "capability_id": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["Present in source", "Missing", "Contradictory"]
          },
          "source_path": { "$ref": "#/$defs/relative_path" },
          "matched_tokens": {
            "type": "array",
            "items": { "type": "string" }
          },
          "missing_tokens": {
            "type": "array",
            "items": { "type": "string" }
          },
          "contradictory_tokens": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_sha256": { "$ref": "#/$defs/sha256" },
          "excerpt_path": { "$ref": "#/$defs/relative_path" }
        }
      }
    },
    "decision": { "enum": ["Passed", "Blocked", "Candidate"] },
    "decision_reason": { "type": "string", "minLength": 1 }
  }
}
