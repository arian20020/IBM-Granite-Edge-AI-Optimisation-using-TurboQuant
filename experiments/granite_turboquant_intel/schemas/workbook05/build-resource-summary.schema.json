{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/workbook05/build-resource-summary.schema.json",
  "title": "Workbook 05 build resource summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "record_type",
    "route_id",
    "component",
    "command_id",
    "sample_interval_seconds",
    "sample_count",
    "peak_working_set_bytes",
    "peak_private_bytes",
    "minimum_available_memory_bytes",
    "maximum_commit_percent",
    "heartbeat_timeout_seconds",
    "safety_stop_triggered",
    "safety_stop_reason"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"const": "GTQ-WB05-MF-v1"},
    "record_type": {"const": "build-resource-summary"},
    "route_id": {"enum": ["route-a-merged-openvino", "route-b-experimental-qjl-polar"]},
    "component": {"enum": ["runtime", "genai"]},
    "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sample_interval_seconds": {"const": 2},
    "sample_count": {"type": "integer", "minimum": 1},
    "peak_working_set_bytes": {"type": "integer", "minimum": 0},
    "peak_private_bytes": {"type": "integer", "minimum": 0},
    "minimum_available_memory_bytes": {"type": "integer", "minimum": 0},
    "maximum_commit_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "heartbeat_timeout_seconds": {"const": 900},
    "safety_stop_triggered": {"type": "boolean"},
    "safety_stop_reason": {"type": ["string", "null"]}
  }
}
