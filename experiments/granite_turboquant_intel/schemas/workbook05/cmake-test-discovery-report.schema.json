{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]{2})(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "phase_id",
    "route_id",
    "blocker_id",
    "source_path",
    "class_file_name",
    "repeated_arch_assignment",
    "repeated_common_assignment",
    "intended_sources",
    "final_sources",
    "omitted_sources",
    "generated_metadata_path",
    "status",
    "reasons"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "campaign_id": { "const": "GTQ-WB05-MF-v1" },
    "phase_id": { "const": "phase-1-source-admission" },
    "route_id": { "const": "route-b-experimental-qjl-polar" },
    "blocker_id": { "const": "RB-SRC-001" },
    "source_path": { "$ref": "#/$defs/relative_path" },
    "class_file_name": { "type": "string", "minLength": 1 },
    "repeated_arch_assignment": { "type": "boolean" },
    "repeated_common_assignment": { "type": "boolean" },
    "intended_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    },
    "final_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    },
    "omitted_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    },
    "generated_metadata_path": { "$ref": "#/$defs/relative_path" },
    "status": { "enum": ["Confirmed", "Disproved", "Inconclusive"] },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
