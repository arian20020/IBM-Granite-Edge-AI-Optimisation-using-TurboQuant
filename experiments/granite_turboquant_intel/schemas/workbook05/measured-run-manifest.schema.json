{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]{2})(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegative_number_or_null": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "nonnegative_integer_or_null": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "score_or_null": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 10
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "test_id",
    "run_id",
    "route",
    "workbook_id",
    "run_purpose",
    "timestamps",
    "references",
    "execution",
    "generation",
    "performance",
    "resources",
    "procedure",
    "quality",
    "evidence",
    "classification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "campaign_id": { "const": "GTQ-WB05-MF-v1" },
    "test_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "route": {
      "enum": ["official-openvino", "custom-openvino-turboquant"]
    },
    "workbook_id": { "const": "WB-05" },
    "run_purpose": { "type": "string", "minLength": 1 },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_utc", "end_utc", "timezone"],
      "properties": {
        "start_utc": { "type": "string", "format": "date-time" },
        "end_utc": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "repository_id",
        "build_id",
        "model_id",
        "model_hash",
        "tokenizer_hash",
        "weight_quantization",
        "configuration_id",
        "prompt_set_id",
        "prompt_id",
        "rubric_id",
        "matched_baseline_run_id"
      ],
      "properties": {
        "environment_id": { "type": "string" },
        "repository_id": { "type": "string" },
        "build_id": { "type": "string" },
        "model_id": { "type": "string", "minLength": 1 },
        "model_hash": { "$ref": "#/$defs/sha256" },
        "tokenizer_hash": { "$ref": "#/$defs/sha256" },
        "weight_quantization": { "type": "string", "minLength": 1 },
        "configuration_id": { "type": "string" },
        "prompt_set_id": { "const": "GTQ-PROMPTS-v1" },
        "prompt_id": { "enum": ["P1", "P2", "P3", "P4", "P5", "P6"] },
        "rubric_id": { "const": "GTQ-QUALITY-RUBRIC-v1" },
        "matched_baseline_run_id": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_directory",
        "command_path",
        "environment_variables_path",
        "exit_code",
        "requested_backend",
        "actual_backend",
        "requested_device",
        "actual_device",
        "requested_model_placement",
        "actual_model_placement",
        "actual_kv_placement",
        "requested_k_precision",
        "verified_k_precision",
        "requested_v_precision",
        "verified_v_precision",
        "requested_k_codec",
        "verified_k_codec",
        "requested_v_codec",
        "verified_v_codec",
        "optimisation_requested",
        "optimisation_activated",
        "activation_proof_path",
        "fallback_check_path",
        "fallback_observed"
      ],
      "properties": {
        "working_directory": { "$ref": "#/$defs/relative_path" },
        "command_path": { "$ref": "#/$defs/relative_path" },
        "environment_variables_path": { "$ref": "#/$defs/relative_path" },
        "exit_code": { "type": "integer" },
        "requested_backend": { "type": "string" },
        "actual_backend": { "type": "string" },
        "requested_device": { "type": "string" },
        "actual_device": { "type": "string" },
        "requested_model_placement": { "type": "string" },
        "actual_model_placement": { "type": "string" },
        "actual_kv_placement": { "type": "string" },
        "requested_k_precision": { "type": "string" },
        "verified_k_precision": { "type": "string" },
        "requested_v_precision": { "type": "string" },
        "verified_v_precision": { "type": "string" },
        "requested_k_codec": { "type": "string" },
        "verified_k_codec": { "type": "string" },
        "requested_v_codec": { "type": "string" },
        "verified_v_codec": { "type": "string" },
        "optimisation_requested": { "type": "boolean" },
        "optimisation_activated": { "type": "boolean" },
        "activation_proof_path": { "$ref": "#/$defs/relative_path" },
        "fallback_check_path": { "$ref": "#/$defs/relative_path" },
        "fallback_observed": { "type": "boolean" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "sampling_settings",
        "max_output_tokens",
        "context_target_tokens",
        "actual_input_tokens",
        "actual_output_tokens",
        "stop_reason"
      ],
      "properties": {
        "seed": { "type": "integer" },
        "sampling_settings": { "type": "object" },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "context_target_tokens": { "type": "integer", "minimum": 1 },
        "actual_input_tokens": { "type": "integer", "minimum": 0 },
        "actual_output_tokens": { "type": "integer", "minimum": 0 },
        "stop_reason": { "type": "string", "minLength": 1 }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_load_time_ms",
        "ttft_ms",
        "ttft_includes_tokenization",
        "ttft_includes_prefill",
        "prompt_processing_tokens_per_second",
        "tpot_ms",
        "decode_tokens_per_second",
        "total_generation_time_ms",
        "perplexity",
        "perplexity_fixture_id",
        "perplexity_token_count"
      ],
      "properties": {
        "model_load_time_ms": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "ttft_ms": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "ttft_includes_tokenization": { "type": "boolean" },
        "ttft_includes_prefill": { "type": "boolean" },
        "prompt_processing_tokens_per_second": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "tpot_ms": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "decode_tokens_per_second": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "total_generation_time_ms": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "perplexity": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "perplexity_fixture_id": { "type": ["string", "null"] },
        "perplexity_token_count": { "$ref": "#/$defs/nonnegative_integer_or_null" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak_working_set_bytes",
        "peak_private_bytes",
        "available_ram_before_bytes",
        "minimum_available_ram_during_bytes",
        "available_ram_after_bytes",
        "k_cache_allocated_bytes",
        "v_cache_allocated_bytes",
        "cpu_mean_percent",
        "cpu_peak_percent",
        "gpu_dedicated_peak_bytes",
        "gpu_shared_peak_bytes"
      ],
      "properties": {
        "peak_working_set_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "peak_private_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "available_ram_before_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "minimum_available_ram_during_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "available_ram_after_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "k_cache_allocated_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "v_cache_allocated_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "cpu_mean_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "cpu_peak_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "gpu_dedicated_peak_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" },
        "gpu_shared_peak_bytes": { "$ref": "#/$defs/nonnegative_number_or_null" }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_role", "repetition_number", "included_in_formal_statistics"],
      "properties": {
        "run_role": { "enum": ["Pilot", "Warm-up", "Measured"] },
        "repetition_number": { "type": "integer", "minimum": 0 },
        "included_in_formal_statistics": { "type": "boolean" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_output_path",
        "raw_output_sha256",
        "deterministic_checks_path",
        "deterministic_failures",
        "dimension_scores",
        "critical_caps",
        "score_0_to_10",
        "matched_baseline_run_id",
        "paired_score_delta",
        "judge_label_hidden",
        "pairwise_order",
        "adjudication_path",
        "material_degradation",
        "stability_result"
      ],
      "properties": {
        "raw_output_path": { "$ref": "#/$defs/relative_path" },
        "raw_output_sha256": { "$ref": "#/$defs/sha256" },
        "deterministic_checks_path": { "$ref": "#/$defs/relative_path" },
        "deterministic_failures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dimension_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correctness_and_grounding",
            "instruction_and_format_adherence",
            "completeness_and_fact_retention",
            "relevance_clarity_and_coherence",
            "stability_and_output_integrity"
          ],
          "properties": {
            "correctness_and_grounding": { "$ref": "#/$defs/score_or_null" },
            "instruction_and_format_adherence": { "$ref": "#/$defs/score_or_null" },
            "completeness_and_fact_retention": { "$ref": "#/$defs/score_or_null" },
            "relevance_clarity_and_coherence": { "$ref": "#/$defs/score_or_null" },
            "stability_and_output_integrity": { "$ref": "#/$defs/score_or_null" }
          }
        },
        "critical_caps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "score_0_to_10": { "$ref": "#/$defs/score_or_null" },
        "matched_baseline_run_id": { "type": "string" },
        "paired_score_delta": {
          "type": ["number", "null"],
          "minimum": -10,
          "maximum": 10
        },
        "judge_label_hidden": { "type": "boolean" },
        "pairwise_order": {
          "enum": ["baseline-first", "candidate-first", "not-applicable"]
        },
        "adjudication_path": { "$ref": "#/$defs/relative_path" },
        "material_degradation": {
          "enum": ["Yes", "No", "Moderate - adjudication required", "Not evaluated"]
        },
        "stability_result": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout_path",
        "stderr_path",
        "raw_response_path",
        "resource_samples_path",
        "device_proof_path",
        "processed_result_path",
        "hash_manifest_path"
      ],
      "properties": {
        "stdout_path": { "$ref": "#/$defs/relative_path" },
        "stderr_path": { "$ref": "#/$defs/relative_path" },
        "raw_response_path": { "$ref": "#/$defs/relative_path" },
        "resource_samples_path": { "$ref": "#/$defs/relative_path" },
        "device_proof_path": { "$ref": "#/$defs/relative_path" },
        "processed_result_path": { "$ref": "#/$defs/relative_path" },
        "hash_manifest_path": { "$ref": "#/$defs/relative_path" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "result_reason", "failure_ids", "missing_data_codes", "next_action"],
      "properties": {
        "result": {
          "enum": ["Passed", "Failed", "Blocked", "Skipped by frontier", "Not applicable"]
        },
        "result_reason": { "type": "string", "minLength": 1 },
        "failure_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_data_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "next_action": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "properties": { "result": { "const": "Passed" } },
            "required": ["result"]
          }
        },
        "required": ["classification"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "actual_backend": { "minLength": 1 },
              "actual_device": { "minLength": 1 },
              "verified_k_precision": { "minLength": 1 },
              "verified_v_precision": { "minLength": 1 },
              "verified_k_codec": { "minLength": 1 },
              "verified_v_codec": { "minLength": 1 },
              "activation_proof_path": { "minLength": 1 },
              "fallback_check_path": { "minLength": 1 },
              "fallback_observed": { "const": false }
            }
          },
          "performance": {
            "properties": {
              "model_load_time_ms": { "type": "number" },
              "ttft_ms": { "type": "number" },
              "prompt_processing_tokens_per_second": { "type": "number" },
              "tpot_ms": { "type": "number" },
              "decode_tokens_per_second": { "type": "number" },
              "total_generation_time_ms": { "type": "number" }
            }
          },
          "resources": {
            "properties": {
              "peak_working_set_bytes": { "type": "number" },
              "peak_private_bytes": { "type": "number" },
              "available_ram_before_bytes": { "type": "number" },
              "minimum_available_ram_during_bytes": { "type": "number" },
              "available_ram_after_bytes": { "type": "number" },
              "k_cache_allocated_bytes": { "type": "number" },
              "v_cache_allocated_bytes": { "type": "number" },
              "cpu_mean_percent": { "type": "number" },
              "cpu_peak_percent": { "type": "number" }
            }
          },
          "quality": {
            "properties": {
              "raw_output_path": { "minLength": 1 },
              "raw_output_sha256": { "$ref": "#/$defs/sha256" },
              "deterministic_checks_path": { "minLength": 1 },
              "dimension_scores": {
                "properties": {
                  "correctness_and_grounding": { "type": "number" },
                  "instruction_and_format_adherence": { "type": "number" },
                  "completeness_and_fact_retention": { "type": "number" },
                  "relevance_clarity_and_coherence": { "type": "number" },
                  "stability_and_output_integrity": { "type": "number" }
                }
              },
              "score_0_to_10": { "type": "number" },
              "matched_baseline_run_id": { "minLength": 1 },
              "paired_score_delta": { "type": "number" },
              "judge_label_hidden": { "const": true },
              "pairwise_order": { "enum": ["baseline-first", "candidate-first"] },
              "adjudication_path": { "minLength": 1 },
              "material_degradation": {
                "enum": ["Yes", "No", "Moderate - adjudication required"]
              },
              "stability_result": { "minLength": 1 }
            }
          },
          "evidence": {
            "properties": {
              "stdout_path": { "minLength": 1 },
              "stderr_path": { "minLength": 1 },
              "raw_response_path": { "minLength": 1 },
              "resource_samples_path": { "minLength": 1 },
              "device_proof_path": { "minLength": 1 },
              "processed_result_path": { "minLength": 1 },
              "hash_manifest_path": { "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": { "result": { "const": "Passed" } },
            "required": ["result"]
          },
          "execution": {
            "properties": { "optimisation_requested": { "const": true } },
            "required": ["optimisation_requested"]
          }
        },
        "required": ["classification", "execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": { "optimisation_activated": { "const": true } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": { "result": { "const": "Passed" } },
            "required": ["result"]
          },
          "execution": {
            "properties": { "optimisation_requested": { "const": false } },
            "required": ["optimisation_requested"]
          }
        },
        "required": ["classification", "execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": { "optimisation_activated": { "const": false } }
          }
        }
      }
    }
  ]
}
