{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/schemas/workbook05/phase3-checkpoint.schema.json",
  "title": "Workbook 05 Phase 3 checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "generation",
    "identity",
    "steps"
  ],
  "properties": {
    "record_type": {
      "const": "phase3-checkpoint"
    },
    "schema_version": {
      "const": "1.0"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_head",
        "prerequisite_proof_sha256",
        "asset_lock_sha256",
        "executable_sha256",
        "request_sha256",
        "configuration_sha256",
        "prompt_sha256",
        "rubric_sha256"
      ],
      "properties": {
        "repository_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "prerequisite_proof_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "asset_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "status",
          "evidence_path",
          "evidence_sha256"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "status": {
            "enum": [
              "Pending",
              "Passed",
              "Failed",
              "Blocked",
              "Skipped"
            ]
          },
          "evidence_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "Passed"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
