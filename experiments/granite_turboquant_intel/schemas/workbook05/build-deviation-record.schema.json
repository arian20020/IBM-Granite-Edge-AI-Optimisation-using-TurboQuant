{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/workbook05/build-deviation-record.schema.json",
  "title": "Workbook 05 build deviation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "record_type",
    "deviation_id",
    "route_id",
    "component",
    "document",
    "document_commit",
    "original_step",
    "proposed_change",
    "reason",
    "risk",
    "approval_status",
    "approved_by",
    "approved_utc",
    "evidence_paths",
    "executed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"const": "GTQ-WB05-MF-v1"},
    "record_type": {"const": "build-deviation"},
    "deviation_id": {"type": "string", "pattern": "^DEV-(RA|RB)-[0-9]{3}$"},
    "route_id": {"enum": ["route-a-merged-openvino", "route-b-experimental-qjl-polar"]},
    "component": {"enum": ["runtime", "genai"]},
    "document": {"type": "string", "minLength": 1},
    "document_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "original_step": {"type": "string", "minLength": 1},
    "proposed_change": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "risk": {"type": "string", "minLength": 1},
    "approval_status": {"enum": ["Proposed", "Approved", "Rejected", "Superseded"]},
    "approved_by": {"type": ["string", "null"], "minLength": 1},
    "approved_utc": {"type": ["string", "null"], "format": "date-time"},
    "evidence_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "executed": {"type": "boolean"}
  }
}
