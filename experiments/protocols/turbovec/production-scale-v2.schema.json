{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granite-edge-ai.local/schemas/turbovec-production-scale-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "experiment_id", "scales", "required_scales", "conditional_scales", "configurations", "embedding", "measurement", "gate_a", "gate_b"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "campaign_id": {"const": "turbovec-production-scale-final-evaluation-v2"},
    "experiment_id": {"const": "EXP-TV-COMP-001"},
    "scales": {"const": [30, 1000, 10000, 100000]},
    "required_scales": {"const": [30, 1000, 10000]},
    "conditional_scales": {"const": [100000]},
    "configurations": {"const": ["exact", "tq2", "tq3", "tq4"]},
    "embedding": {"type": "object"},
    "measurement": {"type": "object"},
    "gate_a": {"type": "object"},
    "gate_b": {"type": "object"}
  }
}
