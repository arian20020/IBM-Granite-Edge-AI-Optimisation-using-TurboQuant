+TEST(TurboQuantStatefulGraph, UsesOneFusedOperationPerSelectedStateWithExactIdentity) {
+    const auto result = transform_stateful_kv_graph(make_two_layer_stateful_sdpa_model(),
+                                                    {CacheAlgorithm::TBQ3, CacheAlgorithm::TBQ4, true},
+                                                    "CPU");
+
+    ASSERT_EQ(fused_operation_count(result.model), 4u);
+    EXPECT_EQ(standard_codec_arithmetic_region_count(result.model), 0u);
+    EXPECT_EQ(selected_full_precision_variable_count(result.model), 0u);
+
+    std::set<std::string> expected_variable_ids;
+    for (size_t layer = 0; layer < 2; ++layer) {
+        for (const auto kind : {std::string("key"), std::string("value")}) {
+            const auto base_id = "layer_" + std::to_string(layer) + "_sdpa." + kind;
+            const auto update = find_fused_operation(result.model, base_id + ".update_decode");
+            ASSERT_EQ(update->get_input_size(), 4u);
+            ASSERT_EQ(update->get_output_size(), 4u);
+
+            const std::array<std::string, 3> suffixes{".payload", ".norm", ".meta"};
+            const std::array<ov::element::Type, 3> types{
+                ov::element::u8,
+                ov::element::f32,
+                ov::element::i32,
+            };
+            for (size_t index = 0; index < suffixes.size(); ++index) {
+                const auto read =
+                    ov::as_type_ptr<ov::op::v6::ReadValue>(update->input_value(index).get_node_shared_ptr());
+                ASSERT_TRUE(read);
+                EXPECT_EQ(read->get_input_size(), 0u);
+                EXPECT_EQ(read->get_variable()->get_info().variable_id, base_id + suffixes[index]);
+                EXPECT_EQ(update->get_input_element_type(index), types[index]);
+                EXPECT_EQ(update->get_output_element_type(index), types[index]);
+                expected_variable_ids.insert(base_id + suffixes[index]);
+
+                const auto targets = update->output(index).get_target_inputs();
+                ASSERT_EQ(targets.size(), 1u);
+                const auto assign =
+                    ov::as_type_ptr<ov::op::v6::Assign>(targets.begin()->get_node()->shared_from_this());
+                ASSERT_TRUE(assign);
+                EXPECT_EQ(assign->get_variable()->get_info().variable_id, base_id + suffixes[index]);
+            }
+
+            EXPECT_EQ(update->input_value(3).get_node()->get_friendly_name(), base_id + ".token");
+            EXPECT_EQ(update->get_input_element_type(3), ov::element::f32);
+            EXPECT_EQ(update->get_output_element_type(3), ov::element::f32);
+
+            const auto decoded_targets = update->output(3).get_target_inputs();
+            ASSERT_EQ(decoded_targets.size(), 1u);
+            const auto sdpa =
+                ov::as_type_ptr<ov::op::v13::ScaledDotProductAttention>(
+                    decoded_targets.begin()->get_node()->shared_from_this());
+            ASSERT_TRUE(sdpa);
+            EXPECT_EQ(sdpa->get_friendly_name(), "layer_" + std::to_string(layer) + "_sdpa");
+            EXPECT_EQ(decoded_targets.begin()->get_index(), kind == "key" ? 1u : 2u);
+        }
+    }
+
+    std::set<std::string> actual_variable_ids;
+    for (const auto& variable : result.model->get_variables())
+        actual_variable_ids.insert(variable->get_info().variable_id);
+    EXPECT_EQ(actual_variable_ids, expected_variable_ids);
+}
