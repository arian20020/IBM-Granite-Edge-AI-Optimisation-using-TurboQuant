+    OPENVINO_ASSERT(telemetry.status == "activated", "Unknown TurboQuant activation status");
+    OPENVINO_ASSERT(telemetry.requested_key_algorithm != CacheAlgorithm::STANDARD ||
+                        telemetry.requested_value_algorithm != CacheAlgorithm::STANDARD,
+                    "An activated TurboQuant event must request at least one compressed state");
+    OPENVINO_ASSERT(telemetry.activated_key_algorithm == telemetry.requested_key_algorithm &&
+                        telemetry.activated_value_algorithm == telemetry.requested_value_algorithm,
+                    "TurboQuant activated algorithms differ from the request");
+    OPENVINO_ASSERT(!telemetry.fallback, "TurboQuant activation cannot claim fallback");
+    validate_runtime_precision_evidence(telemetry);
+    OPENVINO_ASSERT(telemetry.expected_persistent_standard_bytes ==
+                            telemetry.actual_persistent_standard_bytes &&
+                        telemetry.expected_persistent_payload_bytes ==
+                            telemetry.actual_persistent_payload_bytes &&
+                        telemetry.expected_persistent_norm_bytes ==
+                            telemetry.actual_persistent_norm_bytes &&
+                        telemetry.expected_persistent_metadata_bytes ==
+                            telemetry.actual_persistent_metadata_bytes,
+                    "TurboQuant activated persistent allocations do not reconcile");
+    OPENVINO_ASSERT(telemetry.expected_bytes == telemetry.actual_bytes,
+                    "TurboQuant activated total allocations do not reconcile");
+    OPENVINO_ASSERT(
+        telemetry.expected_bytes ==
