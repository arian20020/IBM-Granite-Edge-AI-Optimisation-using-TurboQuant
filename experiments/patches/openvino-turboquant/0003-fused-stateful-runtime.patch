+constexpr size_t kHeadCount = 2;
+constexpr size_t kHeadDimension = 8;
+constexpr size_t kLayerCount = 2;
+
+struct StatePath {
+    std::shared_ptr<ov::op::v6::Assign> assign;
+    ov::Output<ov::Node> update;
+};
+
+StatePath make_state_path(const std::string& variable_id,
+                          const ov::Output<ov::Node>& fresh,
+                          bool dynamic_batch) {
+    const ov::PartialShape state_shape{
+        dynamic_batch ? ov::Dimension::dynamic() : ov::Dimension{1},
+        kHeadCount,
+        ov::Dimension::dynamic(),
+        kHeadDimension};
+    auto initial = ov::op::v0::Constant::create(
+        ov::element::f32, ov::Shape{1, kHeadCount, 0, kHeadDimension}, std::vector<float>{});
+    auto variable = std::make_shared<ov::op::util::Variable>(
+        ov::op::util::VariableInfo{state_shape, ov::element::f32, variable_id});
+    auto read = std::make_shared<ov::op::v6::ReadValue>(initial, variable);
+    read->set_friendly_name(variable_id + ".read");
+    auto update = std::make_shared<ov::op::v0::Concat>(ov::OutputVector{read, fresh}, 2);
+    update->set_friendly_name(variable_id + ".concat");
+    auto assign = std::make_shared<ov::op::v6::Assign>(update, variable);
+    assign->set_friendly_name(variable_id + ".assign");
+    return {assign, update};
+}
+
+std::shared_ptr<ov::Model> make_fixture_model(bool dynamic_state_batch = false) {
+    auto input_ids = std::make_shared<ov::op::v0::Parameter>(
+        ov::element::i64,
+        ov::PartialShape{dynamic_state_batch ? ov::Dimension::dynamic() : ov::Dimension{1}, 1});
+    auto attention_mask =
+        std::make_shared<ov::op::v0::Parameter>(ov::element::i64, ov::PartialShape{1, ov::Dimension::dynamic()});
+    auto beam_idx =
+        std::make_shared<ov::op::v0::Parameter>(ov::element::i32, ov::PartialShape{ov::Dimension::dynamic()});
+    input_ids->set_friendly_name("input_ids");
+    attention_mask->set_friendly_name("attention_mask");
+    beam_idx->set_friendly_name("beam_idx");
+    input_ids->output(0).get_tensor().set_names({"input_ids"});
+    attention_mask->output(0).get_tensor().set_names({"attention_mask"});
+    beam_idx->output(0).get_tensor().set_names({"beam_idx"});
+
+    auto token = std::make_shared<ov::op::v0::Convert>(input_ids, ov::element::f32);
+    auto axes = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{2}, {1, 3});
+    auto expanded = std::make_shared<ov::op::v0::Unsqueeze>(token, axes);
+    auto repeats = ov::op::v0::Constant::create(
+        ov::element::i64,
+        ov::Shape{4},
+        std::vector<int64_t>{1,
+                             static_cast<int64_t>(kHeadCount),
+                             1,
+                             static_cast<int64_t>(kHeadDimension)});
+    ov::Output<ov::Node> base_fresh = std::make_shared<ov::op::v0::Tile>(expanded, repeats);
+
+    ov::SinkVector sinks;
+    std::vector<ov::Output<ov::Node>> layer_outputs;
+    for (size_t layer = 0; layer < kLayerCount; ++layer) {
+        const auto layer_offset = ov::op::v0::Constant::create(
+            ov::element::f32, ov::Shape{}, {static_cast<float>(layer) * 0.25f});
+        auto fresh = std::make_shared<ov::op::v1::Add>(base_fresh, layer_offset);
+        auto key =
+            make_state_path("layer_" + std::to_string(layer) + "_sdpa.key", fresh, dynamic_state_batch);
+        auto value_offset = ov::op::v0::Constant::create(ov::element::f32, ov::Shape{}, {0.125f});
+        auto value_fresh = std::make_shared<ov::op::v1::Add>(fresh, value_offset);
+        auto value =
+            make_state_path("layer_" + std::to_string(layer) + "_sdpa.value", value_fresh, dynamic_state_batch);
+        auto sdpa = std::make_shared<ov::op::v13::ScaledDotProductAttention>(
+            fresh, key.update, value.update, false);
+        sdpa->set_friendly_name("layer_" + std::to_string(layer) + "_sdpa");
+        sinks.push_back(key.assign);
+        sinks.push_back(value.assign);
+        layer_outputs.push_back(sdpa);
+    }
+
+    auto combined = std::make_shared<ov::op::v1::Add>(layer_outputs.at(0), layer_outputs.at(1));
+    auto reduction_axes = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{2}, {1, 3});
+    auto token_score = std::make_shared<ov::op::v1::ReduceMean>(combined, reduction_axes, false);
+    auto vocabulary_axis = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {2});
+    auto single_logit = std::make_shared<ov::op::v0::Unsqueeze>(token_score, vocabulary_axis);
+    auto vocabulary_repeats = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{3}, {1, 1, 4});
+    ov::Output<ov::Node> logits = std::make_shared<ov::op::v0::Tile>(single_logit, vocabulary_repeats);
+
+    auto mask_sum_axes = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{2}, {0, 1});
+    auto beam_sum_axes = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {0});
+    auto mask_sum = std::make_shared<ov::op::v1::ReduceSum>(
+        std::make_shared<ov::op::v0::Convert>(attention_mask, ov::element::f32), mask_sum_axes, false);
+    auto beam_sum = std::make_shared<ov::op::v1::ReduceSum>(
+        std::make_shared<ov::op::v0::Convert>(beam_idx, ov::element::f32), beam_sum_axes, false);
+    auto ignored_inputs = std::make_shared<ov::op::v1::Multiply>(
+        std::make_shared<ov::op::v1::Add>(mask_sum, beam_sum),
+        ov::op::v0::Constant::create(ov::element::f32, ov::Shape{}, {0.0f}));
+    logits = std::make_shared<ov::op::v1::Add>(logits, ignored_inputs);
+    logits.get_tensor().set_names({"logits"});
+    logits.get_node_shared_ptr()->set_friendly_name("logits");
+    auto result = std::make_shared<ov::op::v0::Result>(logits);
+    result->output(0).get_tensor().set_names({"logits"});
+
+    return std::make_shared<ov::Model>(
+        ov::ResultVector{result}, sinks, ov::ParameterVector{input_ids, attention_mask, beam_idx}, "tq_activation");
+}
+
+std::shared_ptr<ov::Model> make_transform_failure_model() {
+    auto input = std::make_shared<ov::op::v0::Parameter>(ov::element::f32, ov::Shape{1});
+    return std::make_shared<ov::Model>(
+        ov::OutputVector{std::make_shared<ov::op::v0::Relu>(input)}, ov::ParameterVector{input});
+}
