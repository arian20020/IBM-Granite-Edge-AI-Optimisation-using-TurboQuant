+    EXPECT_EQ(payload_oracle.payload.back(), 122u);
+    const auto overflow_oracle = encode(overflow_reproducer, TurboQuantBits::B4);
+    EXPECT_TRUE(std::isfinite(overflow_oracle.norm));
+    EXPECT_GT(overflow_oracle.norm, 1.0e38f);
+    const auto underflow_oracle = encode(underflow_reproducer, TurboQuantBits::B4);
+    EXPECT_GT(underflow_oracle.norm, 0.0f);
+
+    expect_graph_matches_scalar_codec(CacheAlgorithm::TBQ4,
+                                      TurboQuantBits::B4,
+                                      {payload_reproducer, overflow_reproducer, underflow_reproducer});
+}
