+struct ExpectedState {
+    std::string name;
+    ov::element::Type type;
+    ov::Shape shape;
+    size_t byte_count;
+};
+
+constexpr size_t lifetime_head_dimension = 8;
+constexpr size_t lifetime_head_count = 2;
+constexpr size_t lifetime_layer_count = 2;
+constexpr uint64_t fnv1a_offset_basis = UINT64_C(14695981039346656037);
+constexpr uint64_t fnv1a_prime = UINT64_C(1099511628211);
+constexpr const char* lifetime_hash_algorithm = "FNV-1a-64-labelled-step-result-raw-bytes";
+
+std::shared_ptr<ov::Model> transformed_two_layer_model(CacheAlgorithm key, CacheAlgorithm value) {
+    auto transformed =
+        transform_stateful_kv_graph(make_two_layer_stateful_sdpa_model(),
+                                    {key, value, true},
+                                    "CPU")
+            .model;
+    OPENVINO_ASSERT(fused_operation_count(transformed) == 4u,
+                    "Expected four fused TurboQuant operations before serialization");
+    return transformed;
+}
+
+std::vector<ExpectedState> expected_states(size_t step) {
+    std::vector<ExpectedState> states;
+    states.reserve(12);
+    for (size_t layer = 0; layer < lifetime_layer_count; ++layer) {
+        for (const auto& kind : {std::string("key"), std::string("value")}) {
+            const auto prefix = "layer_" + std::to_string(layer) + "_sdpa." + kind;
+            const size_t payload_width = kind == "key" ? 3u : 4u;
+            states.push_back(
+                {prefix + ".payload",
+                 ov::element::u8,
+                 {1, lifetime_head_count, step, payload_width},
+                 lifetime_head_count * step * payload_width});
+            states.push_back(
+                {prefix + ".norm",
+                 ov::element::f32,
+                 {1, lifetime_head_count, step, 1},
+                 lifetime_head_count * step * sizeof(float)});
+            states.push_back(
+                {prefix + ".meta",
+                 ov::element::i32,
+                 {1, lifetime_head_count, step, 1},
+                 lifetime_head_count * step * sizeof(int32_t)});
+        }
+    }
+    return states;
+}
+
+StateSnapshot snapshot_selected_state(ov::InferRequest& request, size_t step) {
+    std::map<std::string, ov::Tensor> actual_states;
+    for (const auto& state : request.query_state()) {
+        const auto inserted = actual_states.emplace(state.get_name(), state.get_state());
+        OPENVINO_ASSERT(inserted.second, "Duplicate selected state name: ", state.get_name());
+    }
+
+    const auto expected = expected_states(step);
+    OPENVINO_ASSERT(actual_states.size() == expected.size(),
+                    "Expected exactly 12 selected persistent states, got ",
+                    actual_states.size());
+
+    StateSnapshot snapshot{step, 0, 0, 0, 0, 0};
+    for (const auto& state : expected) {
+        const auto actual = actual_states.find(state.name);
+        OPENVINO_ASSERT(actual != actual_states.end(), "Missing selected persistent state: ", state.name);
+        const auto& tensor = actual->second;
+        OPENVINO_ASSERT(tensor.get_element_type() == state.type,
+                        "Selected state ",
+                        state.name,
+                        " has type ",
+                        tensor.get_element_type(),
+                        ", expected ",
+                        state.type);
+        OPENVINO_ASSERT(tensor.get_shape() == state.shape,
+                        "Selected state ",
+                        state.name,
+                        " has shape ",
+                        tensor.get_shape(),
+                        ", expected ",
+                        state.shape);
+        OPENVINO_ASSERT(tensor.get_byte_size() == state.byte_count,
+                        "Selected state ",
+                        state.name,
+                        " has ",
+                        tensor.get_byte_size(),
+                        " bytes, expected ",
+                        state.byte_count);
+        OPENVINO_ASSERT(!(tensor.get_element_type() == ov::element::f32 &&
+                          tensor.get_shape().size() == 4u &&
+                          tensor.get_shape().back() == lifetime_head_dimension),
+                        "Selected full-precision shadow state is forbidden: ",
+                        state.name);
+
+        if (state.name.size() >= 5u && state.name.compare(state.name.size() - 5u, 5u, ".meta") == 0) {
+            OPENVINO_ASSERT(tensor.get_element_type().size() <= sizeof(int32_t),
+                            "Selected metadata state is wider than four bytes: ",
+                            state.name);
+            snapshot.metadata_bytes += tensor.get_byte_size();
+        } else if (state.name.size() >= 5u &&
+                   state.name.compare(state.name.size() - 5u, 5u, ".norm") == 0) {
+            snapshot.norm_bytes += tensor.get_byte_size();
+        } else if (state.name.size() >= 8u &&
+                   state.name.compare(state.name.size() - 8u, 8u, ".payload") == 0) {
+            snapshot.payload_bytes += tensor.get_byte_size();
+        } else {
+            OPENVINO_THROW("Unrecognised selected persistent state: ", state.name);
+        }
+        actual_states.erase(actual);
+    }
+    OPENVINO_ASSERT(actual_states.empty(), "Unrecognised selected persistent state");
+
+    snapshot.full_precision_equivalent_bytes =
+        lifetime_layer_count * 2u * lifetime_head_count * step * lifetime_head_dimension * sizeof(float);
+    snapshot.decoded_scratch_bytes = snapshot.full_precision_equivalent_bytes;
+    return snapshot;
+}
+
+std::pair<size_t, size_t> reference_operation_counts(const ov::CompiledModel& compiled) {
+    std::set<std::string> expected_names;
+    for (size_t layer = 0; layer < lifetime_layer_count; ++layer) {
+        for (const auto& kind : {std::string("key"), std::string("value")}) {
+            expected_names.insert("layer_" + std::to_string(layer) + "_sdpa." + kind + ".update_decode");
+        }
+    }
+
+    const auto is_update_decode_name = [](const std::string& name) {
+        constexpr const char* suffix = ".update_decode";
+        constexpr size_t suffix_length = 14;
+        return name.size() >= suffix_length &&
+               name.compare(name.size() - suffix_length, suffix_length, suffix) == 0;
+    };
+
+    std::set<std::string> matched_names;
+    size_t reference_operation_count = 0;
+    for (const auto& node : compiled.get_runtime_model()->get_ops()) {
+        const auto& runtime_info = node->get_rt_info();
+        const auto original_names = runtime_info.find("originalLayersNames");
+        const std::string original_name =
+            original_names == runtime_info.end() ? "" : original_names->second.as<std::string>();
+        if (!is_update_decode_name(node->get_friendly_name()) &&
+            !is_update_decode_name(original_name))
+            continue;
+
+        const auto layer_type = runtime_info.find("layerType");
+        OPENVINO_ASSERT(original_names != runtime_info.end(),
+                        "TurboQuant runtime node has no originalLayersNames metadata: ",
+                        node->get_friendly_name());
+        OPENVINO_ASSERT(layer_type != runtime_info.end() &&
+                            layer_type->second.as<std::string>() == "Reference",
+                        "TurboQuant runtime node is not a Reference operation: ",
+                        node->get_friendly_name());
+        OPENVINO_ASSERT(node->get_friendly_name() == original_name,
+                        "TurboQuant runtime node name/provenance mismatch: ",
+                        node->get_friendly_name(),
+                        " vs ",
+                        original_name);
+        OPENVINO_ASSERT(expected_names.count(original_name) == 1u,
+                        "Unexpected TurboQuant Reference runtime node: ",
+                        original_name);
+        OPENVINO_ASSERT(matched_names.insert(original_name).second,
+                        "Duplicate TurboQuant Reference runtime node: ",
+                        original_name);
+        ++reference_operation_count;
+    }
+
+    const size_t matched_state_count = matched_names.size();
+    OPENVINO_ASSERT(matched_state_count == 4u,
+                    "Expected exactly four matched TurboQuant runtime nodes, got ",
+                    matched_state_count);
+    OPENVINO_ASSERT(reference_operation_count == 4u,
+                    "Expected exactly four Reference TurboQuant runtime nodes, got ",
+                    reference_operation_count);
+    return {reference_operation_count, matched_state_count};
+}
+
+void fnv1a_update(uint64_t& hash, const void* data, size_t byte_count) {
+    const auto* bytes = static_cast<const uint8_t*>(data);
+    for (size_t index = 0; index < byte_count; ++index) {
+        hash ^= bytes[index];
+        hash *= fnv1a_prime;
+    }
+}
+
+void fill_lifetime_parameter(ov::Tensor& tensor, const std::string& friendly_name, size_t step) {
+    OPENVINO_ASSERT(tensor.get_element_type() == ov::element::f32,
+                    "Lifetime fixture expects f32 inputs");
+    auto* data = tensor.data<float>();
+    const auto element_count = tensor.get_size();
+    const size_t layer = friendly_name.find("layer_1_sdpa") != std::string::npos ? 1u : 0u;
+
+    if (friendly_name.find(".key.token") != std::string::npos ||
+        friendly_name.find(".value.token") != std::string::npos) {
+        const size_t kind = friendly_name.find(".value.token") != std::string::npos ? 1u : 0u;
+        for (size_t index = 0; index < element_count; ++index) {
+            const float magnitude = static_cast<float>(step) * 0.01f +
+                                    static_cast<float>(layer) * 0.5f +
+                                    static_cast<float>(kind) * 0.25f +
+                                    static_cast<float>(index + 1u) * 0.015625f;
+            const bool negate = ((step + layer + kind + index) % 2u) != 0u;
+            data[index] = negate ? -magnitude : magnitude;
+        }
+        return;
+    }
+
+    if (friendly_name.find(".initial") != std::string::npos) {
+        std::fill(data, data + element_count, 0.0f);
+        return;
+    }
+
+    OPENVINO_ASSERT(friendly_name.find(".query") != std::string::npos,
+                    "Unexpected lifetime fixture input: ",
+                    friendly_name);
+    for (size_t index = 0; index < element_count; ++index)
+        data[index] = static_cast<float>((layer + 1u) * (index + 1u)) * 0.03125f;
+}
+
+std::string hex_hash(uint64_t hash) {
+    std::ostringstream stream;
+    stream << std::hex << std::setfill('0') << std::setw(16) << hash;
+    return stream.str();
+}
+
+std::string run_lifetime_request(ov::CompiledModel& compiled,
+                                 std::vector<StateSnapshot>* snapshots) {
+    auto request = compiled.create_infer_request();
+    uint64_t hash = fnv1a_offset_basis;
+    for (size_t step = 1; step <= 100; ++step) {
+        for (size_t input_index = 0; input_index < compiled.inputs().size(); ++input_index) {
+            const auto input = compiled.input(input_index);
+            ov::Tensor tensor(input.get_element_type(), input.get_shape());
+            fill_lifetime_parameter(tensor, input.get_node()->get_friendly_name(), step);
+            request.set_input_tensor(input_index, tensor);
+        }
+        request.infer();
+
+        for (size_t result_index = 0; result_index < compiled.outputs().size(); ++result_index) {
+            const std::string label =
+                "step=" + std::to_string(step) + ";result=" + std::to_string(result_index) + ";";
+            fnv1a_update(hash, label.data(), label.size());
+            const uint8_t separator = 0;
+            fnv1a_update(hash, &separator, sizeof(separator));
+            const auto output = request.get_output_tensor(result_index);
+            fnv1a_update(hash, output.data(), output.get_byte_size());
+        }
+
+        if (snapshots != nullptr && (step == 1u || step == 2u || step == 50u || step == 100u))
+            snapshots->push_back(snapshot_selected_state(request, step));
+    }
+    return hex_hash(hash);
+}
