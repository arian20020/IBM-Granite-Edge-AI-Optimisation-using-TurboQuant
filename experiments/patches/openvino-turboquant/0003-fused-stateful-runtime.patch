+LifetimeEvidence run_one_hundred_steps(CacheAlgorithm key, CacheAlgorithm value) {
+    auto transformed = transformed_two_layer_model(key, value);
+    std::ostringstream xml;
+    std::ostringstream bin;
+    ov::pass::Serialize serializer(xml, bin);
+    (void)serializer.run_on_model(transformed);
+    OPENVINO_ASSERT(xml.good() && bin.good() && !xml.str().empty(),
+                    "Failed to serialize transformed TurboQuant model");
+
+    const auto bin_bytes = bin.str();
+    ov::Tensor weights(ov::element::u8,
+                       ov::Shape{bin_bytes.size()},
+                       const_cast<char*>(bin_bytes.data()));
+    auto restored = ov::genai::utils::singleton_core().read_model(xml.str(), weights);
+    OPENVINO_ASSERT(fused_operation_count(restored) == 4u,
+                    "Expected four fused TurboQuant operations after deserialization");
+    auto compiled = ov::genai::utils::singleton_core().compile_model(restored, "CPU");
+    const auto operation_counts = reference_operation_counts(compiled);
+
+    LifetimeEvidence evidence{
+        100u,
+        lifetime_hash_algorithm,
+        {},
+        false,
+        true,
+        operation_counts.first,
+        operation_counts.second,
+        {},
+    };
+    evidence.output_hashes[0] = run_lifetime_request(compiled, &evidence.snapshots);
+    evidence.output_hashes[1] = run_lifetime_request(compiled, nullptr);
+    evidence.repeat_hash_matches = evidence.output_hashes[0] == evidence.output_hashes[1];
+    return evidence;
+}
