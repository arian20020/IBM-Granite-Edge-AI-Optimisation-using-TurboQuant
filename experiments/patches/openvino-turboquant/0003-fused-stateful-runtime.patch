+EvaluatedState run_compiled_prefill_and_decode(const ov::CompiledModel& compiled) {
+    constexpr size_t head_dimension = 8;
+    auto sources = reviewer_adversarial_vectors();
+    sources.push_back(
+        {0.25f, -0.5f, 0.75f, -1.0f, 0.125f, 0.5f, -0.25f, 1.0f});
+    ov::Tensor payload(ov::element::u8,
+                       ov::Shape{1, 1, 0, packed_bytes(head_dimension, TurboQuantBits::B4)});
+    ov::Tensor norm(ov::element::f32, ov::Shape{1, 1, 0, 1});
+    ov::Tensor metadata(ov::element::i32, ov::Shape{1, 1, 0, 1});
+    ov::Tensor decoded(ov::element::f32, ov::Shape{1, 1, 0, head_dimension});
+    auto executable = compiled;
+    auto request = executable.create_infer_request();
+
+    for (size_t step = 0; step < 2; ++step) {
+        request.set_input_tensor(0, payload);
+        request.set_input_tensor(1, norm);
+        request.set_input_tensor(2, metadata);
+        std::vector<float> fresh_values;
+        const size_t first_source = step == 0 ? 0u : 2u;
+        const size_t fresh_sequence = step == 0 ? 2u : 1u;
+        for (size_t index = 0; index < fresh_sequence; ++index) {
+            const auto& source = sources[first_source + index];
+            fresh_values.insert(
+                fresh_values.end(), source.begin(), source.end());
+        }
+        request.set_input_tensor(3,
+                                 tensor_from_values<float>(
+                                     ov::element::f32,
+                                     ov::Shape{1,
+                                               1,
+                                               fresh_sequence,
+                                               head_dimension},
+                                     fresh_values));
+        request.infer();
+        payload = clone_tensor(request.get_output_tensor(0));
+        norm = clone_tensor(request.get_output_tensor(1));
+        metadata = clone_tensor(request.get_output_tensor(2));
+        decoded = clone_tensor(request.get_output_tensor(3));
+    }
+
+    return {
+        tensor_values<uint8_t>(payload),
+        tensor_bytes(norm),
+        tensor_values<int32_t>(metadata),
+        tensor_values<float>(decoded),
+        payload.get_shape().at(2),
+    };
+}
