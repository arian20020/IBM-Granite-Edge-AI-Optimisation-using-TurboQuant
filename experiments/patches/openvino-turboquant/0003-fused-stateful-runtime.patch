+struct NumericalOutputs {
+    std::vector<float> source_key;
+    std::vector<float> source_value;
+    std::vector<float> decoded_key;
+    std::vector<float> decoded_value;
+    ov::Shape decoded_key_shape;
+    ov::Shape decoded_value_shape;
+    std::map<std::string, CapturedTensor> states;
+};
+
+void fill_parameter(ov::Tensor& tensor,
+                    const std::string& friendly_name,
+                    const std::vector<float>& key_token,
+                    const std::vector<float>& value_token) {
+    OPENVINO_ASSERT(tensor.get_element_type() == ov::element::f32);
+    auto* data = tensor.data<float>();
+    const auto count = tensor.get_size();
+    if (friendly_name.find(".key.token") != std::string::npos) {
+        OPENVINO_ASSERT(key_token.size() > 0 && count % key_token.size() == 0);
+        for (size_t index = 0; index < count; ++index)
+            data[index] = key_token[index % key_token.size()];
+    } else if (friendly_name.find(".value.token") != std::string::npos) {
+        OPENVINO_ASSERT(value_token.size() > 0 && count % value_token.size() == 0);
+        for (size_t index = 0; index < count; ++index)
+            data[index] = value_token[index % value_token.size()];
+    } else if (friendly_name.find(".query") != std::string::npos) {
+        std::fill(data, data + count, 0.125f);
+    } else {
+        std::fill(data, data + count, 0.0f);
+    }
+}
+
+NumericalOutputs run_steps_and_read_sdpa_inputs(CacheAlgorithm key_algorithm,
+                                                CacheAlgorithm value_algorithm,
+                                                const std::vector<std::vector<float>>& key_tokens,
+                                                const std::vector<std::vector<float>>& value_tokens,
+                                                bool norm_correction = true,
+                                                size_t head_dimension = 8) {
+    OPENVINO_ASSERT(key_tokens.size() == value_tokens.size() && !key_tokens.empty());
+    auto source_model = make_model({make_attention_layer("numerical_sdpa", rank_four_shape(head_dimension))},
+                                   "numerical_stateful_sdpa");
+    auto transformed =
+        transform_stateful_kv_graph(source_model, {key_algorithm, value_algorithm, norm_correction}, "CPU").model;
+    const auto sdpa = find_sdpa(transformed, "numerical_sdpa");
+    const auto original_output_count = transformed->get_results().size();
+    transformed->add_results({std::make_shared<ov::op::v0::Result>(sdpa->input_value(1)),
+                              std::make_shared<ov::op::v0::Result>(sdpa->input_value(2))});
+    transformed->validate_nodes_and_infer_types();
+
+    ov::Core core;
+    auto compiled = core.compile_model(transformed, "CPU");
+    auto request = compiled.create_infer_request();
+    for (size_t step = 0; step < key_tokens.size(); ++step) {
+        for (size_t index = 0; index < compiled.inputs().size(); ++index) {
+            const auto input = compiled.input(index);
+            ov::Tensor tensor(input.get_element_type(), input.get_shape());
+            fill_parameter(tensor, input.get_node()->get_friendly_name(), key_tokens[step], value_tokens[step]);
+            request.set_input_tensor(index, tensor);
+        }
+        request.infer();
+    }
+
+    const auto key_output = request.get_output_tensor(original_output_count);
+    const auto value_output = request.get_output_tensor(original_output_count + 1);
+    NumericalOutputs outputs;
+    outputs.source_key = repeat_for_heads(key_tokens, 2);
+    outputs.source_value = repeat_for_heads(value_tokens, 2);
+    outputs.decoded_key.assign(key_output.data<const float>(), key_output.data<const float>() + key_output.get_size());
+    outputs.decoded_value.assign(value_output.data<const float>(),
+                                 value_output.data<const float>() + value_output.get_size());
+    outputs.decoded_key_shape = key_output.get_shape();
+    outputs.decoded_value_shape = value_output.get_shape();
+    for (const auto& state : request.query_state())
+        outputs.states.emplace(state.get_name(), capture_tensor(state.get_state()));
+    return outputs;
+}
