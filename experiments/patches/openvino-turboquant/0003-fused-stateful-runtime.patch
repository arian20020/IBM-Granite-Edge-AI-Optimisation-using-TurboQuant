+void validate_identity(const ActivationTelemetry& telemetry) {
+    OPENVINO_ASSERT(telemetry.build_commit.size() == 40,
+                    "TurboQuant build commit must be an exact 40-character Git ID");
+    OPENVINO_ASSERT(
+        telemetry.build_commit.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos,
+        "TurboQuant build commit must be hexadecimal");
+    OPENVINO_ASSERT(!telemetry.model_hash.empty(), "TurboQuant model hash must not be empty");
+    for (const auto* value : {&telemetry.status,
+                              &telemetry.requested_key_cache_precision,
+                              &telemetry.requested_value_cache_precision,
+                              &telemetry.activated_key_cache_precision,
+                              &telemetry.activated_value_cache_precision,
+                              &telemetry.observed_key_state_precision,
+                              &telemetry.observed_value_state_precision,
+                              &telemetry.operation_type,
+                              &telemetry.transformed_model_hash,
+                              &telemetry.attention_path,
+                              &telemetry.device,
+                              &telemetry.actual_device,
+                              &telemetry.runtime_layer_type}) {
+        OPENVINO_ASSERT(!value->empty(), "TurboQuant telemetry text fields must not be empty");
+    }
+}
+
+void validate_runtime_precision_evidence(const ActivationTelemetry& telemetry) {
+    const auto validate_kind =
+        [](CacheAlgorithm algorithm,
+           const std::string& requested,
+           const std::string& activated,
+           const std::string& observed) {
+        if (algorithm == CacheAlgorithm::STANDARD) {
+            OPENVINO_ASSERT(requested != "not_requested" &&
+                                activated != "not_requested" &&
+                                observed != "not_requested",
+                            "A runtime-observed STANDARD cache requires requested, activated, and "
+                            "query_state precision evidence");
+            return;
+        }
+        const std::string logical_precision =
+            algorithm == CacheAlgorithm::TBQ3 ? "u3" : "u4";
+        OPENVINO_ASSERT(requested == logical_precision &&
+                            activated == logical_precision,
+                        "TurboQuant logical cache precision differs from its algorithm");
+        OPENVINO_ASSERT(observed == "u8+f32+i32",
+                        "TurboQuant query_state component precision evidence is invalid");
+    };
+    validate_kind(telemetry.requested_key_algorithm,
+                  telemetry.requested_key_cache_precision,
+                  telemetry.activated_key_cache_precision,
+                  telemetry.observed_key_state_precision);
+    validate_kind(telemetry.requested_value_algorithm,
+                  telemetry.requested_value_cache_precision,
+                  telemetry.activated_value_cache_precision,
+                  telemetry.observed_value_state_precision);
+}
+
+size_t checked_persistent_total(size_t standard,
+                                size_t payload,
+                                size_t norm,
+                                size_t metadata) {
+    const auto checked_add = [](size_t left, size_t right) {
+        OPENVINO_ASSERT(left <= std::numeric_limits<size_t>::max() - right,
+                        "TurboQuant telemetry total allocation overflow");
+        return left + right;
+    };
+    return checked_add(checked_add(checked_add(standard, payload), norm), metadata);
+}
