+ov::Output<ov::Node> wrap_state_edge(const ov::Output<ov::Node>& state, EdgeWrapper wrapper) {
+    switch (wrapper) {
+    case EdgeWrapper::NONE:
+        return state;
+    case EdgeWrapper::SLICE:
+    case EdgeWrapper::SLICE_WRONG_AXIS:
+    case EdgeWrapper::SLICE_WRONG_STEP:
+    case EdgeWrapper::SLICE_WRONG_BOUNDS: {
+        const auto start_value = wrapper == EdgeWrapper::SLICE_WRONG_BOUNDS ? 1 : 0;
+        const auto step_value = wrapper == EdgeWrapper::SLICE_WRONG_STEP ? 2 : 1;
+        const auto axis_value = wrapper == EdgeWrapper::SLICE_WRONG_AXIS ? 1 : -2;
+        const auto start = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {start_value});
+        const auto stop =
+            ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {std::numeric_limits<int64_t>::max()});
+        const auto step = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {step_value});
+        const auto axes = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {axis_value});
+        return std::make_shared<ov::op::v8::Slice>(state, start, stop, step, axes);
+    }
+    case EdgeWrapper::CONVERT_TO_F32:
+        return std::make_shared<ov::op::v0::Convert>(state, ov::element::f32);
+    case EdgeWrapper::RELU:
+        return std::make_shared<ov::op::v0::Relu>(state);
+    }
+    OPENVINO_THROW("Unknown test edge wrapper");
+}
