+TEST(TurboQuantStatefulGraph, KeepsCompressedStateAlignedAcrossCpuBeamReorders) {
+    constexpr size_t batch_size = 2;
+    constexpr size_t head_count = 2;
+    constexpr size_t head_dimension = 8;
+    auto transformed = transform_stateful_kv_graph(
+                           make_granite_like_stateful_sdpa_model(
+                               static_cast<int64_t>(batch_size)),
+                           {CacheAlgorithm::TBQ3,
+                            CacheAlgorithm::TBQ4,
+                            true},
+                           "CPU")
+                           .model;
+    const auto key_update = find_fused_operation(
+        transformed, "granite_like_sdpa.key.update_decode");
+    const auto value_update = find_fused_operation(
+        transformed, "granite_like_sdpa.value.update_decode");
+    const auto decoded_output_offset = transformed->get_results().size();
+    transformed->add_results(
+        {std::make_shared<ov::op::v0::Result>(key_update->output(3)),
+         std::make_shared<ov::op::v0::Result>(value_update->output(3))});
+    transformed->validate_nodes_and_infer_types();
+
+    ov::Core core;
+    auto compiled = core.compile_model(transformed, "CPU");
+    auto request = compiled.create_infer_request();
+
+    struct BeamStep {
+        std::vector<int32_t> indices;
+        size_t sequence_length;
+        std::vector<float> key;
+        std::vector<float> value;
+    };
+    const auto make_values = [=](size_t step,
+                                 size_t sequence_length,
+                                 float kind_bias) {
+        std::vector<float> values(batch_size * head_count *
+                                  sequence_length * head_dimension);
+        for (size_t batch = 0; batch < batch_size; ++batch) {
+            for (size_t head = 0; head < head_count; ++head) {
+                for (size_t token = 0; token < sequence_length; ++token) {
+                    for (size_t dimension = 0;
+                         dimension < head_dimension;
+                         ++dimension) {
+                        const auto index =
+                            (((batch * head_count + head) *
+                                  sequence_length +
+                              token) *
+                                 head_dimension +
+                             dimension);
+                        const float magnitude =
+                            kind_bias + static_cast<float>(step * 7) +
+                            static_cast<float>(batch * 3 + head * 2 +
+                                               token) +
+                            static_cast<float>(dimension + 1) * 0.0625f;
+                        values[index] =
+                            ((step + batch + head + token + dimension) %
+                                     2 ==
+                                 0)
+                                ? magnitude
+                                : -magnitude;
+                    }
+                }
+            }
+        }
+        return values;
+    };
+    std::vector<BeamStep> steps;
+    for (const auto& specification :
+         {std::make_tuple(std::vector<int32_t>{0, 1}, 2u),
+          std::make_tuple(std::vector<int32_t>{1, 0}, 1u),
+          std::make_tuple(std::vector<int32_t>{0, 0}, 1u)}) {
+        const auto step = steps.size();
+        const auto sequence_length = std::get<1>(specification);
+        steps.push_back({std::get<0>(specification),
+                         sequence_length,
+                         make_values(step, sequence_length, 1.0f),
+                         make_values(step, sequence_length, 41.0f)});
+    }
+
+    using RowHistory = std::vector<std::vector<float>>;
+    std::vector<RowHistory> key_history(batch_size * head_count);
+    std::vector<RowHistory> value_history(batch_size * head_count);
+    const auto append_reordered = [=](std::vector<RowHistory>& history,
+                                      const BeamStep& step,
+                                      const std::vector<float>& fresh) {
+        std::vector<RowHistory> next(batch_size * head_count);
+        for (size_t batch = 0; batch < batch_size; ++batch) {
+            for (size_t head = 0; head < head_count; ++head) {
+                const auto destination = batch * head_count + head;
+                const auto source =
+                    static_cast<size_t>(step.indices[batch]) * head_count +
+                    head;
+                next[destination] = history[source];
+                for (size_t token = 0; token < step.sequence_length;
+                     ++token) {
+                    const auto offset =
+                        ((destination * step.sequence_length + token) *
+                         head_dimension);
+                    next[destination].emplace_back(
+                        fresh.begin() + offset,
+                        fresh.begin() + offset + head_dimension);
+                }
+            }
+        }
+        history = std::move(next);
+    };
+
+    for (const auto& step : steps) {
+        for (size_t index = 0; index < compiled.inputs().size(); ++index) {
+            const auto input = compiled.input(index);
+            const auto& name = input.get_node()->get_friendly_name();
+            ov::Tensor tensor;
+            if (name == "granite_like_sdpa.beam_idx") {
+                tensor = ov::Tensor(ov::element::i32, {batch_size});
+                std::copy(step.indices.begin(),
+                          step.indices.end(),
+                          tensor.data<int32_t>());
+            } else if (name == "granite_like_sdpa.key.token" ||
+                       name == "granite_like_sdpa.value.token") {
+                tensor = ov::Tensor(
+                    ov::element::f32,
+                    {batch_size,
+                     head_count,
+                     step.sequence_length,
+                     head_dimension});
+                const auto& values =
+                    name == "granite_like_sdpa.key.token" ? step.key
+                                                           : step.value;
+                std::copy(
+                    values.begin(), values.end(), tensor.data<float>());
+            } else if (name == "granite_like_sdpa.query") {
+                tensor = ov::Tensor(
+                    ov::element::f32,
+                    {batch_size,
+                     head_count * 2,
+                     step.sequence_length,
+                     head_dimension});
+                std::fill(tensor.data<float>(),
+                          tensor.data<float>() + tensor.get_size(),
+                          0.125f);
+            } else if (name.find(".initial") != std::string::npos) {
+                tensor = ov::Tensor(
+                    ov::element::f32,
+                    {batch_size, head_count, 0, head_dimension});
+            } else {
+                FAIL() << "Unexpected Granite-like input: " << name;
+                continue;
+            }
+            request.set_input_tensor(index, tensor);
+        }
+        request.infer();
+
+        append_reordered(key_history, step, step.key);
+        append_reordered(value_history, step, step.value);
+        ASSERT_FALSE(key_history.empty());
+        const auto sequence_length = key_history.front().size();
+        ASSERT_TRUE(std::all_of(
+            key_history.begin(),
+            key_history.end(),
+            [sequence_length](const RowHistory& row) {
+                return row.size() == sequence_length;
+            }));
+        ASSERT_TRUE(std::all_of(
+            value_history.begin(),
+            value_history.end(),
+            [sequence_length](const RowHistory& row) {
+                return row.size() == sequence_length;
+            }));
+
+        std::map<std::string, CapturedTensor> states;
+        for (const auto& state : request.query_state())
+            states.emplace(state.get_name(), capture_tensor(state.get_state()));
+        const auto decoded_key = capture_tensor(
+            request.get_output_tensor(decoded_output_offset));
+        const auto decoded_value = capture_tensor(
+            request.get_output_tensor(decoded_output_offset + 1));
+
+        const auto expect_kind =
+            [&](const std::string& kind,
+                TurboQuantBits bits,
+                const std::vector<RowHistory>& history,
+                const CapturedTensor& decoded) {
+                std::vector<uint8_t> expected_payload;
+                std::vector<float> expected_norm;
+                std::vector<int32_t> expected_metadata;
+                std::vector<float> expected_decoded;
+                for (const auto& row : history) {
+                    for (const auto& source : row) {
+                        const auto encoded = encode(source, bits);
+                        expected_payload.insert(expected_payload.end(),
+                                                encoded.payload.begin(),
+                                                encoded.payload.end());
+                        expected_norm.push_back(encoded.norm);
+                        expected_metadata.push_back(
+                            static_cast<int32_t>(head_dimension));
+                        const auto values = decode(encoded);
+                        expected_decoded.insert(expected_decoded.end(),
+                                                values.begin(),
+                                                values.end());
+                    }
+                }
+
+                const auto prefix = "granite_like_sdpa." + kind;
+                const auto payload = states.find(prefix + ".payload");
+                const auto norm = states.find(prefix + ".norm");
+                const auto metadata = states.find(prefix + ".meta");
+                ASSERT_NE(payload, states.end());
+                ASSERT_NE(norm, states.end());
+                ASSERT_NE(metadata, states.end());
+                const auto packed_width =
+                    bits == TurboQuantBits::B3 ? 3u : 4u;
+                EXPECT_EQ(payload->second.shape,
+                          (ov::Shape{batch_size,
+                                     head_count,
+                                     sequence_length,
+                                     packed_width}));
+                EXPECT_EQ(norm->second.shape,
+                          (ov::Shape{batch_size,
+                                     head_count,
+                                     sequence_length,
+                                     1}));
+                EXPECT_EQ(metadata->second.shape,
+                          (ov::Shape{batch_size,
+                                     head_count,
+                                     sequence_length,
+                                     1}));
+                EXPECT_EQ(payload->second.bytes, expected_payload);
+                EXPECT_EQ(captured_values<float>(norm->second),
+                          expected_norm);
+                EXPECT_EQ(captured_values<int32_t>(metadata->second),
+                          expected_metadata);
+                EXPECT_EQ(decoded.shape,
+                          (ov::Shape{batch_size,
+                                     head_count,
+                                     sequence_length,
+                                     head_dimension}));
+                EXPECT_EQ(captured_values<float>(decoded),
+                          expected_decoded);
+            };
+        expect_kind(
+            "key", TurboQuantBits::B3, key_history, decoded_key);
+        expect_kind(
+            "value", TurboQuantBits::B4, value_history, decoded_value);
+    }
+}
