diff --git a/src/cpp/src/llm/turboquant_state_update_decode.cpp b/src/cpp/src/llm/turboquant_state_update_decode.cpp
new file mode 100644
index 0000000..5448919
--- /dev/null
+++ b/src/cpp/src/llm/turboquant_state_update_decode.cpp
@@ -0,0 +1,541 @@
+// Copyright (C) 2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+#include "turboquant_state_update_decode.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "openvino/core/except.hpp"
+
+namespace ov::genai {
+namespace {
+
+using turboquant::EncodedVector;
+using turboquant::TurboQuantBits;
+using turboquant::decode;
+using turboquant::decode_natural_inverse;
+using turboquant::encode;
+using turboquant::packed_bytes;
+
+TurboQuantBits checked_bits(int64_t value) {
+    OPENVINO_ASSERT(value == static_cast<int64_t>(TurboQuantBits::B3) ||
+                        value == static_cast<int64_t>(TurboQuantBits::B4),
+                    "TurboQuant bit width must be 3 or 4");
+    return static_cast<TurboQuantBits>(value);
+}
+
+size_t checked_packed_bytes(size_t head_dimension, TurboQuantBits bits) {
+    try {
+        return packed_bytes(head_dimension, bits);
+    } catch (const std::exception& error) {
+        OPENVINO_THROW("TurboQuant payload width is invalid: ", error.what());
+    }
+}
+
+size_t checked_multiply(size_t lhs, size_t rhs, const char* description) {
+    OPENVINO_ASSERT(lhs == 0 || rhs <= std::numeric_limits<size_t>::max() / lhs,
+                    "TurboQuant ",
+                    description,
+                    " overflows size_t");
+    return lhs * rhs;
+}
+
+size_t checked_add(size_t lhs, size_t rhs, const char* description) {
+    OPENVINO_ASSERT(rhs <= std::numeric_limits<size_t>::max() - lhs,
+                    "TurboQuant ",
+                    description,
+                    " overflows size_t");
+    return lhs + rhs;
+}
+
+struct OutputSizes {
+    size_t records;
+    size_t decoded_elements;
+};
+
+OutputSizes preflight_output_sizes(size_t batch,
+                                   size_t heads,
+                                   size_t current_sequence,
+                                   size_t payload_width,
+                                   size_t head_dimension) {
+    const size_t batch_heads = checked_multiply(batch, heads, "batch/head count");
+    const size_t records = checked_multiply(batch_heads, current_sequence, "record count");
+    const size_t payload_elements =
+        checked_multiply(records, payload_width, "payload element count");
+    checked_multiply(payload_elements, sizeof(uint8_t), "payload output byte count");
+    checked_multiply(records, sizeof(float), "norm output byte count");
+    checked_multiply(records, sizeof(int32_t), "metadata output byte count");
+    const size_t decoded_elements =
+        checked_multiply(records, head_dimension, "decoded element count");
+    checked_multiply(decoded_elements, sizeof(float), "decoded output byte count");
+    return {records, decoded_elements};
+}
+
+void require_rank_four(const ov::Node* node, const ov::PartialShape& shape, const char* name) {
+    NODE_VALIDATION_CHECK(node,
+                          shape.rank().is_static() && shape.rank().get_length() == 4,
+                          "TurboQuant ",
+                          name,
+                          " input rank must be four, got ",
+                          shape.rank());
+}
+
+void merge_dimension(const ov::Node* node,
+                     ov::Dimension& destination,
+                     const ov::Dimension& candidate,
+                     const char* description) {
+    ov::Dimension merged;
+    NODE_VALIDATION_CHECK(node,
+                          ov::Dimension::merge(merged, destination, candidate),
+                          "TurboQuant ",
+                          description,
+                          " dimensions are incompatible: ",
+                          destination,
+                          " and ",
+                          candidate);
+    destination = std::move(merged);
+}
+
+void require_compatible_dimension(const ov::Node* node,
+                                  const ov::Dimension& actual,
+                                  size_t expected,
+                                  const char* description) {
+    NODE_VALIDATION_CHECK(node,
+                          actual.compatible(ov::Dimension(static_cast<int64_t>(expected))),
+                          "TurboQuant ",
+                          description,
+                          " dimension must be ",
+                          expected,
+                          ", got ",
+                          actual);
+}
+
+struct RuntimeLayout {
+    size_t batch;
+    size_t heads;
+    size_t prior_sequence;
+    size_t fresh_sequence;
+    size_t current_sequence;
+    size_t payload_width;
+    size_t records;
+    ov::Shape payload_output_shape;
+    ov::Shape scalar_output_shape;
+    ov::Shape decoded_output_shape;
+};
+
+RuntimeLayout validate_runtime_layout(const ov::TensorVector& outputs,
+                                      const ov::TensorVector& inputs,
+                                      TurboQuantBits bits,
+                                      size_t head_dimension) {
+    OPENVINO_ASSERT(inputs.size() == 4, "TurboQuant evaluate expects exactly four input tensors");
+    OPENVINO_ASSERT(outputs.size() == 4, "TurboQuant evaluate expects exactly four output tensors");
+
+    constexpr std::array<ov::element::Type_t, 4> input_types{
+        ov::element::Type_t::u8,
+        ov::element::Type_t::f32,
+        ov::element::Type_t::i32,
+        ov::element::Type_t::f32,
+    };
+    constexpr std::array<ov::element::Type_t, 4> output_types{
+        ov::element::Type_t::u8,
+        ov::element::Type_t::f32,
+        ov::element::Type_t::i32,
+        ov::element::Type_t::f32,
+    };
+
+    for (size_t index = 0; index < inputs.size(); ++index) {
+        OPENVINO_ASSERT(inputs[index].get_element_type() == ov::element::Type(input_types[index]),
+                        "TurboQuant runtime input ",
+                        index,
+                        " has type ",
+                        inputs[index].get_element_type(),
+                        ", expected ",
+                        ov::element::Type(input_types[index]));
+        OPENVINO_ASSERT(inputs[index].get_shape().size() == 4,
+                        "TurboQuant runtime input ",
+                        index,
+                        " rank must be four");
+    }
+    for (size_t index = 0; index < outputs.size(); ++index) {
+        OPENVINO_ASSERT(outputs[index].get_element_type() == ov::element::Type(output_types[index]),
+                        "TurboQuant runtime output ",
+                        index,
+                        " has type ",
+                        outputs[index].get_element_type(),
+                        ", expected ",
+                        ov::element::Type(output_types[index]));
+    }
+
+    const ov::Shape& payload_shape = inputs[0].get_shape();
+    const ov::Shape& norm_shape = inputs[1].get_shape();
+    const ov::Shape& metadata_shape = inputs[2].get_shape();
+    const ov::Shape& fresh_shape = inputs[3].get_shape();
+    const size_t payload_width = checked_packed_bytes(head_dimension, bits);
+
+    for (size_t index = 1; index < 3; ++index) {
+        const auto& shape = inputs[index].get_shape();
+        OPENVINO_ASSERT(shape[0] == payload_shape[0],
+                        "TurboQuant runtime prior-state batch dimensions must match");
+        OPENVINO_ASSERT(shape[1] == payload_shape[1],
+                        "TurboQuant runtime head-count dimensions must match");
+    }
+    OPENVINO_ASSERT(fresh_shape[1] == payload_shape[1],
+                    "TurboQuant runtime head-count dimensions must match");
+    OPENVINO_ASSERT(norm_shape[2] == payload_shape[2] && metadata_shape[2] == payload_shape[2],
+                    "TurboQuant prior sequence dimensions must match");
+    OPENVINO_ASSERT(fresh_shape[2] > 0, "TurboQuant fresh sequence dimension must be positive");
+    OPENVINO_ASSERT(payload_shape[3] == payload_width,
+                    "TurboQuant runtime payload width must be ",
+                    payload_width);
+    OPENVINO_ASSERT(norm_shape[3] == 1, "TurboQuant runtime norm record width must be one");
+    OPENVINO_ASSERT(metadata_shape[3] == 1, "TurboQuant runtime metadata record width must be one");
+    OPENVINO_ASSERT(fresh_shape[3] == head_dimension,
+                    "TurboQuant runtime fresh head dimension must be ",
+                    head_dimension);
+    OPENVINO_ASSERT(fresh_shape[0] > 0, "TurboQuant runtime fresh batch must be positive");
+
+    const bool uninitialized_dynamic_batch =
+        payload_shape[0] == 0 && payload_shape[2] == 0;
+    if (!uninitialized_dynamic_batch)
+        OPENVINO_ASSERT(fresh_shape[0] == payload_shape[0],
+                        "TurboQuant runtime batch dimensions must match");
+    const size_t batch = uninitialized_dynamic_batch ? fresh_shape[0] : payload_shape[0];
+
+    const size_t current_sequence =
+        checked_add(payload_shape[2], fresh_shape[2], "sequence length");
+    const auto output_sizes = preflight_output_sizes(batch,
+                                                     payload_shape[1],
+                                                     current_sequence,
+                                                     payload_width,
+                                                     head_dimension);
+
+    return {
+        batch,
+        payload_shape[1],
+        payload_shape[2],
+        fresh_shape[2],
+        current_sequence,
+        payload_width,
+        output_sizes.records,
+        {batch, payload_shape[1], current_sequence, payload_width},
+        {batch, payload_shape[1], current_sequence, 1},
+        {batch, payload_shape[1], current_sequence, head_dimension},
+    };
+}
+
+struct PreparedRecord {
+    EncodedVector encoded;
+    std::vector<float> decoded;
+};
+
+PreparedRecord prepare_existing_record(TurboQuantBits bits,
+                                       int32_t expected_metadata,
+                                       bool norm_correction,
+                                       const uint8_t* payload,
+                                       size_t payload_width,
+                                       float norm,
+                                       int32_t metadata,
+                                       size_t batch,
+                                       size_t head,
+                                       size_t sequence) {
+    try {
+        if (metadata < 0)
+            throw std::invalid_argument("TurboQuant metadata must be non-negative");
+        if (metadata != expected_metadata)
+            throw std::invalid_argument("TurboQuant metadata does not equal the configured head dimension");
+        EncodedVector encoded{
+            bits,
+            static_cast<size_t>(metadata),
+            norm,
+            std::vector<uint8_t>(payload, payload + payload_width),
+        };
+        auto decoded = norm_correction ? decode(encoded) : decode_natural_inverse(encoded);
+        return {std::move(encoded), std::move(decoded)};
+    } catch (const std::exception& error) {
+        OPENVINO_THROW("TurboQuant state [",
+                       batch,
+                       ",",
+                       head,
+                       ",",
+                       sequence,
+                       "] is malformed: ",
+                       error.what());
+    }
+}
+
+PreparedRecord prepare_fresh_record(TurboQuantBits bits,
+                                    size_t head_dimension,
+                                    bool norm_correction,
+                                    const float* fresh,
+                                    size_t batch,
+                                    size_t head,
+                                    size_t sequence) {
+    try {
+        std::vector<float> row(fresh, fresh + head_dimension);
+        auto encoded = encode(row, bits);
+        auto decoded = norm_correction ? decode(encoded) : decode_natural_inverse(encoded);
+        return {std::move(encoded), std::move(decoded)};
+    } catch (const std::exception& error) {
+        OPENVINO_THROW("TurboQuant state [",
+                       batch,
+                       ",",
+                       head,
+                       ",",
+                       sequence,
+                       "] cannot encode the fresh vector: ",
+                       error.what());
+    }
+}
+
+}  // namespace
+
+TurboQuantStateUpdateDecode::TurboQuantStateUpdateDecode(const ov::Output<ov::Node>& payload,
+                                                         const ov::Output<ov::Node>& norm,
+                                                         const ov::Output<ov::Node>& metadata,
+                                                         const ov::Output<ov::Node>& new_vector,
+                                                         turboquant::TurboQuantBits bits,
+                                                         size_t head_dimension,
+                                                         bool norm_correction)
+    : ov::op::Op({payload, norm, metadata, new_vector}),
+      m_bits(bits),
+      m_head_dimension(head_dimension),
+      m_norm_correction(norm_correction) {
+    constructor_validate_and_infer_types();
+}
+
+void TurboQuantStateUpdateDecode::validate_and_infer_types() {
+    NODE_VALIDATION_CHECK(this,
+                          get_input_size() == 4,
+                          "TurboQuantStateUpdateDecode expects exactly four inputs");
+
+    const auto bits = checked_bits(static_cast<int64_t>(m_bits));
+    NODE_VALIDATION_CHECK(this,
+                          m_head_dimension > 0 && m_head_dimension % 8 == 0,
+                          "TurboQuant head dimension must be positive and divisible by eight");
+    NODE_VALIDATION_CHECK(
+        this,
+        m_head_dimension <= static_cast<size_t>(std::numeric_limits<int32_t>::max()),
+        "TurboQuant head dimension exceeds the i32 metadata range");
+    const size_t payload_width = checked_packed_bytes(m_head_dimension, bits);
+
+    constexpr std::array<ov::element::Type_t, 4> expected_types{
+        ov::element::Type_t::u8,
+        ov::element::Type_t::f32,
+        ov::element::Type_t::i32,
+        ov::element::Type_t::f32,
+    };
+    std::array<ov::PartialShape, 4> shapes;
+    for (size_t index = 0; index < expected_types.size(); ++index) {
+        const auto expected = ov::element::Type(expected_types[index]);
+        NODE_VALIDATION_CHECK(this,
+                              get_input_element_type(index) == expected,
+                              "TurboQuant input ",
+                              index,
+                              " must have type ",
+                              expected,
+                              ", got ",
+                              get_input_element_type(index));
+        shapes[index] = get_input_partial_shape(index);
+        require_rank_four(this, shapes[index], index == 0   ? "payload"
+                                               : index == 1 ? "norm"
+                                               : index == 2 ? "metadata"
+                                                            : "fresh-vector");
+        NODE_VALIDATION_CHECK(this,
+                              shapes[index][1].is_static(),
+                              "TurboQuant input ",
+                              index,
+                              " head-count dimension must be static");
+    }
+
+    ov::Dimension heads = shapes[0][1];
+    for (size_t index = 1; index < shapes.size(); ++index) {
+        NODE_VALIDATION_CHECK(this,
+                              shapes[index][1] == heads,
+                              "TurboQuant head-count dimensions must match: ",
+                              heads,
+                              " and ",
+                              shapes[index][1]);
+    }
+
+    ov::Dimension prior_sequence = shapes[0][2];
+    merge_dimension(this, prior_sequence, shapes[1][2], "prior sequence");
+    merge_dimension(this, prior_sequence, shapes[2][2], "prior sequence");
+
+    ov::Dimension prior_batch = shapes[0][0];
+    merge_dimension(this, prior_batch, shapes[1][0], "prior-state batch");
+    merge_dimension(this, prior_batch, shapes[2][0], "prior-state batch");
+    ov::Dimension batch = prior_batch;
+    const bool uninitialized_dynamic_batch =
+        prior_batch.is_static() && prior_batch.get_length() == 0 &&
+        prior_sequence.is_static() && prior_sequence.get_length() == 0;
+    if (uninitialized_dynamic_batch)
+        batch = shapes[3][0];
+    else
+        merge_dimension(this, batch, shapes[3][0], "batch");
+
+    require_compatible_dimension(this, shapes[0][3], payload_width, "payload record width");
+    require_compatible_dimension(this, shapes[1][3], 1, "norm record width");
+    require_compatible_dimension(this, shapes[2][3], 1, "metadata record width");
+    NODE_VALIDATION_CHECK(this,
+                          shapes[3][2].is_dynamic() ||
+                              shapes[3][2].get_length() > 0,
+                          "TurboQuant fresh sequence dimension must permit at least one vector, got ",
+                          shapes[3][2]);
+    require_compatible_dimension(this, shapes[3][3], m_head_dimension, "fresh head");
+
+    ov::Dimension current_sequence = ov::Dimension::dynamic();
+    if (prior_sequence.is_static() && shapes[3][2].is_static()) {
+        const auto prior_length = prior_sequence.get_length();
+        const auto fresh_length = shapes[3][2].get_length();
+        NODE_VALIDATION_CHECK(this,
+                              fresh_length <=
+                                  std::numeric_limits<int64_t>::max() - prior_length,
+                              "TurboQuant sequence dimension overflows int64");
+        current_sequence = ov::Dimension(prior_length + fresh_length);
+    }
+    if (batch.is_static() && heads.is_static() && current_sequence.is_static()) {
+        preflight_output_sizes(static_cast<size_t>(batch.get_length()),
+                               static_cast<size_t>(heads.get_length()),
+                               static_cast<size_t>(current_sequence.get_length()),
+                               payload_width,
+                               m_head_dimension);
+    }
+
+    set_output_size(4);
+    set_output_type(0,
+                    ov::element::u8,
+                    ov::PartialShape{batch,
+                                     heads,
+                                     current_sequence,
+                                     ov::Dimension(static_cast<int64_t>(payload_width))});
+    set_output_type(1, ov::element::f32, ov::PartialShape{batch, heads, current_sequence, 1});
+    set_output_type(2, ov::element::i32, ov::PartialShape{batch, heads, current_sequence, 1});
+    set_output_type(
+        3,
+        ov::element::f32,
+        ov::PartialShape{batch, heads, current_sequence, ov::Dimension(static_cast<int64_t>(m_head_dimension))});
+}
+
+std::shared_ptr<ov::Node> TurboQuantStateUpdateDecode::clone_with_new_inputs(
+    const ov::OutputVector& inputs) const {
+    OPENVINO_ASSERT(inputs.size() == 4,
+                    "TurboQuantStateUpdateDecode clone expects exactly four inputs");
+    return std::make_shared<TurboQuantStateUpdateDecode>(inputs[0],
+                                                         inputs[1],
+                                                         inputs[2],
+                                                         inputs[3],
+                                                         m_bits,
+                                                         m_head_dimension,
+                                                         m_norm_correction);
+}
+
+bool TurboQuantStateUpdateDecode::visit_attributes(ov::AttributeVisitor& visitor) {
+    int64_t bits_value = static_cast<int64_t>(m_bits);
+    visitor.on_attribute("bits", bits_value);
+    visitor.on_attribute("head_dimension", m_head_dimension);
+    visitor.on_attribute("norm_correction", m_norm_correction);
+    m_bits = checked_bits(bits_value);
+    return true;
+}
+
+bool TurboQuantStateUpdateDecode::has_evaluate() const {
+    return true;
+}
+
+bool TurboQuantStateUpdateDecode::evaluate(ov::TensorVector& outputs,
+                                           const ov::TensorVector& inputs) const {
+    const auto bits = checked_bits(static_cast<int64_t>(m_bits));
+    OPENVINO_ASSERT(m_head_dimension > 0 && m_head_dimension % 8 == 0,
+                    "TurboQuant head dimension must be positive and divisible by eight");
+    OPENVINO_ASSERT(
+        m_head_dimension <= static_cast<size_t>(std::numeric_limits<int32_t>::max()),
+        "TurboQuant head dimension exceeds the i32 metadata range");
+    const int32_t expected_metadata = static_cast<int32_t>(m_head_dimension);
+    const RuntimeLayout layout =
+        validate_runtime_layout(outputs, inputs, bits, m_head_dimension);
+
+    const auto* payload_data = inputs[0].data<const uint8_t>();
+    const auto* norm_data = inputs[1].data<const float>();
+    const auto* metadata_data = inputs[2].data<const int32_t>();
+    const auto* fresh_data = inputs[3].data<const float>();
+
+    std::vector<PreparedRecord> prepared;
+    prepared.reserve(layout.records);
+    for (size_t batch = 0; batch < layout.batch; ++batch) {
+        for (size_t head = 0; head < layout.heads; ++head) {
+            const size_t batch_head = batch * layout.heads + head;
+            const size_t prior_base = batch_head * layout.prior_sequence;
+            for (size_t sequence = 0; sequence < layout.prior_sequence; ++sequence) {
+                const size_t record = prior_base + sequence;
+                prepared.push_back(prepare_existing_record(bits,
+                                                           expected_metadata,
+                                                           m_norm_correction,
+                                                           payload_data + record * layout.payload_width,
+                                                           layout.payload_width,
+                                                           norm_data[record],
+                                                           metadata_data[record],
+                                                           batch,
+                                                           head,
+                                                           sequence));
+            }
+            const size_t fresh_base =
+                checked_multiply(batch_head,
+                                 layout.fresh_sequence,
+                                 "fresh record offset");
+            for (size_t sequence = 0; sequence < layout.fresh_sequence; ++sequence) {
+                const size_t fresh_record =
+                    checked_add(fresh_base, sequence, "fresh record offset");
+                prepared.push_back(prepare_fresh_record(
+                    bits,
+                    m_head_dimension,
+                    m_norm_correction,
+                    fresh_data + checked_multiply(fresh_record,
+                                                  m_head_dimension,
+                                                  "fresh element offset"),
+                    batch,
+                    head,
+                    checked_add(layout.prior_sequence,
+                                sequence,
+                                "fresh sequence index")));
+            }
+        }
+    }
+    OPENVINO_ASSERT(prepared.size() == layout.records, "TurboQuant prepared record count is inconsistent");
+
+    outputs[0].set_shape(layout.payload_output_shape);
+    outputs[1].set_shape(layout.scalar_output_shape);
+    outputs[2].set_shape(layout.scalar_output_shape);
+    outputs[3].set_shape(layout.decoded_output_shape);
+
+    auto* output_payload = outputs[0].data<uint8_t>();
+    auto* output_norm = outputs[1].data<float>();
+    auto* output_metadata = outputs[2].data<int32_t>();
+    auto* output_decoded = outputs[3].data<float>();
+    for (size_t record = 0; record < prepared.size(); ++record) {
+        const auto& state = prepared[record];
+        OPENVINO_ASSERT(state.encoded.payload.size() == layout.payload_width,
+                        "TurboQuant prepared payload width is inconsistent");
+        OPENVINO_ASSERT(state.encoded.element_count == m_head_dimension,
+                        "TurboQuant prepared metadata is inconsistent");
+        OPENVINO_ASSERT(state.decoded.size() == m_head_dimension,
+                        "TurboQuant prepared decode width is inconsistent");
+        std::copy(state.encoded.payload.begin(),
+                  state.encoded.payload.end(),
+                  output_payload + record * layout.payload_width);
+        output_norm[record] = state.encoded.norm;
+        output_metadata[record] = expected_metadata;
+        std::copy(state.decoded.begin(),
+                  state.decoded.end(),
+                  output_decoded + record * m_head_dimension);
+    }
+    return true;
+}
+
+}  // namespace ov::genai
