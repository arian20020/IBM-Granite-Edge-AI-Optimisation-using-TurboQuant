+TEST(TurboQuantStateUpdateDecode, PinnedCpuExecutesDynamicPrefillThenDecodeAsReference) {
+    constexpr size_t head_dimension = 8;
+    const auto graph = make_operation(TurboQuantBits::B4, head_dimension, true);
+    graph.operation->set_friendly_name("TurboQuantStateUpdateDecode");
+    auto model = std::make_shared<ov::Model>(
+        ov::OutputVector{graph.operation->output(0),
+                         graph.operation->output(1),
+                         graph.operation->output(2),
+                         graph.operation->output(3)},
+        ov::ParameterVector{graph.payload, graph.norm, graph.metadata, graph.fresh});
+
+    ov::Core core;
+    const auto compiled = core.compile_model(model, "CPU");
+    EXPECT_EQ(runtime_layer_type(compiled, "TurboQuantStateUpdateDecode"), "Reference");
+
+    const auto outputs = run_compiled_prefill_and_decode(compiled);
+    auto sources = reviewer_adversarial_vectors();
+    sources.push_back(
+        {0.25f, -0.5f, 0.75f, -1.0f, 0.125f, 0.5f, -0.25f, 1.0f});
+    EXPECT_EQ(outputs.sequence_length, 3u);
+    EXPECT_EQ(outputs.payload, scalar_payload_for(sources, TurboQuantBits::B4));
+    EXPECT_EQ(outputs.norm_bytes, scalar_norm_bytes_for(sources, TurboQuantBits::B4));
+    EXPECT_EQ(outputs.metadata, (std::vector<int32_t>{8, 8, 8}));
+    EXPECT_EQ(outputs.decoded, scalar_corrected_decode_for(sources, TurboQuantBits::B4));
+}
