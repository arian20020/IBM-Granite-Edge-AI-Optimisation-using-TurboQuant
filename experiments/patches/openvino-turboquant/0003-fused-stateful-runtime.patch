+std::string runtime_layer_type(const ov::CompiledModel& compiled,
+                               const std::string& original_op_name) {
+    const auto runtime_model = compiled.get_runtime_model();
+    for (const auto& node : runtime_model->get_ops()) {
+        if (node->get_friendly_name() != original_op_name)
+            continue;
+        const auto& runtime_info = node->get_rt_info();
+        const auto layer_type = runtime_info.find("layerType");
+        OPENVINO_ASSERT(layer_type != runtime_info.end(), "Named runtime node has no layerType metadata");
+        return layer_type->second.as<std::string>();
+    }
+    OPENVINO_THROW("Compiled model has no runtime node named ", original_op_name);
+}
