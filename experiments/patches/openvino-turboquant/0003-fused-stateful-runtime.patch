 namespace ov::genai {
 
+ActivationTelemetry reconcile_turboquant_activation(
+    ov::InferRequest request,
+    const turboquant::GraphTransformManifest& manifest,
+    const TurboQuantConfig& config,
+    const std::string& model_hash,
+    const std::string& requested_key_cache_precision,
+    const std::string& requested_value_cache_precision) {
+    OPENVINO_ASSERT(!manifest.activated,
+                    "TurboQuant activation manifest must not claim activation before reconciliation");
+    OPENVINO_ASSERT(manifest.device == "CPU", "TurboQuant activation manifest device must be CPU");
+    OPENVINO_ASSERT(!manifest.transformed_model_hash.empty(),
+                    "TurboQuant activation manifest has no transformed-model hash");
+    OPENVINO_ASSERT(!model_hash.empty(), "TurboQuant activation model hash must not be empty");
+
+    const auto compiled_model = request.get_compiled_model();
+    const auto device = actual_execution_device(compiled_model);
+    OPENVINO_ASSERT(device == "CPU",
+                    "TurboQuant activation requires actual CPU execution, got ",
+                    device);
+
+    std::map<std::string, ov::Tensor> actual_states;
+    for (const auto& state : request.query_state()) {
+        const auto [unused, inserted] = actual_states.emplace(state.get_name(), state.get_state());
+        (void)unused;
+        OPENVINO_ASSERT(inserted, "Duplicate TurboQuant runtime state: ", state.get_name());
+    }
+
+    std::optional<size_t> runtime_batch;
+    std::optional<size_t> sequence_length;
+    size_t expected_standard_bytes = 0;
+    size_t actual_standard_bytes = 0;
+    size_t expected_payload_bytes = 0;
+    size_t actual_payload_bytes = 0;
+    size_t expected_norm_bytes = 0;
+    size_t actual_norm_bytes = 0;
+    size_t expected_metadata_bytes = 0;
+    size_t actual_metadata_bytes = 0;
+    size_t decoded_scratch_bytes = 0;
+    size_t full_precision_equivalent_bytes = 0;
+    std::set<std::string> expected_operation_names;
+    std::optional<std::string> observed_key_state_precision;
+    std::optional<std::string> observed_value_state_precision;
+
+    const auto reconcile_state =
+        [&](const std::string& name,
+            const ov::element::Type& expected_type,
+            const ov::Dimension& expected_batch,
+            size_t heads,
+            size_t width,
+            const char* description) -> RuntimeStateEvidence {
+        const auto found = actual_states.find(name);
+        OPENVINO_ASSERT(found != actual_states.end(), "Missing TurboQuant runtime state: ", name);
+        const auto& tensor = found->second;
+        const auto& shape = tensor.get_shape();
+        OPENVINO_ASSERT(tensor.get_element_type() == expected_type,
+                        "TurboQuant runtime state ",
+                        name,
+                        " has type ",
+                        tensor.get_element_type(),
+                        ", expected ",
+                        expected_type);
+        OPENVINO_ASSERT(shape.size() == 4u,
+                        "TurboQuant runtime state has an invalid shape: ",
+                        name);
+        OPENVINO_ASSERT(shape[0] > 0u &&
+                            shape[0] <= static_cast<size_t>(std::numeric_limits<int64_t>::max()),
+                        "TurboQuant runtime state has an invalid batch dimension: ",
+                        name);
+        OPENVINO_ASSERT(
+            expected_batch.compatible(ov::Dimension(static_cast<int64_t>(shape[0]))),
+            "TurboQuant runtime state batch dimension conflicts with its manifest: ",
+            name);
+        OPENVINO_ASSERT(shape[1] == heads && shape[3] == width,
+                        "TurboQuant runtime state has an invalid shape: ",
+                        name);
+        if (runtime_batch)
+            OPENVINO_ASSERT(*runtime_batch == shape[0],
+                            "TurboQuant runtime state batch dimensions differ: ",
+                            name);
+        else
+            runtime_batch = shape[0];
+        OPENVINO_ASSERT(shape[2] > 0u, "TurboQuant runtime state has no generated sequence: ", name);
+        if (sequence_length)
+            OPENVINO_ASSERT(*sequence_length == shape[2],
+                            "TurboQuant runtime state sequence lengths differ: ",
+                            name);
+        else
+            sequence_length = shape[2];
+
+        auto expected_bytes = checked_multiply(shape[0], heads, description);
+        expected_bytes = checked_multiply(expected_bytes, shape[2], description);
+        expected_bytes = checked_multiply(expected_bytes, width, description);
+        expected_bytes = checked_multiply(expected_bytes, expected_type.size(), description);
+        OPENVINO_ASSERT(tensor.get_byte_size() == expected_bytes,
+                        "TurboQuant runtime state byte count differs from its exact shape: ",
+                        name);
+        const auto observed_precision = tensor.get_element_type().get_type_name();
+        actual_states.erase(found);
+        return {expected_bytes, observed_precision};
+    };
+
+    const auto record_observed_precision =
+        [&](turboquant::KVKind kind, const std::string& precision) {
+        auto& observed = kind == turboquant::KVKind::KEY
+                             ? observed_key_state_precision
+                             : observed_value_state_precision;
+        if (observed) {
+            OPENVINO_ASSERT(*observed == precision,
+                            "TurboQuant runtime states of one cache kind use different precisions");
+        } else {
+            observed = precision;
+        }
+    };
+
+    std::set<std::string> logical_state_ids;
+    for (const auto& state : manifest.states) {
+        OPENVINO_ASSERT(logical_state_ids.insert(state.variable_id).second,
+                        "Duplicate TurboQuant manifest state: ",
+                        state.variable_id);
+        const auto expected_algorithm =
+            state.kind == turboquant::KVKind::KEY ? config.key_algorithm : config.value_algorithm;
+        OPENVINO_ASSERT(state.algorithm == expected_algorithm,
+                        "TurboQuant manifest algorithm differs from the requested configuration: ",
+                        state.variable_id);
+        const size_t heads = static_dimension(state.original_shape, 1, state.variable_id);
+        const size_t head_dimension = static_dimension(state.original_shape, 3, state.variable_id);
+        const auto& batch = state.original_shape[0];
+        OPENVINO_ASSERT(head_dimension == state.head_dimension,
+                        "TurboQuant manifest head dimensions differ: ",
+                        state.variable_id);
+
+        if (state.algorithm == CacheAlgorithm::STANDARD) {
+            const auto evidence = reconcile_state(state.variable_id,
+                                                  state.original_type,
+                                                  batch,
+                                                  heads,
+                                                  head_dimension,
+                                                  "STANDARD state");
+            actual_standard_bytes =
+                checked_add(actual_standard_bytes, evidence.bytes, "STANDARD total");
+            record_observed_precision(state.kind, evidence.precision);
+        } else {
+            const auto payload_name = state.variable_id + ".payload";
+            const auto norm_name = state.variable_id + ".norm";
+            const auto metadata_name = state.variable_id + ".meta";
+            const auto payload = reconcile_state(payload_name,
+                                                 ov::element::u8,
+                                                 batch,
+                                                 heads,
+                                                 state.packed_bytes_per_vector,
+                                                 "payload state");
+            const auto norm = reconcile_state(norm_name,
+                                              ov::element::f32,
+                                              batch,
+                                              heads,
+                                              1u,
+                                              "norm state");
+            const auto metadata = reconcile_state(metadata_name,
+                                                  ov::element::i32,
+                                                  batch,
+                                                  heads,
+                                                  1u,
+                                                  "metadata state");
+            actual_payload_bytes =
+                checked_add(actual_payload_bytes, payload.bytes, "payload total");
