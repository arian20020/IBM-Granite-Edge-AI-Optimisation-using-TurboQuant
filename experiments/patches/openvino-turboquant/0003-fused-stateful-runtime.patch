+ov::Output<ov::Node> make_grouped_query_cache_layout(const ov::Output<ov::Node>& state,
+                                                     const std::string& friendly_name,
+                                                     int64_t unsqueeze_axis = 2) {
+    auto axes = ov::op::v0::Constant::create(
+        ov::element::i64, ov::Shape{}, {unsqueeze_axis});
+    auto unsqueeze = std::make_shared<ov::op::v0::Unsqueeze>(state, axes);
+    unsqueeze->set_friendly_name(friendly_name + ".unsqueeze");
+
+    auto state_shape = std::make_shared<ov::op::v3::ShapeOf>(state, ov::element::i64);
+    state_shape->set_friendly_name(friendly_name + ".shape");
+    auto shape_axis =
+        ov::op::v0::Constant::create(ov::element::i64, ov::Shape{}, {0});
+    const auto gather_dimension = [&](int64_t index) {
+        auto dimension_index =
+            ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {index});
+        return std::make_shared<ov::op::v8::Gather>(
+            state_shape, dimension_index, shape_axis, 0);
+    };
+    auto target_shape = std::make_shared<ov::op::v0::Concat>(
+        ov::OutputVector{
+            gather_dimension(0),
+            ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {2}),
+            ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {2}),
+            gather_dimension(2),
+            ov::op::v0::Constant::create(ov::element::i64, ov::Shape{1}, {8}),
+        },
+        0);
+    auto broadcast = std::make_shared<ov::op::v3::Broadcast>(
+        unsqueeze,
+        target_shape,
+        ov::op::BroadcastType::BIDIRECTIONAL);
+    broadcast->set_friendly_name(friendly_name + ".broadcast");
+    auto pattern = ov::op::v0::Constant::create(
+        ov::element::i64, ov::Shape{4}, {0, 4, -1, 8});
+    auto reshape =
+        std::make_shared<ov::op::v1::Reshape>(broadcast, pattern, true);
+    reshape->set_friendly_name(friendly_name + ".reshape");
+    return reshape;
+}
+
+AttentionLayer make_grouped_query_attention_layer(const std::string& friendly_name,
+                                                  const ShapeSpec& shape,
+                                                  int64_t unsqueeze_axis = 2) {
+    auto key = make_state_path(friendly_name + ".key", ov::element::f32, shape);
+    auto value = make_state_path(friendly_name + ".value", ov::element::f32, shape);
+    auto query = std::make_shared<ov::op::v0::Parameter>(
+        ov::element::f32,
+        ov::PartialShape{1, 4, 1, 8});
+    query->set_friendly_name(friendly_name + ".query");
+    auto sdpa = std::make_shared<ov::op::v13::ScaledDotProductAttention>(
+        query,
+        make_grouped_query_cache_layout(
+            key.update, friendly_name + ".key", unsqueeze_axis),
+        make_grouped_query_cache_layout(
+            value.update, friendly_name + ".value", unsqueeze_axis),
+        false);
+    sdpa->set_friendly_name(friendly_name);
+    return {std::move(key), std::move(value), std::move(query), std::move(sdpa)};
+}
