+        auto vectors = checked_multiply(*runtime_batch, heads, "state vectors");
+        vectors = checked_multiply(vectors, *sequence_length, "state vectors");
+
+        auto original_elements = checked_multiply(vectors, state.head_dimension, "full-precision state");
+        full_precision_equivalent_bytes =
