+TEST(TurboQuantStateUpdateDecode, AppendsMultipleFreshRecordsInOnePrefillEvaluation) {
+    constexpr size_t head_dimension = 8;
+    constexpr auto bits = TurboQuantBits::B4;
+    const size_t payload_width = packed_bytes(head_dimension, bits);
+    const std::vector<float> prior{
+        0.25f, -0.5f, 0.75f, -1.0f, 0.125f, 0.5f, -0.25f, 1.0f};
+    const std::vector<std::vector<float>> fresh_rows{
+        {1.0f, 0.5f, 0.25f, 0.125f, -0.125f, -0.25f, -0.5f, -1.0f},
+        {-0.75f, -0.25f, 0.25f, 0.75f, 1.0f, -1.0f, 0.5f, -0.5f},
+    };
+    const auto encoded_prior = encode(prior, bits);
+    const auto graph = make_operation_with_shapes(
+        bits,
+        head_dimension,
+        true,
+        ov::PartialShape{1, 1, 1, payload_width},
+        ov::PartialShape{1, 1, 1, 1},
+        ov::PartialShape{1, 1, 1, 1},
+        ov::PartialShape{1, 1, fresh_rows.size(), head_dimension});
+    std::vector<float> flattened_fresh;
+    for (const auto& row : fresh_rows)
+        flattened_fresh.insert(flattened_fresh.end(), row.begin(), row.end());
+    ov::TensorVector inputs{
+        tensor_from_values<uint8_t>(
+            ov::element::u8, ov::Shape{1, 1, 1, payload_width}, encoded_prior.payload),
+        tensor_from_values<float>(
+            ov::element::f32, ov::Shape{1, 1, 1, 1}, {encoded_prior.norm}),
+        tensor_from_values<int32_t>(
+            ov::element::i32, ov::Shape{1, 1, 1, 1}, {static_cast<int32_t>(head_dimension)}),
+        tensor_from_values<float>(
+            ov::element::f32,
+            ov::Shape{1, 1, fresh_rows.size(), head_dimension},
+            flattened_fresh),
+    };
+    auto outputs = sentinel_outputs();
+
+    ASSERT_TRUE(graph.operation->evaluate(outputs, inputs));
+
+    std::vector<std::vector<float>> expected_rows{prior};
+    expected_rows.insert(expected_rows.end(), fresh_rows.begin(), fresh_rows.end());
+    EXPECT_EQ(outputs[0].get_shape(), (ov::Shape{1, 1, expected_rows.size(), payload_width}));
+    EXPECT_EQ(outputs[3].get_shape(), (ov::Shape{1, 1, expected_rows.size(), head_dimension}));
+    EXPECT_EQ(tensor_values<uint8_t>(outputs[0]), scalar_payload_for(expected_rows, bits));
+    EXPECT_EQ(tensor_bytes(outputs[1]), scalar_norm_bytes_for(expected_rows, bits));
+    EXPECT_EQ(tensor_values<int32_t>(outputs[2]),
+              std::vector<int32_t>(expected_rows.size(), static_cast<int32_t>(head_dimension)));
+    EXPECT_EQ(tensor_values<float>(outputs[3]), scalar_corrected_decode_for(expected_rows, bits));
+}
