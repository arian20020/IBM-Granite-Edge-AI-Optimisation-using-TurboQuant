+nlohmann::json compile_and_generate_fixture_pipeline(const std::string& device,
+                                                     CacheAlgorithm key,
+                                                     CacheAlgorithm value,
+                                                     const ov::AnyMap& properties = {}) {
+    ClogCapture capture;
+    StatefulLLMPipeline pipeline(make_fixture_model(),
+                                 Tokenizer{},
+                                 device,
+                                 properties,
+                                 fixture_generation_config(),
+                                 TurboQuantConfig{key, value, true},
+                                 "fixture-model-hash");
+    const auto result =
+        pipeline.generate(EncodedInputs{fixture_tokens()}, std::nullopt, StreamerVariant{std::monostate{}});
+    EXPECT_EQ(result.tokens.size(), 1u);
+    EXPECT_EQ(result.tokens.at(0).size(), 1u);
+    const auto events = activation_events(capture.str());
+    EXPECT_EQ(events.size(), 1u);
+    return events.empty() ? nlohmann::json{} : events.front();
+}
