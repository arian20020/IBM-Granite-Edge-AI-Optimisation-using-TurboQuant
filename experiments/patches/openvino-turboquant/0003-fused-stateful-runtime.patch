+GenerationConfig fixture_generation_config() {
+    GenerationConfig config;
+    config.max_new_tokens = 1;
+    config.set_eos_token_id(3);
+    return config;
+}
+
+ov::Tensor fixture_tokens(const ov::Shape& shape = {1, 1}) {
+    ov::Tensor input(ov::element::i64, shape);
+    std::fill_n(input.data<int64_t>(), input.get_size(), 1);
+    return input;
+}
+
+class ClogCapture {
+public:
+    ClogCapture() : m_previous(std::clog.rdbuf(m_buffer.rdbuf())) {}
+    ~ClogCapture() {
+        std::clog.rdbuf(m_previous);
+    }
+    std::string str() const {
+        return m_buffer.str();
+    }
+
+private:
+    std::ostringstream m_buffer;
+    std::streambuf* m_previous;
+};
+
+std::vector<nlohmann::json> activation_events(const std::string& captured) {
+    std::vector<nlohmann::json> events;
+    std::istringstream lines(captured);
+    for (std::string line; std::getline(lines, line);) {
+        if (line.find("\"requested_key_algorithm\"") == std::string::npos)
+            continue;
+        events.push_back(nlohmann::json::parse(line));
+    }
+    return events;
+}
+
+template <typename Callable>
+void expect_ov_exception_contains(Callable&& callable, const std::string& expected) {
+    try {
+        callable();
+        FAIL() << "Expected ov::Exception containing: " << expected;
+    } catch (const ov::Exception& exception) {
+        EXPECT_NE(std::string(exception.what()).find(expected), std::string::npos)
+            << "Unexpected diagnostic: " << exception.what();
+    }
+}
