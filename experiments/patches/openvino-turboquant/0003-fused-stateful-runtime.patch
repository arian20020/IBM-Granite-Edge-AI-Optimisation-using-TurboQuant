+TEST(TurboQuantStatefulGraph, PreservesAllNineIndependentKeyValueSelections) {
+    const std::vector<CacheAlgorithm> algorithms{
+        CacheAlgorithm::STANDARD,
+        CacheAlgorithm::TBQ3,
+        CacheAlgorithm::TBQ4,
+    };
+    std::set<std::vector<float>> executed_key_inputs;
+    size_t combination_index = 0;
+    for (const auto key_algorithm : algorithms) {
+        for (const auto value_algorithm : algorithms) {
+            auto caller = make_model({make_attention_layer("matrix_sdpa", rank_four_shape(8))}, "matrix_stateful_sdpa");
+            const auto before = snapshot_graph(caller);
+            const auto result = transform_stateful_kv_graph(caller, {key_algorithm, value_algorithm, true}, "CPU");
+            EXPECT_TRUE(snapshot_graph(caller) == before);
+            EXPECT_NE(result.model, caller);
+            const auto sdpa = find_sdpa(result.model, "matrix_sdpa");
+            const size_t expected_fused_operations =
+                (key_algorithm == CacheAlgorithm::STANDARD ? 0u : 1u) +
+                (value_algorithm == CacheAlgorithm::STANDARD ? 0u : 1u);
+            EXPECT_EQ(fused_operation_count(result.model), expected_fused_operations);
+            EXPECT_EQ(standard_codec_arithmetic_region_count(result.model), 0u);
+
+            for (const auto selection :
+                 {std::make_pair(KVKind::KEY, key_algorithm), std::make_pair(KVKind::VALUE, value_algorithm)}) {
+                const auto kind = selection.first;
+                const auto algorithm = selection.second;
+                const auto sdpa_port = kind == KVKind::KEY ? 1u : 2u;
+                const auto suffix = kind == KVKind::KEY ? ".key" : ".value";
+                const auto id = std::string("matrix_sdpa") + suffix;
+                const auto& record = find_record(result.manifest, 0, kind);
+                EXPECT_EQ(record.algorithm, algorithm);
+                if (algorithm == CacheAlgorithm::STANDARD) {
+                    ASSERT_TRUE(find_variable_info(result.model, id));
+                    EXPECT_FALSE(find_variable_info(result.model, id + ".payload"));
+                    EXPECT_FALSE(find_variable_info(result.model, id + ".norm"));
+                    EXPECT_FALSE(find_variable_info(result.model, id + ".meta"));
+                    EXPECT_TRUE(record.payload_shape.rank().is_dynamic());
+                    EXPECT_EQ(record.packed_bytes_per_vector, 0u);
+                    EXPECT_EQ(sdpa->input_value(sdpa_port).get_node()->get_friendly_name(), id + ".concat");
+                } else {
+                    EXPECT_FALSE(find_variable_info(result.model, id));
+                    const auto payload = find_variable_info(result.model, id + ".payload");
+                    const auto norm = find_variable_info(result.model, id + ".norm");
+                    const auto metadata = find_variable_info(result.model, id + ".meta");
+                    ASSERT_TRUE(payload);
+                    ASSERT_TRUE(norm);
+                    ASSERT_TRUE(metadata);
+                    EXPECT_EQ(payload->data_type, ov::element::u8);
+                    EXPECT_EQ(norm->data_type, ov::element::f32);
+                    EXPECT_EQ(metadata->data_type, ov::element::i32);
+                    const size_t expected_payload = algorithm == CacheAlgorithm::TBQ3 ? 3u : 4u;
+                    EXPECT_EQ(payload->data_shape[3].get_length(), expected_payload);
+                    EXPECT_EQ(record.packed_bytes_per_vector, expected_payload);
+                    EXPECT_EQ(record.norm_bytes_per_vector, sizeof(float));
+                    EXPECT_EQ(record.metadata_bytes_per_vector, sizeof(int32_t));
+                    EXPECT_TRUE(
+                        ov::is_type<TurboQuantStateUpdateDecode>(sdpa->input_value(sdpa_port).get_node_shared_ptr()));
+                }
+            }
+
+            std::vector<float> key_source{0.25f, -0.5f, 0.75f, -1.0f, 0.125f, 0.5f, -0.25f, 1.0f};
+            key_source.front() += 0.01f * static_cast<float>(combination_index);
+            auto value_source = key_source;
+            std::reverse(value_source.begin(), value_source.end());
+            ASSERT_NE(key_source, value_source);
+            EXPECT_TRUE(executed_key_inputs.insert(key_source).second);
+            std::optional<NumericalOutputs> outputs;
+            try {
+                outputs =
+                    run_steps_and_read_sdpa_inputs(key_algorithm, value_algorithm, {key_source}, {value_source});
+            } catch (const std::exception& error) {
+                ADD_FAILURE() << "real CPU execution failed for K=" << static_cast<int>(key_algorithm)
+                              << ", V=" << static_cast<int>(value_algorithm) << ": " << error.what();
+                ++combination_index;
+                continue;
+            }
+            EXPECT_NE(outputs->source_key, outputs->source_value);
+            for (const auto selection :
+                 {std::make_tuple(key_algorithm, std::cref(outputs->source_key), std::cref(outputs->decoded_key)),
+                  std::make_tuple(value_algorithm,
+                                  std::cref(outputs->source_value),
+                                  std::cref(outputs->decoded_value))}) {
+                const auto algorithm = std::get<0>(selection);
+                const auto& expected = std::get<1>(selection);
+                const auto& actual = std::get<2>(selection);
+                if (algorithm == CacheAlgorithm::STANDARD)
+                    EXPECT_EQ(actual, expected);
+                else
+                    EXPECT_LE(mean_squared_error(expected, actual), 0.08f);
+            }
+            ++combination_index;
+        }
+    }
+    EXPECT_EQ(executed_key_inputs.size(), 9u);
+}
