+TEST(TurboQuantStateUpdateDecode, PreservesExactOrderingAcrossBatchHeadsAndPriorSequence) {
+    constexpr size_t batch_count = 2;
+    constexpr size_t head_count = 2;
+    constexpr size_t prior_sequence = 2;
+    constexpr size_t fresh_sequence = 2;
+    constexpr size_t head_dimension = 8;
+    constexpr auto bits = TurboQuantBits::B4;
+    const size_t payload_width = packed_bytes(head_dimension, bits);
+
+    std::vector<std::vector<float>> prior_rows;
+    std::vector<std::vector<float>> fresh_rows;
+    std::vector<uint8_t> prior_payload;
+    std::vector<float> prior_norms;
+    std::vector<int32_t> prior_metadata;
+    for (size_t batch = 0; batch < batch_count; ++batch) {
+        for (size_t head = 0; head < head_count; ++head) {
+            for (size_t sequence = 0; sequence < prior_sequence; ++sequence) {
+                const float base = static_cast<float>(1 + batch * 100 + head * 10 + sequence);
+                prior_rows.push_back(
+                    {base, -base, base * 0.5f, -base * 0.25f, base + 0.125f, -base - 0.5f, 0.0f, base * 2.0f});
+                const auto encoded = encode(prior_rows.back(), bits);
+                prior_payload.insert(prior_payload.end(), encoded.payload.begin(), encoded.payload.end());
+                prior_norms.push_back(encoded.norm);
+                prior_metadata.push_back(static_cast<int32_t>(head_dimension));
+            }
+            for (size_t sequence = 0; sequence < fresh_sequence; ++sequence) {
+                const float base =
+                    static_cast<float>(1000 + batch * 100 + head * 10 + sequence);
+                fresh_rows.push_back(
+                    {-base,
+                     base,
+                     -base * 0.5f,
+                     base * 0.25f,
+                     -base - 0.125f,
+                     base + 0.5f,
+                     0.0f,
+                     -base * 2.0f});
+            }
+        }
+    }
+
+    const auto graph = make_operation(bits, head_dimension, true, batch_count, head_count);
+    ov::TensorVector inputs{
+        tensor_from_values<uint8_t>(
+            ov::element::u8,
+            ov::Shape{batch_count, head_count, prior_sequence, payload_width},
+            prior_payload),
+        tensor_from_values<float>(
+            ov::element::f32,
+            ov::Shape{batch_count, head_count, prior_sequence, 1},
+            prior_norms),
+        tensor_from_values<int32_t>(
+            ov::element::i32,
+            ov::Shape{batch_count, head_count, prior_sequence, 1},
+            prior_metadata),
+        tensor_from_values<float>(
+            ov::element::f32,
+            ov::Shape{batch_count, head_count, fresh_sequence, head_dimension},
+            [&] {
+                std::vector<float> flattened;
+                for (const auto& row : fresh_rows)
+                    flattened.insert(flattened.end(), row.begin(), row.end());
+                return flattened;
+            }()),
+    };
+    auto outputs = sentinel_outputs();
+    ASSERT_TRUE(graph.operation->evaluate(outputs, inputs));
+
+    std::vector<std::vector<float>> expected_rows;
+    for (size_t batch = 0; batch < batch_count; ++batch) {
+        for (size_t head = 0; head < head_count; ++head) {
+            const size_t batch_head = batch * head_count + head;
+            for (size_t sequence = 0; sequence < prior_sequence; ++sequence)
+                expected_rows.push_back(prior_rows[batch_head * prior_sequence + sequence]);
+            for (size_t sequence = 0; sequence < fresh_sequence; ++sequence)
+                expected_rows.push_back(
+                    fresh_rows[batch_head * fresh_sequence + sequence]);
+        }
+    }
+
+    EXPECT_EQ(outputs[0].get_shape(),
+              (ov::Shape{batch_count,
+                         head_count,
+                         prior_sequence + fresh_sequence,
+                         payload_width}));
+    EXPECT_EQ(outputs[3].get_shape(),
+              (ov::Shape{batch_count,
+                         head_count,
+                         prior_sequence + fresh_sequence,
+                         head_dimension}));
+    EXPECT_EQ(tensor_values<uint8_t>(outputs[0]), scalar_payload_for(expected_rows, bits));
+    EXPECT_EQ(tensor_bytes(outputs[1]), scalar_norm_bytes_for(expected_rows, bits));
+    EXPECT_EQ(tensor_values<int32_t>(outputs[2]),
+              std::vector<int32_t>(expected_rows.size(), static_cast<int32_t>(head_dimension)));
+    EXPECT_EQ(tensor_values<float>(outputs[3]), scalar_corrected_decode_for(expected_rows, bits));
+}
