+    EXPECT_EQ(event.at("observed_key_state_precision"), "u8+f32+i32");
+    EXPECT_EQ(event.at("requested_value_cache_precision"), "u4");
+    EXPECT_EQ(event.at("activated_value_cache_precision"), "u4");
+    EXPECT_EQ(event.at("observed_value_state_precision"), "u8+f32+i32");
+    EXPECT_EQ(event.at("expected_persistent_standard_bytes"), 0u);
