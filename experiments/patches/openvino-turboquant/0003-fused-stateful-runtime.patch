+StatePath make_state_path(const std::string& variable_id, const ov::element::Type& type, const ShapeSpec& shape) {
+    auto initial = std::make_shared<ov::op::v0::Parameter>(type, shape.initial);
+    initial->set_friendly_name(variable_id + ".initial");
+    auto token = std::make_shared<ov::op::v0::Parameter>(type, shape.token);
+    token->set_friendly_name(variable_id + ".token");
+    auto variable =
+        std::make_shared<ov::op::util::Variable>(ov::op::util::VariableInfo{shape.variable, type, variable_id});
+    auto read_value = std::make_shared<ov::op::v6::ReadValue>(initial, variable);
+    read_value->set_friendly_name(variable_id + ".read");
+    auto update = std::make_shared<ov::op::v0::Concat>(ov::OutputVector{read_value, token}, shape.sequence_axis);
+    update->set_friendly_name(variable_id + ".concat");
+    auto assign = std::make_shared<ov::op::v6::Assign>(update, variable);
+    assign->set_friendly_name(variable_id + ".assign");
+    return {variable, read_value, update, assign, {initial, token}};
+}
