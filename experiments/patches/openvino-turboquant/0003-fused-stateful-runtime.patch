+std::shared_ptr<ov::Model> make_granite_like_stateful_sdpa_model(
+    const ov::Dimension& batch_dimension = ov::Dimension::dynamic()) {
+    const ShapeSpec shape{
+        {batch_dimension, 2, ov::Dimension::dynamic(), 8},
+        {batch_dimension, 2, 0, 8},
+        {batch_dimension, 2, ov::Dimension::dynamic(), 8},
+        {batch_dimension, 4, ov::Dimension::dynamic(), 8},
+        -2,
+    };
+    auto beam_idx = std::make_shared<ov::op::v0::Parameter>(
+        ov::element::i32, ov::PartialShape{batch_dimension});
+    beam_idx->set_friendly_name("granite_like_sdpa.beam_idx");
+    auto key =
+        make_granite_cache_path("granite_like_sdpa.key", shape, beam_idx);
+    auto value =
+        make_granite_cache_path("granite_like_sdpa.value", shape, beam_idx);
+
+    const auto key_reorder = ov::as_type_ptr<ov::op::v8::Gather>(
+        key.update->input_value(0).get_node_shared_ptr());
+    OPENVINO_ASSERT(key_reorder);
+    auto prior_shape =
+        std::make_shared<ov::op::v3::ShapeOf>(key_reorder, ov::element::i64);
+    prior_shape->set_friendly_name("granite_like_sdpa.key.prior_shape");
+    auto sequence_index =
+        ov::op::v0::Constant::create(ov::element::i64, ov::Shape{}, {2});
+    auto shape_axis =
+        ov::op::v0::Constant::create(ov::element::i64, ov::Shape{}, {0});
+    auto prior_sequence_length = std::make_shared<ov::op::v8::Gather>(
+        prior_shape, sequence_index, shape_axis, 0);
+    prior_sequence_length->set_friendly_name(
+        "granite_like_sdpa.key.prior_sequence_length");
+
+    auto post_shape =
+        std::make_shared<ov::op::v3::ShapeOf>(key.update, ov::element::i64);
+    post_shape->set_friendly_name("granite_like_sdpa.key.post_shape");
+    const auto gather_dimension = [&](int64_t index) {
+        auto dimension_index = ov::op::v0::Constant::create(
+            ov::element::i64, ov::Shape{1}, {index});
+        return std::make_shared<ov::op::v8::Gather>(
+            post_shape, dimension_index, shape_axis, 0);
+    };
+    auto grouped_query_shape = std::make_shared<ov::op::v0::Concat>(
+        ov::OutputVector{
+            gather_dimension(0),
+            ov::op::v0::Constant::create(
+                ov::element::i64, ov::Shape{1}, {2}),
+            ov::op::v0::Constant::create(
+                ov::element::i64, ov::Shape{1}, {2}),
+            gather_dimension(2),
+            ov::op::v0::Constant::create(
+                ov::element::i64, ov::Shape{1}, {8}),
+        },
+        0);
+    grouped_query_shape->set_friendly_name(
+        "granite_like_sdpa.grouped_query_shape");
+
+    auto query = std::make_shared<ov::op::v0::Parameter>(
+        ov::element::f32, shape.query);
+    query->set_friendly_name("granite_like_sdpa.query");
+    auto sdpa =
+        std::make_shared<ov::op::v13::ScaledDotProductAttention>(
+            query,
+            make_granite_grouped_query_layout(
+                key.update,
+                grouped_query_shape,
+                "granite_like_sdpa.key"),
+            make_granite_grouped_query_layout(
+                value.update,
+                grouped_query_shape,
+                "granite_like_sdpa.value"),
+            false);
+    sdpa->set_friendly_name("granite_like_sdpa");
+
+    ov::ParameterVector parameters;
+    parameters.insert(
+        parameters.end(), key.parameters.begin(), key.parameters.end());
+    parameters.insert(
+        parameters.end(), value.parameters.begin(), value.parameters.end());
+    parameters.push_back(beam_idx);
+    parameters.push_back(query);
+    return std::make_shared<ov::Model>(
+        ov::ResultVector{
+            std::make_shared<ov::op::v0::Result>(sdpa),
+            std::make_shared<ov::op::v0::Result>(prior_sequence_length),
+        },
+        ov::SinkVector{key.assign, value.assign},
+        parameters,
+        "granite_like_stateful_sdpa");
+}
+
+void append_parameters(ov::ParameterVector& destination, const ov::ParameterVector& source) {
+    destination.insert(destination.end(), source.begin(), source.end());
+}
+
+std::shared_ptr<ov::Model> make_model(const std::vector<AttentionLayer>& layers,
+                                      const std::string& name = "stateful_sdpa") {
+    ov::ResultVector results;
+    ov::SinkVector sinks;
+    ov::ParameterVector parameters;
+    for (const auto& layer : layers) {
+        results.push_back(std::make_shared<ov::op::v0::Result>(layer.sdpa));
+        sinks.push_back(layer.key.assign);
+        sinks.push_back(layer.value.assign);
+        append_parameters(parameters, layer.key.parameters);
+        append_parameters(parameters, layer.value.parameters);
+        parameters.push_back(layer.query);
+    }
+    return std::make_shared<ov::Model>(results, sinks, parameters, name);
+}
