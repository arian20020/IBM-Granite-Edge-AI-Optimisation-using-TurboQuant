+TEST(TurboQuantPipelineActivation, SymmetricTurboQuantReportsLogicalAndObservedPrecisions) {
+    const auto event =
+        compile_and_generate_fixture_pipeline("CPU", CacheAlgorithm::TBQ3, CacheAlgorithm::TBQ4);
+    ASSERT_FALSE(event.empty());
+
+    EXPECT_EQ(event.at("requested_key_cache_precision"), "u3");
