+// Copyright (C) 2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+#include "turboquant_stateful_graph.hpp"
+#include "turboquant_state_update_decode.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <map>
+#include <queue>
+#include <set>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include "continuous_batching/cache/turboquant_codec.hpp"
+#include "openvino/core/except.hpp"
+#include "openvino/op/assign.hpp"
+#include "openvino/op/broadcast.hpp"
+#include "openvino/op/concat.hpp"
+#include "openvino/op/constant.hpp"
+#include "openvino/op/convert.hpp"
+#include "openvino/op/gather.hpp"
+#include "openvino/op/read_value.hpp"
+#include "openvino/op/reshape.hpp"
+#include "openvino/op/scaled_dot_product_attention.hpp"
+#include "openvino/op/shape_of.hpp"
+#include "openvino/op/slice.hpp"
+#include "openvino/op/unsqueeze.hpp"
+#include "openvino/op/util/assign_base.hpp"
+#include "openvino/op/util/read_value_base.hpp"
+#include "openvino/opsets/opset13.hpp"
+
+namespace ov::genai::turboquant {
+namespace {
+
+using Assign = ov::op::v6::Assign;
+using Gather = ov::op::v8::Gather;
+using ReadValue = ov::op::v6::ReadValue;
+using SDPA = ov::op::v13::ScaledDotProductAttention;
+using ShapeOf = ov::op::v3::ShapeOf;
+
+struct Endpoint {
+    std::shared_ptr<SDPA> sdpa;
+    KVKind kind;
+};
+
+struct TraceResult {
+    std::vector<Endpoint> endpoints;
+    size_t paired_assign_edges = 0;
+    bool has_unsupported_edge = false;
+};
+
+struct OutputIdentity {
+    const ov::Node* node;
+    size_t index;
+
+    bool operator<(const OutputIdentity& other) const {
+        if (node != other.node)
+            return std::less<const ov::Node*>{}(node, other.node);
+        return index < other.index;
+    }
+};
+
+struct Candidate {
+    std::shared_ptr<Assign> assign;
+    std::shared_ptr<ReadValue> read_value;
+    std::shared_ptr<ov::op::v0::Concat> append;
+    ov::Output<ov::Node> new_vector;
+    std::shared_ptr<Gather> cache_reorder;
+    std::vector<std::shared_ptr<ShapeOf>> cache_shape_consumers;
+    std::shared_ptr<SDPA> sdpa;
+    KVKind kind;
+    ov::op::util::VariableInfo variable_info;
+};
+
+struct AppendPath {
+    std::shared_ptr<ov::op::v0::Concat> append;
+    ov::Output<ov::Node> new_vector;
+    std::shared_ptr<Gather> cache_reorder;
+    std::vector<std::shared_ptr<ShapeOf>> cache_shape_consumers;
+};
+
+bool has_single_i64_value(const ov::Output<ov::Node>& input, int64_t expected) {
+    const auto constant = ov::as_type_ptr<ov::op::v0::Constant>(input.get_node_shared_ptr());
+    return constant && constant->get_element_type() == ov::element::i64 && constant->get_shape() == ov::Shape{1} &&
+           constant->cast_vector<int64_t>() == std::vector<int64_t>{expected};
+}
+
+bool is_integer_constant(const ov::Output<ov::Node>& input, int64_t expected) {
+    const auto constant = ov::as_type_ptr<ov::op::v0::Constant>(input.get_node_shared_ptr());
+    if (!constant ||
+        (constant->get_shape() != ov::Shape{} &&
+         constant->get_shape() != ov::Shape{1})) {
+        return false;
+    }
+    if (constant->get_element_type() != ov::element::i32 &&
+        constant->get_element_type() != ov::element::i64) {
+        return false;
+    }
+    return constant->cast_vector<int64_t>() == std::vector<int64_t>{expected};
+}
+
+bool is_supported_sequence_length_shape(const std::shared_ptr<ShapeOf>& shape_of) {
+    const auto consumers = shape_of->output(0).get_target_inputs();
+    if (consumers.empty())
+        return false;
+    for (const auto& consumer : consumers) {
+        const auto gather =
+            ov::as_type_ptr<Gather>(consumer.get_node()->shared_from_this());
+        if (!gather || consumer.get_index() != 0u ||
+            gather->get_input_size() != 3u ||
+            gather->get_batch_dims() != 0 ||
+            !is_integer_constant(gather->input_value(1), 2) ||
+            !is_integer_constant(gather->input_value(2), 0)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool is_supported_sequence_slice(const std::shared_ptr<ov::op::v8::Slice>& slice) {
+    if (slice->get_input_size() != 5u)
+        return false;
+
+    const auto axes = ov::as_type_ptr<ov::op::v0::Constant>(slice->input_value(4).get_node_shared_ptr());
+    if (!axes || axes->get_element_type() != ov::element::i64 || axes->get_shape() != ov::Shape{1})
+        return false;
+    const auto axis_values = axes->cast_vector<int64_t>();
+    const bool is_sequence_axis = axis_values == std::vector<int64_t>{2} || axis_values == std::vector<int64_t>{-2};
+
+    return is_sequence_axis && has_single_i64_value(slice->input_value(1), 0) &&
+           has_single_i64_value(slice->input_value(2), std::numeric_limits<int64_t>::max()) &&
+           has_single_i64_value(slice->input_value(3), 1);
+}
+
+bool has_one_output_consumer(const std::shared_ptr<ov::Node>& node) {
+    size_t consumer_count = 0;
+    for (const auto& output : node->outputs())
+        consumer_count += output.get_target_inputs().size();
+    return consumer_count == 1u;
+}
+
+bool has_rank(const ov::PartialShape& shape, int64_t rank) {
+    return shape.rank().is_static() && shape.rank().get_length() == rank;
+}
+
+bool is_supported_grouped_query_unsqueeze(
+    const std::shared_ptr<ov::op::v0::Unsqueeze>& unsqueeze) {
+    if (unsqueeze->get_input_size() != 2u ||
+        !is_integer_constant(unsqueeze->input_value(1), 2) ||
+        !has_one_output_consumer(unsqueeze)) {
+        return false;
+    }
+    const auto& input = unsqueeze->get_input_partial_shape(0);
+    const auto& output = unsqueeze->get_output_partial_shape(0);
+    return has_rank(input, 4) && has_rank(output, 5) &&
+           output[0].compatible(input[0]) &&
+           output[1].compatible(input[1]) &&
+           output[2].compatible(1) &&
+           output[3].compatible(input[2]) &&
+           output[4].compatible(input[3]);
+}
+
+bool is_supported_grouped_query_broadcast(
+    const std::shared_ptr<ov::op::v3::Broadcast>& broadcast) {
+    if (broadcast->get_input_size() != 2u ||
+        broadcast->get_broadcast_spec().m_type !=
+            ov::op::BroadcastType::BIDIRECTIONAL ||
+        !has_one_output_consumer(broadcast)) {
+        return false;
+    }
+    const auto& target_shape = broadcast->get_input_partial_shape(1);
+    const auto& input = broadcast->get_input_partial_shape(0);
+    const auto& output = broadcast->get_output_partial_shape(0);
+    return has_rank(target_shape, 1) && target_shape[0].is_static() &&
+           target_shape[0].get_length() == 5 && has_rank(input, 5) &&
+           has_rank(output, 5) && input[2].compatible(1) &&
+           output[2].is_static() && output[2].get_length() > 0 &&
+           output[0].compatible(input[0]) &&
+           output[1].compatible(input[1]) &&
+           output[3].compatible(input[3]) &&
+           output[4].compatible(input[4]);
+}
+
+bool is_supported_grouped_query_reshape(
+    const std::shared_ptr<ov::op::v1::Reshape>& reshape) {
+    if (reshape->get_input_size() != 2u || !reshape->get_special_zero() ||
+        !has_one_output_consumer(reshape)) {
+        return false;
+    }
+    const auto pattern = ov::as_type_ptr<ov::op::v0::Constant>(
+        reshape->input_value(1).get_node_shared_ptr());
+    if (!pattern ||
+        (pattern->get_element_type() != ov::element::i32 &&
+         pattern->get_element_type() != ov::element::i64) ||
+        pattern->get_shape() != ov::Shape{4}) {
+        return false;
+    }
+    const auto values = pattern->cast_vector<int64_t>();
+    if (values[0] != 0 || values[1] <= 0 || values[2] != -1 ||
+        values[3] <= 0) {
+        return false;
+    }
+    const auto& input = reshape->get_input_partial_shape(0);
+    const auto& output = reshape->get_output_partial_shape(0);
+    if (!has_rank(input, 5) || !has_rank(output, 4) ||
+        !input[1].is_static() || !input[2].is_static() ||
+        !input[4].is_static()) {
+        return false;
+    }
+    const auto heads = input[1].get_length();
+    const auto group = input[2].get_length();
+    if (heads <= 0 || group <= 0 ||
+        heads > std::numeric_limits<int64_t>::max() / group ||
+        heads * group != values[1] || input[4].get_length() != values[3]) {
+        return false;
+    }
+    return output[0].compatible(input[0]) &&
+           output[1].compatible(values[1]) &&
+           output[2].compatible(input[3]) &&
+           output[3].compatible(input[4]);
+}
+
+bool derives_from_state_operation(const ov::Output<ov::Node>& source) {
+    std::queue<ov::Output<ov::Node>> pending;
+    std::set<OutputIdentity> visited;
+    pending.push(source);
+
+    while (!pending.empty()) {
+        const auto output = pending.front();
+        pending.pop();
+        if (!visited.insert({output.get_node(), output.get_index()}).second)
+            continue;
+
+        const auto node = output.get_node_shared_ptr();
+        if (std::dynamic_pointer_cast<ov::op::util::ReadValueBase>(node) ||
+            std::dynamic_pointer_cast<ov::op::util::AssignBase>(node)) {
+            return true;
+        }
+        for (const auto& input : node->inputs())
+            pending.push(input.get_source_output());
+    }
+    return false;
+}
+
+bool derives_from_node(const ov::Output<ov::Node>& source,
+                       const ov::Node* forbidden) {
+    std::queue<ov::Output<ov::Node>> pending;
+    std::set<OutputIdentity> visited;
+    pending.push(source);
+
+    while (!pending.empty()) {
+        const auto output = pending.front();
+        pending.pop();
+        if (!visited.insert({output.get_node(), output.get_index()}).second)
+            continue;
+
+        const auto node = output.get_node_shared_ptr();
+        if (node.get() == forbidden)
+            return true;
+        for (const auto& input : node->inputs())
+            pending.push(input.get_source_output());
+    }
+    return false;
+}
+
+void validate_cache_layout(const ov::op::util::VariableInfo& variable_info) {
+    const auto& shape = variable_info.data_shape;
+    OPENVINO_ASSERT(shape.rank().is_static() && shape.rank().get_length() == 4,
+                    "TurboQuant state variable rank must be four: ",
+                    variable_info.variable_id);
+    OPENVINO_ASSERT(shape[3].is_static(), "TurboQuant state head dimension must be static");
+    const auto head_dimension = shape[3].get_length();
+    OPENVINO_ASSERT(head_dimension > 0 && head_dimension % 8 == 0,
+                    "TurboQuant state head dimension must be positive and divisible by eight");
+}
+
+AppendPath find_supported_append(const std::shared_ptr<ReadValue>& read_value,
+                                 const ov::op::util::VariableInfo& variable_info) {
+    const auto consumers = read_value->output(0).get_target_inputs();
+    OPENVINO_ASSERT(consumers.size() == 1u,
+                    "TurboQuant prior state must feed exactly one cache append path: ",
+                    variable_info.variable_id);
+
+    const auto state_input = *consumers.begin();
+    auto append =
+        ov::as_type_ptr<ov::op::v0::Concat>(state_input.get_node()->shared_from_this());
+    std::shared_ptr<Gather> cache_reorder;
+    std::vector<std::shared_ptr<ShapeOf>> cache_shape_consumers;
+    if (!append) {
+        cache_reorder =
+            ov::as_type_ptr<Gather>(state_input.get_node()->shared_from_this());
+        OPENVINO_ASSERT(cache_reorder && state_input.get_index() == 0u,
+                        "TurboQuant cache path supports only a direct Concat or "
+                        "batch-axis Gather from prior state: ",
+                        variable_info.variable_id);
+        OPENVINO_ASSERT(cache_reorder->get_input_size() == 3u &&
+                            cache_reorder->get_batch_dims() == 0 &&
+                            is_integer_constant(cache_reorder->input_value(2), 0),
+                        "TurboQuant cache reorder must be a batch-axis Gather with "
+                        "batch_dims zero: ",
+                        variable_info.variable_id);
+        const auto& indices_shape =
+            cache_reorder->input_value(1).get_partial_shape();
+        OPENVINO_ASSERT(
+            (cache_reorder->get_input_element_type(1) == ov::element::i32 ||
+             cache_reorder->get_input_element_type(1) == ov::element::i64) &&
+                indices_shape.rank().is_static() &&
+                indices_shape.rank().get_length() == 1 &&
+                !derives_from_state_operation(cache_reorder->input_value(1)),
+            "TurboQuant cache reorder indices must be an independent rank-one "
+            "integer input: ",
+            variable_info.variable_id);
+        const auto reordered_consumers =
+            cache_reorder->output(0).get_target_inputs();
+        for (const auto& reordered_consumer : reordered_consumers) {
+            const auto candidate_append =
+                ov::as_type_ptr<ov::op::v0::Concat>(
+                    reordered_consumer.get_node()->shared_from_this());
+            if (candidate_append) {
+                OPENVINO_ASSERT(!append &&
+                                    reordered_consumer.get_index() == 0u,
+                                "TurboQuant reordered prior state must feed exactly "
+                                "one Concat input 0: ",
+                                variable_info.variable_id);
+                append = candidate_append;
+                continue;
+            }
+            const auto shape_of = ov::as_type_ptr<ShapeOf>(
+                reordered_consumer.get_node()->shared_from_this());
+            OPENVINO_ASSERT(shape_of &&
+                                reordered_consumer.get_index() == 0u &&
+                                is_supported_sequence_length_shape(shape_of),
+                            "TurboQuant cache reorder has an unsupported side "
+                            "consumer: ",
+                            variable_info.variable_id);
+            cache_shape_consumers.push_back(shape_of);
+        }
+        OPENVINO_ASSERT(append,
+                        "TurboQuant cache reorder must feed an append Concat: ",
+                        variable_info.variable_id);
+    } else {
+        OPENVINO_ASSERT(state_input.get_index() == 0u,
+                        "TurboQuant cache append must place prior state at Concat "
+                        "input 0: ",
+                        variable_info.variable_id);
+    }
+    OPENVINO_ASSERT(append->get_input_size() == 2u,
+                    "TurboQuant cache append must join prior state and exactly one new vector: ",
+                    variable_info.variable_id);
+    OPENVINO_ASSERT(append->get_axis() == 2 || append->get_axis() == -2,
+                    "TurboQuant cache append Concat axis must be the rank-4 sequence axis 2/-2: ",
+                    variable_info.variable_id);
+
+    const auto new_vector = append->input_value(1);
+    const auto& new_shape = new_vector.get_partial_shape();
+    OPENVINO_ASSERT(new_shape.rank().is_static() && new_shape.rank().get_length() == 4,
+                    "TurboQuant newly appended vector rank must be four: ",
+                    variable_info.variable_id);
+    OPENVINO_ASSERT(new_shape[2].is_dynamic() ||
+                        new_shape[2].get_length() > 0,
+                    "TurboQuant cache append must permit at least one new sequence vector: ",
+                    variable_info.variable_id);
+    OPENVINO_ASSERT(!derives_from_node(new_vector, read_value.get()),
+                    "TurboQuant newly appended vector must not derive from the same cached state: ",
+                    variable_info.variable_id);
+
+    const auto& state_shape = variable_info.data_shape;
+    for (const auto axis : {0u, 1u, 3u}) {
+        OPENVINO_ASSERT(state_shape[axis].compatible(new_shape[axis]),
+                        "TurboQuant newly appended vector layout differs from cached state: ",
+                        variable_info.variable_id);
+    }
+    OPENVINO_ASSERT(state_shape.compatible(append->get_output_partial_shape(0)),
+                    "TurboQuant cache append output differs from state variable layout: ",
+                    variable_info.variable_id);
+    return {append, new_vector, cache_reorder, cache_shape_consumers};
+}
+
+void add_endpoint(TraceResult& trace, const std::shared_ptr<SDPA>& sdpa, KVKind kind) {
+    const auto duplicate = std::find_if(trace.endpoints.begin(), trace.endpoints.end(), [&](const Endpoint& endpoint) {
+        return endpoint.sdpa == sdpa && endpoint.kind == kind;
+    });
+    if (duplicate == trace.endpoints.end())
+        trace.endpoints.push_back({sdpa, kind});
+}
+
+TraceResult trace_state_consumers(const std::shared_ptr<ov::op::v0::Concat>& append,
+                                  const std::shared_ptr<Assign>& paired_assign) {
+    TraceResult trace;
+    std::queue<ov::Output<ov::Node>> pending;
+    std::set<OutputIdentity> visited;
+    pending.push(append->output(0));
+
+    while (!pending.empty()) {
+        const auto output = pending.front();
+        pending.pop();
+        if (!visited.insert({output.get_node(), output.get_index()}).second)
+            continue;
+
+        for (const auto& target_input : output.get_target_inputs()) {
+            auto target = target_input.get_node()->shared_from_this();
+            const auto input_index = target_input.get_index();
+
+            if (target == paired_assign) {
+                trace.paired_assign_edges += input_index == 0 ? 1u : 0u;
+                trace.has_unsupported_edge |= input_index != 0;
+                continue;
+            }
+
+            if (ov::is_type<Assign>(target)) {
+                trace.has_unsupported_edge = true;
+                continue;
+            }
+
+            if (const auto sdpa = ov::as_type_ptr<SDPA>(target)) {
+                if (input_index == 1)
+                    add_endpoint(trace, sdpa, KVKind::KEY);
+                else if (input_index == 2)
+                    add_endpoint(trace, sdpa, KVKind::VALUE);
+                else
+                    trace.has_unsupported_edge = true;
+                continue;
+            }
+
+            if (ov::is_type<ov::op::v0::Convert>(target)) {
+                if (input_index != 0u) {
+                    trace.has_unsupported_edge = true;
+                    continue;
+                }
+                for (auto& target_output : target->outputs())
+                    pending.push(target_output);
+                continue;
+            }
+
+            if (const auto slice = ov::as_type_ptr<ov::op::v8::Slice>(target)) {
+                OPENVINO_ASSERT(input_index == 0u,
+                                "TurboQuant cache Slice must consume the supported update on data input 0");
+                OPENVINO_ASSERT(
+                    is_supported_sequence_slice(slice),
+                    "TurboQuant cache Slice must use rank-4 sequence axis 2 with exact [0:INT64_MAX:1] bounds");
+                for (auto& target_output : target->outputs())
+                    pending.push(target_output);
+                continue;
+            }
+
+            if (const auto unsqueeze =
+                    ov::as_type_ptr<ov::op::v0::Unsqueeze>(target)) {
+                if (input_index != 0u ||
+                    !is_supported_grouped_query_unsqueeze(unsqueeze)) {
+                    trace.has_unsupported_edge = true;
+                    continue;
+                }
+                for (auto& target_output : target->outputs())
+                    pending.push(target_output);
+                continue;
+            }
+
+            if (const auto broadcast =
+                    ov::as_type_ptr<ov::op::v3::Broadcast>(target)) {
+                if (input_index != 0u ||
+                    !is_supported_grouped_query_broadcast(broadcast)) {
+                    trace.has_unsupported_edge = true;
+                    continue;
+                }
+                for (auto& target_output : target->outputs())
+                    pending.push(target_output);
+                continue;
+            }
+
+            if (const auto reshape =
+                    ov::as_type_ptr<ov::op::v1::Reshape>(target)) {
+                if (input_index != 0u ||
+                    !is_supported_grouped_query_reshape(reshape)) {
+                    trace.has_unsupported_edge = true;
+                    continue;
+                }
+                for (auto& target_output : target->outputs())
+                    pending.push(target_output);
+                continue;
+            }
+
+            if (ov::is_type<ShapeOf>(target)) {
+                trace.has_unsupported_edge |= input_index != 0u;
+                continue;
+            }
+
+            trace.has_unsupported_edge = true;
+        }
+    }
+    return trace;
+}
+
+size_t kind_index(KVKind kind) {
+    return kind == KVKind::KEY ? 0u : 1u;
+}
+
+CacheAlgorithm algorithm_for(KVKind kind, const TurboQuantConfig& config) {
+    return kind == KVKind::KEY ? config.key_algorithm : config.value_algorithm;
+}
+
+TurboQuantBits bits_for(CacheAlgorithm algorithm) {
+    switch (algorithm) {
+    case CacheAlgorithm::TBQ3:
+        return TurboQuantBits::B3;
+    case CacheAlgorithm::TBQ4:
+        return TurboQuantBits::B4;
+    case CacheAlgorithm::STANDARD:
+        break;
+    }
+    OPENVINO_THROW("A STANDARD cache does not have a TurboQuant bit width");
+}
+
+StateRecord make_state_record(const Candidate& candidate, size_t layer_index, const TurboQuantConfig& config) {
+    const auto& shape = candidate.variable_info.data_shape;
+    const auto head_dimension = static_cast<size_t>(shape[3].get_length());
+    const auto algorithm = algorithm_for(candidate.kind, config);
+    if (algorithm == CacheAlgorithm::STANDARD) {
+        return {candidate.variable_info.variable_id,
+                layer_index,
+                candidate.kind,
+                algorithm,
+                candidate.variable_info.data_type,
+                shape,
+                ov::PartialShape::dynamic(),
+                head_dimension,
+                0,
+                0,
+                0,
+                0};
+    }
+
+    const auto payload_bytes = packed_bytes(head_dimension, bits_for(algorithm));
+    auto payload_shape = shape;
+    payload_shape[3] = static_cast<int64_t>(payload_bytes);
+    return {candidate.variable_info.variable_id,
+            layer_index,
+            candidate.kind,
+            algorithm,
+            candidate.variable_info.data_type,
+            shape,
+            payload_shape,
+            head_dimension,
+            payload_bytes,
+            sizeof(float),
+            sizeof(int32_t),
+            0};
+}
+
+struct PendingReplacement {
+    Candidate candidate;
+    std::shared_ptr<Assign> payload_assign;
+    std::shared_ptr<Assign> norm_assign;
+    std::shared_ptr<Assign> metadata_assign;
+    ov::Output<ov::Node> payload_state;
+    ov::Output<ov::Node> decoded;
+};
+
+PendingReplacement build_replacement(const Candidate& candidate, const TurboQuantConfig& config) {
+    const auto algorithm = algorithm_for(candidate.kind, config);
+    OPENVINO_ASSERT(algorithm != CacheAlgorithm::STANDARD);
+    const auto bits = bits_for(algorithm);
+    const auto head_dimension = static_cast<size_t>(candidate.variable_info.data_shape[3].get_length());
+    const auto payload_bytes = packed_bytes(head_dimension, bits);
+    OPENVINO_ASSERT(candidate.variable_info.data_shape[1].is_static(),
+                    "TurboQuant selected state requires a static head-count dimension: ",
+                    candidate.variable_info.variable_id);
+    if (candidate.read_value->get_input_size() != 0u) {
+        const auto& initial_shape = candidate.read_value->get_input_partial_shape(0);
+        OPENVINO_ASSERT(initial_shape.rank().is_static() && initial_shape.rank().get_length() == 4 &&
+                            initial_shape[2].is_static() && initial_shape[2].get_length() == 0,
+                        "TurboQuant selected state initializer must have an empty sequence axis: ",
+                        candidate.variable_info.variable_id);
+    }
+
+    auto payload_shape = candidate.variable_info.data_shape;
+    payload_shape[3] = static_cast<int64_t>(payload_bytes);
+    auto sidecar_shape = candidate.variable_info.data_shape;
+    sidecar_shape[3] = 1;
+
+    const auto base_id = candidate.variable_info.variable_id;
+    auto payload_variable = std::make_shared<ov::op::util::Variable>(
+        ov::op::util::VariableInfo{payload_shape, ov::element::u8, base_id + ".payload"});
+    auto norm_variable = std::make_shared<ov::op::util::Variable>(
+        ov::op::util::VariableInfo{sidecar_shape, ov::element::f32, base_id + ".norm"});
+    auto metadata_variable = std::make_shared<ov::op::util::Variable>(
+        ov::op::util::VariableInfo{sidecar_shape, ov::element::i32, base_id + ".meta"});
+
+    auto payload_read = std::make_shared<ReadValue>(payload_variable);
+    auto norm_read = std::make_shared<ReadValue>(norm_variable);
+    auto metadata_read = std::make_shared<ReadValue>(metadata_variable);
+    payload_read->set_friendly_name(base_id + ".payload.read");
+    norm_read->set_friendly_name(base_id + ".norm.read");
+    metadata_read->set_friendly_name(base_id + ".meta.read");
+    const auto route_state = [&](const ov::Output<ov::Node>& state,
+                                 const char* suffix) {
+        if (!candidate.cache_reorder)
+            return state;
+        auto reordered = std::make_shared<Gather>(
+            state,
+            candidate.cache_reorder->input_value(1),
+            candidate.cache_reorder->input_value(2),
+            candidate.cache_reorder->get_batch_dims());
+        reordered->set_friendly_name(base_id + suffix + ".cache_reorder");
+        return reordered->output(0);
+    };
+    const auto payload_state = route_state(payload_read, ".payload");
+    const auto norm_state = route_state(norm_read, ".norm");
+    const auto metadata_state = route_state(metadata_read, ".meta");
+    auto update = std::make_shared<TurboQuantStateUpdateDecode>(payload_state,
+                                                                norm_state,
+                                                                metadata_state,
+                                                                candidate.new_vector,
+                                                                bits,
+                                                                head_dimension,
+                                                                config.norm_correction);
+    update->set_friendly_name(base_id + ".update_decode");
+
+    auto payload_assign = std::make_shared<Assign>(update->output(0), payload_variable);
+    auto norm_assign = std::make_shared<Assign>(update->output(1), norm_variable);
+    auto metadata_assign = std::make_shared<Assign>(update->output(2), metadata_variable);
+    payload_assign->set_friendly_name(base_id + ".payload.assign");
+    norm_assign->set_friendly_name(base_id + ".norm.assign");
+    metadata_assign->set_friendly_name(base_id + ".meta.assign");
+
+    return {
+        candidate,
+        payload_assign,
+        norm_assign,
+        metadata_assign,
+        payload_state,
+        update->output(3),
+    };
+}
+
+}  // namespace
+
+GraphTransformResult transform_stateful_kv_graph_impl(
+    std::shared_ptr<ov::Model> model,
+    const TurboQuantConfig& config,
+    const std::string& device,
+    bool preserve_source_model) {
+    OPENVINO_ASSERT(model, "TurboQuant stateful graph discovery requires a model");
+    OPENVINO_ASSERT(device == "CPU", "TurboQuant stateful graph discovery supports CPU only");
+    auto transformed_model =
+        preserve_source_model ? model->clone() : std::move(model);
+
+    std::unordered_map<std::string, std::vector<std::shared_ptr<ReadValue>>> reads_by_id;
+    for (const auto& node : transformed_model->get_ops()) {
+        const std::string type_name = node->get_type_name();
+        OPENVINO_ASSERT(type_name.find("PagedAttention") == std::string::npos,
+                        "TurboQuant stateful graph discovery does not support PagedAttention");
+
+        if (std::dynamic_pointer_cast<ov::op::util::ReadValueBase>(node)) {
+            const auto read_value = std::dynamic_pointer_cast<ReadValue>(node);
+            OPENVINO_ASSERT(read_value, "TurboQuant encountered an unsupported state operation version");
+            const auto info = read_value->get_variable()->get_info();
+            OPENVINO_ASSERT(!info.variable_id.empty(), "TurboQuant state variable ID must not be empty");
+            reads_by_id[info.variable_id].push_back(read_value);
+        }
+        if (std::dynamic_pointer_cast<ov::op::util::AssignBase>(node)) {
+            OPENVINO_ASSERT(std::dynamic_pointer_cast<Assign>(node),
+                            "TurboQuant encountered an unsupported state operation version");
+        }
+    }
+
+    std::vector<Candidate> candidates;
+    std::unordered_set<std::string> assigned_ids;
+    for (const auto& sink : transformed_model->get_sinks()) {
+        const auto assign = ov::as_type_ptr<Assign>(sink);
+        if (!assign)
+            continue;
+
+        const auto assign_info = assign->get_variable()->get_info();
+        OPENVINO_ASSERT(!assign_info.variable_id.empty(), "TurboQuant state variable ID must not be empty");
+        OPENVINO_ASSERT(assigned_ids.insert(assign_info.variable_id).second,
+                        "Duplicate TurboQuant state variable ID: ",
+                        assign_info.variable_id);
+
+        const auto reads = reads_by_id.find(assign_info.variable_id);
+        OPENVINO_ASSERT(reads != reads_by_id.end() && reads->second.size() == 1u,
+                        "TurboQuant state variable must have exactly one ReadValue: ",
+                        assign_info.variable_id);
+        const auto& read_value = reads->second.front();
+        const auto read_info = read_value->get_variable()->get_info();
+        OPENVINO_ASSERT(read_info.data_type == assign_info.data_type && read_info.data_shape == assign_info.data_shape,
+                        "TurboQuant Assign and ReadValue metadata differ for variable: ",
+                        assign_info.variable_id);
+
+        validate_cache_layout(assign_info);
+        const auto append_path = find_supported_append(read_value, assign_info);
+        const auto trace = trace_state_consumers(append_path.append, assign);
+        OPENVINO_ASSERT(trace.paired_assign_edges == 1u,
+                        "TurboQuant supported cache update must reach its paired Assign exactly once: ",
+                        assign_info.variable_id);
+        OPENVINO_ASSERT(!trace.has_unsupported_edge,
+                        "TurboQuant state uses an unsupported graph edge: ",
+                        assign_info.variable_id);
+        OPENVINO_ASSERT(trace.endpoints.size() == 1u,
+                        "TurboQuant state must reach exactly one SDPA key or value input: ",
+                        assign_info.variable_id);
+
+        const auto& endpoint = trace.endpoints.front();
+        candidates.push_back({assign,
+                              read_value,
+                              append_path.append,
+                              append_path.new_vector,
+                              append_path.cache_reorder,
+                              append_path.cache_shape_consumers,
+                              endpoint.sdpa,
+                              endpoint.kind,
+                              assign_info});
+    }
+
+    OPENVINO_ASSERT(!candidates.empty(), "No supported CPU stateful-SDPA cache states were found");
+    OPENVINO_ASSERT(assigned_ids.size() == reads_by_id.size(),
+                    "Every TurboQuant ReadValue must have exactly one paired Assign");
+
+    const auto expected_type = candidates.front().variable_info.data_type;
+    std::map<const SDPA*, std::array<size_t, 2>> endpoint_counts;
+    std::map<std::string, const SDPA*> attention_names;
+    for (const auto& candidate : candidates) {
+        OPENVINO_ASSERT(candidate.variable_info.data_type == expected_type,
+                        "TurboQuant state variables must use one element type");
+
+        auto& count = endpoint_counts[candidate.sdpa.get()][kind_index(candidate.kind)];
+        ++count;
+        OPENVINO_ASSERT(count == 1u, "Each SDPA cache input must map to exactly one state variable");
+
+        const auto& friendly_name = candidate.sdpa->get_friendly_name();
+        const auto [name, inserted] = attention_names.emplace(friendly_name, candidate.sdpa.get());
+        OPENVINO_ASSERT(inserted || name->second == candidate.sdpa.get(),
+                        "SDPA friendly names must uniquely identify layers: ",
+                        friendly_name);
+    }
+
+    for (const auto& [sdpa, counts] : endpoint_counts) {
+        (void)sdpa;
+        OPENVINO_ASSERT(counts[0] == 1u && counts[1] == 1u,
+                        "Every supported SDPA layer must have independent key and value states");
+    }
+
+    std::sort(candidates.begin(), candidates.end(), [](const Candidate& left, const Candidate& right) {
+        const auto& left_name = left.sdpa->get_friendly_name();
+        const auto& right_name = right.sdpa->get_friendly_name();
+        if (left_name != right_name)
+            return left_name < right_name;
+        return kind_index(left.kind) < kind_index(right.kind);
+    });
+
+    GraphTransformManifest manifest;
+    manifest.device = device;
+    size_t layer_index = 0;
+    const SDPA* previous_sdpa = nullptr;
+    for (const auto& candidate : candidates) {
+        if (previous_sdpa && previous_sdpa != candidate.sdpa.get())
+            ++layer_index;
+        manifest.states.push_back(make_state_record(candidate, layer_index, config));
+        previous_sdpa = candidate.sdpa.get();
+    }
+
+    std::unordered_set<std::string> final_variable_ids;
+    for (const auto& candidate : candidates) {
+        const auto algorithm = algorithm_for(candidate.kind, config);
+        if (algorithm == CacheAlgorithm::STANDARD) {
+            OPENVINO_ASSERT(final_variable_ids.insert(candidate.variable_info.variable_id).second,
+                            "TurboQuant final state variable ID collision: ",
+                            candidate.variable_info.variable_id);
+            continue;
+        }
+        for (const auto* suffix : {".payload", ".norm", ".meta"}) {
+            const auto transformed_id = candidate.variable_info.variable_id + suffix;
+            OPENVINO_ASSERT(final_variable_ids.insert(transformed_id).second,
+                            "TurboQuant final state variable ID collision: ",
+                            transformed_id);
+        }
+    }
+
+    std::vector<PendingReplacement> replacements;
+    replacements.reserve(candidates.size());
+    for (const auto& candidate : candidates) {
+        if (algorithm_for(candidate.kind, config) != CacheAlgorithm::STANDARD)
+            replacements.push_back(build_replacement(candidate, config));
+    }
+
+    ov::SinkVector new_sinks;
+    new_sinks.reserve(replacements.size() * 3);
+    for (const auto& replacement : replacements) {
+        for (const auto& shape_of :
+             replacement.candidate.cache_shape_consumers) {
+            shape_of->input(0).replace_source_output(
+                replacement.payload_state);
+        }
+        const auto append_consumers =
+            replacement.candidate.append->output(0).get_target_inputs();
+        for (auto target_input : append_consumers) {
+            if (target_input.get_node() != replacement.candidate.assign.get())
+                target_input.replace_source_output(replacement.decoded);
+        }
+        transformed_model->remove_sink(replacement.candidate.assign);
+        transformed_model->remove_variable(replacement.candidate.read_value->get_variable());
+        new_sinks.push_back(replacement.payload_assign);
+        new_sinks.push_back(replacement.norm_assign);
+        new_sinks.push_back(replacement.metadata_assign);
+    }
+    transformed_model->add_sinks(new_sinks);
+    transformed_model->validate_nodes_and_infer_types();
+    return {std::move(transformed_model), std::move(manifest)};
+}
+
+GraphTransformResult transform_stateful_kv_graph(std::shared_ptr<ov::Model> model,
+                                                 const TurboQuantConfig& config,
+                                                 const std::string& device) {
+    return transform_stateful_kv_graph_impl(
+        std::move(model), config, device, true);
+}
+
+GraphTransformResult transform_stateful_kv_graph_in_place(
+    std::shared_ptr<ov::Model> model,
+    const TurboQuantConfig& config,
+    const std::string& device) {
+    return transform_stateful_kv_graph_impl(
+        std::move(model), config, device, false);
+}
+
+}  // namespace ov::genai::turboquant
