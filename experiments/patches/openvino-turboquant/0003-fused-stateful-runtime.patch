+std::vector<std::vector<float>> reviewer_adversarial_vectors() {
+    return {
+        {0.0f,
+         -0.0f,
+         1.0f,
+         -1.0f,
+         std::numeric_limits<float>::min(),
+         -std::numeric_limits<float>::min(),
+         4096.0f,
+         -4096.0f},
+        {1.0e-30f, -1.0e-30f, 0.25f, -0.5f, 16.0f, -32.0f, 1.0e15f, -1.0e15f},
+    };
+}
+
+std::vector<float> seeded_magnitude_vector(size_t length, uint32_t seed) {
+    std::vector<float> values;
+    values.reserve(length);
+    uint32_t state = seed;
+    for (size_t index = 0; index < length; ++index) {
+        state ^= state << 13;
+        state ^= state >> 17;
+        state ^= state << 5;
+        const float mantissa = 0.5f + static_cast<float>(state & 0xffffu) / 131070.0f;
+        const int exponent = static_cast<int>((state >> 16) % 161u) - 80;
+        const float sign = (state & 1u) == 0 ? 1.0f : -1.0f;
+        values.push_back(sign * std::ldexp(mantissa, exponent));
+    }
+    return values;
+}
+
+std::vector<uint8_t> scalar_payload_for(const std::vector<std::vector<float>>& sources,
+                                        TurboQuantBits bits) {
+    std::vector<uint8_t> payload;
+    for (const auto& source : sources) {
+        const auto encoded = encode(source, bits);
+        payload.insert(payload.end(), encoded.payload.begin(), encoded.payload.end());
+    }
+    return payload;
+}
+
+std::vector<uint8_t> scalar_norm_bytes_for(const std::vector<std::vector<float>>& sources,
+                                           TurboQuantBits bits) {
+    std::vector<uint8_t> norm_bytes;
+    for (const auto& source : sources) {
+        const auto encoded = encode(source, bits);
+        const size_t offset = norm_bytes.size();
+        norm_bytes.resize(offset + sizeof(encoded.norm));
+        std::memcpy(norm_bytes.data() + offset, &encoded.norm, sizeof(encoded.norm));
+    }
+    return norm_bytes;
+}
+
+std::vector<float> scalar_decode_for(const std::vector<std::vector<float>>& sources,
+                                     TurboQuantBits bits,
+                                     bool norm_correction) {
+    std::vector<float> decoded;
+    for (const auto& source : sources) {
+        const auto encoded = encode(source, bits);
+        const auto row = norm_correction ? decode(encoded) : decode_natural_inverse(encoded);
+        decoded.insert(decoded.end(), row.begin(), row.end());
+    }
+    return decoded;
+}
+
+std::vector<float> scalar_corrected_decode_for(const std::vector<std::vector<float>>& sources,
+                                               TurboQuantBits bits) {
+    return scalar_decode_for(sources, bits, true);
+}
+
+EvaluatedState evaluate_steps(TurboQuantBits bits,
+                              size_t head_dimension,
+                              bool norm_correction,
+                              const std::vector<std::vector<float>>& fresh_vectors) {
+    const auto graph = make_operation(bits, head_dimension, norm_correction);
+    ov::Tensor payload(ov::element::u8, ov::Shape{1, 1, 0, packed_bytes(head_dimension, bits)});
+    ov::Tensor norm(ov::element::f32, ov::Shape{1, 1, 0, 1});
+    ov::Tensor metadata(ov::element::i32, ov::Shape{1, 1, 0, 1});
+    ov::Tensor decoded(ov::element::f32, ov::Shape{1, 1, 0, head_dimension});
+
+    for (const auto& fresh_vector : fresh_vectors) {
+        OPENVINO_ASSERT(fresh_vector.size() == head_dimension, "Test vector has the wrong head dimension");
+        auto fresh =
+            tensor_from_values<float>(ov::element::f32, ov::Shape{1, 1, 1, head_dimension}, fresh_vector);
+        ov::TensorVector inputs{payload, norm, metadata, fresh};
+        auto outputs = sentinel_outputs();
+        OPENVINO_ASSERT(graph.operation->evaluate(outputs, inputs), "TurboQuant operation declined evaluation");
+        payload = outputs[0];
+        norm = outputs[1];
+        metadata = outputs[2];
+        decoded = outputs[3];
+    }
+
+    return {
+        tensor_values<uint8_t>(payload),
+        tensor_bytes(norm),
+        tensor_values<int32_t>(metadata),
+        tensor_values<float>(decoded),
+        payload.get_shape().at(2),
+    };
+}
