+    telemetry.norm_correction = config.norm_correction;
+    telemetry.expected_persistent_standard_bytes = expected_standard_bytes;
+    telemetry.actual_persistent_standard_bytes = actual_standard_bytes;
+    telemetry.expected_persistent_payload_bytes = expected_payload_bytes;
+    telemetry.actual_persistent_payload_bytes = actual_payload_bytes;
+    telemetry.expected_persistent_norm_bytes = expected_norm_bytes;
