+TEST(TurboQuantPipelineActivation, ActivatesEveryRequestedKeyValueSelectionWithoutFallback) {
+    const std::vector<CacheAlgorithm> algorithms{
+        CacheAlgorithm::STANDARD, CacheAlgorithm::TBQ3, CacheAlgorithm::TBQ4};
+    for (const auto key : algorithms) {
+        for (const auto value : algorithms) {
+            if (key == CacheAlgorithm::STANDARD && value == CacheAlgorithm::STANDARD)
+                continue;
+            const auto event = compile_and_generate_fixture_pipeline("CPU", key, value);
+            ASSERT_FALSE(event.empty());
+            EXPECT_EQ(event.at("status"), "activated");
+            EXPECT_EQ(event.at("requested_key_algorithm"), event.at("activated_key_algorithm"));
+            EXPECT_EQ(event.at("requested_value_algorithm"), event.at("activated_value_algorithm"));
+            EXPECT_FALSE(event.at("fallback").get<bool>());
+
+            const auto selected_kinds =
+                static_cast<size_t>(key != CacheAlgorithm::STANDARD) +
+                static_cast<size_t>(value != CacheAlgorithm::STANDARD);
+            const auto operation_count = selected_kinds * kLayerCount;
+            const auto standard_bytes =
+                (static_cast<size_t>(key == CacheAlgorithm::STANDARD) +
+                 static_cast<size_t>(value == CacheAlgorithm::STANDARD)) *
+                128u;
+            const auto payload_bytes_for = [](CacheAlgorithm algorithm) {
+                if (algorithm == CacheAlgorithm::TBQ3)
+                    return size_t{12};
+                if (algorithm == CacheAlgorithm::TBQ4)
+                    return size_t{16};
+                return size_t{0};
+            };
+            EXPECT_EQ(event.at("operation_count"), operation_count);
+            EXPECT_EQ(event.at("matched_state_count"), operation_count);
+            EXPECT_EQ(event.at("actual_persistent_standard_bytes"), standard_bytes);
+            EXPECT_EQ(event.at("actual_persistent_payload_bytes"),
+                      payload_bytes_for(key) + payload_bytes_for(value));
+            EXPECT_EQ(event.at("actual_persistent_norm_bytes"), operation_count * 8u);
+            EXPECT_EQ(event.at("actual_persistent_metadata_bytes"), operation_count * 8u);
+            EXPECT_EQ(event.at("actual_bytes"),
+                      standard_bytes + payload_bytes_for(key) + payload_bytes_for(value) +
+                          operation_count * 16u);
+            EXPECT_EQ(event.at("decoded_scratch_bytes"), operation_count * 64u);
+            EXPECT_EQ(event.at("full_precision_equivalent_bytes"), 256u);
+        }
+    }
+}
