+class CaptureAttributes final : public ov::AttributeVisitor {
+public:
+    using ov::AttributeVisitor::on_adapter;
+
+    void on_adapter(const std::string& name, ov::ValueAccessor<void>&) override {
+        OPENVINO_THROW("Unexpected attribute adapter for ", name);
+    }
+
+    void on_adapter(const std::string& name, ov::ValueAccessor<int64_t>& adapter) override {
+        integers.emplace(name, adapter.get());
+    }
+
+    void on_adapter(const std::string& name, ov::ValueAccessor<bool>& adapter) override {
+        booleans.emplace(name, adapter.get());
+    }
+
+    std::map<std::string, int64_t> integers;
+    std::map<std::string, bool> booleans;
+};
+
+class InvalidBitsAttributes final : public ov::AttributeVisitor {
+public:
+    using ov::AttributeVisitor::on_adapter;
+
+    void on_adapter(const std::string&, ov::ValueAccessor<void>&) override {}
+
+    void on_adapter(const std::string& name, ov::ValueAccessor<int64_t>& adapter) override {
+        if (name == "bits")
+            adapter.set(5);
+    }
+};
