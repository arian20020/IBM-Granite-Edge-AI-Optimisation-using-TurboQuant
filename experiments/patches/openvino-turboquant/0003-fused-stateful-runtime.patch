+TEST(TurboQuantStateUpdateDecode, RejectsMalformedInputsBeforeWritingOutputs) {
+    const auto malformed = malformed_operation_evaluations();
+    ASSERT_EQ(malformed.size(), 17u);
+    for (size_t index = 0; index < malformed.size(); ++index) {
+        SCOPED_TRACE("malformed matrix index " + std::to_string(index));
+        EXPECT_THROW(malformed[index](), ov::Exception);
+    }
+}
