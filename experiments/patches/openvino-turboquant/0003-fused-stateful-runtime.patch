+TEST(TurboQuantPipelineActivation, CpuCachePrecisionPropertiesDoNotChangeObservedStateTensorPrecision) {
+    const std::vector<ov::element::Type> precisions{
+        ov::element::f16,
+        ov::element::u8,
+        ov::element::u4,
+    };
+    for (const auto& precision : precisions) {
+        const ov::AnyMap properties{
+            {ov::key_cache_precision.name(), precision},
+            {ov::value_cache_precision.name(), precision},
+        };
+        auto compiled =
+            ov::genai::utils::singleton_core().compile_model(make_fixture_model(), "CPU", properties);
+        EXPECT_EQ(compiled.get_property(ov::key_cache_precision), precision);
+        EXPECT_EQ(compiled.get_property(ov::value_cache_precision), precision);
+
+        auto request = compiled.create_infer_request();
+        request.set_tensor("input_ids", fixture_tokens());
+        request.set_tensor("attention_mask", fixture_tokens());
+        ov::Tensor beam_idx(ov::element::i32, {1});
+        beam_idx.data<int32_t>()[0] = 0;
+        request.set_tensor("beam_idx", beam_idx);
+        request.infer();
+
+        size_t persistent_bytes = 0;
+        const auto states = request.query_state();
+        ASSERT_EQ(states.size(), kLayerCount * 2u);
+        for (const auto& state : states) {
+            EXPECT_EQ(state.get_state().get_element_type(), ov::element::f32)
+                << "KEY_CACHE_PRECISION/VALUE_CACHE_PRECISION=" << precision
+                << " changed the concrete query_state tensor " << state.get_name();
+            persistent_bytes += state.get_state().get_byte_size();
+        }
+        EXPECT_EQ(persistent_bytes, 256u);
+    }
+}
