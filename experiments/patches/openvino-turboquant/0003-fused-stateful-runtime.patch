+TEST(TurboQuantStatefulGraph, AppendsAndDecodesThreeTokensWithoutFullPrecisionState) {
+    const std::vector<std::vector<float>> key_tokens{
+        {0.25f, -0.5f, 0.75f, -1.0f, 0.125f, 0.5f, -0.25f, 1.0f},
+        {1.0f, 0.5f, 0.25f, 0.125f, -0.125f, -0.25f, -0.5f, -1.0f},
+        {-0.75f, -0.25f, 0.25f, 0.75f, 1.0f, -1.0f, 0.5f, -0.5f},
+    };
+    auto value_tokens = key_tokens;
+    for (auto& token : value_tokens)
+        std::reverse(token.begin(), token.end());
+
+    const auto outputs =
+        run_steps_and_read_sdpa_inputs(CacheAlgorithm::TBQ3, CacheAlgorithm::TBQ4, key_tokens, value_tokens);
+
+    EXPECT_EQ(outputs.decoded_key_shape, (ov::Shape{1, 2, 3, 8}));
+    EXPECT_EQ(outputs.decoded_value_shape, (ov::Shape{1, 2, 3, 8}));
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.key.payload").shape, (ov::Shape{1, 2, 3, 3}));
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.key.norm").shape, (ov::Shape{1, 2, 3, 1}));
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.key.meta").shape, (ov::Shape{1, 2, 3, 1}));
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.value.payload").shape, (ov::Shape{1, 2, 3, 4}));
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.value.norm").shape, (ov::Shape{1, 2, 3, 1}));
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.value.meta").shape, (ov::Shape{1, 2, 3, 1}));
+    EXPECT_EQ(captured_values<int32_t>(outputs.states.at("numerical_sdpa.key.meta")), std::vector<int32_t>(6, 8));
+    EXPECT_EQ(captured_values<int32_t>(outputs.states.at("numerical_sdpa.value.meta")), std::vector<int32_t>(6, 8));
+    EXPECT_FALSE(outputs.states.count("numerical_sdpa.key"));
+    EXPECT_FALSE(outputs.states.count("numerical_sdpa.value"));
+
+    for (size_t offset = 0; offset < outputs.source_key.size(); offset += 8) {
+        const std::vector<float> source_key(outputs.source_key.begin() + offset,
+                                            outputs.source_key.begin() + offset + 8);
+        const std::vector<float> decoded_key(outputs.decoded_key.begin() + offset,
+                                             outputs.decoded_key.begin() + offset + 8);
+        const std::vector<float> source_value(outputs.source_value.begin() + offset,
+                                              outputs.source_value.begin() + offset + 8);
+        const std::vector<float> decoded_value(outputs.decoded_value.begin() + offset,
+                                               outputs.decoded_value.begin() + offset + 8);
+        EXPECT_NEAR(l2_norm(decoded_key), l2_norm(source_key), 1e-5f);
+        EXPECT_NEAR(l2_norm(decoded_value), l2_norm(source_value), 1e-5f);
+        EXPECT_LE(mean_squared_error(source_key, decoded_key), 0.08f);
+        EXPECT_LE(mean_squared_error(source_value, decoded_value), 0.08f);
+    }
+}
