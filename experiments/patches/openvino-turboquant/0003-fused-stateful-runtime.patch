+
 #include "lora/helper.hpp"
 #include "lm_encoding.hpp"
 #include "openvino/genai/text_streamer.hpp"
+#include "openvino/pass/serialize.hpp"
 
 #include "utils.hpp"
 
+namespace {
+
+bool turboquant_requested(const ov::genai::TurboQuantConfig& config) {
+    return config.key_algorithm != ov::genai::CacheAlgorithm::STANDARD ||
+           config.value_algorithm != ov::genai::CacheAlgorithm::STANDARD;
+}
+
+std::shared_ptr<ov::Model> require_model(const std::shared_ptr<ov::Model>& model) {
+    OPENVINO_ASSERT(model, "Model must not be null");
+    return model;
+}
+
+size_t checked_multiply(size_t left, size_t right, const char* description) {
+    OPENVINO_ASSERT(right == 0u || left <= std::numeric_limits<size_t>::max() / right,
+                    "TurboQuant activation byte count overflow for ",
+                    description);
+    return left * right;
+}
+
+size_t checked_add(size_t left, size_t right, const char* description) {
+    OPENVINO_ASSERT(left <= std::numeric_limits<size_t>::max() - right,
+                    "TurboQuant activation byte count overflow for ",
+                    description);
+    return left + right;
+}
+
+std::string requested_plugin_cache_precision(const ov::AnyMap& properties,
+                                             const std::string& property_name) {
+    const auto found = properties.find(property_name);
+    if (found == properties.end())
+        return "plugin_default";
+    return found->second.as<ov::element::Type>().get_type_name();
+}
+
+std::string cache_precision_for_algorithm(ov::genai::CacheAlgorithm algorithm,
+                                          const std::string& standard_precision) {
+    switch (algorithm) {
+    case ov::genai::CacheAlgorithm::STANDARD:
+        OPENVINO_ASSERT(!standard_precision.empty(),
+                        "STANDARD cache precision evidence must not be empty");
+        return standard_precision;
+    case ov::genai::CacheAlgorithm::TBQ3:
+        return "u3";
+    case ov::genai::CacheAlgorithm::TBQ4:
+        return "u4";
+    }
+    OPENVINO_THROW("Invalid TurboQuant cache algorithm enum");
+}
+
+struct RuntimeStateEvidence {
+    size_t bytes;
+    std::string precision;
+};
+
+size_t static_dimension(const ov::PartialShape& shape, size_t axis, const std::string& variable_id) {
+    OPENVINO_ASSERT(shape.rank().is_static() && shape.rank().get_length() == 4,
+                    "TurboQuant manifest state must have rank four: ",
+                    variable_id);
+    OPENVINO_ASSERT(shape[axis].is_static(),
+                    "TurboQuant manifest state has a dynamic fixed dimension: ",
+                    variable_id);
+    return static_cast<size_t>(shape[axis].get_length());
+}
+
+std::string transformed_model_hash(const std::shared_ptr<ov::Model>& model) {
+    std::ostringstream xml;
+    std::ostringstream bin;
+    ov::pass::Serialize serializer(xml, bin);
+    serializer.run_on_model(model);
+    OPENVINO_ASSERT(xml.good() && bin.good() && !xml.str().empty(),
+                    "Failed to serialize transformed TurboQuant model for hashing");
+    return ov::genai::turboquant_model_hash(xml.str() + "\n--turboquant-weights--\n" + bin.str());
+}
+
+std::string actual_execution_device(const ov::CompiledModel& compiled_model) {
+    const auto devices = compiled_model.get_property(ov::execution_devices);
+    OPENVINO_ASSERT(devices.size() == 1u,
+                    "TurboQuant activation requires exactly one execution device, got ",
+                    devices.size());
+    return devices.front();
+}
+
+std::string execution_device_summary(const ov::CompiledModel& compiled_model) {
+    const auto devices = compiled_model.get_property(ov::execution_devices);
+    OPENVINO_ASSERT(!devices.empty(), "Compiled model reported no execution devices");
+    std::ostringstream summary;
+    for (size_t index = 0; index < devices.size(); ++index) {
+        if (index != 0u)
+            summary << ',';
+        summary << devices[index];
+    }
+    return summary.str();
+}
