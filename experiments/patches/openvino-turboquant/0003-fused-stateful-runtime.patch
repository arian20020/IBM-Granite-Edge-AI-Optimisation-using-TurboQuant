+    parameters.push_back(query);
+    return std::make_shared<ov::Model>(
+        ov::ResultVector{std::make_shared<ov::op::v0::Result>(sdpa), std::make_shared<ov::op::v0::Result>(second_read)},
+        ov::SinkVector{key.assign, value.assign},
+        parameters,
+        "multiple_read_values_model");
+}
