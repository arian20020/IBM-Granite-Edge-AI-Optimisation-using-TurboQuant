+    auto token =
+        std::make_shared<ov::op::v0::Parameter>(ov::element::f32, shape.token);
+    token->set_friendly_name(variable_id + ".token");
+    auto variable = std::make_shared<ov::op::util::Variable>(
+        ov::op::util::VariableInfo{
+            shape.variable, ov::element::f32, variable_id});
+    auto read_value =
+        std::make_shared<ov::op::v6::ReadValue>(initial, variable);
+    read_value->set_friendly_name(variable_id + ".read");
+    auto batch_axis =
+        ov::op::v0::Constant::create(ov::element::i64, ov::Shape{}, {0});
+    auto reordered = std::make_shared<ov::op::v8::Gather>(
+        read_value, beam_idx, batch_axis, 0);
+    reordered->set_friendly_name(variable_id + ".cache_reorder");
+    auto update = std::make_shared<ov::op::v0::Concat>(
+        ov::OutputVector{reordered, token}, -2);
+    update->set_friendly_name(variable_id + ".concat");
+    auto assign = std::make_shared<ov::op::v6::Assign>(update, variable);
+    assign->set_friendly_name(variable_id + ".assign");
+    return {variable, read_value, update, assign, {initial, token}};
+}
+
+ov::Output<ov::Node> make_granite_grouped_query_layout(
+    const ov::Output<ov::Node>& state,
+    const ov::Output<ov::Node>& target_shape,
+    const std::string& friendly_name) {
+    auto axes =
+        ov::op::v0::Constant::create(ov::element::i64, ov::Shape{}, {2});
+    auto unsqueeze =
+        std::make_shared<ov::op::v0::Unsqueeze>(state, axes);
+    unsqueeze->set_friendly_name(friendly_name + ".unsqueeze");
+    auto broadcast = std::make_shared<ov::op::v3::Broadcast>(
+        unsqueeze, target_shape, ov::op::BroadcastType::BIDIRECTIONAL);
+    broadcast->set_friendly_name(friendly_name + ".broadcast");
+    auto pattern = ov::op::v0::Constant::create(
+        ov::element::i64, ov::Shape{4}, {0, 4, -1, 8});
+    auto reshape =
+        std::make_shared<ov::op::v1::Reshape>(broadcast, pattern, true);
+    reshape->set_friendly_name(friendly_name + ".reshape");
+    return reshape;
+}
