+
+        OPENVINO_ASSERT(telemetry.attention_path == "stateful_sdpa_standard" &&
+                            telemetry.operation_type == "not_requested" &&
+                            telemetry.transformed_model_hash == "not_requested" &&
+                            telemetry.runtime_layer_type == "not_requested" &&
+                            telemetry.device == "CPU" &&
+                            telemetry.actual_device == "CPU",
+                        "A runtime-observed STANDARD event has an invalid runtime identity");
+        validate_runtime_precision_evidence(telemetry);
+        OPENVINO_ASSERT(telemetry.expected_persistent_standard_bytes > 0u &&
+                            telemetry.expected_persistent_standard_bytes ==
