+struct CapturedTensor {
+    ov::element::Type type;
+    ov::Shape shape;
+    std::vector<uint8_t> bytes;
+};
+
+CapturedTensor capture_tensor(const ov::Tensor& tensor) {
+    CapturedTensor captured{tensor.get_element_type(),
+                            tensor.get_shape(),
+                            std::vector<uint8_t>(tensor.get_byte_size())};
+    if (!captured.bytes.empty())
+        std::memcpy(captured.bytes.data(), tensor.data(), captured.bytes.size());
+    return captured;
+}
+
+template <typename T>
+std::vector<T> captured_values(const CapturedTensor& tensor) {
+    OPENVINO_ASSERT(tensor.bytes.size() % sizeof(T) == 0);
+    std::vector<T> values(tensor.bytes.size() / sizeof(T));
+    if (!values.empty())
+        std::memcpy(values.data(), tensor.bytes.data(), tensor.bytes.size());
+    return values;
+}
