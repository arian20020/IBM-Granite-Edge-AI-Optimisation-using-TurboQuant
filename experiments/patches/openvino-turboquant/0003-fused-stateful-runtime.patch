+GraphSnapshot snapshot_graph(const std::shared_ptr<ov::Model>& model) {
+    GraphSnapshot snapshot;
+    for (const auto& node : model->get_ordered_ops()) {
+        snapshot.nodes.push_back(node.get());
+        snapshot.friendly_names.push_back(node->get_friendly_name());
+        std::vector<std::pair<const ov::Node*, size_t>> sources;
+        for (const auto& input : node->inputs()) {
+            const auto source = input.get_source_output();
+            sources.emplace_back(source.get_node(), source.get_index());
+        }
+        snapshot.input_sources.push_back(std::move(sources));
+    }
+    for (const auto& sink : model->get_sinks())
+        snapshot.sinks.push_back(sink.get());
+    return snapshot;
+}
