+template <typename T>
+ov::Tensor tensor_from_values(const ov::element::Type& type,
+                              const ov::Shape& shape,
+                              const std::vector<T>& values) {
+    OPENVINO_ASSERT(ov::shape_size(shape) == values.size(), "Test tensor value count does not match shape");
+    ov::Tensor tensor(type, shape);
+    if (!values.empty())
+        std::copy(values.begin(), values.end(), tensor.data<T>());
+    return tensor;
+}
+
+template <typename T>
+std::vector<T> tensor_values(const ov::Tensor& tensor) {
+    if (tensor.get_size() == 0)
+        return {};
+    const T* begin = tensor.data<const T>();
+    return {begin, begin + tensor.get_size()};
+}
+
+std::vector<uint8_t> tensor_bytes(const ov::Tensor& tensor) {
+    if (tensor.get_byte_size() == 0)
+        return {};
+    const auto* begin = static_cast<const uint8_t*>(tensor.data());
+    return {begin, begin + tensor.get_byte_size()};
+}
+
+ov::Tensor clone_tensor(const ov::Tensor& source) {
+    ov::Tensor clone(source.get_element_type(), source.get_shape());
+    if (source.get_byte_size() != 0)
+        std::memcpy(clone.data(), source.data(), source.get_byte_size());
+    return clone;
+}
+
+ov::TensorVector sentinel_outputs() {
+    return {
+        ov::Tensor(ov::element::u8, ov::Shape{2}),
+        ov::Tensor(ov::element::f32, ov::Shape{2}),
+        ov::Tensor(ov::element::i32, ov::Shape{2}),
+        ov::Tensor(ov::element::f32, ov::Shape{2}),
+    };
+}
+
+OperationInputs make_operation_with_shapes(TurboQuantBits bits,
+                                           size_t head_dimension,
+                                           bool norm_correction,
+                                           const ov::PartialShape& payload_shape,
+                                           const ov::PartialShape& norm_shape,
+                                           const ov::PartialShape& metadata_shape,
+                                           const ov::PartialShape& fresh_shape,
+                                           const ov::element::Type& payload_type = ov::element::u8,
+                                           const ov::element::Type& norm_type = ov::element::f32,
+                                           const ov::element::Type& metadata_type = ov::element::i32,
+                                           const ov::element::Type& fresh_type = ov::element::f32) {
+    OperationInputs result;
+    result.payload = std::make_shared<Parameter>(payload_type, payload_shape);
+    result.norm = std::make_shared<Parameter>(norm_type, norm_shape);
+    result.metadata = std::make_shared<Parameter>(metadata_type, metadata_shape);
+    result.fresh = std::make_shared<Parameter>(fresh_type, fresh_shape);
+    result.operation = std::make_shared<TurboQuantStateUpdateDecode>(result.payload,
+                                                                     result.norm,
+                                                                     result.metadata,
+                                                                     result.fresh,
+                                                                     bits,
+                                                                     head_dimension,
+                                                                     norm_correction);
+    return result;
+}
+
+OperationInputs make_operation(TurboQuantBits bits,
+                               size_t head_dimension,
+                               bool norm_correction,
+                               size_t batch = 1,
+                               size_t heads = 1) {
+    const auto payload_width = packed_bytes(head_dimension, bits);
+    return make_operation_with_shapes(
+        bits,
+        head_dimension,
+        norm_correction,
+        ov::PartialShape{batch, heads, ov::Dimension::dynamic(), payload_width},
+        ov::PartialShape{batch, heads, ov::Dimension::dynamic(), 1},
+        ov::PartialShape{batch, heads, ov::Dimension::dynamic(), 1},
+        ov::PartialShape{batch, heads, ov::Dimension::dynamic(), head_dimension});
+}
+
+ov::TensorVector valid_runtime_inputs() {
+    const std::vector<float> prior{-3.0f, -1.0f, -0.25f, 0.0f, 0.125f, 0.5f, 2.0f, 8.0f};
+    const std::vector<float> fresh{8.0f, 2.0f, 0.5f, 0.125f, 0.0f, -0.25f, -1.0f, -3.0f};
+    const auto encoded = encode(prior, TurboQuantBits::B3);
+    return {
+        tensor_from_values<uint8_t>(ov::element::u8, ov::Shape{1, 1, 1, encoded.payload.size()}, encoded.payload),
+        tensor_from_values<float>(ov::element::f32, ov::Shape{1, 1, 1, 1}, {encoded.norm}),
+        tensor_from_values<int32_t>(ov::element::i32, ov::Shape{1, 1, 1, 1}, {8}),
+        tensor_from_values<float>(ov::element::f32, ov::Shape{1, 1, 1, 8}, fresh),
+    };
+}
+
+void evaluate_expect_failure_without_output_mutation(const std::shared_ptr<TurboQuantStateUpdateDecode>& operation,
+                                                     const ov::TensorVector& inputs) {
+    auto outputs = sentinel_outputs();
+    std::vector<ov::Shape> original_shapes;
+    for (const auto& output : outputs)
+        original_shapes.push_back(output.get_shape());
+
+    try {
+        operation->evaluate(outputs, inputs);
+    } catch (...) {
+        for (size_t index = 0; index < outputs.size(); ++index)
+            EXPECT_EQ(outputs[index].get_shape(), original_shapes[index]);
+        throw;
+    }
+    FAIL() << "Malformed evaluation unexpectedly succeeded";
+}
