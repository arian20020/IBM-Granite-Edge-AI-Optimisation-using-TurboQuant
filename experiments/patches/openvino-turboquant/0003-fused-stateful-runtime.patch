+void expect_graph_matches_scalar_codec(CacheAlgorithm algorithm,
+                                       TurboQuantBits bits,
+                                       const std::vector<std::vector<float>>& sources) {
+    ASSERT_FALSE(sources.empty());
+    const auto head_dimension = sources.front().size();
+    ASSERT_GT(head_dimension, 0u);
+    ASSERT_TRUE(std::all_of(sources.begin(), sources.end(), [head_dimension](const std::vector<float>& source) {
+        return source.size() == head_dimension;
+    }));
+
+    std::vector<std::vector<float>> value_sources;
+    value_sources.reserve(sources.size());
+    for (const auto& source : sources) {
+        auto value_source = source;
+        std::reverse(value_source.begin(), value_source.end());
+        for (auto& value : value_source)
+            value = -value;
+        if (value_source == source)
+            value_source.front() = source.front() == 0.0f ? 1.0f : -source.front();
+        ASSERT_NE(value_source, source);
+        value_sources.push_back(std::move(value_source));
+    }
+    ASSERT_NE(value_sources, sources);
+
+    struct ScalarCodecOracle {
+        std::vector<uint8_t> payload;
+        std::vector<uint8_t> norm_bytes;
+        std::vector<float> decoded;
+    };
+    const auto make_oracle = [bits](const std::vector<std::vector<float>>& source_rows) {
+        std::vector<uint8_t> payload_for_one_head;
+        std::vector<float> norms_for_one_head;
+        std::vector<std::vector<float>> decoded_for_one_head;
+        for (const auto& source : source_rows) {
+            const auto encoded = encode(source, bits);
+            payload_for_one_head.insert(payload_for_one_head.end(), encoded.payload.begin(), encoded.payload.end());
+            norms_for_one_head.push_back(encoded.norm);
+            decoded_for_one_head.push_back(decode(encoded));
+        }
+
+        ScalarCodecOracle oracle;
+        std::vector<float> expected_norms;
+        for (size_t head = 0; head < 2; ++head) {
+            oracle.payload.insert(oracle.payload.end(), payload_for_one_head.begin(), payload_for_one_head.end());
+            expected_norms.insert(expected_norms.end(), norms_for_one_head.begin(), norms_for_one_head.end());
+        }
+        oracle.norm_bytes.resize(expected_norms.size() * sizeof(float));
+        std::memcpy(oracle.norm_bytes.data(), expected_norms.data(), oracle.norm_bytes.size());
+        oracle.decoded = repeat_for_heads(decoded_for_one_head, 2);
+        return oracle;
+    };
+
+    const auto key_oracle = make_oracle(sources);
+    const auto value_oracle = make_oracle(value_sources);
+    ASSERT_NE(key_oracle.payload, value_oracle.payload);
+    ASSERT_NE(key_oracle.decoded, value_oracle.decoded);
+    const auto outputs =
+        run_steps_and_read_sdpa_inputs(algorithm, algorithm, sources, value_sources, true, head_dimension);
+    ASSERT_NE(outputs.source_key, outputs.source_value);
+
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.key.payload").bytes, key_oracle.payload);
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.key.norm").bytes, key_oracle.norm_bytes);
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.value.payload").bytes, value_oracle.payload);
+    EXPECT_EQ(outputs.states.at("numerical_sdpa.value.norm").bytes, value_oracle.norm_bytes);
+    EXPECT_EQ(outputs.decoded_key, key_oracle.decoded);
+    EXPECT_EQ(outputs.decoded_value, value_oracle.decoded);
+}
+
+std::vector<std::vector<float>> make_seeded_magnitude_vectors(size_t head_dimension, uint32_t seed) {
+    std::mt19937 generator(seed);
+    const std::array<int, 4> exponents{-145, -80, 0, 120};
+    std::vector<std::vector<float>> sources;
+    sources.reserve(exponents.size() + 1);
+    for (const auto exponent : exponents) {
+        std::vector<float> source;
+        source.reserve(head_dimension);
+        for (size_t index = 0; index < head_dimension; ++index) {
+            const auto random = generator();
+            const float mantissa = 1.0f + 0.75f * static_cast<float>(random & 0xffffu) / 65535.0f;
+            const float sign = (random & 0x10000u) == 0u ? -1.0f : 1.0f;
+            source.push_back(sign * std::ldexp(mantissa, exponent));
+        }
+        sources.push_back(std::move(source));
+    }
+
+    std::vector<float> mixed;
+    mixed.reserve(head_dimension);
+    for (size_t index = 0; index < head_dimension; ++index) {
+        const auto random = generator();
+        const float mantissa = 1.0f + 0.75f * static_cast<float>(random & 0xffffu) / 65535.0f;
+        const float sign = (random & 0x10000u) == 0u ? -1.0f : 1.0f;
+        mixed.push_back(sign * std::ldexp(mantissa, exponents[index % exponents.size()]));
+    }
+    sources.push_back(std::move(mixed));
+    return sources;
+}
