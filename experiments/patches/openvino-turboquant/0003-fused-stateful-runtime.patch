+struct TemporaryModelDirectory {
+    TemporaryModelDirectory() {
+        path = std::filesystem::temp_directory_path() /
+               ("turboquant-pipeline-" +
+                std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+        std::filesystem::create_directories(path);
+        ov::pass::Serialize serializer(path / "openvino_model.xml", path / "openvino_model.bin");
+        serializer.run_on_model(make_fixture_model());
+        std::ofstream config(path / "generation_config.json", std::ios::binary);
+        config << R"({"eos_token_id":3,"max_new_tokens":1})";
+        config.close();
+        OPENVINO_ASSERT(config.good(), "Failed to write fixture generation_config.json");
+    }
+    ~TemporaryModelDirectory() {
+        std::error_code ignored;
+        std::filesystem::remove_all(path, ignored);
+    }
+    std::filesystem::path path;
+};
