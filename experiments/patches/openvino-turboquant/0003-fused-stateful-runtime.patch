+struct GraphSnapshot {
+    std::vector<const ov::Node*> nodes;
+    std::vector<std::string> friendly_names;
+    std::vector<std::vector<std::pair<const ov::Node*, size_t>>> input_sources;
+    std::vector<const ov::Node*> sinks;
+
+    bool operator==(const GraphSnapshot& other) const {
+        return nodes == other.nodes && friendly_names == other.friendly_names && input_sources == other.input_sources &&
+               sinks == other.sinks;
+    }
+};
