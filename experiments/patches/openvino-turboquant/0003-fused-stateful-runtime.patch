+NumericalOutputs run_one_step_and_read_sdpa_inputs(CacheAlgorithm algorithm) {
+    const std::vector<float> source{0.25f, -0.5f, 0.75f, -1.0f, 0.125f, 0.5f, -0.25f, 1.0f};
+    return run_steps_and_read_sdpa_inputs(algorithm, algorithm, {source}, {source});
+}
