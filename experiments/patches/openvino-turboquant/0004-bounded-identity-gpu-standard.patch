+std::string transformed_model_identity(
+    const GraphTransformManifest& manifest,
+    const std::string& source_model_hash,
+    const std::string& build_commit) {
+    OPENVINO_ASSERT(!source_model_hash.empty(),
+                    "TurboQuant transformed-model identity requires a source-model hash");
+    OPENVINO_ASSERT(!build_commit.empty(),
+                    "TurboQuant transformed-model identity requires a build commit");
+
+    const auto field = [](std::ostringstream& output,
+                          const std::string& name,
+                          const std::string& value) {
+        output << name.size() << ':' << name << '='
+               << value.size() << ':' << value << '\n';
+    };
+    std::ostringstream canonical;
+    field(canonical, "schema", "turboquant-transform-manifest/v1");
+    field(canonical, "source_model_hash", source_model_hash);
+    field(canonical, "build_commit", build_commit);
+    field(canonical, "device", manifest.device);
+    canonical << "activated=" << (manifest.activated ? 1 : 0) << '\n'
+              << "state_count=" << manifest.states.size() << '\n';
+    for (const auto& state : manifest.states) {
+        canonical << "state\n";
+        field(canonical, "variable_id", state.variable_id);
+        canonical << "layer_index=" << state.layer_index << '\n'
+                  << "kind=" << static_cast<unsigned int>(state.kind) << '\n'
+                  << "algorithm="
+                  << static_cast<unsigned int>(state.algorithm) << '\n';
+        field(canonical,
+              "original_type",
+              state.original_type.get_type_name());
+        field(canonical,
+              "original_shape",
+              state.original_shape.to_string());
+        field(canonical,
+              "payload_shape",
+              state.payload_shape.to_string());
+        canonical << "head_dimension=" << state.head_dimension << '\n'
+                  << "packed_bytes_per_vector="
+                  << state.packed_bytes_per_vector << '\n'
+                  << "norm_bytes_per_vector="
+                  << state.norm_bytes_per_vector << '\n'
+                  << "metadata_bytes_per_vector="
+                  << state.metadata_bytes_per_vector << '\n'
+                  << "scratch_bytes_upper_bound="
+                  << state.scratch_bytes_upper_bound << '\n';
+    }
+    std::uint64_t hash = 14695981039346656037ULL;
+    const auto bytes = canonical.str();
+    for (const unsigned char byte : bytes) {
+        hash ^= byte;
+        hash *= 1099511628211ULL;
+    }
+    static constexpr char HEX[] = "0123456789abcdef";
+    std::string result(16, '0');
+    for (size_t index = result.size(); index-- > 0;) {
+        result[index] = HEX[hash & 0x0f];
+        hash >>= 4u;
+    }
+    return result;
+}
+
 }  // namespace ov::genai::turboquant
