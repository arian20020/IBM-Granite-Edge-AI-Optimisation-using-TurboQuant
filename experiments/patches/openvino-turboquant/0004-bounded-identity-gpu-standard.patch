+TEST(TurboQuantPipelineActivation, GpuStandardModelReportsObservedStateOnlyAfterGeneration) {
+    const auto available_devices = ov::genai::utils::singleton_core().get_available_devices();
+    if (std::none_of(available_devices.begin(), available_devices.end(), [](const std::string& device) {
+            return device.rfind("GPU", 0) == 0;
+        })) {
+        GTEST_SKIP() << "No OpenVINO GPU device is available";
+    }
+
+    ClogCapture capture;
+    StatefulLLMPipeline pipeline(make_fixture_model(),
+                                 Tokenizer{},
+                                 "GPU",
+                                 {},
+                                 fixture_generation_config(),
+                                 TurboQuantConfig{},
+                                 "fixture-model-hash");
+    EXPECT_TRUE(activation_events(capture.str()).empty())
+        << "GPU STANDARD telemetry must not claim runtime state before generation";
+
+    const auto result =
+        pipeline.generate(EncodedInputs{fixture_tokens()}, std::nullopt, StreamerVariant{std::monostate{}});
+    ASSERT_EQ(result.tokens.size(), 1u);
+    ASSERT_EQ(result.tokens.front().size(), 1u);
+
+    const auto events = activation_events(capture.str());
+    ASSERT_EQ(events.size(), 1u);
+    const auto& event = events.front();
+    EXPECT_EQ(event.at("status"), "not_requested");
+    EXPECT_EQ(event.at("attention_path"), "stateful_sdpa_standard");
+    EXPECT_EQ(event.at("device"), "GPU");
+    EXPECT_EQ(event.at("actual_device").get<std::string>().rfind("GPU", 0), 0u);
+    EXPECT_NE(event.at("observed_key_state_precision"), "not_requested");
+    EXPECT_NE(event.at("observed_value_state_precision"), "not_requested");
+    EXPECT_GT(event.at("actual_persistent_standard_bytes").get<size_t>(), 0u);
+    EXPECT_EQ(event.at("expected_persistent_standard_bytes"),
+              event.at("actual_persistent_standard_bytes"));
+    EXPECT_EQ(event.at("expected_bytes"), event.at("actual_bytes"));
+    EXPECT_EQ(event.at("full_precision_equivalent_bytes"), event.at("actual_bytes"));
+}
