+TEST(TurboQuantStatefulGraph, HashesSourceAndCanonicalManifestWithoutModelSerialization) {
+    const auto transformed =
+        transform_stateful_kv_graph(make_two_layer_stateful_sdpa_model(),
+                                    {CacheAlgorithm::TBQ3, CacheAlgorithm::TBQ4, true},
+                                    "CPU");
+    const std::string source_hash = "source-artifact-hash";
+    const std::string build_commit = "0123456789abcdef0123456789abcdef01234567";
+    const auto identity =
+        ov::genai::turboquant::transformed_model_identity(
+            transformed.manifest, source_hash, build_commit);
+
+    EXPECT_EQ(identity.size(), 16u);
+    EXPECT_EQ(identity.find_first_not_of("0123456789abcdef"), std::string::npos);
+    EXPECT_EQ(identity,
+              ov::genai::turboquant::transformed_model_identity(
+                  transformed.manifest, source_hash, build_commit));
+
+    auto changed_manifest = transformed.manifest;
+    ++changed_manifest.states.front().packed_bytes_per_vector;
+    EXPECT_NE(identity,
+              ov::genai::turboquant::transformed_model_identity(
+                  changed_manifest, source_hash, build_commit));
+    EXPECT_NE(identity,
+              ov::genai::turboquant::transformed_model_identity(
+                  transformed.manifest, "different-source-artifact-hash", build_commit));
+    EXPECT_NE(identity,
+              ov::genai::turboquant::transformed_model_identity(
+                  transformed.manifest,
+                  source_hash,
+                  "1123456789abcdef0123456789abcdef01234567"));
+}
