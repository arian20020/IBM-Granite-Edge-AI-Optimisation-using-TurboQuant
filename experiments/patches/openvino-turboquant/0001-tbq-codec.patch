@@ -0,0 +1,151 @@
+// Copyright (C) 2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+#include "turboquant_codec.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace ov::genai::turboquant {
+namespace {
+
+// Deterministic scalar centroids for a unit-normal input.  These fixed tables
+// are the reconstruction levels at the midpoints of 8 and 16 equal-probability
+// standard-normal bins (rounded once here, never learned at runtime).
+constexpr std::array<float, 8> codebook_b3{
+    -1.5341206f, -0.8871466f, -0.4887764f, -0.1573107f,
+     0.1573107f,  0.4887764f,  0.8871466f,  1.5341206f,
+};
+
+constexpr std::array<float, 16> codebook_b4{
+    -1.8627319f, -1.3180109f, -1.0099902f, -0.7764218f,
+    -0.5791322f, -0.4022501f, -0.2372021f, -0.0784124f,
+     0.0784124f,  0.2372021f,  0.4022501f,  0.5791322f,
+     0.7764218f,  1.0099902f,  1.3180109f,  1.8627319f,
+};
+
+unsigned bit_width(TurboQuantBits bits) {
+    switch (bits) {
+    case TurboQuantBits::B3:
+        return 3;
+    case TurboQuantBits::B4:
+        return 4;
+    }
+    throw std::invalid_argument("TurboQuant bit width must be 3 or 4");
+}
+
+float centroid(TurboQuantBits bits, uint8_t index) {
+    return bits == TurboQuantBits::B3 ? codebook_b3[index] : codebook_b4[index];
+}
+
+uint8_t nearest_centroid(float value, TurboQuantBits bits) {
+    const size_t count = size_t{1} << bit_width(bits);
+    uint8_t best = 0;
+    float best_distance = std::abs(value - centroid(bits, 0));
+    for (size_t i = 1; i < count; ++i) {
+        const float distance = std::abs(value - centroid(bits, static_cast<uint8_t>(i)));
+        if (distance < best_distance) {
+            best = static_cast<uint8_t>(i);
+            best_distance = distance;
+        }
+    }
+    return best;
+}
+
+double stable_norm(const std::vector<float>& values) {
+    double norm = 0.0;
+    for (const float value : values)
+        norm = std::hypot(norm, static_cast<double>(value));
+    return norm;
+}
+
+void pack_index(std::vector<uint8_t>& payload, size_t position, unsigned width, uint8_t index) {
+    const size_t bit_offset = position * width;
+    const size_t byte_offset = bit_offset / 8;
+    const unsigned shift = static_cast<unsigned>(bit_offset % 8);
+    const uint16_t shifted = static_cast<uint16_t>(index) << shift;
+    payload[byte_offset] |= static_cast<uint8_t>(shifted);
+    if (shift + width > 8)
+        payload[byte_offset + 1] |= static_cast<uint8_t>(shifted >> 8);
+}
+
+uint8_t unpack_index(const std::vector<uint8_t>& payload, size_t position, unsigned width) {
+    const size_t bit_offset = position * width;
+    const size_t byte_offset = bit_offset / 8;
+    const unsigned shift = static_cast<unsigned>(bit_offset % 8);
+    uint16_t packed = payload[byte_offset];
+    if (shift + width > 8)
+        packed |= static_cast<uint16_t>(payload[byte_offset + 1]) << 8;
+    return static_cast<uint8_t>((packed >> shift) & ((uint16_t{1} << width) - 1));
+}
+
+}  // namespace
+
+size_t packed_bytes(size_t element_count, TurboQuantBits bits) {
+    const unsigned width = bit_width(bits);
+    if (element_count > (std::numeric_limits<size_t>::max() - 7) / width)
+        throw std::length_error("TurboQuant packed size overflows size_t");
+    return (element_count * width + 7) / 8;
+}
+
+EncodedVector encode(const std::vector<float>& input, TurboQuantBits bits) {
+    const unsigned width = bit_width(bits);
+    for (const float value : input) {
+        if (!std::isfinite(value))
+            throw std::invalid_argument("TurboQuant input values must be finite");
+    }
+
+    const double norm = stable_norm(input);
+    if (norm > std::numeric_limits<float>::max())
+        throw std::invalid_argument("TurboQuant input norm is not representable");
+
+    EncodedVector encoded{bits, input.size(), static_cast<float>(norm),
+                          std::vector<uint8_t>(packed_bytes(input.size(), bits), 0)};
+    if (norm == 0.0)
+        return encoded;
+
+    const double normalization = std::sqrt(static_cast<double>(input.size())) / norm;
+    for (size_t i = 0; i < input.size(); ++i)
+        pack_index(encoded.payload, i, width, nearest_centroid(static_cast<float>(input[i] * normalization), bits));
+    return encoded;
+}
+
+std::vector<float> decode(const EncodedVector& encoded) {
+    const unsigned width = bit_width(encoded.bits);
+    if (!std::isfinite(encoded.norm) || encoded.norm < 0.0f)
+        throw std::invalid_argument("TurboQuant norm must be finite and non-negative");
+    if (encoded.payload.size() != packed_bytes(encoded.element_count, encoded.bits))
+        throw std::invalid_argument("TurboQuant payload size does not match metadata");
+    if (encoded.element_count == 0 && encoded.norm != 0.0f)
+        throw std::invalid_argument("An empty TurboQuant vector must have zero norm");
+
+    const size_t used_bits = encoded.element_count * width;
+    if (!encoded.payload.empty() && used_bits % 8 != 0) {
+        const uint8_t unused_mask = static_cast<uint8_t>(0xffu << (used_bits % 8));
+        if ((encoded.payload.back() & unused_mask) != 0)
+            throw std::invalid_argument("TurboQuant payload has non-zero padding bits");
+    }
+
+    std::vector<float> output(encoded.element_count, 0.0f);
+    if (encoded.norm == 0.0f) {
+        if (std::any_of(encoded.payload.begin(), encoded.payload.end(), [](uint8_t byte) { return byte != 0; }))
+            throw std::invalid_argument("A zero-norm TurboQuant vector must have a zero payload");
+        return output;
+    }
+
+    for (size_t i = 0; i < output.size(); ++i)
+        output[i] = centroid(encoded.bits, unpack_index(encoded.payload, i, width));
+
+    const double quantized_norm = stable_norm(output);
+    if (quantized_norm == 0.0)
+        throw std::invalid_argument("TurboQuant payload cannot restore a non-zero norm");
+    const double restoration = static_cast<double>(encoded.norm) / quantized_norm;
+    for (float& value : output)
+        value = static_cast<float>(value * restoration);
+    return output;
+}
+
+}  // namespace ov::genai::turboquant
diff --git a/src/cpp/src/continuous_batching/cache/turboquant_codec.hpp b/src/cpp/src/continuous_batching/cache/turboquant_codec.hpp
