+// Copyright (C) 2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ov::genai::turboquant {
+
+enum class TurboQuantBits : uint8_t {
+    B3 = 3,
+    B4 = 4,
+};
+
+struct EncodedVector {
+    TurboQuantBits bits = TurboQuantBits::B3;
+    size_t element_count = 0;
+    float norm = 0.0f;
+    std::vector<uint8_t> payload;
+};
+
+size_t packed_bytes(size_t element_count, TurboQuantBits bits);
+EncodedVector encode(const std::vector<float>& input, TurboQuantBits bits);
+std::vector<float> decode(const EncodedVector& encoded);
+
+}  // namespace ov::genai::turboquant
