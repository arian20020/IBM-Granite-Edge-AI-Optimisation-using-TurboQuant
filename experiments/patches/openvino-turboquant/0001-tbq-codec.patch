diff --git a/tests/cpp/turboquant_codec.cpp b/tests/cpp/turboquant_codec.cpp
new file mode 100644
index 0000000..987ab81
--- /dev/null
+++ b/tests/cpp/turboquant_codec.cpp
@@ -0,0 +1,99 @@
+// Copyright (C) 2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+#include "continuous_batching/cache/turboquant_codec.hpp"
+
+#include <gtest/gtest.h>
+
+#include <cmath>
+#include <limits>
+#include <vector>
+
+namespace {
+
+using ov::genai::turboquant::EncodedVector;
+using ov::genai::turboquant::TurboQuantBits;
+using ov::genai::turboquant::decode;
+using ov::genai::turboquant::encode;
+using ov::genai::turboquant::packed_bytes;
+
+float l2_norm(const std::vector<float>& values) {
+    double squared_norm = 0.0;
+    for (const float value : values)
+        squared_norm += static_cast<double>(value) * value;
+    return static_cast<float>(std::sqrt(squared_norm));
+}
+
+float normalized_rmse(const std::vector<float>& expected, const std::vector<float>& actual) {
+    double squared_error = 0.0;
+    double squared_signal = 0.0;
+    for (size_t i = 0; i < expected.size(); ++i) {
+        const double error = static_cast<double>(expected[i]) - actual[i];
+        squared_error += error * error;
+        squared_signal += static_cast<double>(expected[i]) * expected[i];
+    }
+    return static_cast<float>(std::sqrt(squared_error / squared_signal));
+}
+
+TEST(TurboQuantCodec, RoundTripPreservesNormAndPackedSize) {
+    const std::vector<float> input{0.25f, -0.5f, 0.75f, -1.0f, 0.125f, 0.5f, -0.25f, 1.0f};
+    for (const auto bits : {TurboQuantBits::B3, TurboQuantBits::B4}) {
+        const auto encoded = encode(input, bits);
+        const auto output = decode(encoded);
+        EXPECT_EQ(encoded.payload.size(), packed_bytes(input.size(), bits));
+        EXPECT_NEAR(l2_norm(input), l2_norm(output), 1e-5f);
+        EXPECT_LT(normalized_rmse(input, output), bits == TurboQuantBits::B4 ? 0.20f : 0.35f);
+    }
+}
+
+TEST(TurboQuantCodec, ZeroVectorRoundTripsWithoutDivisionByZero) {
+    for (const auto bits : {TurboQuantBits::B3, TurboQuantBits::B4}) {
+        const auto encoded = encode(std::vector<float>(11, 0.0f), bits);
+        EXPECT_FLOAT_EQ(encoded.norm, 0.0f);
+        EXPECT_EQ(decode(encoded), std::vector<float>(11, 0.0f));
+    }
+}
+
+TEST(TurboQuantCodec, PacksNonByteAlignedLengthsExactly) {
+    EXPECT_EQ(packed_bytes(1, TurboQuantBits::B3), 1u);
+    EXPECT_EQ(packed_bytes(3, TurboQuantBits::B3), 2u);
+    EXPECT_EQ(packed_bytes(9, TurboQuantBits::B3), 4u);
+    EXPECT_EQ(packed_bytes(1, TurboQuantBits::B4), 1u);
+    EXPECT_EQ(packed_bytes(3, TurboQuantBits::B4), 2u);
+}
+
+TEST(TurboQuantCodec, ProducesDeterministicGoldenLittleEndianPayloads) {
+    const std::vector<float> input{-1.0f, 0.0f, 1.0f};
+    const auto b3_first = encode(input, TurboQuantBits::B3);
+    const auto b3_second = encode(input, TurboQuantBits::B3);
+    EXPECT_EQ(b3_first.payload, (std::vector<uint8_t>{0xd8, 0x01}));
+    EXPECT_EQ(b3_first.payload, b3_second.payload);
+
+    const auto b4_first = encode(input, TurboQuantBits::B4);
+    const auto b4_second = encode(input, TurboQuantBits::B4);
+    EXPECT_EQ(b4_first.payload, (std::vector<uint8_t>{0x71, 0x0e}));
+    EXPECT_EQ(b4_first.payload, b4_second.payload);
+}
+
+TEST(TurboQuantCodec, RejectsInvalidMetadataAndInput) {
+    EXPECT_THROW(encode({1.0f}, static_cast<TurboQuantBits>(5)), std::invalid_argument);
+    EXPECT_THROW(encode({std::numeric_limits<float>::infinity()}, TurboQuantBits::B3), std::invalid_argument);
+
+    auto encoded = encode({-1.0f, 1.0f}, TurboQuantBits::B3);
+    encoded.bits = static_cast<TurboQuantBits>(2);
+    EXPECT_THROW(decode(encoded), std::invalid_argument);
+
+    encoded = encode({-1.0f, 1.0f}, TurboQuantBits::B3);
+    encoded.payload.clear();
+    EXPECT_THROW(decode(encoded), std::invalid_argument);
+
+    encoded = encode({-1.0f, 1.0f}, TurboQuantBits::B3);
+    encoded.norm = std::numeric_limits<float>::quiet_NaN();
+    EXPECT_THROW(decode(encoded), std::invalid_argument);
+
+    encoded = encode({-1.0f}, TurboQuantBits::B3);
+    encoded.payload.back() |= 0xf8;
+    EXPECT_THROW(decode(encoded), std::invalid_argument);
+}
+
+}  // namespace
