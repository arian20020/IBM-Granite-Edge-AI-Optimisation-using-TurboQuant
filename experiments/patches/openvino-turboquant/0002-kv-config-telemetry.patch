+    if type(record["norm_correction"]) is not bool or type(record["fallback"]) is not bool:
+        raise ValueError("flags")
+    if any(type(record[name]) is not int or record[name] < 0 for name in ("expected_bytes", "actual_bytes")):
+        raise ValueError("bytes")
+    if any(type(record[name]) is not str or not record[name] or len(record[name].encode()) > 1024
+           for name in ("attention_path", "device", "build_commit", "model_hash")):
+        raise ValueError("text")
+    if len(record["build_commit"]) != 40:
+        raise ValueError("build commit")
