+    out << '{'
+        << "\"requested_key_algorithm\":\"" << algorithm_name(telemetry.requested_key_algorithm) << "\","
+        << "\"requested_value_algorithm\":\"" << algorithm_name(telemetry.requested_value_algorithm) << "\","
+        << "\"activated_key_algorithm\":\"" << algorithm_name(telemetry.activated_key_algorithm) << "\","
+        << "\"activated_value_algorithm\":\"" << algorithm_name(telemetry.activated_value_algorithm) << "\","
+        << "\"norm_correction\":" << (telemetry.norm_correction ? "true" : "false") << ','
+        << "\"expected_bytes\":" << telemetry.expected_bytes << ','
+        << "\"actual_bytes\":" << telemetry.actual_bytes << ','
+        << "\"attention_path\":" << json_string(telemetry.attention_path) << ','
+        << "\"device\":" << json_string(telemetry.device) << ','
+        << "\"fallback\":" << (telemetry.fallback ? "true" : "false") << ','
+        << "\"build_commit\":" << json_string(telemetry.build_commit) << ','
+        << "\"model_hash\":" << json_string(telemetry.model_hash) << '}';
+    auto result = out.str();
+    OPENVINO_ASSERT(result.size() <= 4096, "TurboQuant activation telemetry exceeds 4096 bytes");
+    return result;
+}
+
+std::string turboquant_build_commit() {
+#ifdef OV_GENAI_TURBOQUANT_BUILD_COMMIT
+    return OV_GENAI_TURBOQUANT_BUILD_COMMIT;
+#else
+    OPENVINO_THROW("TurboQuant build commit was not embedded");
+#endif
+}
+
+std::string inactive_activation_telemetry_json(const TurboQuantConfig& config,
+                                               const std::string& device,
+                                               const std::string& build_commit,
+                                               const std::string& model_hash) {
+    OPENVINO_ASSERT(build_commit.size() == 40, "TurboQuant build commit must be an exact 40-character Git ID");
+    OPENVINO_ASSERT(!model_hash.empty(), "TurboQuant model hash must not be empty");
+    ActivationTelemetry telemetry;
+    telemetry.requested_key_algorithm = config.key_algorithm;
+    telemetry.requested_value_algorithm = config.value_algorithm;
+    telemetry.norm_correction = config.norm_correction;
+    telemetry.attention_path = "not_activated";
+    telemetry.device = device;
+    telemetry.fallback = config.key_algorithm != CacheAlgorithm::STANDARD ||
+                         config.value_algorithm != CacheAlgorithm::STANDARD;
+    telemetry.build_commit = build_commit;
+    telemetry.model_hash = model_hash;
+    return activation_telemetry_json(telemetry);
+}
+
+namespace {
+void fnv1a_update(std::uint64_t& hash, const char* data, std::size_t size) {
+    for (std::size_t i = 0; i < size; ++i) {
+        hash ^= static_cast<unsigned char>(data[i]);
+        hash *= 1099511628211ULL;
+    }
+}
+
+std::string fnv1a_hex(std::uint64_t hash) {
+    std::ostringstream out;
+    out << std::hex << std::setfill('0') << std::setw(16) << hash;
+    return out.str();
+}
+}  // namespace
+
+std::string turboquant_model_hash(const std::string& model_xml) {
+    std::uint64_t hash = 14695981039346656037ULL;
+    fnv1a_update(hash, model_xml.data(), model_xml.size());
+    return fnv1a_hex(hash);
+}
+
+std::string turboquant_model_hash(const std::filesystem::path& model_path) {
+    std::vector<std::filesystem::path> files;
+    if (std::filesystem::is_regular_file(model_path)) {
+        files.push_back(model_path);
+    } else {
+        for (const auto& entry : std::filesystem::recursive_directory_iterator(model_path)) {
+            if (entry.is_regular_file()) files.push_back(entry.path());
+        }
+    }
+    std::sort(files.begin(), files.end());
+    OPENVINO_ASSERT(!files.empty(), "Cannot hash an empty model path");
+    std::uint64_t hash = 14695981039346656037ULL;
+    std::vector<char> buffer(64 * 1024);
+    for (const auto& file : files) {
+        const auto relative = std::filesystem::relative(file, model_path).generic_string();
+        fnv1a_update(hash, relative.data(), relative.size());
+        std::ifstream stream(file, std::ios::binary);
+        OPENVINO_ASSERT(stream, "Cannot read model file for hashing: ", file.string());
+        while (stream) {
+            stream.read(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+            fnv1a_update(hash, buffer.data(), static_cast<std::size_t>(stream.gcount()));
+        }
+    }
+    return fnv1a_hex(hash);
+}
+
+}  // namespace ov::genai
