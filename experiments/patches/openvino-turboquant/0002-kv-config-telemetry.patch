--- /dev/null
+++ b/tests/python/test_turboquant_activation_schema.py
@@ -0,0 +1,14 @@
+import json, unittest
+REQUIRED={"requested_key_algorithm","requested_value_algorithm","activated_key_algorithm","activated_value_algorithm","norm_correction","expected_bytes","actual_bytes","attention_path","device","fallback","build_commit","model_hash"}
+def validate_activation_record(r):
+ if set(r)!=REQUIRED: raise ValueError("activation record fields differ from schema")
+ for n in ("requested_key_algorithm","requested_value_algorithm","activated_key_algorithm","activated_value_algorithm"):
+  if r[n] not in {"STANDARD","TBQ3","TBQ4"}: raise ValueError(n)
+ if type(r["norm_correction"]) is not bool or type(r["fallback"]) is not bool: raise ValueError("flags")
+ if any(type(r[n]) is not int or r[n]<0 for n in ("expected_bytes","actual_bytes")): raise ValueError("bytes")
+ if any(type(r[n]) is not str or len(r[n].encode())>1024 for n in ("attention_path","device","build_commit","model_hash")): raise ValueError("text")
+class Tests(unittest.TestCase):
+ def test_fixture(self): validate_activation_record(json.loads('{"requested_key_algorithm":"TBQ3","requested_value_algorithm":"TBQ4","activated_key_algorithm":"STANDARD","activated_value_algorithm":"STANDARD","norm_correction":true,"expected_bytes":123,"actual_bytes":0,"attention_path":"not_activated","device":"CPU","fallback":true,"build_commit":"0123456789abcdef0123456789abcdef01234567","model_hash":"abcdef"}'))
+ def test_extra(self):
+  with self.assertRaises(ValueError): validate_activation_record({"unexpected":True})
+if __name__=="__main__": unittest.main()
