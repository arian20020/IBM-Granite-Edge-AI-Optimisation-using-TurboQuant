+++ b/src/cpp/include/openvino/genai/turboquant_config.hpp
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstddef>
+#include <string>
+#include "openvino/core/any.hpp"
+namespace ov::genai {
+inline constexpr const char* TURBOQUANT_KEY_ALGORITHM="TURBOQUANT_KEY_ALGORITHM";
+inline constexpr const char* TURBOQUANT_VALUE_ALGORITHM="TURBOQUANT_VALUE_ALGORITHM";
+inline constexpr const char* TURBOQUANT_NORM_CORRECTION="TURBOQUANT_NORM_CORRECTION";
+enum class CacheAlgorithm { STANDARD, TBQ3, TBQ4 };
+struct TurboQuantConfig { CacheAlgorithm key_algorithm=CacheAlgorithm::STANDARD; CacheAlgorithm value_algorithm=CacheAlgorithm::STANDARD; bool norm_correction=false; };
+TurboQuantConfig parse_turboquant_config(ov::AnyMap& properties);
+struct ActivationTelemetry {
+ CacheAlgorithm requested_key_algorithm=CacheAlgorithm::STANDARD, requested_value_algorithm=CacheAlgorithm::STANDARD;
+ CacheAlgorithm activated_key_algorithm=CacheAlgorithm::STANDARD, activated_value_algorithm=CacheAlgorithm::STANDARD;
+ bool norm_correction=false; std::size_t expected_bytes=0, actual_bytes=0; std::string attention_path="not_activated", device; bool fallback=false; std::string build_commit, model_hash;
+};
+std::string activation_telemetry_json(const ActivationTelemetry& telemetry);
+}
diff --git a/src/cpp/src/continuous_batching/cache/turboquant_config.cpp b/src/cpp/src/continuous_batching/cache/turboquant_config.cpp
new file mode 100644
index 0000000..9377c88
--- /dev/null
+++ b/src/cpp/src/continuous_batching/cache/turboquant_config.cpp
@@ -0,0 +1,12 @@
+#include "openvino/genai/turboquant_config.hpp"
+#include <sstream>
+#include "openvino/core/except.hpp"
+namespace ov::genai { namespace {
+CacheAlgorithm parse(const ov::Any& v,const char* p){auto s=v.as<std::string>(); if(s=="STANDARD")return CacheAlgorithm::STANDARD;if(s=="TBQ3")return CacheAlgorithm::TBQ3;if(s=="TBQ4")return CacheAlgorithm::TBQ4;OPENVINO_THROW("Unsupported ",p," value: ",s);}
+const char* name(CacheAlgorithm a){switch(a){case CacheAlgorithm::STANDARD:return "STANDARD";case CacheAlgorithm::TBQ3:return "TBQ3";case CacheAlgorithm::TBQ4:return "TBQ4";}OPENVINO_THROW("Invalid TurboQuant cache algorithm enum");}
+std::string quote(const std::string& s){OPENVINO_ASSERT(s.size()<=1024,"TurboQuant telemetry field exceeds 1024 bytes");std::string r="\"";for(unsigned char c:s){if(c=='\"')r+="\\\"";else if(c=='\\')r+="\\\\";else if(c=='\n')r+="\\n";else if(c=='\r')r+="\\r";else if(c=='\t')r+="\\t";else{OPENVINO_ASSERT(c>=0x20,"TurboQuant telemetry contains a control character");r+=static_cast<char>(c);}}return r+'\"';}
+}
+TurboQuantConfig parse_turboquant_config(ov::AnyMap& p){TurboQuantConfig r;auto consume=[&](const char* n,CacheAlgorithm& a){auto i=p.find(n);if(i!=p.end()){a=parse(i->second,n);p.erase(i);}};consume(TURBOQUANT_KEY_ALGORITHM,r.key_algorithm);consume(TURBOQUANT_VALUE_ALGORITHM,r.value_algorithm);auto i=p.find(TURBOQUANT_NORM_CORRECTION);if(i!=p.end()){r.norm_correction=i->second.as<bool>();p.erase(i);}return r;}
+std::string activation_telemetry_json(const ActivationTelemetry&t){std::ostringstream o;o<<'{'
+<<"\"requested_key_algorithm\":\""<<name(t.requested_key_algorithm)<<"\",\"requested_value_algorithm\":\""<<name(t.requested_value_algorithm)<<"\",\"activated_key_algorithm\":\""<<name(t.activated_key_algorithm)<<"\",\"activated_value_algorithm\":\""<<name(t.activated_value_algorithm)<<"\",\"norm_correction\":"<<(t.norm_correction?"true":"false")<<",\"expected_bytes\":"<<t.expected_bytes<<",\"actual_bytes\":"<<t.actual_bytes<<",\"attention_path\":"<<quote(t.attention_path)<<",\"device\":"<<quote(t.device)<<",\"fallback\":"<<(t.fallback?"true":"false")<<",\"build_commit\":"<<quote(t.build_commit)<<",\"model_hash\":"<<quote(t.model_hash)<<'}';auto r=o.str();OPENVINO_ASSERT(r.size()<=4096,"TurboQuant activation telemetry exceeds 4096 bytes");return r;}
+}
