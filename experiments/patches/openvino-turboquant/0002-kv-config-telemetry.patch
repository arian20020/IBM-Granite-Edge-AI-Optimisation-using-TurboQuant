+#include <gtest/gtest.h>
+#include "openvino/genai/turboquant_config.hpp"
+using namespace ov::genai;
+TEST(TurboQuantConfig,PreservesAllAsymmetricSelectionsAndRemovesExactProperties){const std::pair<const char*,CacheAlgorithm> v[]={{"STANDARD",CacheAlgorithm::STANDARD},{"TBQ3",CacheAlgorithm::TBQ3},{"TBQ4",CacheAlgorithm::TBQ4}};for(auto k:v)for(auto x:v){ov::AnyMap p{{TURBOQUANT_KEY_ALGORITHM,std::string(k.first)},{TURBOQUANT_VALUE_ALGORITHM,std::string(x.first)},{TURBOQUANT_NORM_CORRECTION,true},{"PERFORMANCE_HINT",std::string("LATENCY")}};auto c=parse_turboquant_config(p);EXPECT_EQ(c.key_algorithm,k.second);EXPECT_EQ(c.value_algorithm,x.second);EXPECT_TRUE(c.norm_correction);EXPECT_EQ(p.size(),1u);}}
+TEST(TurboQuantConfig,DefaultsToStandardWithoutNormCorrection){ov::AnyMap p;auto c=parse_turboquant_config(p);EXPECT_EQ(c.key_algorithm,CacheAlgorithm::STANDARD);EXPECT_EQ(c.value_algorithm,CacheAlgorithm::STANDARD);EXPECT_FALSE(c.norm_correction);}
+TEST(TurboQuantConfig,RejectsUnknownOrWrongCaseAlgorithms){for(const char*s:{"TBQ5","tbq3","standard",""}){ov::AnyMap p{{TURBOQUANT_KEY_ALGORITHM,std::string(s)}};EXPECT_THROW(parse_turboquant_config(p),ov::Exception);}}
+TEST(TurboQuantConfig,EmitsBoundedActivationJsonWithoutClaimingActivation){ActivationTelemetry t;t.requested_key_algorithm=CacheAlgorithm::TBQ3;t.requested_value_algorithm=CacheAlgorithm::TBQ4;t.norm_correction=true;t.expected_bytes=123;t.attention_path="not_activated";t.device="CPU";t.fallback=true;t.build_commit="0123456789abcdef0123456789abcdef01234567";t.model_hash="abcdef";auto j=activation_telemetry_json(t);EXPECT_LT(j.size(),4096u);EXPECT_NE(j.find("\"activated_key_algorithm\":\"STANDARD\""),std::string::npos);EXPECT_NE(j.find("\"fallback\":true"),std::string::npos);}
+TEST(TurboQuantConfig,RejectsOversizedTelemetryFields){ActivationTelemetry t;t.model_hash.assign(1025,'x');EXPECT_THROW(activation_telemetry_json(t),ov::Exception);}
