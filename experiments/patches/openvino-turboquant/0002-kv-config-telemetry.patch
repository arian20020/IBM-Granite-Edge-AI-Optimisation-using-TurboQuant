+std::string json_string(const std::string& value) {
+    OPENVINO_ASSERT(value.size() <= 1024, "TurboQuant telemetry field exceeds 1024 bytes");
+    validate_utf8(value);
+    std::string result = "\"";
+    for (const unsigned char c : value) {
+        if (c == '"') result += "\\\"";
+        else if (c == '\\') result += "\\\\";
+        else if (c == '\n') result += "\\n";
+        else if (c == '\r') result += "\\r";
+        else if (c == '\t') result += "\\t";
+        else {
+            OPENVINO_ASSERT(c >= 0x20, "TurboQuant telemetry contains a control character");
+            result += static_cast<char>(c);
+        }
+    }
+    return result + '"';
+}
