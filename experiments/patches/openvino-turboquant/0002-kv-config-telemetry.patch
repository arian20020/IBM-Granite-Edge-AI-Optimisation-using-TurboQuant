+TEST(TurboQuantConfig, AcceptsUtf8ScalarBoundaryValues) {
+    const std::vector<std::string> valid{
+        std::string("\xc2\x80", 2), std::string("\xdf\xbf", 2),
+        std::string("\xe0\xa0\x80", 3), std::string("\xef\xbf\xbf", 3),
+        std::string("\xf0\x90\x80\x80", 4), std::string("\xf4\x8f\xbf\xbf", 4)};
+    for (const auto& scalar : valid) {
+        ActivationTelemetry telemetry;
+        telemetry.device = scalar;
+        telemetry.build_commit = "0123456789abcdef0123456789abcdef01234567";
+        telemetry.model_hash = "abcdef";
+        EXPECT_NO_THROW({ const auto parsed = nlohmann::json::parse(activation_telemetry_json(telemetry)); });
+    }
+}
+
+TEST(TurboQuantConfig, RejectsEveryInvalidUtf8ScalarCategory) {
+    const std::vector<std::string> invalid{
+        std::string("\x80", 1), std::string("\xc0\x80", 2), std::string("\xc2", 1),
+        std::string("\xc2\x20", 2), std::string("\xe0\x80\x80", 3),
+        std::string("\xed\xa0\x80", 3), std::string("\xf0\x80\x80\x80", 4),
+        std::string("\xf4\x90\x80\x80", 4), std::string("\xf5\x80\x80\x80", 4)};
+    for (const auto& scalar : invalid) {
+        ActivationTelemetry telemetry;
+        telemetry.device = scalar;
+        telemetry.build_commit = "0123456789abcdef0123456789abcdef01234567";
+        telemetry.model_hash = "abcdef";
+        EXPECT_THROW(activation_telemetry_json(telemetry), ov::Exception);
+    }
+}
+
+TEST(TurboQuantConfig, RequiresHexadecimalBuildCommit) {
+    TurboQuantConfig config;
+    EXPECT_THROW(inactive_activation_telemetry_json(
+                     config, "CPU", "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", "model"),
+                 ov::Exception);
+}
