+void validate_utf8(const std::string& value) {
+    for (std::size_t i = 0; i < value.size();) {
+        const auto lead = static_cast<unsigned char>(value[i]);
+        std::size_t continuation = 0;
+        if (lead <= 0x7f) continuation = 0;
+        else if (lead >= 0xc2 && lead <= 0xdf) continuation = 1;
+        else if (lead >= 0xe0 && lead <= 0xef) continuation = 2;
+        else if (lead >= 0xf0 && lead <= 0xf4) continuation = 3;
+        else OPENVINO_THROW("TurboQuant telemetry contains invalid UTF-8");
+        OPENVINO_ASSERT(i + continuation < value.size(), "TurboQuant telemetry contains truncated UTF-8");
+        for (std::size_t j = 1; j <= continuation; ++j) {
+            const auto byte = static_cast<unsigned char>(value[i + j]);
+            OPENVINO_ASSERT((byte & 0xc0) == 0x80, "TurboQuant telemetry contains invalid UTF-8");
+        }
+        i += continuation + 1;
+    }
+}
