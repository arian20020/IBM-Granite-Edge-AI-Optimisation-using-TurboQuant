+def validate_activation_record(record):
+    if set(record) != REQUIRED:
+        raise ValueError("activation record fields differ from schema")
+    for name in ("requested_key_algorithm", "requested_value_algorithm",
+                 "activated_key_algorithm", "activated_value_algorithm"):
+        if record[name] not in {"STANDARD", "TBQ3", "TBQ4"}:
