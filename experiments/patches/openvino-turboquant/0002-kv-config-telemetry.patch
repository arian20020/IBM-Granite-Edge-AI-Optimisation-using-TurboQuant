+TurboQuantConfig parse_turboquant_config(ov::AnyMap& properties) {
+    static const std::unordered_set<std::string> accepted{
+        TURBOQUANT_KEY_ALGORITHM, TURBOQUANT_VALUE_ALGORITHM, TURBOQUANT_NORM_CORRECTION};
+    for (const auto& [name, value] : properties) {
+        if (name.rfind("TURBOQUANT_", 0) == 0 && accepted.count(name) == 0) {
+            OPENVINO_THROW("Unknown TurboQuant property: ", name);
+        }
+    }
+
+    TurboQuantConfig result;
+    if (const auto it = properties.find(TURBOQUANT_KEY_ALGORITHM); it != properties.end())
+        result.key_algorithm = parse_algorithm(it->second, TURBOQUANT_KEY_ALGORITHM);
+    if (const auto it = properties.find(TURBOQUANT_VALUE_ALGORITHM); it != properties.end())
+        result.value_algorithm = parse_algorithm(it->second, TURBOQUANT_VALUE_ALGORITHM);
+    if (const auto it = properties.find(TURBOQUANT_NORM_CORRECTION); it != properties.end())
+        result.norm_correction = it->second.as<bool>();
+
+    properties.erase(TURBOQUANT_KEY_ALGORITHM);
+    properties.erase(TURBOQUANT_VALUE_ALGORITHM);
+    properties.erase(TURBOQUANT_NORM_CORRECTION);
+    return result;
+}
