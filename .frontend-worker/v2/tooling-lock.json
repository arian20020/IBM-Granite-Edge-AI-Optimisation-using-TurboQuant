{
  "schemaVersion": 2,
  "profile": "native-winui",
  "tools": [
    {
      "id": "powershell-7",
      "requiredForInitialization": true,
      "command": "pwsh",
      "minimumVersion": "7.4.0",
      "automaticInstall": false
    },
    {
      "id": "git",
      "requiredForInitialization": true,
      "command": "git",
      "automaticInstall": false
    },
    {
      "id": "codex-cli",
      "requiredForInitialization": true,
      "command": "codex",
      "automaticInstall": false,
      "notes": "Use an already authenticated Codex installation with plugin support enabled."
    },
    {
      "id": "dotnet-sdk",
      "requiredForInitialization": true,
      "command": "dotnet",
      "minimumVersion": "8.0.100",
      "automaticInstall": false,
      "notes": "Required to build and self-test GraniteFrontendGuard."
    },
    {
      "id": "node-npm",
      "requiredForInitialization": false,
      "requiredWhenProviderEnabled": "ui-ux-pro-max",
      "command": "npm",
      "automaticInstall": false
    },
    {
      "id": "python-3",
      "requiredForInitialization": false,
      "requiredWhenProviderEnabled": "ui-ux-pro-max",
      "commands": ["py -3", "python", "python3"],
      "automaticInstall": false
    },
    {
      "id": "winapp-cli",
      "requiredForInitialization": false,
      "requiredBeforeImplementation": true,
      "command": "winapp",
      "minimumVersion": "0.6.0",
      "automaticInstall": false,
      "humanApprovedInstallCommand": "winget install --id Microsoft.WinAppCli --exact --source winget"
    },
    {
      "id": "accessibility-insights-windows",
      "requiredForInitialization": false,
      "requiredBeforeReleaseGate": true,
      "automaticInstall": false
    },
    {
      "id": "windows-developer-mode",
      "requiredForInitialization": false,
      "requiredWhenRuntimeAutomationNeedsIt": true,
      "automaticInstall": false,
      "notes": "Never enable unattended; request human approval before elevation or registry changes."
    }
  ]
}
