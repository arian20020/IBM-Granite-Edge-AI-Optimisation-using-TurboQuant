* text=auto

*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf

# Release checksums are defined over canonical Git blobs. Keep exported archives
# and fresh checkouts byte-identical to those LF-normalized text blobs.
docs/testing/final-results/** text eol=lf
docs/testing/final-results/**/*.docx -text
docs/testing/final-results/**/*.pdf -text
docs/testing/final-results/**/*.xlsx -text
# BEGIN IXN CONTROLLED EXPERIMENT EVIDENCE
# Machine-generated evidence is immutable. Do not normalize line endings.
experiments/granite_turboquant_intel/logs/** -text whitespace=-blank-at-eol,-blank-at-eof
experiments/granite_turboquant_intel/manifests/** -text
experiments/granite_turboquant_intel/notes/upstream-llama-cpp/** -text
experiments/raw-results/openvino-turboquant/2026-07-30/diagnostics/u4-tbq4-load-probe-attempt-001/** -text whitespace=-blank-at-eol,-blank-at-eof
experiments/raw-results/openvino-turboquant/** -text whitespace=-blank-at-eol,-blank-at-eof
# END IXN CONTROLLED EXPERIMENT EVIDENCE

# Portable unified diffs contain mandatory one-space context lines. Preserve
# their exported bytes and do not treat that format syntax as trailing-space
# source errors.
experiments/patches/**/*.patch -text whitespace=-blank-at-eol,-blank-at-eof
