{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceCommit", "sourceTree", "packageFamilyName", "applicationId", "executablePath", "executableSha256", "executableBytes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceCommit": { "const": "4748fe04f19afdf6b27c4c12502b84db325e7294" },
    "sourceTree": { "const": "fe1fa8fb5fe4de8e7c1d867a83e08375bc1d0c91" },
    "packageFamilyName": { "type": "string", "minLength": 3 },
    "applicationId": { "type": "string", "minLength": 1 },
    "executablePath": { "type": "string", "minLength": 1 },
    "executableSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "executableBytes": { "type": "integer", "minimum": 1 }
  }
}
