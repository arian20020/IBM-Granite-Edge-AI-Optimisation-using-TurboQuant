<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GraniteEdgeAI.UnitTests</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUIDSDKReferences>false</WinUIDSDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DefineConstants>$(DefineConstants);MODEL_INSPECTION_FIXTURE_GALLERY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Features\ModelInspection\DebugFixtures\**" />
    <Page Remove="Features\ModelInspection\DebugFixtures\**" />
    <None Remove="Features\ModelInspection\DebugFixtures\**" />
    <Content Remove="Features\ModelInspection\DebugFixtures\**" />
    <EmbeddedResource Remove="Features\ModelInspection\DebugFixtures\**" />
    <PRIResource Remove="Features\ModelInspection\DebugFixtures\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <Compile Include="Features\ModelInspection\DebugFixtures\**\*.cs" />
    <Page Include="Features\ModelInspection\DebugFixtures\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Content Include="..\..\TestFixtures\ModelInspectionScenarios\**\*.json">
      <Link>TestFixtures\ModelInspectionScenarios\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>TestFixtures\ModelInspectionScenarios\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Page Remove="UnitTestApp.xaml" />
    <ApplicationDefinition Include="UnitTestApp.xaml" />
    <Page Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelInspection\Presentation\ModelInspectionTheme.xaml"
          Link="Features\ModelInspection\Presentation\ModelInspectionTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <ProjectCapability Include="TestContainer" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\SplashScreen.scale-200.png" Link="Assets\SplashScreen.scale-200.png" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\LockScreenLogo.scale-200.png" Link="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\Square150x150Logo.scale-200.png" Link="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\Square44x44Logo.scale-200.png" Link="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\Square44x44Logo.targetsize-24_altform-unplated.png" Link="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\StoreLogo.png" Link="Assets\StoreLogo.png" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\Wide310x150Logo.scale-200.png" Link="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\Fonts\Inter-Regular.ttf" Link="Assets\Fonts\Inter-Regular.ttf" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\Fonts\Inter-Bold.ttf" Link="Assets\Fonts\Inter-Bold.ttf" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\Fonts\OFL.txt" Link="Assets\Fonts\OFL.txt" />
    <Content Include="..\..\..\IBM Granite with TurboQuant (Intel)\Assets\Fonts\inter-manifest.json" Link="Assets\Fonts\inter-manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectReference Include="..\..\..\IBM Granite with TurboQuant (Intel)\IBM Granite with TurboQuant (Intel).csproj" />
    <ProjectReference Include="..\..\..\infrastructure\GraniteEdgeAI.ModelInspection.WorkerClient\GraniteEdgeAI.ModelInspection.WorkerClient.csproj" />
    <ProjectReference Include="..\..\..\shared\GraniteEdgeAI.ModelInspection.Contracts\GraniteEdgeAI.ModelInspection.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.TestPlatform.TestHost" Version="18.8.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\TestFixtures\GGUF\**\*.gguf">
      <Link>TestFixtures\GGUF\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\TestFixtures\Malformed\**\*.gguf">
      <Link>TestFixtures\Malformed\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\TestFixtures\ExpectedMetadata\**\*.json">
      <Link>TestFixtures\ExpectedMetadata\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\TestFixtures\fixture-manifest.json">
      <Link>TestFixtures\fixture-manifest.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- BEGIN EXPLICIT MODEL INSPECTION NAVIGATION TESTS -->

  <!--
    These navigation tests are explicitly listed so their folder structure
    is visible in Visual Studio Solution Explorer.
  -->
  <ItemGroup Label="ModelInspectionNavigationTests">

    <!-- Remove the SDK's implicit copies before explicitly including them. -->
    <Compile Remove="Features\ModelImport\ModelImportNavigationRequestTests.cs" />
    <Compile Remove="Features\Onboarding\OnboardingModelInspectionNavigationTests.cs" />
    <Compile Remove="Features\ModelInspection\ModelInspectionPageNavigationTests.cs" />

    <!-- Explicit project items displayed by Solution Explorer. -->
    <Compile Include="Features\ModelImport\ModelImportNavigationRequestTests.cs" />
    <Compile Include="Features\Onboarding\OnboardingModelInspectionNavigationTests.cs" />
    <Compile Include="Features\ModelInspection\ModelInspectionPageNavigationTests.cs" />

  </ItemGroup>

  <!-- END EXPLICIT MODEL INSPECTION NAVIGATION TESTS -->
</Project>
