<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <!-- Linked application sources retain the owning project's analyzer
         baseline; T1 must not rewrite production solely for this test host. -->
    <NoWarn>$(NoWarn);CA1068;CA1512;CA1707;CA1720;CA1822;CA1859;CA1870;CA2208</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelImport\Selection\*.cs"
             Link="Production\ModelImport\Selection\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelImport\DragDropRoute\ModelImportDropHandler.cs"
             Link="Production\ModelImport\DragDropRoute\ModelImportDropHandler.cs" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelInspection\Application\ModelInspectionHandoff*.cs"
             Link="Production\ModelInspection\Handoff\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelInspection\Contracts\*.cs"
             Link="Production\ModelInspection\Contracts\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelOptimization\Storage\*.cs"
             Exclude="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelOptimization\Storage\OptimizationSourceResolver.cs"
             Link="Production\ModelOptimization\Storage\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelOptimization\Application\*.cs"
             Link="Production\ModelOptimization\Application\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelHardwareCompatibility\Application\OptimizationJourneyEntryContext.cs"
             Link="Production\ModelHardwareCompatibility\OptimizationJourneyEntryContext.cs" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\ModelHardwareCompatibility\Contracts\*.cs"
             Link="Production\ModelHardwareCompatibility\Contracts\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\GgufRuntime\History\ChatCompletionStatus.cs"
             Link="Production\GgufRuntime\History\ChatCompletionStatus.cs" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\GgufRuntime\History\ChatConversation.cs"
             Link="Production\GgufRuntime\History\ChatConversation.cs" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\GgufRuntime\History\ChatHistoryPolicy.cs"
             Link="Production\GgufRuntime\History\ChatHistoryPolicy.cs" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\GgufRuntime\History\ChatMessage.cs"
             Link="Production\GgufRuntime\History\ChatMessage.cs" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\GgufRuntime\History\ChatTitlePolicy.cs"
             Link="Production\GgufRuntime\History\ChatTitlePolicy.cs" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\GgufRuntime\Services\IGgufChatSession.cs"
             Link="Production\GgufRuntime\Services\IGgufChatSession.cs" />
    <Compile Include="..\..\..\IBM Granite with TurboQuant (Intel)\Features\GgufRuntime\Services\GgufChatSessionAdapter.cs"
             Link="Production\GgufRuntime\Services\GgufChatSessionAdapter.cs" />
    <Compile Include="..\..\..\infrastructure\GraniteEdgeAI.GgufQuantization.WorkerClient\GgufQuantizerEnvironmentPolicy.cs"
